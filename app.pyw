def _find_pdf_font():
    """Ищет системный TTF с поддержкой кириллицы."""
    candidates = [
        r"C:\Windows\Fonts\segoeui.ttf",
        r"C:\Windows\Fonts\arial.ttf",
        r"C:\Windows\Fonts\tahoma.ttf",
        r"C:\Windows\Fonts\verdana.ttf",
        r"C:\Windows\Fonts\calibri.ttf",
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    # Поиск по всем шрифтам, содержащим "sans" в имени
    try:
        fonts_dir = r"C:\Windows\Fonts"
        if os.path.isdir(fonts_dir):
            for f in os.listdir(fonts_dir):
                low = f.lower()
                if low.endswith(".ttf") and "sans" in low:
                    return os.path.join(fonts_dir, f)
    except Exception:
        pass
    return None


def _build_pdf_report(data, path):
    """Строит PDF-отчёт по данным collect_full_report()."""
    if not FPDF_AVAILABLE:
        raise RuntimeError(
            "Модуль fpdf2 не установлен.\n\n"
            "Установите командой:\n"
            "  python -m pip install fpdf2")

    pdf = FPDF(orientation="P", unit="mm", format="A4")
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.add_page()

    # Шрифт с кириллицей
    font_path = _find_pdf_font()
    font_loaded = False
    if font_path:
        try:
            pdf.add_font("Main", "", font_path)
            pdf.add_font("Main", "B", font_path)
            font_loaded = True
        except Exception:
            font_loaded = False
    font_name = "Main" if font_loaded else "Helvetica"

    # ─── Заголовок ───
    pdf.set_fill_color(21, 101, 192)
    pdf.set_text_color(255, 255, 255)
    pdf.set_font(font_name, "B", 20)
    pdf.cell(0, 14, "Optix - Паспорт ПК",
             align="C", fill=True, new_x="LMARGIN", new_y="NEXT")

    pdf.ln(2)
    pdf.set_text_color(80, 80, 80)
    pdf.set_font(font_name, "", 10)
    pdf.cell(0, 6, f"Дата: {data['generated']}",
             align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.ln(4)

    def section(title, rows):
        # Заголовок раздела
        pdf.set_fill_color(21, 101, 192)
        pdf.set_text_color(255, 255, 255)
        pdf.set_font(font_name, "B", 12)
        pdf.cell(0, 9, f"  {title}",
                 align="L", fill=True, new_x="LMARGIN", new_y="NEXT")
        pdf.ln(1)
        # Строки: метка фиксированной ширины 60 мм, значение — 120 мм
        for label, value in rows:
            y_before = pdf.get_y()
            # Метка
            pdf.set_text_color(100, 100, 100)
            pdf.set_font(font_name, "", 10)
            pdf.set_xy(15, y_before)
            pdf.cell(60, 7, f"  {label}", border=0,
                     new_x="RIGHT", new_y="TOP")
            # Значение — фиксированная ширина, multi_cell для длинных строк
            pdf.set_text_color(0, 0, 0)
            pdf.set_font(font_name, "B", 10)
            x_value = pdf.get_x()
            pdf.multi_cell(120, 7, str(value),
                            border=0, align="L",
                            new_x="LMARGIN", new_y="NEXT")
            # Если значение короткое (одна строка) — ничего не делаем.
            # Если длинное (несколько строк) — multi_cell сам перенёс Y.
        pdf.ln(3)

    o = data["os"]
    c = data["cpu"]
    ram = data["ram"]

    # ─── Система ───
    section("Система", [
        ("Компьютер", o.get("computer_name", "?")),
        ("Пользователь", o.get("user", "?")),
        ("ОС", f"{o.get('system', '?')} {o.get('release', '')}"),
        ("Версия", o.get("version", "?")),
        ("Архитектура", o.get("arch", "?")),
        ("Аптайм", data.get("uptime", "?")),
    ])

    # ─── Процессор ───
    section("Процессор", [
        ("Модель", c.get("name", "?")),
        ("Ядра", f"{c.get('cores', 0)} физических / "
                  f"{c.get('threads', 0)} логических"),
        ("Частота", c.get("freq") or "—"),
    ])

    # ─── ОЗУ ───
    section("ОЗУ", [
        ("Всего", human_size(ram.get("total", 0))),
        ("Доступно", human_size(ram.get("available", 0))),
        ("Занято", f"{ram.get('used_percent', 0)}%"),
    ])

    # ─── Диски ───
    disk_rows = []
    for d in data.get("disks", []):
        disk_rows.append((
            d.get("mount", "?"),
            f"{human_size(d.get('used', 0))} / "
            f"{human_size(d.get('total', 0))} "
            f"({d.get('percent', 0)}%)"
        ))
    if disk_rows:
        section("Диски", disk_rows)
    else:
        section("Диски", [("—", "нет данных")])

    # ─── Оптимизация ───
    tweaks = data.get("tweaks_count", 0)
    section("Оптимизация", [
        ("Применено твиков", tweaks if tweaks else "нет"),
    ])

    # ─── Подвал ───
    pdf.ln(4)
    pdf.set_text_color(150, 150, 150)
    pdf.set_font(font_name, "", 8)
    pdf.cell(0, 5, "Отчёт сформирован программой Optix",
             align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.cell(0, 5, f"Версия {APP_VERSION}",
             align="C", new_x="LMARGIN", new_y="NEXT")

    pdf.output(path)


