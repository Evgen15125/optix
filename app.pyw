    ctk.CTkButton(br, text="Закрыть", height=38, font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A", corner_radius=19, command=win.destroy).pack(side="left", padx=(4, 0), fill="x", expand=True)


def _sched_delete_task(task_full, task_name=""):
    """Удаление задачи с подтверждением."""
    if not messagebox.askyesno(
        "Удалить задачу?",
        f"Задача будет удалена полностью:\n\n{task_name or task_full}\n\n"
        f"⚠️ Это не «отключить», а именно удалить.\n"
        f"Откатить можно только импортом XML-бэкапа.\n\n"
        f"Продолжить?"):
        return False
    if not messagebox.askyesno(
        "Подтверждение",
        f"ТОЧНО удалить задачу?\n\n{task_full}"):
        return False
    try:
        r = subprocess.run(
            ["schtasks", "/delete", "/tn", task_full, "/f"],
            capture_output=True, timeout=30,
            creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b"\n" + (r.stderr or b""))
        if r.returncode == 0:
            messagebox.showinfo("Готово", "Задача удалена.")
            return True
        else:
            messagebox.showerror("Ошибка",
                f"Код {r.returncode}\n\n{out[:500]}")
            return False
    except Exception as e:
        log_error("_sched_delete_task", e)
        messagebox.showerror("Ошибка", str(e))
        return False


def _sched_export_all():
    """Экспортирует все задачи планировщика в одну папку."""
    if not messagebox.askyesno(
        "Экспорт всех задач",
        "Все задачи планировщика (включая системные) будут сохранены "
        "в выбранную папку как XML-файлы.\n\n"
        "Это займёт 1–2 минуты.\n\nПродолжить?"):
        return
    folder = filedialog.askdirectory(
        title="Куда сохранить задачи?")
    if not folder:
        return
    ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
    backup_dir = os.path.join(folder, f"Optix_Scheduler_Backup_{ts}")
    try:
        os.makedirs(backup_dir, exist_ok=True)
    except Exception as e:
        messagebox.showerror("Ошибка", f"Не создать папку:\n{e}")
        return

    diag_ui["status"].configure(text="⏳ Экспорт задач...",
                                 text_color="#FFD54F") if "status" in diag_ui else None

    def worker():
        try:
            # Получаем список всех задач
            r = subprocess.run(
                ["schtasks", "/query", "/fo", "csv", "/v"],
                capture_output=True, timeout=120,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(r.stdout or b"")
            import csv
            import io
            reader = csv.reader(io.StringIO(out))
            rows = list(reader)
            if not rows:
                app.after(0, lambda: messagebox.showinfo(
                    "Готово", "Задач не найдено."))
                return
            header = rows[0]
            # Ищем индексы "TaskName" и "Task To Run"
            try:
                name_idx = next(
                    i for i, h in enumerate(header)
                    if "taskname" in h.lower() or "имя задачи" in h.lower())
            except StopIteration:
                name_idx = 1
            exported = 0
            failed = 0
            for row in rows[1:]:
                if len(row) <= name_idx:
                    continue
                task_name = row[name_idx].strip()
                if not task_name or task_name.lower() == "taskname":
                    continue
                # Пропускаем задачи в корне \Microsoft (системные)
                # — но лучше экспортировать всё, чтобы был полный бэкап
                xml, err = _sched_get_task_xml(task_name)
                if err or not xml:
                    failed += 1
                    continue
                # Безопасное имя файла
                safe = task_name.replace("\\", "_").replace("/", "_") \
                                 .replace(":", "_").replace("*", "_") \
                                 .replace("?", "_").replace('"', "_") \
                                 .replace("<", "_").replace(">", "_") \
                                 .replace("|", "_")
                if len(safe) > 180:
                    safe = safe[-180:]
                fp = os.path.join(backup_dir, f"{safe}.xml")
                try:
                    with open(fp, "w", encoding="utf-16") as f:
                        f.write(xml)
                    exported += 1
                except Exception:
                    failed += 1

            def finish():
                messagebox.showinfo(
                    "Готово",
                    f"Экспортировано задач: {exported}\n"
                    f"Не удалось: {failed}\n\n"
                    f"Папка: {backup_dir}")
                try:
                    os.startfile(backup_dir)
                except Exception:
                    pass
            app.after(0, finish)
        except Exception as e:
            log_error("_sched_export_all", e)
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


def _sched_import_xml():
    """Импорт задачи из XML."""
    if not messagebox.askyesno(
        "Импорт задачи",
        "Выберите XML-файл с описанием задачи планировщика.\n\n"
        "Задача будет создана заново (или перезаписана, если с таким "
        "именем уже существует).\n\n"
        "⚠️ Импорт может запросить права администратора.\n\n"
        "Продолжить?"):
        return
    path = filedialog.askopenfilename(
        title="Выберите XML задачи",
        filetypes=[("XML", "*.xml"), ("Все файлы", "*.*")])
    if not path:
        return
    try:
        # Импортируем через schtasks /create /xml <path> /tn <name>
        # Имя берём из файла
        with open(path, "r", encoding="utf-16") as f:
            content = f.read()
        import re
        m = re.search(r"<URI>(.*?)</URI>", content)
        task_name = m.group(1).strip() if m else None
        if not task_name:
            task_name = os.path.splitext(os.path.basename(path))[0]
        cmd = ["schtasks", "/create", "/xml", path, "/tn", task_name, "/f"]
        r = subprocess.run(cmd, capture_output=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b"\n" + (r.stderr or b""))
        if r.returncode == 0:
            messagebox.showinfo(
                "Готово",
                f"Задача импортирована:\n{task_name}")
        else:
            messagebox.showerror(
                "Ошибка",
                f"Код {r.returncode}\n\n{out[:800]}")
    except Exception as e:
        log_error("_sched_import_xml", e)
        messagebox.showerror("Ошибка", str(e))


