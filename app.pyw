# ================== УМНЫЙ АССИСТЕНТ ==================
def _assistant_query_deepseek(query):
    """Отправляет запрос к DeepSeek API (совместим с OpenAI) через urllib."""
    import urllib.request
    import urllib.error
    import json
    
    api_key = _STATE.get("deepseek_api_key", "").strip()
    if not api_key:
        return "Ошибка: API-ключ DeepSeek не задан."

    # Базовый URL и эндпоинт DeepSeek (формат OpenAI)
    url = "https://api.deepseek.com/chat/completions"
    
    headers = {
        'Content-Type': 'application/json',
        'Authorization': f'Bearer {api_key}'
    }
    
    # Системный промпт — настраиваем характер ИИ
    system_prompt = (
        "Ты — встроенный ИИ-ассистент программы Optix для оптимизации Windows. "
        "Отвечай кратко, дружелюбно и по делу. Если пользователь спрашивает, как что-то "
        "сделать в Windows — дай четкую пошаговую инструкцию."
    )
    
    data = {
        "model": "deepseek-chat",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": query}
        ],
        "temperature": 0.7,
        "max_tokens": 800,
        "stream": False
    }
    
    try:
        req = urllib.request.Request(url, data=json.dumps(data).encode('utf-8'), headers=headers, method='POST')
        with urllib.request.urlopen(req, timeout=30) as response:
            res_data = json.loads(response.read().decode('utf-8'))
            text = res_data['choices'][0]['message']['content']
            return text.strip()
    except urllib.error.HTTPError as e:
        err_body = ""
        try:
            err_body = e.read().decode('utf-8')
        except: pass
        
        if e.code == 401:
            return "⚠️ Ошибка API (401): Неверный API-ключ DeepSeek. Проверьте его в Настройках."
        elif e.code == 402:
            return "⚠️ Ошибка API (402): Недостаточно средств на балансе DeepSeek. Пополните счёт на platform.deepseek.com"
        elif e.code == 429:
            return "⚠️ Превышен лимит запросов (429). Подожди минуту и попробуй снова."
        return f"⚠️ Ошибка API: {e.code} {e.reason}\n{err_body[:200]}"
    except Exception as e:
        return f"⚠️ Ошибка сети: Не удалось связаться с DeepSeek.\n{str(e)}"


def build_assistant_page(parent):
    f = ctk.CTkFrame(parent, fg_color="#0A1A30")
    
    header_frame = ctk.CTkFrame(f, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(10, 8), padx=15, ipadx=20)
    
    icon_img = _load_sidebar_icon("assistant")
    if icon_img:
        ctk.CTkLabel(header_frame, text="", image=icon_img, fg_color="transparent").pack(side="left", padx=(15, 5), pady=8)
    ctk.CTkLabel(header_frame, text="Ассистент", font=("Inter", 24, "bold"), text_color="#ffffff", fg_color="transparent").pack(side="left", padx=(0 if icon_img else 15, 15), pady=8)

    ctk.CTkLabel(f, text="Локальный помощник. Понимает базовые команды (например: «очисти», «температура», «диск»).",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    # ─── Область чата ───
    chat_wrap = ctk.CTkFrame(f, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    chat_wrap.pack(fill="both", expand=True, padx=15, pady=(0, 10))
    
    chat_scroll = ctk.CTkScrollableFrame(chat_wrap, fg_color="transparent", corner_radius=0,
                                         scrollbar_button_color="#243A5E", scrollbar_button_hover_color="#4FC3F7")
    chat_scroll.pack(fill="both", expand=True, padx=6, pady=6)

    def _scroll_to_bottom():
        try:
            app.after(50, lambda: chat_scroll._parent_canvas.yview_moveto(1.0))
        except Exception:
            pass

    def add_bot_message(text):
        frame = ctk.CTkFrame(chat_scroll, fg_color="transparent")
        frame.pack(fill="x", pady=4, padx=5)
        bubble = ctk.CTkFrame(frame, fg_color="#1F2E4A", corner_radius=12, border_width=1, border_color="#2A3B5C")
        bubble.pack(side="left", anchor="w")
        lbl = ctk.CTkLabel(bubble, text=text, font=("Inter", 13), text_color="#e0e8f5", wraplength=600, justify="left")
        lbl.pack(padx=12, pady=8)
        _scroll_to_bottom()

    def add_user_message(text):
        frame = ctk.CTkFrame(chat_scroll, fg_color="transparent")
        frame.pack(fill="x", pady=4, padx=5)
        bubble = ctk.CTkFrame(frame, fg_color="#1565C0", corner_radius=12)
        bubble.pack(side="right", anchor="e")
        lbl = ctk.CTkLabel(bubble, text=text, font=("Inter", 13), text_color="#ffffff", wraplength=600, justify="left")
        lbl.pack(padx=12, pady=8)
        _scroll_to_bottom()

    # Приветствие
    add_bot_message("🤖 Привет! Я локальный ассистент Optix.\n\nЯ умею выполнять базовые команды:\n• «очисти» — быстрая очистка Temp\n• «температура» — датчики CPU/GPU\n• «диск» — свободное место на C:\n• «диагностика» — проверка SFC\n\nЧем могу помочь?")

    # ─── Поле ввода ───
    input_row = ctk.CTkFrame(f, fg_color="transparent")
    input_row.pack(fill="x", padx=15, pady=(0, 15))
    
    entry = ctk.CTkEntry(input_row, placeholder_text="Напиши команду...", height=44,
                         font=("Inter", 14), fg_color="#1F2E4A", text_color="#ffffff", corner_radius=22)
    entry.pack(side="left", fill="x", expand=True, padx=(0, 10))

    def process_command(query):
        q = query.lower().strip()
        
        if any(w in q for w in ["привет", "здравствуй", "хай"]):
            add_bot_message("Привет! Готов к работе. Напиши команду.")
            return
            
        if any(w in q for w in ["очист", "мусор", "temp", "кэш"]):
            add_bot_message("⏳ Запускаю быструю очистку временных файлов...")
            def do_clean():
                total = 0
                for cat in CATEGORIES:
                    if "Временные файлы" in cat["name"]:
                        try:
                            fl, _, _ = clean_category(cat)
                            total += fl
                        except: pass
                app.after(0, lambda: add_bot_message(f"✅ Готово! Освобождено: {human_size(total)}"))
            threading.Thread(target=do_clean, daemon=True).start()
            return
            
        if any(w in q for w in ["температур", "греет", "нагрев", "cpu"]):
            temps = get_cached_temperatures()
            t_cpu = temps.get("cpu", "—")
            t_gpu = temps.get("gpu", "—")
            add_bot_message(f"Текущая температура:\n🌡 CPU: {t_cpu}°C\n🌡 GPU: {t_gpu}°C")
            return
            
        if any(w in q for w in ["диск", "место", "свободно", "hdd", "ssd"]):
            try:
                import psutil
                c_drive = next((p for p in psutil.disk_partitions() if p.mountpoint == "C:\\"), None)
                if c_drive:
                    u = psutil.disk_usage(c_drive.mountpoint)
                    add_bot_message(f"💾 На диске C: свободно {human_size(u.free)} из {human_size(u.total)}.\nЗанято: {u.percent}%.")
                else:
                    add_bot_message("Не удалось найти диск C:")
            except Exception:
                add_bot_message("Ошибка при чтении информации о дисках.")
            return
            
        if any(w in q for w in ["диагност", "проверь", "sfc", "ошибк"]):
            add_bot_message("⏳ Запускаю проверку SFC (это займёт 1–2 минуты)...")
            def do_diag():
                ok, out = run_command_with_output(["sfc", "/verifyonly"], timeout=600)
                status = "✅ Проверка завершена. Ошибок не найдено." if ok else "⚠️ Найдены ошибки или не удалось запустить."
                app.after(0, lambda: add_bot_message(status))
            threading.Thread(target=do_diag, daemon=True).start()
            return
            
        # Если ничего не подошло локально — проверяем наличие API-ключа
        api_key = _STATE.get("deepseek_api_key", "").strip()
        if api_key:
            # Создаем временное сообщение "думаю"
            think_lbl = ctk.CTkLabel(chat_scroll, text="🤖 Optix: 🤔 Думаю...", 
                                     font=("Inter", 12, "italic"), text_color="#90A4AE")
            think_lbl.pack(anchor="w", padx=15, pady=4)
            _scroll_to_bottom()
            
            def ask_ai():
                ans = _assistant_query_deepseek(query)
                def update_ui():
                    think_lbl.destroy()
                    add_bot_message(ans)
                app.after(0, update_ui)
                
            threading.Thread(target=ask_ai, daemon=True).start()
            return

        # Если ключа нет, показываем справку
        add_bot_message("Извини, я пока не умею отвечать на такие вопросы.\n\nПопробуй: «очисти», «температура», «диск» или «диагностика».\n\n💡 Чтобы я стал умнее, добавь API-ключ DeepSeek в Настройках.")

    state = {"busy": False}

    def send_msg(event=None):
        if state["busy"]:
            return
        query = entry.get().strip()
        if not query:
            return
        entry.delete(0, "end")
        add_user_message(query)
        
        state["busy"] = True
        entry.configure(state="disabled")
        btn_send.configure(state="disabled")
        
        def run_and_unlock():
            process_command(query)
            state["busy"] = False
            entry.configure(state="normal")
            btn_send.configure(state="normal")
            entry.focus_set()
            
        # Небольшая задержка для эффекта "печати"
        app.after(300, run_and_unlock)

    entry.bind("<Return>", send_msg)
    
    btn_send = ctk.CTkButton(input_row, text="📤 Отправить", width=140, height=44,
                             font=("Inter", 13, "bold"), fg_color="#1976D2",
                             hover_color="#42A5F5", corner_radius=22, command=send_msg)
    btn_send.pack(side="right")

    return f


