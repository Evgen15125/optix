def _open_disk_management():
    """Открывает оснастку «Управление дисками» Windows."""
    try:
        # Способ 1: через mmc.exe (правильный)
        subprocess.Popen(["mmc.exe", "diskmgmt.msc"],
                         creationflags=CREATE_NO_WINDOW)
        return
    except Exception:
        pass
    # Способ 2: через os.startfile (ассоциация .msc)
    try:
        os.startfile("diskmgmt.msc")
        return
    except Exception:
        pass
    # Способ 3: через cmd start
    try:
        subprocess.Popen(["cmd", "/c", "start", "", "diskmgmt.msc"],
                         creationflags=CREATE_NO_WINDOW)
        return
    except Exception as e:
        log_error("_open_disk_management", e)
        messagebox.showerror("Ошибка", str(e))


