    ctk.CTkLabel(dlg, text="📨  Отправить отзыв разработчику",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)

    ctk.CTkLabel(dlg,
                 text="Опишите проблему, предложение или вопрос.",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 10))

    # ─── Поле «Ваше имя / ник» (опционально) ───
    ctk.CTkLabel(dlg, text="Ваше имя или ник (необязательно):",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF", anchor="w").pack(
        fill="x", padx=20, pady=(0, 2))
    name_entry = ctk.CTkEntry(dlg, height=34,
                                font=("Arial", 12),
                                fg_color="#1A2A4A",
                                text_color="#ffffff",
                                placeholder_text="Например: Иван")
    name_entry.pack(fill="x", padx=20, pady=(0, 8))

    # ─── Поле «Ваш email» (опционально, для ответа) ───
    ctk.CTkLabel(dlg,
                 text="Ваш email для ответа (необязательно):",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF", anchor="w").pack(
        fill="x", padx=20, pady=(0, 2))
    email_entry = ctk.CTkEntry(dlg, height=34,
                                 font=("Arial", 12),
                                 fg_color="#1A2A4A",
                                 text_color="#ffffff",
                                 placeholder_text="user@example.com")
    email_entry.pack(fill="x", padx=20, pady=(0, 8))

    # ─── Поле сообщения ───
    ctk.CTkLabel(dlg, text="Сообщение:",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF", anchor="w").pack(
        fill="x", padx=20, pady=(0, 2))
    tb = ctk.CTkTextbox(dlg, font=("Consolas", 12),
                         fg_color="#1A2A4A",
                         text_color="#ffffff",
                         corner_radius=10, wrap="word")
    tb.pack(fill="both", expand=True, padx=20, pady=(0, 8))

    try:
        import platform
        sys_info = (f"Optix: {APP_VERSION}\n"
                    f"ОС: {platform.system()} "
                    f"{platform.release()}\n"
                    f"Версия: {platform.version()}\n"
                    f"Python: {sys.version.split()[0]}")
    except Exception:
        sys_info = f"Optix: {APP_VERSION}"

    template = (
        "Опишите отзыв здесь:\n"
        "\n"
        "\n"
        "─────────────────────────────\n"
        "Техническая информация (можете удалить, если не хотите):\n"
        f"{sys_info}\n"
    )
    tb.insert("1.0", template)

    # ─── Статус ───
    status_lbl = ctk.CTkLabel(dlg, text="",
                               font=("Arial", 11, "bold"),
                               text_color="#FFD54F",
                               fg_color="#0D47A1",
                               corner_radius=8, height=26)
    status_lbl.pack(fill="x", padx=20, pady=(0, 6))

    def get_body():
        return tb.get("1.0", "end").strip()

    def set_status(text, color="#FFD54F"):
        try:
            status_lbl.configure(text=text, text_color=color)
        except Exception:
            pass

    def send_feedback():
        """Отправляет отзыв через Web3Forms API в фоновом потоке."""
        body = get_body()
        if not body or len(body.strip()) < 10:
            messagebox.showwarning(
                "Пустое сообщение",
                "Напишите хотя бы одно-два предложения.")
            return

        name = name_entry.get().strip() or "Аноним"
        user_email = email_entry.get().strip()

        # Отключаем кнопки на время отправки
        try:
            send_btn.configure(state="disabled", text="⏳ Отправка...")
            copy_btn.configure(state="disabled")
        except Exception:
            pass
        set_status("⏳ Отправляю письмо...", "#FFD54F")

        def worker():
            try:
                subject = f"Optix — отзыв от {name}"
                payload = {
                    "access_key": ACCESS_KEY,
                    "subject": subject,
                    "from_name": "Optix Feedback",
                    "name": name,
                    "message": body,
                }
                if user_email:
                    payload["email"] = user_email
                    payload["replyto"] = user_email

                data = _json.dumps(payload,
                                    ensure_ascii=False).encode("utf-8")
                req = urllib.request.Request(
                    "https://api.web3forms.com/submit",
                    data=data,
                    headers={
                        "Content-Type":
                            "application/json; charset=utf-8",
                        "Accept": "application/json",
                        "User-Agent":
                            f"Optix/{APP_VERSION} (Windows)",
                    },
                    method="POST",
                )

                # Читаем тело даже при HTTPError — чтобы видеть
                # реальную ошибку сервера
                resp_body = ""
                http_code = 0
                try:
                    with urllib.request.urlopen(req,
                                                 timeout=30) as resp:
                        resp_body = resp.read().decode(
                            "utf-8", errors="replace")
                        http_code = resp.status
                except urllib.error.HTTPError as he:
                    http_code = he.code
                    try:
                        resp_body = he.read().decode(
                            "utf-8", errors="replace")
                    except Exception:
                        resp_body = f"HTTP {he.code} {he.reason}"

                # Парсим JSON-ответ
                result = {}
                try:
                    result = _json.loads(resp_body)
                except Exception:
                    result = {"_raw": resp_body[:500]}

                if result.get("success"):
                    def on_ok():
                        set_status("✅ Отзыв отправлен. Спасибо!",
                                    "#7CFC7C")
                        try:
                            send_btn.configure(state="disabled",
                                                text="✅ Отправлено")
                        except Exception:
                            pass
                        try:
                            show_toast(
                                "Optix — отзыв отправлен",
                                "Спасибо! Ваше сообщение получено.")
                        except Exception:
                            pass
                        dlg.after(1800, dlg.destroy)
                    app.after(0, on_ok)
                else:
                    # Достаём осмысленное сообщение
                    err = (result.get("message")
                           or result.get("body", {}).get("message")
                           if isinstance(result.get("body"), dict)
                           else None
                           or result.get("_raw")
                           or f"HTTP {http_code}")
                    def on_fail():
                        set_status(
                            f"❌ Ошибка: {str(err)[:80]}",
                            "#FF8A8A")
                        try:
                            send_btn.configure(state="normal",
                                                text="📤 Отправить")
                            copy_btn.configure(state="normal")
                        except Exception:
                            pass
                        messagebox.showerror(
                            "Ошибка отправки",
                            f"Сервер ответил ({http_code}):\n\n"
                            f"{err}\n\n"
                            f"Попробуйте «📋 Копировать текст» "
                            f"и отправьте вручную на "
                            f"{DEVELOPER_EMAIL}.")
                    app.after(0, on_fail)
            except Exception as e:
                log_error("_open_feedback_mail.send", e)
                def on_err(err=e):
                    set_status(f"❌ {type(err).__name__}: "
                                f"{str(err)[:60]}", "#FF8A8A")
                    try:
                        send_btn.configure(state="normal",
                                            text="📤 Отправить")
                        copy_btn.configure(state="normal")
                    except Exception:
                        pass
                    messagebox.showerror(
                        "Ошибка сети",
                        f"Не удалось отправить отзыв:\n\n{err}\n\n"
                        f"Проверьте интернет или используйте "
                        f"«📋 Копировать текст».")
                app.after(0, on_err)

        threading.Thread(target=worker, daemon=True).start()

    def copy_body():
        try:
            app.clipboard_clear()
            app.clipboard_append(get_body())
            set_status("📋 Текст скопирован. Вставьте в письмо.",
                        "#7CFC7C")
            try:
                show_toast("Optix", "Текст скопирован в буфер.")
            except Exception:
                pass
        except Exception as e:
            log_error("_open_feedback_mail.copy", e)

    def open_gmail_fallback():
        """Резервный вариант — открыть Gmail в браузере."""
        copy_body()
        try:
            subprocess.Popen(
                ["cmd", "/c", "start", "",
                 "https://mail.google.com/mail/u/0/?view=cm&fs=1"],
                creationflags=CREATE_NO_WINDOW)
            try:
                show_toast(
                    "Optix — отзыв",
                    f"Текст скопирован. Вставьте (Ctrl+V). "
                    f"Адрес: {DEVELOPER_EMAIL}")
            except Exception:
                pass
        except Exception as e:
            log_error("_open_feedback_mail.gmail_fallback", e)

    # ─── Кнопки: ряд 1 — отправить ───
    br1 = ctk.CTkFrame(dlg, fg_color="transparent")
    br1.pack(pady=(0, 6), padx=20, fill="x")
    send_btn = ctk.CTkButton(
        br1, text="📤 Отправить",
        height=46, font=("Inter", 15, "bold"),
        fg_color="#2E7D32", hover_color="#43A047",
        corner_radius=23, command=send_feedback)
    send_btn.pack(fill="x")

    # ─── Кнопки: ряд 2 — резерв ───
    br2 = ctk.CTkFrame(dlg, fg_color="transparent")
    br2.pack(pady=(0, 6), padx=20, fill="x")
    copy_btn = ctk.CTkButton(
        br2, text="📋 Копировать текст",
        height=34, font=("Arial", 11, "bold"),
        fg_color="#1976D2", hover_color="#42A5F5",
        corner_radius=17, command=copy_body)
    copy_btn.pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(
        br2, text="📧 Открыть Gmail (резерв)",
        height=34, font=("Arial", 11, "bold"),
        fg_color="#455A64", hover_color="#546E7A",
        corner_radius=17, command=open_gmail_fallback
    ).pack(side="left", padx=(4, 0), fill="x", expand=True)

    # ─── Ряд 3: закрыть ───
    ctk.CTkButton(dlg, text="Закрыть", height=34,
                  font=("Arial", 11, "bold"),
                  fg_color="#37474F", hover_color="#455A64",
                  corner_radius=17, command=dlg.destroy
                  ).pack(pady=(0, 14), padx=20, fill="x")


