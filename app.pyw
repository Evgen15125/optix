    sort_menu = ctk.CTkOptionMenu(ctrl, values=["По имени", "По размеру", "По дате", "По издателю", "По оценке"],
        width=150, height=38, font=("Inter", 12), fg_color="#1F2E4A", button_color="#1976D2",
        button_hover_color="#42A5F5", command=lambda v: refresh_programs_ui())
    sort_menu.set("По имени")
    sort_menu.pack(side="left", padx=(0, 6))
    programs_ui["sort"] = sort_menu

    date_filter_menu = ctk.CTkOptionMenu(ctrl, values=["Все", "За 7 дней", "За 30 дней", "За 90 дней", "За 365 дней"],
