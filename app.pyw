def _normalize_name(s):
    """Убирает всё кроме букв и цифр, приводит к нижнему регистру."""
    import re
    return re.sub(r"[^a-z0-9а-яё]", "", (s or "").lower())


def _match_level(candidate, target_norm):
    """Сравнивает имя: 'exact', 'partial', 'none'."""
    n = _normalize_name(candidate)
    if not n or not target_norm:
        return "none"
    if n == target_norm:
        return "exact"
    if target_norm in n:
        return "partial"
    return "none"


# Программы, которые НЕЛЬЗЯ удалять через полное удаление —
# они часть Windows, и удаление их ключей ломает систему.
SYSTEM_PROGRAMS = [
    "microsoft edge",
    "microsoft edge webview",
    "microsoft edge update",
    "windows defender",
    "microsoft windows",
    "windows security",
    "microsoft visual c++",
    "microsoft .net",
    "microsoft store",
    "windows terminal",
