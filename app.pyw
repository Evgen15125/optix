        if not points:
            ctk.CTkLabel(pts_card,
                         text="Точек не найдено. Возможно, защита "
                              "системы отключена.",
                         font=("Inter", 12),
                         text_color="#90A4AE").pack(
                fill="x", padx=14, pady=(0, 10))
        else:
            for p in points:
                row = ctk.CTkFrame(pts_card, fg_color="#0D1B33",
                                    corner_radius=8)
                row.pack(fill="x", padx=14, pady=2)
                ctk.CTkLabel(row, text=f"#{p['seq']}",
                             font=("Consolas", 12, "bold"),
                             text_color="#4FC3F7", width=60,
                             anchor="w").pack(side="left",
                                              padx=(10, 4), pady=6)
                ctk.CTkLabel(row, text=p["desc"][:60],
                             font=("Arial", 12),
                             text_color="#ffffff", anchor="w",
                             width=320).pack(side="left", padx=4,
                                              pady=6)
                ctk.CTkLabel(row, text=p["type"],
                             font=("Inter", 11),
                             text_color="#90CAF9", anchor="w",
                             width=180).pack(side="left", padx=4,
                                              pady=6)
                ctk.CTkLabel(row, text=p["created"],
                             font=("Consolas", 12),
                             text_color="#B0BEC5", anchor="e").pack(
                    side="right", padx=10, pady=6)

                # Кнопка удаления этой точки
                def mk_del_one(seq=p["seq"], created=p["created"],
                                desc=p["desc"]):
                    def do():
                        ok = _rp_delete_one_point(seq, created, desc)
                        if ok:
                            try:
                                show_toast(
                                    "Optix — точка удалена",
                                    f"Точка #{seq} удалена")
                            except Exception:
                                pass
                            refresh()
                    return do

                ctk.CTkButton(row, text="🗑", width=36, height=26,
                              font=("Arial", 10, "bold"),
                              fg_color="#B71C1C",
                              hover_color="#E53935",
                              corner_radius=13,
                              command=mk_del_one()
                              ).pack(side="right", padx=(4, 6),
                                      pady=4)

        status_lbl.configure(
            text=f"✅ Точек: {len(points)}   •   "
                 f"{datetime.now().strftime('%H:%M:%S')}",
            text_color="#7CFC7C")

    def refresh():
        status_lbl.configure(text="⏳ Загрузка...",
                              text_color="#FFD54F")

        def worker():
            pts = _rp_get_points_detailed()
            storage = _rp_get_shadow_storage()
            app.after(0, lambda: render(pts, storage))
        threading.Thread(target=worker, daemon=True).start()

    def create_point():
        name = f"Optix_{datetime.now().strftime('%Y-%m-%d_%H-%M')}"
        try:
            ps = (f"Checkpoint-Computer -Description '{name}' "
                  f"-RestorePointType 'MODIFY_SETTINGS'")
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=180,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            if r.returncode == 0:
                messagebox.showinfo("Готово", f"Точка создана: {name}")
                refresh()
            else:
                messagebox.showerror("Ошибка",
                    (r.stderr or r.stdout)[:500])
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    # ─── Кнопки действий ───
    act1 = ctk.CTkFrame(win, fg_color="transparent")
    act1.pack(pady=(0, 6), padx=20, fill="x")
    ctk.CTkButton(act1, text="➕ Создать точку",
