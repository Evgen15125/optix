def show_output_dialog(title, text, summary=None):
    win = ctk.CTkToplevel(app)
    win.title(title)
    win.geometry("900x680")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)
    
    head = ctk.CTkLabel(win, text=title, font=("Inter", 20, "bold"),
                        text_color="#ffffff", fg_color="#1565C0",
                        corner_radius=14, height=44, border_width=1, border_color="#4FC3F7")
    head.pack(pady=(16, 10), padx=20, ipadx=20)
    
    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=12, border_width=1, border_color="#2A3B5C")
    wrap.pack(fill="both", expand=True, padx=20, pady=(0, 10))
    
    box = ctk.CTkTextbox(wrap, font=("Consolas", 11), fg_color="#0D1B33",
                          text_color="#e0e8f5", corner_radius=8, wrap="word")
    box.pack(fill="both", expand=True, padx=8, pady=8)
    box.insert("1.0", text)
    box.configure(state="disabled")
    
    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 16), padx=20, fill="x")

    def cp():
        app.clipboard_clear()
        app.clipboard_append(text)
        messagebox.showinfo("Готово", "Текст скопирован в буфер обмена.")

    def save_txt():
        default = f"Optix_Output_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
        path = filedialog.asksaveasfilename(
            title="Сохранить результат",
            defaultextension=".txt", initialfile=default,
            filetypes=[("Текст", "*.txt"), ("Все файлы", "*.*")])
        if not path: return
        try:
            with open(path, "w", encoding="utf-8-sig") as f: f.write(text)
            messagebox.showinfo("Готово", f"Сохранено:\n{path}")
            try: os.startfile(os.path.dirname(path))
            except Exception: pass
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    ctk.CTkButton(br, text="📋 Копировать", height=40, font=("Inter", 13, "bold"),
                  fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=20, command=cp
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
                  
    ctk.CTkButton(br, text="💾 Сохранить в TXT", height=40, font=("Inter", 13, "bold"),
                  fg_color="#2E7D32", hover_color="#43A047", corner_radius=20, command=save_txt
                  ).pack(side="left", padx=6, fill="x", expand=True)
                  
    ctk.CTkButton(br, text="Закрыть", height=40, font=("Inter", 13, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=20, command=win.destroy
                  ).pack(side="left", padx=(6, 0), fill="x", expand=True)


def _show_busy_dialog(title, message="Выполняется..."):
    dlg = ctk.CTkToplevel(app)
    dlg.title(title)
    dlg.geometry("460x200")
    dlg.configure(fg_color="#0A1A30")
    _center_window(dlg)
    
    frame = ctk.CTkFrame(dlg, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#4FC3F7")
    frame.pack(fill="both", expand=True, padx=10, pady=10)
    
    ctk.CTkLabel(frame, text=title, font=("Inter", 16, "bold"),
                 text_color="#ffffff").pack(pady=(24, 10))
                 
    ctk.CTkLabel(frame, text=message, font=("Inter", 12),
                       text_color="#B0BEC5").pack(pady=(0, 15))
    
    pb = ctk.CTkProgressBar(frame, width=350, height=12, progress_color="#4FC3F7", mode="indeterminate", corner_radius=6)
    pb.pack(pady=(0, 20))
    pb.start()
    
    def close_dlg():
        try:
            pb.stop()
            dlg.destroy()
        except Exception:
            pass
            
    return close_dlg


def diag_run(cmd, title, timeout=600, confirm_text=None):
    if confirm_text and not messagebox.askyesno(title, confirm_text):
        return
    
    try:
        diag_ui["status"].configure(text=f"⏳ {title}...", text_color="#FFD54F")
    except Exception:
        pass

    close_busy = _show_busy_dialog(title, "Выполняется. Это может занять несколько минут...")

    def worker():
        ok = False
        out = "Ошибка выполнения"
        try:
            ok, out = run_command_with_output(cmd, timeout=timeout)
        except Exception as e:
            out = str(e)
            log_error(f"diag_run({title})", e)

        def finish():
            close_busy()
            try:
                diag_ui["status"].configure(
                    text=f"{'✅' if ok else '⚠️'} {title} — Готово",
                    text_color="#7CFC7C" if ok else "#FF8A8A")
            except Exception:
                pass
            show_output_dialog(title, out)
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()



