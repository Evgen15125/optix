def _full_exit():
    try:
        # Сохраняем размер окна перед выходом
        w = app.winfo_width()
        h = app.winfo_height()
        if w > 100 and h > 100:
            _STATE["win_w"] = w
            _STATE["win_h"] = h
            _save_settings()
    except Exception:
        pass
    try:
        _monitor_state["active"] = False
    except Exception:
        pass
    try:
        _kill_ohm()
    except Exception:
        pass
    try:
        stop_tray()
    except Exception:
        pass
    try:
        app.quit()
        app.destroy()
    except Exception:
        try:
            os._exit(0)
        except Exception:
            pass


def _show_first_run_disclaimer():
    """
    Показывает дисклеймер при первом запуске.
    Отказ = программа закрывается.
    """
    flag_path = os.path.join(BASE_DIR, "disclaimer_accepted.json")
    if os.path.exists(flag_path):
        return True
    try:
        result = messagebox.askyesno(
            "Optix — первое использование",
            "⚠️ ВАЖНО ПРОЧИТАТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ\n\n"
            "Optix — инструмент для опытных пользователей. "
            "Некоторые функции изменяют системные настройки "
            "(реестр, службы, планировщик задач, автозапуск).\n\n"
            "• Программа предоставляется «как есть».\n"
            "• Автор НЕ несёт ответственности за любые повреждения "
            "системы, потерю данных или снижение производительности.\n"
            "• ПЕРЕД использованием функций оптимизации, изменения "
            "служб и автозапуска создайте точку восстановления "
            "системы (раздел «Очистка» → «Точки восстановления»).\n"
            "• Используйте на свой страх и риск.\n\n"
            "Согласны продолжить?")
        if not result:
            try:
                app.quit()
                app.destroy()
            except Exception:
                pass
            sys.exit(0)
        try:
            with open(flag_path, "w", encoding="utf-8") as f:
                json.dump({
                    "accepted": datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"),
                    "version": APP_VERSION,
                }, f, ensure_ascii=False, indent=2)
        except Exception:
            pass
        return True
    except Exception as e:
        log_error("_show_first_run_disclaimer", e)
        return True


def _on_window_close():
    try:
        # Безопасно пытаемся запомнить размер (без опасного winfo_state)
        try:
            w = app.winfo_width()
            h = app.winfo_height()
            if w > 100 and h > 100:
                _STATE["win_w"] = w
                _STATE["win_h"] = h
                _save_settings()
        except Exception:
            pass
            
        # Смотрим на настройку
        if _STATE.get("minimize_to_tray", True):
            # Сворачиваем в трей
            app.withdraw()
            if not _STATE.get("tray_hint_shown", False):
                try:
                    show_toast("Optix — работает в фоне", "Программа свёрнута в трей. Кликните по иконке, чтобы открыть.")
                except Exception:
                    pass
                _STATE["tray_hint_shown"] = True
                _save_settings()
        else:
            # Полный выход
            _full_exit()
            
    except Exception as e:
        # Если что-то пошло не так, принудительно выходим, чтобы не остаться с висящим окном
        log_error("_on_window_close", e)
        try:
            _full_exit()
        except Exception:
            pass


