def diag_bsod_analyzer():
    diag_ui["status"].configure(text="⏳ Анализ BSOD...", text_color="#FFD54F")
    close_busy = _show_busy_dialog("Анализ BSOD", "Поиск дампов и событий в журнале...")

    def worker():
        import re
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$ErrorActionPreference='SilentlyContinue';"
            "Get-WinEvent -FilterHashtable @{LogName='System';"
            "ProviderName='Microsoft-Windows-WER-SystemErrorReporting';Id=1001} "
            "-MaxEvents 50 -ErrorAction SilentlyContinue | "
            "Select-Object @{n='TimeCreated';e={$_.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss')}},"
            "Message | ConvertTo-Json -Compress"
        )
        events = []
        try:
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=60,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            out = (r.stdout or "").strip()
            if out.startswith("\ufeff"):
                out = out[1:]
            if out and out != "null":
                events = json.loads(out)
                if isinstance(events, dict):
                    events = [events]
                if events == [None]:
                    events = []
        except Exception as e:
            log_error("diag_bsod_events", e)

        dumps = []
        for ddir in [r"C:\Windows\Minidump", r"C:\Windows"]:
            if not os.path.isdir(ddir):
                continue
            try:
                for f in os.listdir(ddir):
                    if f.lower().endswith(".dmp"):
                        fp = os.path.join(ddir, f)
                        try:
                            sz = os.path.getsize(fp)
                            mt = os.path.getmtime(fp)
                            dumps.append((fp, sz, mt))
                        except Exception:
                            continue
            except Exception:
                pass
        dumps.sort(key=lambda x: -x[2])

        def finish():
            close_busy()
            lines = ["=" * 70,
                     "  АНАЛИЗ BSOD (СИНИХ ЭКРАНОВ)",
                     "=" * 70, ""]
            if not events and not dumps:
                lines.append("✅ BSOD не обнаружено.")
                lines.append("")
                lines.append("В журнале нет событий BugCheck, "
                             "дампы отсутствуют — система работала стабильно.")
                diag_ui["status"].configure(text="✅ BSOD не найдено", text_color="#7CFC7C")
                show_output_dialog("Анализ BSOD", "\n".join(lines))
                return

            parsed = []
            for ev in events:
                if not ev:
                    continue
                t = str(ev.get("TimeCreated", ""))
                msg = str(ev.get("Message", ""))
                codes = re.findall(r"0x([0-9a-fA-F]{8})", msg)
                bugcheck_code = None
                for c in codes:
                    try:
                        val = int(c, 16)
                        if val <= 0xFFFFFFFF and val >= 0x100:
                            bugcheck_code = val
                            break
                    except Exception:
                        continue
                dump_paths = re.findall(r"[A-Z]:\\[^\s]+\.dmp", msg)
                short_msg = re.sub(r"\s+", " ", msg).strip()[:250]
                parsed.append({"time": t, "code": bugcheck_code, "paths": dump_paths, "msg": short_msg})

            if parsed:
                lines.append(f"🔴 НАЙДЕНО BSOD: {len(parsed)}")
                lines.append("")
                by_code = {}
                for p in parsed:
                    by_code.setdefault(p["code"], []).append(p)
                lines.append("─" * 70)
                lines.append("  СВОДКА ПО КОДАМ ОШИБОК")
                lines.append("─" * 70)
                for code, items in sorted(by_code.items(), key=lambda x: -len(x[1])):
                    if code is None:
                        lines.append(f"  • Неизвестный код — {len(items)} раз(а)")
                        continue
                    info = BSOD_CODES.get(code)
                    code_hex = f"0x{code:08X}"
                    if info:
                        name, descr = info
                        lines.append(f"  • {code_hex}  {name}  — {len(items)} раз(а)")
                        lines.append(f"      {descr}")
                    else:
                        lines.append(f"  • {code_hex}  — {len(items)} раз(а)")
                lines.append("")
                lines.append("─" * 70)
                lines.append("  ПОСЛЕДНИЕ 10 СОБЫТИЙ")
                lines.append("─" * 70)
                for p in parsed[:10]:
                    t_short = p["time"][:19] if p["time"] else "?"
                    code = p["code"]
                    code_hex = f"0x{code:08X}" if code else "?"
                    lines.append(f"\n  📅 {t_short}")
                    lines.append(f"     Код: {code_hex}")
                    if p["paths"]:
                        lines.append(f"     Дамп: {p['paths'][0]}")

            if dumps:
                lines.append("")
                lines.append("─" * 70)
                lines.append(f"  ФАЙЛЫ ДАМПОВ ({len(dumps)})")
                lines.append("─" * 70)
                for fp, sz, mt in dumps[:15]:
                    from datetime import datetime as _dt
                    tstr = _dt.fromtimestamp(mt).strftime("%Y-%m-%d %H:%M")
                    lines.append(f"  💾 {fp}")
                    lines.append(f"     {human_size(sz)} • {tstr}")

            lines.append("")
            lines.append("─" * 70)
            lines.append("  ЧТО ДЕЛАТЬ")
            lines.append("─" * 70)
            lines.append("  1. Проверьте драйверы: особенно видеокарты, сетевой, чипсета.")
            lines.append("  2. Проверьте RAM: mdsched.exe (перезагрузка).")
            lines.append("  3. Проверьте перегрев: раздел «Мониторинг».")
            lines.append("  4. Для глубокого анализа — WinDbg: !analyze -v.")

            diag_ui["status"].configure(
                text=f"⚠️ Найдено BSOD: {len(parsed)}",
                text_color="#FFD54F" if parsed else "#7CFC7C")
            show_output_dialog("Анализ BSOD (синие экраны)", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def diag_event_log_analyzer():
    diag_ui["status"].configure(text="⏳ Анализ журнала...", text_color="#FFD54F")
    close_busy = _show_busy_dialog("Журнал событий", "Чтение системного журнала за 7 дней...")

    def worker():
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$ErrorActionPreference='SilentlyContinue';"
            "$start = (Get-Date).AddDays(-7);"
            "$logs = @('System','Application');"
            "$out = foreach ($log in $logs) {"
            "  Get-WinEvent -FilterHashtable @{LogName=$log;Level=1,2;StartTime=$start} -ErrorAction SilentlyContinue | "
            "  Select-Object @{n='TimeCreated';e={$_.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss')}},LogName,ProviderName,Id,Message"
            "};"
            "$out | ConvertTo-Json -Compress -Depth 3"
        )
        events = []
        try:
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=120,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            out = (r.stdout or "").strip()
            if out.startswith("\ufeff"):
                out = out[1:]
            if out and out != "null":
                events = json.loads(out)
                if isinstance(events, dict):
                    events = [events]
                if events == [None]:
                    events = []
        except Exception as e:
            log_error("diag_event_log_analyzer", e)

        EVENT_KNOWN = {
            ("Microsoft-Windows-Kernel-Power", 41): ("⚠️ Неожиданная перезагрузка", "Система перезагрузилась без корректного завершения."),
            ("Microsoft-Windows-WER-SystemErrorReporting", 1001): ("🔴 BSOD (BugCheck)", "Синий экран смерти. См. раздел «Анализ BSOD»."),
            ("EventLog", 6008): ("⚠️ Некорректное завершение", "Предыдущая сессия Windows завершилась неправильно."),
            ("disk", 7): ("🔴 Плохой блок на диске", "Диск содержит повреждённые сектора! Запустите chkdsk."),
            ("disk", 51): ("🔴 Ошибка ввода-вывода диска", "Проблема при чтении/записи. Возможен сбой диска."),
            ("Ntfs", 55): ("🔴 Повреждение файловой системы", "NTFS нашла ошибку. Запустите chkdsk!"),
            ("Microsoft-Windows-WHEA-Logger", 17): ("🔴 Аппаратная ошибка", "Проблема с оборудованием (CPU/RAM).")
        }

        def finish():
            close_busy()
            lines = ["=" * 70, "  УМНЫЙ АНАЛИЗ ЖУРНАЛА СОБЫТИЙ (7 дней)", "=" * 70, ""]
            if not events:
                lines.append("✅ Критических событий не найдено.")
                diag_ui["status"].configure(text="✅ Чисто — событий нет", text_color="#7CFC7C")
                show_output_dialog("Анализ журнала событий", "\n".join(lines))
                return

            groups = {}
            for ev in events:
                if not ev: continue
                prov = str(ev.get("ProviderName", "") or "?")
                try: eid = int(ev.get("Id", 0))
                except: eid = 0
                key = (prov, eid)
                if key not in groups:
                    groups[key] = {"count": 0, "last": "", "sample": ""}
                g = groups[key]
                g["count"] += 1
                t = str(ev.get("TimeCreated", ""))[:19]
                if t > g["last"]: g["last"] = t
                if not g["sample"]:
                    msg = str(ev.get("Message", "") or "")
                    g["sample"] = " ".join(msg.split())[:200]

            known = []
            unknown = []
            for (prov, eid), g in groups.items():
                info = EVENT_KNOWN.get((prov, eid))
                if info: known.append((prov, eid, g, info))
                else: unknown.append((prov, eid, g))

            known.sort(key=lambda x: -x[2]["count"])
            unknown.sort(key=lambda x: -x[2]["count"])

            critical_count = sum(1 for (p, e, g, (icon, _)) in known if icon.startswith("🔴"))
            warn_count = sum(1 for (p, e, g, (icon, _)) in known if icon.startswith("⚠️"))

            lines.append(f"📊 Всего критических событий: {len(events)}")
            lines.append(f"   🔴 Опасных типов: {critical_count}")
            lines.append(f"   ⚠️ Предупреждающих типов: {warn_count}")
            lines.append("")

            if known:
                lines.append("─" * 70)
                lines.append("  ИЗВЕСТНЫЕ СОБЫТИЯ (с расшифровкой)")
                lines.append("─" * 70)
                for prov, eid, g, (icon, descr) in known[:15]:
                    lines.append("")
                    lines.append(f"  {icon}  {prov}  (ID {eid})  — {g['count']} раз(а)")
                    lines.append(f"     Последнее: {g['last']}")
                    lines.append(f"     Что это: {descr}")
                    if g["sample"]: lines.append(f"     Пример: {g['sample'][:150]}")

            if unknown:
                lines.append("")
                lines.append("─" * 70)
                lines.append("  ДРУГИЕ СОБЫТИЯ (топ-10 по частоте)")
                lines.append("─" * 70)
                for prov, eid, g in unknown[:10]:
                    lines.append(f"  • {prov}  (ID {eid})  — {g['count']} раз(а)  [{g['last']}]")

            lines.append("")
            lines.append("─" * 70)
            lines.append("  РЕКОМЕНДАЦИИ")
            lines.append("─" * 70)
            has_disk_err = any((p, e) in [("disk", 7), ("disk", 51), ("Ntfs", 55)] for (p, e, g, _) in known)
            has_hw_err = any(p == "Microsoft-Windows-WHEA-Logger" for (p, e, g, _) in known)
            has_bsod = any((p, e) == ("Microsoft-Windows-WER-SystemErrorReporting", 1001) for (p, e, g, _) in known)
            has_power = any((p, e) == ("Microsoft-Windows-Kernel-Power", 41) for (p, e, g, _) in known)
            recs = []
            if has_disk_err: recs.append("• ⚠️ Есть ошибки диска — срочно проверьте здоровье SSD/HDD.")
            if has_hw_err: recs.append("• ⚠️ Аппаратные ошибки — проверьте RAM (mdsched) и подключения карт расширения.")
            if has_bsod: recs.append("• 🔴 Были BSOD — откройте «Анализ BSOD».")
            if has_power: recs.append("• ⚠️ Были внезапные перезагрузки — проверьте блок питания и кабель.")
            if not recs: recs.append("• ✅ Критических проблем не обнаружено.")
            lines.extend(recs)

            status_icon = "🔴" if critical_count else ("⚠️" if warn_count else "✅")
            diag_ui["status"].configure(
                text=f"{status_icon} Событий: {len(events)}, опасных: {critical_count}",
                text_color="#FF8A8A" if critical_count else "#FFD54F" if warn_count else "#7CFC7C")
            show_output_dialog("Умный анализ журнала событий", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def diag_latency_monitor():
    diag_ui["status"].configure(text="⏳ Сбор данных DPC/ISR (30 сек)...", text_color="#FFD54F")
    close_busy = _show_busy_dialog("Задержки DPC/ISR", "Сбор данных производительности (30 секунд)...")

    def worker():
        def collect(counter_path):
            ps = (
                "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
                f"$s = (Get-Counter '{counter_path}' "
                "-SampleInterval 1 -MaxSamples 30 "
                "-ErrorAction SilentlyContinue).CounterSamples | "
                "Select-Object -ExpandProperty CookedValue; "
                "$s | ConvertTo-Json -Compress"
            )
            try:
                r = subprocess.run(
                    ["powershell", "-NoProfile", "-Command", ps],
                    capture_output=True, text=True, timeout=90,
                    creationflags=CREATE_NO_WINDOW,
                    encoding="utf-8", errors="replace")
                out = (r.stdout or "").strip()
                if out.startswith("\ufeff"):
                    out = out[1:]
                if not out or out == "null":
                    return []
                data = json.loads(out)
                if isinstance(data, (int, float)):
                    data = [data]
                return [float(x) for x in data if x is not None]
            except Exception as e:
                log_error(f"latency_collect({counter_path})", e)
                return []

        dpc = collect(r"\Processor Information(_Total)\% DPC Time")
        isr = collect(r"\Processor Information(_Total)\% Interrupt Time")
        idle = collect(r"\Processor Information(_Total)\% Idle Time")
        user = collect(r"\Processor Information(_Total)\% User Time")

        def stats(arr):
            if not arr:
                return {"avg": 0.0, "max": 0.0, "n": 0}
            return {"avg": sum(arr) / len(arr), "max": max(arr), "n": len(arr)}

        def finish():
            close_busy()
            lines = ["=" * 70,
                     "  МОНИТОРИНГ ЗАДЕРЖЕК (DPC / ISR)",
                     "=" * 70, "",
                     "  Показатели сняты за 30 секунд.",
                     "  Если DPC или ISR превышают порог — драйвер создаёт",
                     "  микро-фризы (в играх, аудио, USB).", ""]
            if not dpc and not isr:
                lines.append("⚠️ Не удалось снять счётчики.")
                diag_ui["status"].configure(text="⚠️ Счётчики недоступны", text_color="#FF8A8A")
                show_output_dialog("Мониторинг задержек (DPC/ISR)", "\n".join(lines))
                return

            ds = stats(dpc)
            iss = stats(isr)
            ils = stats(idle)
            us = stats(user)

            lines.append("─" * 70)
            lines.append("  СРЕДНИЕ И МАКСИМАЛЬНЫЕ ЗНАЧЕНИЯ")
            lines.append("─" * 70)
            lines.append(f"  DPC          сред: {ds['avg']:>5.2f} %    макс: {ds['max']:>5.2f} %")
            lines.append(f"  ISR          сред: {iss['avg']:>5.2f} %    макс: {iss['max']:>5.2f} %")
            if ils["n"]:
                lines.append(f"  Idle         сред: {ils['avg']:>5.2f} %")
            if us["n"]:
                lines.append(f"  User         сред: {us['avg']:>5.2f} %")
            lines.append("")

            lines.append("─" * 70)
            lines.append("  ОЦЕНКА")
            lines.append("─" * 70)
            d_avg = ds["avg"]
            i_avg = iss["avg"]
            d_max = ds["max"]
            i_max = iss["max"]

            verdicts = []
            if d_avg < 1.0 and i_avg < 1.0 and d_max < 5.0 and i_max < 5.0:
                verdicts.append("✅ Всё ОТЛИЧНО — задержек нет.")
                color = "#7CFC7C"
            elif d_avg < 3.0 and i_avg < 3.0 and d_max < 15.0 and i_max < 10.0:
                verdicts.append("🟢 ХОРОШО — небольшие задержки, обычно не заметны.")
                color = "#7CFC7C"
            elif d_avg < 5.0 and i_avg < 5.0 and d_max < 30.0:
                verdicts.append("🟡 СРЕДНЕ — возможны редкие фризы.")
                color = "#FFD54F"
            else:
                verdicts.append("🔴 ПЛОХО — серьёзные задержки!")
                color = "#FF8A8A"

            if d_max > 50.0:
                verdicts.append(f"  ⚠️ Пиковый DPC {d_max:.1f}% — какой-то драйвер блокировал систему.")
            if i_max > 30.0:
                verdicts.append(f"  ⚠️ Пиковый ISR {i_max:.1f}% — проблема с обработкой прерываний.")
            lines.extend(verdicts)
            lines.append("")
            lines.append("─" * 70)
            lines.append("  РЕКОМЕНДАЦИИ")
            lines.append("─" * 70)
            lines.append("  1. Обновите драйверы: чипсет, видеокарта, USB, аудио, сеть.")
            lines.append("  2. Отключите временно сторонний антивирус.")
            lines.append("  3. Обновите BIOS.")
            lines.append("  4. Проверьте отключение энергосбережения USB/PCIe в схеме питания.")
            lines.append("")
            lines.append("  Для глубокой диагностики: LatencyMon или WPA.")

            diag_ui["status"].configure(
                text=f"{verdicts[0][:2]} DPC {d_avg:.2f}% / ISR {i_avg:.2f}%",
                text_color=color)
            show_output_dialog("Мониторинг задержек (DPC/ISR)", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


