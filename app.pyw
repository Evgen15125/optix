                             anchor="w").pack(fill="x", padx=(14, 10), pady=(0, 6))

            btns = ctk.CTkFrame(row, fg_color="transparent")
            btns.pack(fill="x", padx=10, pady=(0, 8))
            svc_name = t["task_full"]

            def make_dis(n=svc_name):
                def do():
                    try:
                        subprocess.run(
                            ["schtasks", "/Change", "/TN", n, "/DISABLE"],
                            capture_output=True, text=True, timeout=20,
                            creationflags=CREATE_NO_WINDOW)
                        messagebox.showinfo("Готово", "Задача отключена.")
                    except Exception as e:
                        messagebox.showerror("Ошибка", str(e))
                return do

            def make_en(n=svc_name):
                def do():
                    try:
                        subprocess.run(
                            ["schtasks", "/Change", "/TN", n, "/ENABLE"],
                            capture_output=True, text=True, timeout=20,
                            creationflags=CREATE_NO_WINDOW)
                        messagebox.showinfo("Готово", "Задача включена.")
                    except Exception as e:
                        messagebox.showerror("Ошибка", str(e))
                return do

            def make_run(n=svc_name):
                def do():
                    try:
                        subprocess.run(
                            ["schtasks", "/Run", "/TN", n],
                            capture_output=True, text=True, timeout=20,
                            creationflags=CREATE_NO_WINDOW)
                    except Exception:
                        pass
                return do

            if t["state"].lower() == "disabled":
                ctk.CTkButton(btns, text="🟢 Включить", width=100, height=26,
