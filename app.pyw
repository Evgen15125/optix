def _refresh_autostart_with_pulse(btn):
    """Обновляет список с пульсацией кнопки (занимает время)."""
    _start_button_pulse(btn, "#1976D2", "#42A5F5")
    try:
        autostart_ui["search"].set("")
    except Exception:
        pass
    try:
        autostart_ui["filter"].set("Все")
    except Exception:
        pass
    app.after(50, lambda: _do_refresh_autostart_with_pulse(btn))


def _do_refresh_autostart_with_pulse(btn):
    try:
        refresh_autostart_ui()
    finally:
        app.after(300, lambda: _stop_button_pulse(btn))


def _run_disable_high_impact(btn):
    """Запускает отключение высокого влияния в фоне с пульсацией."""
    if not messagebox.askyesno(
        "Отключить высокое влияние?",
        "Будут отключены все записи автозапуска с высоким влиянием (🔴).\n\n"
        "Это может занять 10-30 секунд.\n\n"
        "Продолжить?"):
        return
    
    _start_button_pulse(btn, "#C62828", "#FF8A8A")
    btn.configure(state="disabled")
    
    def worker():
        try:
            disable_all_high_impact(silent=True)
        finally:
            def finish():
                _stop_button_pulse(btn)
                btn.configure(state="normal")
            app.after(0, finish)
    
    threading.Thread(target=worker, daemon=True).start()


