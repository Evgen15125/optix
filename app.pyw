        app.after(0, lambda: (
            services_ui["status"].configure(
                text=f"Всего: {len(services_all)}   •   "
                     f"Работает: {sum(1 for s in services_all if str(s['status']).lower() == 'running')}   •   "
                     f"Остановлено: {sum(1 for s in services_all if str(s['status']).lower() == 'stopped')}   •   "
                     f"Можно отключить: {sum(1 for s in services_all if s.get('can_disable'))}",
                text_color="#4FC3F7"),
            services_ui.update({"shown_count": SERVICES_PAGE_SIZE}),
            refresh_services_ui()
        ))
    threading.Thread(target=worker, daemon=True).start()


