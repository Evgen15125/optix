            t["enabled"] = (CLI_TOGGLE_STATE == "enable")
            if t["enabled"]:
                _task_register(t)
            else:
                _task_unregister(t)
            save_optix_tasks(tasks)
            print(f"Задача «{t.get('name')}» — "
                  f"{'включена' if t['enabled'] else 'отключена'}")
            found = True
            break
    if not found:
        print(f"Задача не найдена: {CLI_TOGGLE_TASK}")
    sys.exit(0)

if CLI_RUN_TASK_NAME:
    tasks = load_optix_tasks()
    t = next((x for x in tasks
              if x.get("id") == CLI_RUN_TASK_NAME
              or x.get("name") == CLI_RUN_TASK_NAME), None)
    if not t:
        print(f"Задача не найдена: {CLI_RUN_TASK_NAME}")
        sys.exit(1)
    result = _task_execute_with_retry(t)
    print(result.get("log", ""))
    print(f"\nУспех: {result.get('success')}, "
          f"длительность: {result.get('duration', 0):.1f} сек")
    try:
        app.destroy()
    except Exception:
        pass
    sys.exit(0 if result.get("success") else 1)

