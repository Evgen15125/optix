    if not selected:
        messagebox.showinfo("Optix", "Не выбрано ни одной категории.")
        return
    has_warn = any(cat["group"] == "warn" for cat in selected)
    names = "\n• " + "\n• ".join([c["name"] for c in selected])
    text = f"Удалить содержимое следующих категорий?{names}\n\n"
    if DRY_RUN.get("enabled", False):
        text = "🧪 РЕЖИМ СИМУЛЯЦИИ (файлы НЕ будут удалены)\n\n" + text
    if has_warn:
        text += "⚠️ ВНИМАНИЕ: среди выбранных есть опасные категории!\n\n"
    if SECURE_DELETE["enabled"]:
        text += f"🔒 Включено безопасное удаление ({SECURE_DELETE['passes']} проход(а)).\n\n"
    elif SECURE_DELETE.get("use_backup"):
