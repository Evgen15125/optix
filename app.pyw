def load_scheduler_config():
    defaults = {
        "enabled": False, "frequency": "daily", "time": "03:00",
        "day_of_week": "MON", "day_of_month": 1,
        "clean_categories": ["Временные файлы Windows",
                              "Временные файлы пользователя"],
        "clean_recycle": False,
        "optimize_power": True,
        "last_run": None, "last_result": None,
    }
    try:
        with open(SCHEDULER_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        for k, v in defaults.items():
            data.setdefault(k, v)
        return data
    except Exception:
        return defaults


def save_scheduler_config(cfg):
    try:
        with open(SCHEDULER_PATH, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
        return True
    except Exception:
        return False


def create_scheduler_task(cfg):
    pyw = _get_pythonw_path()
    app_path = os.path.join(BASE_DIR, "app.pyw")
    if not os.path.exists(app_path):
        app_path = os.path.abspath(sys.argv[0])
    tr = f'"{pyw}" "{app_path}" --run-scheduled'
    args = ["schtasks", "/Create", "/TN", SCHEDULER_TASK_NAME,
            "/TR", tr, "/RL", "HIGHEST", "/F", "/ST", cfg.get("time", "03:00")]
    freq = cfg.get("frequency", "daily")
    if freq == "daily":
        args += ["/SC", "DAILY"]
    elif freq == "weekly":
        args += ["/SC", "WEEKLY", "/D", cfg.get("day_of_week", "MON")]
    elif freq == "monthly":
        args += ["/SC", "MONTHLY", "/D", str(int(cfg.get("day_of_month", 1)))]
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        return r.returncode == 0, ((r.stdout or "") + (r.stderr or "")).strip()
    except Exception as e:
        return False, str(e)


def delete_scheduler_task():
    try:
        r = subprocess.run(["schtasks", "/Delete", "/TN",
                            SCHEDULER_TASK_NAME, "/F"],
                           capture_output=True, text=True, timeout=20,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        return r.returncode == 0, ((r.stdout or "") + (r.stderr or "")).strip()
    except Exception as e:
        return False, str(e)


def query_scheduler_task_exists():
    try:
        r = subprocess.run(["schtasks", "/Query", "/TN", SCHEDULER_TASK_NAME],
                           capture_output=True, text=True, timeout=15,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        return r.returncode == 0
    except Exception:
        return False


def run_headless_scheduled():
    """Запускает все включённые задачи (headless режим)."""
    log_scheduler("=== Запуск планировщика (headless) ===")
    tasks = load_optix_tasks()
    if not tasks:
        log_scheduler("Задач нет.")
        return
    for t in tasks:
        if not t.get("enabled"):
            continue
        log_scheduler(f"▶ Задача: {t.get('name', '?')}")
        try:
            result = _task_execute_with_retry(t)
            log_scheduler(result.get("log", "?"))
            log_scheduler(f"Результат: success={result.get('success')}, "
                           f"duration={result.get('duration', 0):.1f}s")
        except Exception as e:
            log_scheduler(f"✗ Ошибка: {e}")

    # Старая логика (Optix_Scheduler) — оставляем для совместимости
    cfg = load_scheduler_config()
    if cfg.get("enabled") and cfg.get("clean_categories"):
        log_scheduler("Запуск legacy-задачи Optix_Scheduler...")
        cat_names = set(cfg.get("clean_categories", []))
        total_freed = 0
        for cat in CATEGORIES:
            if cat["name"] in cat_names:
                try:
                    f_, n_, _ = clean_category(cat)
                    total_freed += f_
                except Exception:
                    pass
        cfg["last_run"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        cfg["last_result"] = f"Освобождено: {human_size(total_freed)}"
        save_scheduler_config(cfg)


def _collect_scheduler_ui():
    cfg = load_scheduler_config()
    cfg["enabled"] = bool(scheduler_ui["enable_var"].get())
    freq_map = {"Ежедневно": "daily", "Еженедельно": "weekly",
                "Ежемесячно": "monthly"}
    cfg["frequency"] = freq_map.get(scheduler_ui["freq_menu"].get(), "daily")
    t = scheduler_ui["time_entry"].get().strip()
    try:
        hh, mm = t.split(":")
        t = f"{int(hh):02d}:{int(mm):02d}"
    except Exception:
        t = "03:00"
    cfg["time"] = t
    dow = scheduler_ui["dow_menu"].get()
    cfg["day_of_week"] = dow.split(" ")[0] if dow else "MON"
    try:
        cfg["day_of_month"] = int(scheduler_ui["dom_menu"].get())
    except Exception:
        cfg["day_of_month"] = 1
    cfg["clean_categories"] = [n for n, v in scheduler_ui["cat_vars"].items()
                                if v.get()]
    cfg["clean_recycle"] = bool(scheduler_ui["rb_var"].get())
    for k, _ in TWEAK_DEFS:
        cfg[k] = bool(scheduler_ui["tweak_vars"][k].get())
    return cfg


def save_scheduler_settings():
    cfg = _collect_scheduler_ui()
    if save_scheduler_config(cfg):
        scheduler_ui["status"].configure(text="✅ Сохранено",
                                          text_color="#7CFC7C")
    refresh_scheduler_status()


def apply_scheduler_settings():
    cfg = _collect_scheduler_ui()
    if not cfg["enabled"]:
        scheduler_ui["status"].configure(text="⚠️ Включите планировщик",
                                          text_color="#FFD54F")
        return
    save_scheduler_config(cfg)
    ok, msg = create_scheduler_task(cfg)
    if ok:
        scheduler_ui["status"].configure(text="✅ Задача создана",
                                          text_color="#7CFC7C")
        messagebox.showinfo("Планировщик", "Задача создана!")
    else:
        messagebox.showerror("Ошибка", msg[:500])
    refresh_scheduler_status()


def remove_scheduler_settings():
    if not messagebox.askyesno("Удалить?", "Удалить из Планировщика Windows?"):
        return
    ok, _ = delete_scheduler_task()
    if ok:
        scheduler_ui["status"].configure(text="✅ Удалена", text_color="#7CFC7C")
    refresh_scheduler_status()


def refresh_scheduler_status():
    if "status" not in scheduler_ui:
