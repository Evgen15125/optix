def diag_network_ping(host, count=10, label=None):
    """
    Пингует хост N раз. Возвращает dict:
    {host, label, sent, recv, lost, loss_pct, times, min, max, avg, jitter}
    """
    import re
    stats = {
        "host": host,
        "label": label or host,
        "sent": count,
        "recv": 0,
        "lost": count,
        "loss_pct": 100.0,
        "times": [],
    }
    try:
        r = subprocess.run(
            ["ping", "-n", str(count), "-w", "2000", host],
            capture_output=True, text=True,
            timeout=count * 3 + 10,
            creationflags=CREATE_NO_WINDOW,
            encoding="cp866", errors="replace"
        )
        out = r.stdout or ""
        # Парсим ТОЛЬКО строки ответа, чтобы не поймать статистику.
        # Русский: "Ответ от 192.168.0.1: число байт=32 время<1мс TTL=64"
        #         "Ответ от 8.8.8.8: число байт=32 время=56мс TTL=118"
        # Английский: "Reply from ... time=56ms TTL=118"
        times = []
        for line in out.splitlines():
            low = line.lower()
            is_reply = ("ответ от" in low or "reply from" in low)
            if not is_reply:
                continue
            # Ищем "<Nмс" или "=Nмс" (ru) / "<Nms" или "=Nms" (en)
            m = re.search(r"врем[яи][^<=\d]*[<=]\s*(\d+)\s*мс",
                          line, re.IGNORECASE)
            if not m:
                m = re.search(r"time[^<=\d]*[<=]\s*(\d+)\s*ms",
                              line, re.IGNORECASE)
            if m:
                try:
                    times.append(int(m.group(1)))
                except Exception:
                    continue
        # Защита от переполнения (на всякий случай)
        if len(times) > count:
            times = times[:count]
        stats["times"] = times
        stats["recv"] = len(times)
        stats["lost"] = max(0, count - len(times))
        stats["loss_pct"] = round((stats["lost"] / count) * 100, 1) \
                            if count > 0 else 0.0
        if times:
            stats["min"] = min(times)
            stats["max"] = max(times)
            stats["avg"] = round(sum(times) / len(times), 1)
            if len(times) > 1:
                diffs = [abs(times[i + 1] - times[i])
                         for i in range(len(times) - 1)]
                stats["jitter"] = round(sum(diffs) / len(diffs), 1)
            else:
                stats["jitter"] = 0.0
        else:
            stats["min"] = 0
            stats["max"] = 0
            stats["avg"] = 0
            stats["jitter"] = 0
    except subprocess.TimeoutExpired:
        stats["error"] = f"Таймаут ({count * 3 + 10} сек)"
    except Exception as e:
        stats["error"] = str(e)
        log_error(f"diag_network_ping({host})", e)
    return stats


def diag_network_traceroute(host="8.8.8.8", max_hops=15):
    """tracert -d -h N -w 1000 host. Возвращает список строк с хопами."""
    hops = []
    try:
        r = subprocess.run(
            ["tracert", "-d", "-h", str(max_hops), "-w", "1000", host],
            capture_output=True, text=True, timeout=120,
            creationflags=CREATE_NO_WINDOW,
            encoding="cp866", errors="replace"
        )
        out = r.stdout or ""
        import re
        # Строки вида: "  1    <1 ms    <1 ms    <1 ms  192.168.1.1"
        for line in out.splitlines():
            s = line.strip()
            if not s:
                continue
            if re.match(r"^\d+\s+", s):
                hops.append(s)
    except subprocess.TimeoutExpired:
        hops.append("(таймаут tracert)")
    except Exception as e:
        log_error("diag_network_traceroute", e)
        hops.append(f"(ошибка: {e})")
    return hops


def _get_default_gateway():
    """Возвращает IP основного шлюза или None."""
    import re
    try:
        r = subprocess.run(["ipconfig"], capture_output=True, text=True,
                           timeout=10, creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = r.stdout or ""
        # Русская Windows: "Основной шлюз . . . . . . . . . : 192.168.1.1"
        for pat in (r"Основной шлюз[^\:]*:\s*([\d\.]+)",
                     r"Default Gateway[^\:]*:\s*([\d\.]+)"):
            m = re.search(pat, out)
            if m:
                ip = m.group(1).strip()
                if ip and ip != "0.0.0.0":
                    return ip
    except Exception:
        pass
    return None


def diag_network_extended():
    diag_ui["status"].configure(text="⏳ Сетевые тесты (30–60 сек)...", text_color="#FFD54F")
    close_busy = _show_busy_dialog("Сетевые тесты", "Пинг узлов и трассировка...")

    def worker():
        r_google = diag_network_ping("8.8.8.8", count=10, label="Google DNS (8.8.8.8)")
        r_ya = diag_network_ping("ya.ru", count=10, label="Яндекс (ya.ru)")
        gw = _get_default_gateway()
        r_gw = None
        if gw:
            r_gw = diag_network_ping(gw, count=10, label=f"Локальный шлюз ({gw})")
        hops = diag_network_traceroute("8.8.8.8", max_hops=15)

        def finish():
            close_busy()
            lines = ["=" * 70, "  РАСШИРЕННАЯ ДИАГНОСТИКА СЕТИ", "=" * 70, "",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", ""]

            def fmt_ping(res, prefix_emoji=""):
                if res is None: return []
                out_lines = []
                name = res.get("label", res.get("host", "?"))
                if "error" in res:
                    out_lines.append(f"  {prefix_emoji} {name}")
                    out_lines.append(f"      ❌ Ошибка: {res['error']}")
                    out_lines.append("")
                    return out_lines
                loss = res.get("loss_pct", 0)
                avg = res.get("avg", 0)
                jitter = res.get("jitter", 0)
                loss_icon = "✅" if loss == 0 else ("🟡" if loss <= 5 else "🔴")
                ping_icon = "—" if avg == 0 else ("✅" if avg < 50 else ("🟡" if avg < 150 else "🔴"))
                jitter_icon = "—" if jitter == 0 else ("✅" if jitter < 5 else ("🟡" if jitter < 20 else "🔴"))
                
                out_lines.append(f"  {prefix_emoji} {name}")
                out_lines.append(f"      Пакетов: {res['sent']}, получено: {res['recv']}")
                out_lines.append(f"      {loss_icon} Потери: {loss}%")
                if res.get("recv", 0) > 0:
                    out_lines.append(f"      {ping_icon} Ping (мин/сред/макс): {res['min']} / {res['avg']} / {res['max']} мс")
                    out_lines.append(f"      {jitter_icon} Джиттер: {jitter} мс")
                out_lines.append("")
                return out_lines

            if r_gw is not None: lines.extend(fmt_ping(r_gw, "🏠"))
            lines.extend(fmt_ping(r_google, "🌐"))
            lines.extend(fmt_ping(r_ya, "🌐"))

            lines.append("─" * 70)
            lines.append("  ОБЩАЯ ОЦЕНКА")
            lines.append("─" * 70)
            all_loss = [r.get("loss_pct", 0) for r in (r_gw, r_google, r_ya) if r and "error" not in r]
            all_jitter = [r.get("jitter", 0) for r in (r_gw, r_google, r_ya) if r and "error" not in r and "jitter" in r]
            max_loss = max(all_loss) if all_loss else 0
            max_jitter = max(all_jitter) if all_jitter else 0
            verdict = []
            if max_loss == 0 and max_jitter < 5: verdict.append("✅ Сеть работает ИДЕАЛЬНО — потерь и джиттера нет.")
            elif max_loss <= 5 and max_jitter < 20: verdict.append("🟢 Сеть работает ХОРОШО — небольшие отклонения.")
            elif max_loss <= 20: verdict.append("🟡 Сеть работает НЕСТАБИЛЬНО — возможны проблемы с Wi-Fi.")
            else: verdict.append("🔴 Сеть работает ПЛОХО — большие потери пакетов.")
            lines.extend(verdict)
            lines.append("")

            lines.append("─" * 70)
            lines.append("  ТРАССИРОВКА ДО 8.8.8.8 (макс. 15 хопов)")
            lines.append("─" * 70)
            if hops:
                for h in hops: lines.append(f"  {h}")
            else: lines.append("  (нет данных)")
            lines.append("")
            lines.append("─" * 70)
            lines.append("  ЧТО ДЕЛАТЬ ПРИ ПРОБЛЕМАХ")
            lines.append("─" * 70)
            lines.append("  • Потери на шлюзе → проблема с Wi-Fi/Ethernet-кабелем.")
            lines.append("  • Потери только на 8.8.8.8/ya.ru → проблема у провайдера.")

            if max_loss == 0 and max_jitter < 5:
                status_text = "✅ Сеть в порядке"
                status_color = "#7CFC7C"
            elif max_loss <= 5:
                status_text = f"🟡 Потери: {max_loss}%"
                status_color = "#FFD54F"
            else:
                status_text = f"🔴 Потери: {max_loss}%"
                status_color = "#FF8A8A"
            diag_ui["status"].configure(text=status_text, text_color=status_color)
            show_output_dialog("Расширенная диагностика сети", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


# ================== ВОССТАНОВЛЕНИЕ ЗАГРУЗКИ ==================
def _boot_info_collect():
    """Собирает диагностику загрузки: прошивка, разделы, ESP, BCD, WinRE."""
    info = {
        "firmware": "?",
        "disk_style": "?",
        "esp_present": False,
        "esp_info": "",
        "bcd_ok": False,
        "bcd_entries": [],
        "winre_enabled": False,
        "winre_info": "",
        "errors": [],
    }

    # ─── 1. Тип прошивки ───
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$fw = (Get-ComputerInfo -Property BiosFirmwareType "
            "-ErrorAction SilentlyContinue).BiosFirmwareType; "
            "if (-not $fw) { "
            "  $fw = if (Test-Path "
            "'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\State') "
            "{ 'Uefi' } else { 'Bios' } "
            "}; "
            "$fw"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=20,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip().lower()
        if "uefi" in out:
            info["firmware"] = "UEFI"
        elif "bios" in out:
            info["firmware"] = "BIOS (Legacy)"
        else:
            info["firmware"] = out or "?"
    except Exception as e:
        info["errors"].append(f"firmware: {e}")

    # ─── 2. Тип разделов (GPT/MBR) для системного диска ───
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$sysdrive = $env:SystemDrive.TrimEnd(':');"
            "$part = Get-Partition -DriveLetter $sysdrive "
            "-ErrorAction SilentlyContinue;"
            "if ($part) { (Get-Disk -Number $part.DiskNumber).PartitionStyle }"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=20,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out:
            info["disk_style"] = out
    except Exception as e:
        info["errors"].append(f"disk_style: {e}")

    # ─── 3. EFI System Partition ───
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$esp = @(Get-Partition -ErrorAction SilentlyContinue | "
            "Where-Object { "
            "  $g = [string]$_.GptType; "
            "  $g = $g.Trim().TrimStart('{').TrimEnd('}').ToLower(); "
            "  $g -eq 'c12a7328-f81f-11d2-ba4b-00a0c93ec93b' "
            "}); "
            "if ($esp.Count -gt 0) { "
            "  $parts = @(); "
            "  foreach ($p in $esp) { "
            "    $size = [math]::Round($p.Size/1MB); "
            "    $parts += ('Диск ' + $p.DiskNumber + ', раздел ' + "
            "$p.PartitionNumber + ', ' + $size + ' МБ') "
            "  }; "
            "  $parts -join ' | ' "
            "}"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=20,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out:
            info["esp_present"] = True
            info["esp_info"] = out
    except Exception as e:
        info["errors"].append(f"esp: {e}")

    # ─── 4. BCD — текущие записи ───
    try:
        r = subprocess.run(["bcdedit", "/enum", "active"],
                           capture_output=True, text=True, timeout=15,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = (r.stdout or "").strip()
        if r.returncode == 0 and out:
            info["bcd_ok"] = True
            info["bcd_entries"] = out.splitlines()[:60]
    except Exception as e:
        info["errors"].append(f"bcdedit: {e}")

    # ─── 5. WinRE (reagentc) ───
    try:
        r = subprocess.run(["reagentc", "/info"],
                           capture_output=True, text=True, timeout=15,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = (r.stdout or "").strip()
        info["winre_info"] = out
        low = out.lower()
        info["winre_enabled"] = (
            "enabled" in low or "включ" in low or "восстановл" in low
        ) and "disabled" not in low and "отключ" not in low
    except Exception as e:
        info["errors"].append(f"reagentc: {e}")

    return info


def _boot_run_bcdedit_export():
    """Экспорт BCD в файл на рабочем столе."""
    try:
        desktop = os.path.join(os.path.expanduser("~"), "Desktop")
        if not os.path.isdir(desktop):
            desktop = os.path.join(os.path.expanduser("~"), "Рабочий стол")
        ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
        path = os.path.join(desktop, f"BCD_backup_{ts}.bcd")
        r = subprocess.run(["bcdedit", "/export", path],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        if r.returncode == 0:
            messagebox.showinfo(
                "Готово",
                f"BCD успешно сохранён:\n{path}\n\n"
                f"Восстановить можно командой:\n"
                f"bcdedit /import \"{path}\"")
        else:
            messagebox.showerror(
                "Ошибка",
                f"Не удалось сохранить BCD:\n"
                f"{(r.stdout or '') + (r.stderr or '')}")
    except Exception as e:
        log_error("_boot_run_bcdedit_export", e)
        messagebox.showerror("Ошибка", str(e))


def _boot_run_scanos():
    """bootrec /scanos — безопасно, только сканирование."""
    if not messagebox.askyesno(
        "bootrec /scanos",
        "Просканировать установленные Windows?\n\n"
        "Это безопасная команда — только чтение. "
        "Она покажет, какие ОС видит загрузчик."
    ):
        return
    try:
        r = subprocess.run(["bootrec", "/scanos"],
                           capture_output=True, text=True, timeout=120,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = ((r.stdout or "") + "\n" + (r.stderr or "")).strip()
        show_output_dialog("bootrec /scanos", out or "(пусто)")
    except Exception as e:
        log_error("_boot_run_scanos", e)
        messagebox.showerror("Ошибка", str(e))


def _boot_run_bootrec(action):
    """Запускает bootrec /<action> с двойным предупреждением."""
    if action == "fixmbr":
        desc = ("Перезапишет главную загрузочную запись (MBR). "
                "Обычно безопасно, но при UEFI+GPT не влияет.")
    elif action == "fixboot":
        desc = ("Запишет новый загрузочный сектор на системный раздел. "
                "⚠️ На UEFI может перезаписать ESP!")
    elif action == "rebuildbcd":
        desc = ("Полностью пересоберёт базу данных BCD. "
                "Может потребовать указать путь к Windows вручную.")
    else:
        desc = action

    if not messagebox.askyesno(
        f"bootrec /{action}",
        f"⚠️ ВНИМАНИЕ!\n\n{desc}\n\n"
        f"Эта команда обычно требует WinRE (среду восстановления) "
        f"для корректной работы. Из запущенной Windows она может "
        f"выдать «Отказано в доступе» или «Элемент не найден».\n\n"
        f"Продолжить?"):
        return

    if not messagebox.askyesno(
        "Подтверждение",
        f"ТОЧНО запустить bootrec /{action}?\n\n"
        f"Перед этим убедитесь, что сделали бэкап BCD."):
        return

    try:
        r = subprocess.run(["bootrec", f"/{action}"],
                           capture_output=True, text=True, timeout=180,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = ((r.stdout or "") + "\n" + (r.stderr or "")).strip()
        code = r.returncode
        header = f"bootrec /{action}  →  код возврата: {code}\n" + "=" * 60 + "\n"
        show_output_dialog(f"bootrec /{action}", header + (out or "(пусто)"))
    except subprocess.TimeoutExpired:
        messagebox.showerror("Ошибка", "Таймаут (3 минуты)")
    except Exception as e:
        log_error(f"_boot_run_bootrec({action})", e)
        messagebox.showerror("Ошибка", str(e))


