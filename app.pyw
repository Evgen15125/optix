# ================== BLOATWARE (ИСПРАВЛЕНО) ==================
BLOATWARE_LIST = [
    "Microsoft.3DBuilder",
    "Microsoft.BingNews",
    "Microsoft.BingWeather",
    "Microsoft.GetHelp",
    "Microsoft.Getstarted",
    "Microsoft.Messaging",
    "Microsoft.MicrosoftOfficeHub",
    "Microsoft.MicrosoftSolitaireCollection",
    "Microsoft.OneConnect",
    "Microsoft.People",
    "Microsoft.SkypeApp",
    "Microsoft.WindowsAlarms",
    "Microsoft.WindowsCamera",
    "Microsoft.WindowsMaps",
    "Microsoft.WindowsPhone",
    "Microsoft.WindowsSoundRecorder",
    "Microsoft.XboxApp",
    "Microsoft.XboxGameOverlay",
    "Microsoft.XboxGamingOverlay",
    "Microsoft.XboxIdentityProvider",
    "Microsoft.XboxSpeechToTextOverlay",
    "Microsoft.ZuneMusic",
    "Microsoft.ZuneVideo",
    "Microsoft.YourPhone",
]


def remove_bloatware():
    if not messagebox.askyesno(
        "Удалить встроенные приложения?",
        f"Будет удалено до {len(BLOATWARE_LIST)} приложений:\n\n"
        + "\n".join([f"• {b.split('.')[-1]}" for b in BLOATWARE_LIST[:10]])
        + "\n..."
        + "\n\nПродолжить?"
    ):
        return

    tweak_widgets["bloatware_status"].configure(
        text="⏳ Удаление...", text_color="#FFD54F"
    )

    def check_installed(pkg):
        """True, если пакет установлен в системе."""
        try:
            ps = f"@(Get-AppxPackage -Name '{pkg}').Count"
            r = subprocess.run(
                ["powershell", "-NoProfile", "-Command", ps],
                capture_output=True, text=True, timeout=30,
                creationflags=CREATE_NO_WINDOW,
                encoding="utf-8", errors="replace")
            out = (r.stdout or "").strip()
            try:
                return int(out) > 0
            except Exception:
                return False
        except Exception:
            return False

    def worker():
        removed = 0
        skipped = 0
        failed = 0
        for pkg in BLOATWARE_LIST:
            try:
                if not check_installed(pkg):
                    skipped += 1
                    continue
                ps = (
                    f"$ErrorActionPreference='SilentlyContinue'; "
                    f"Get-AppxPackage -AllUsers -Name '{pkg}' | "
                    f"Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue"
                )
                subprocess.run(
                    ["powershell", "-NoProfile", "-Command", ps],
                    capture_output=True, text=True, timeout=90,
                    creationflags=CREATE_NO_WINDOW,
                    encoding="utf-8", errors="replace"
                )
                if not check_installed(pkg):
                    removed += 1
                else:
                    failed += 1
            except Exception:
                failed += 1

        def finish():
            parts = [f"📦 Удалено: {removed}"]
            if skipped:
                parts.append(f"Уже нет: {skipped}")
            if failed:
                parts.append(f"Не удалось: {failed}")
            text = "  •  ".join(parts)
            tweak_widgets["bloatware_status"].configure(
                text=text,
                text_color="#7CFC7C" if removed > 0 else "#FFD54F"
            )
            if removed > 0:
                show_toast("Optix — Bloatware",
                           f"Удалено приложений: {removed}")
            else:
                show_toast("Optix — Bloatware",
                           "Ничего не удалено (всё уже удалено)")
        app.after(0, finish)

    threading.Thread(target=worker, daemon=True).start()


