            txt = ctk.CTkTextbox(bcd_card, height=180, font=("Consolas", 10), fg_color="#0D1B33", text_color="#e0e8f5", corner_radius=8, wrap="none")
            txt.pack(fill="x", padx=14, pady=(0, 10))
