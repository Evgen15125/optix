    "nvidia physx",
    "microsoft office",
    "microsoft teams",
    "onedrive",
    "realtek audio",
    "intel(r) graphics",
    "intel graphics",
    "nahimic",
    "microsoft edge webview2",
    "microsoft store",
    "microsoft photos",
    "microsoft edge webview runtime",
    "microsoft webp",
    "microsoft visual studio installer",
    "microsoft onedrive",
    "microsoft edge update",
    "python 3",  # Python тоже лучше не трогать через «полное удаление»
]


def _is_system_program(prog):
    """Проверяет, является ли программа системной (защита от дурака)."""
    name = (prog.get("name", "") or "").lower()
    pub = (prog.get("publisher", "") or "").lower()
    for sp in SYSTEM_PROGRAMS:
        if sp in name:
            return True, sp
    # Издатель Microsoft + слово в имени
    if "microsoft" in pub and any(
        k in name for k in ("edge", "defender", "visual c++", ".net",
                              "store", "office", "teams", "onedrive")):
        return True, "Microsoft"
    return False, ""


def _program_full_uninstall_flow(prog):
    """Окно полного удаления: деинсталлятор → сканирование → удаление остатков."""
    # ─── ЗАЩИТА: системные программы ───
    is_sys, sys_reason = _is_system_program(prog)
    if is_sys:
        messagebox.showerror(
            "🚫 Системная программа",
            f"«{prog['name']}» — компонент Windows.\n\n"
            f"Полное удаление с очисткой остатков для этой программы "
            f"ЗАПРЕЩЕНО, потому что может сломать систему.\n\n"
            f"Если действительно нужно удалить — используйте "
            f"встроенный деинсталлятор Windows (Параметры → "
            f"Приложения).")
        return

    un = prog.get("quiet_uninstall") or prog.get("uninstall", "")

    win = ctk.CTkToplevel(app)
    win.title(f"🧹 Полное удаление: {prog['name']}")
    win.geometry("900x700")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text="🧹  Полное удаление программы",
                 font=("Arial", 17, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win, text=prog["name"][:70],
                 font=("Inter", 14, "bold"),
                 text_color="#ffffff").pack(pady=(0, 4))

    status_lbl = ctk.CTkLabel(win, text="Шаг 1 из 3: Запустите деинсталлятор",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(4, 8), padx=20, fill="x")

    info_lbl = ctk.CTkLabel(
        win,
        text="Шаг 1. Нажмите «▶ Запустить деинсталлятор».\n"
             "Шаг 2. Дождитесь завершения, следуйте инструкциям мастера.\n"
             "Шаг 3. Нажмите «🔍 Сканировать остатки» — Optix найдёт, что осталось.\n"
             "Шаг 4. Выберите, что удалить, и подтвердите.",
        font=("Inter", 12), text_color="#B0BEC5",
        justify="left", wraplength=840).pack(pady=(0, 10), padx=20)

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A",
                                   corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    state = {
        "leftovers": None,
        "checkboxes": {},  # key -> (var, category, item)
    }

    def step1_run_installer():
        if not un:
            messagebox.showinfo(
                "Нет деинсталлятора",
                "У этой программы нет команды деинсталляции.\n\n"
                "Нажмите «Сканировать остатки» — Optix найдёт, "
                "что осталось от программы.")
            step2_scan()
            return

        # ─── Разбираем команду на exe + args ───
        cmd = un.strip()
        if cmd.startswith('"'):
            end = cmd.find('"', 1)
            exe = cmd[1:end]
            params = cmd[end + 1:].strip()
        else:
            parts = cmd.split(" ", 1)
            exe = parts[0].strip('"')
            params = parts[1] if len(parts) > 1 else ""

        if not exe or not os.path.exists(exe):
            # Файл не найден — ищем в стандартных местах
            if not os.path.exists(exe):
                messagebox.showinfo(
                    "Деинсталлятор не найден",
                    f"Файл деинсталлятора не существует:\n{exe}\n\n"
                    f"Возможно, программа была удалена вручную.\n"
                    f"Нажмите «Сканировать остатки», чтобы найти "
                    f"следы программы.")
                step2_scan()
                return

        # ─── Запуск через ShellExecuteW с UAC ───
        import ctypes
        try:
            # runas — запрашивает UAC, SW_SHOWNORMAL (1) — вывести окно
            ret = ctypes.windll.shell32.ShellExecuteW(
                None, "runas", exe, params, os.path.dirname(exe), 1)
            if ret <= 32:
                # UAC отменён или ошибка — пробуем без повышения
                ret = ctypes.windll.shell32.ShellExecuteW(
                    None, "open", exe, params, os.path.dirname(exe), 1)
            if ret <= 32:
                raise OSError(f"ShellExecuteW код {ret}")
        except Exception as e:
            log_error("step1_run_installer", e)
            # Резервный вариант через Popen
            try:
                subprocess.Popen(un, shell=True)
            except Exception as e2:
                messagebox.showerror(
                    "Ошибка",
                    f"Не удалось запустить деинсталлятор:\n{e2}\n\n"
                    f"Попробуйте вручную:\n{un}")
                return

        # ─── Меняем статус ───
        status_lbl.configure(
            text="Шаг 2 из 3: Деинсталлятор запущен. "
                 "Дождитесь завершения и нажмите «Сканировать».",
            text_color="#FFD54F")
        for w in lst.winfo_children():
            w.destroy()

        ctk.CTkLabel(lst,
                     text="⏳ Деинсталлятор работает...\n\n"
                          "1. Если появилось окно UAC — подтвердите.\n"
                          "2. Следуйте шагам мастера удаления.\n"
                          "3. Когда мастер закроется — нажмите "
                          "«🔍 Сканировать остатки».\n\n"
                          "Если мастер завис — нажмите "
                          "«⏭ Пропустить деинсталлятор».",
                     font=("Arial", 12),
                     text_color="#FFD54F",
                     justify="left", wraplength=800).pack(pady=30)

    def step2_scan():
        status_lbl.configure(text="⏳ Сканирование остатков (1–3 мин)...",
                              text_color="#FFD54F")
        for w in lst.winfo_children():
            w.destroy()
        ctk.CTkLabel(lst, text="🔍 Сканирование файлов, реестра, ярлыков...",
                     font=("Arial", 12),
                     text_color="#FFD54F").pack(pady=20)

        def worker():
            result = _program_scan_leftovers(prog)
            app.after(0, lambda: render_leftovers(result))
        threading.Thread(target=worker, daemon=True).start()

    def render_leftovers(result):
        state["leftovers"] = result
        state["checkboxes"] = {}

        for w in lst.winfo_children():
            w.destroy()

        total_files = len(result.get("files", []))
        total_reg = len(result.get("registry", []))
        total_lnk = len(result.get("shortcuts", []))
        total_svc = len(result.get("services", []))
        total_task = len(result.get("tasks", []))
        total = total_files + total_reg + total_lnk + total_svc + total_task

        if total == 0:
            status_lbl.configure(text="✅ Остатков не найдено",
                                  text_color="#7CFC7C")
            ctk.CTkLabel(lst,
                         text="✅ Чисто!\n\n"
                              "Optix не нашёл ни одного файла, ключа "
                              "реестра или ярлыка, связанного с этой "
                              "программой.",
                         font=("Arial", 13),
                         text_color="#7CFC7C").pack(pady=40)
            return

        status_lbl.configure(
            text=f"Найдено остатков: {total}   "
                 f"(файлов: {total_files}, реестр: {total_reg}, "
                 f"ярлыков: {total_lnk}, служб: {total_svc}, "
                 f"задач: {total_task})",
            text_color="#FFD54F")

        # Счётчики для верхних кнопок
        info = ctk.CTkFrame(lst, fg_color="#243A5E",
                             corner_radius=10)
        info.pack(fill="x", pady=(0, 8), padx=2)
        ctk.CTkLabel(info,
                     text="ℹ️  Уровни уверенности",
                     font=("Inter", 13, "bold"),
                     text_color="#82B1FF", anchor="w").pack(
            fill="x", padx=12, pady=(8, 4))
        ctk.CTkLabel(info,
                     text="● Точное совпадение имени — безопасно удалять\n"
                          "● Частичное совпадение — вероятно относится к программе\n"
                          "● Общее имя — может принадлежать чему-то ещё, будьте осторожны",
                     font=("Inter", 11),
                     text_color="#B0BEC5", justify="left").pack(
            fill="x", padx=12, pady=(0, 8))
        # Заменим точки на цветные маркеры
        for child in info.winfo_children():
            if isinstance(child, ctk.CTkLabel) and "Точное" in (child.cget("text") or ""):
                child.configure(text_color="#7CFC7C")
                break

        # Рендерим группы
        categories = [
            ("files", "📁 Файлы и папки", result.get("files", [])),
            ("registry", "🧬 Ключи реестра", result.get("registry", [])),
            ("shortcuts", "🔗 Ярлыки", result.get("shortcuts", [])),
            ("services", "⚙️ Службы", result.get("services", [])),
            ("tasks", "⏰ Задачи планировщика", result.get("tasks", [])),
        ]
        for cat_key, cat_title, items in categories:
            if not items:
                continue
            # Заголовок с чекбоксом "выбрать все"
            head = ctk.CTkFrame(lst, fg_color="#1A3A5E",
                                 corner_radius=8)
            head.pack(fill="x", pady=(8, 2), padx=2)
            head_var = ctk.IntVar(value=1)
            head_chk = ctk.CTkCheckBox(
                head, text=f"  {cat_title} ({len(items)})",
                variable=head_var,
                font=("Inter", 13, "bold"),
                text_color="#82B1FF",
                fg_color="#29B6F6", hover_color="#4FC3F7",
                checkbox_width=20, checkbox_height=20,
                corner_radius=5)
            head_chk.pack(side="left", padx=10, pady=6)
            # Сохраняем связь head_var -> items категории
            head_var._cat_key = cat_key
            head_var._items = items
            head_var._children = []  # заполним ниже

            def mk_toggle_all(v=head_var, ck=cat_key):
                def do():
                    new_val = v.get()
                    for cb_var, cb_cat, _, _ in state["checkboxes"].values():
                        if cb_cat == ck:
                            if new_val:
                                cb_var.set(1)
                            else:
                                cb_var.set(0)
                return do
            head_chk.configure(command=mk_toggle_all())

            # Строки
            for idx, item in enumerate(items):
                row = ctk.CTkFrame(lst, fg_color="#243A5E",
                                    corner_radius=6)
                row.pack(fill="x", pady=1, padx=2)

                var = ctk.IntVar(value=1)
                # Цвет уровня
                lvl = item.get("level", "partial")
                lvl_color = {"exact": "#7CFC7C",
                              "partial": "#FFD54F",
                              "unknown": "#B0BEC5"}.get(lvl, "#FFD54F")
                lvl_symbol = {"exact": "●", "partial": "◐",
                               "unknown": "○"}.get(lvl, "◐")

                ctk.CTkCheckBox(row, text="", variable=var,
                                 width=28, checkbox_width=18,
                                 checkbox_height=18, corner_radius=4,
                                 fg_color="#29B6F6",
                                 hover_color="#4FC3F7"
                                 ).pack(side="left", padx=(8, 4),
                                         pady=4)
                ctk.CTkLabel(row, text=lvl_symbol,
                             font=("Inter", 13, "bold"),
                             text_color=lvl_color, width=16).pack(
                    side="left", padx=(0, 4))

                # ─── Отображаемый текст зависит от категории ───
                if cat_key == "services":
                    display_text = item.get("display") or \
                        item.get("name") or "?"
                    if item.get("name") and item.get("name") != display_text:
                        display_text = f"{display_text}  ({item['name']})"
                elif cat_key == "tasks":
                    display_text = item.get("name") or \
                        item.get("task_full") or "?"
                    if item.get("task_full"):
                        display_text = f"{display_text}  [{item['task_full']}]"
                else:
                    display_text = item.get("path", "?")
                display_text = str(display_text)[:140]

                ctk.CTkLabel(row, text=display_text,
                             font=("Consolas", 9),
                             text_color="#e0e8f5", anchor="w").pack(
                    side="left", padx=4, pady=4, fill="x",
                    expand=True)
                # Размер для файлов
                if cat_key == "files" and item.get("size") is not None:
                    ctk.CTkLabel(row, text=human_size(item["size"]),
                                 font=("Consolas", 9),
                                 text_color="#4FC3F7", width=80,
                                 anchor="e").pack(side="right",
                                                   padx=6, pady=4)

                state["checkboxes"][f"{cat_key}_{idx}"] = (
                    var, cat_key, item, row)

        # Статистика по уровням внизу
        ctk.CTkLabel(lst, text="", height=6).pack()

    def step3_delete():
        if not state["leftovers"]:
            messagebox.showinfo("Optix",
                "Сначала просканируйте остатки.")
            return
        # Собираем отмеченное
        to_delete = {"files": [], "registry": [],
                      "shortcuts": [], "services": [], "tasks": []}
        for key, (var, cat, item, row) in state["checkboxes"].items():
            if var.get() == 1:
                to_delete[cat].append(item)
        total = sum(len(v) for v in to_delete.values())
        if total == 0:
            messagebox.showinfo("Optix", "Ничего не выбрано.")
            return

        msg_lines = [f"Будет удалено остатков: {total}", ""]
        if to_delete["files"]:
            msg_lines.append(
                f"📁 Файлов и папок: {len(to_delete['files'])}")
        if to_delete["registry"]:
            msg_lines.append(
                f"🧬 Ключей реестра: {len(to_delete['registry'])}")
        if to_delete["shortcuts"]:
            msg_lines.append(
                f"🔗 Ярлыков: {len(to_delete['shortcuts'])}")
        if to_delete["services"]:
            msg_lines.append(
                f"⚙️ Служб: {len(to_delete['services'])}")
        if to_delete["tasks"]:
            msg_lines.append(
                f"⏰ Задач: {len(to_delete['tasks'])}")
        msg_lines.append("")
        msg_lines.append("⚠️ Перед удалением ключей реестра будет "
                          "создан бэкап в D:\\Optix\\uninstall_backup\\.\n")
        msg_lines.append("Продолжить?")

        if not messagebox.askyesno("Удалить остатки?",
                                     "\n".join(msg_lines)):
