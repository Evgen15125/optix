# ================== ДИСКИ ==================
def get_disks_info():
    import psutil
    result = []
    for part in psutil.disk_partitions(all=False):
        try:
            usage = psutil.disk_usage(part.mountpoint)
            letter = part.device[0]
            model = ""
            media_type = ""
            bus_type = ""
            try:
                ps = subprocess.run(
                    ["powershell", "-NoProfile", "-Command",
                     f"$d = Get-Partition -DriveLetter '{letter}' -ErrorAction SilentlyContinue | "
                     f"Get-Disk -ErrorAction SilentlyContinue; "
                     f"if ($d) {{ $pd = Get-PhysicalDisk -DeviceNumber $d.Number -ErrorAction SilentlyContinue; "
                     f"if ($pd) {{ $pd | Select-Object FriendlyName,MediaType,BusType | ConvertTo-Csv -NoTypeInformation }} }}"],
                    capture_output=True, text=True, timeout=15,
                    creationflags=CREATE_NO_WINDOW)
                out = (ps.stdout or "").strip().splitlines()
                if len(out) >= 2:
                    parts_line = [p.strip('"') for p in out[1].split('","')]
                    if len(parts_line) >= 3:
                        model = parts_line[0].strip('"')
                        media_type = parts_line[1].strip('"')
                        bus_type = parts_line[2].strip('"')
            except Exception:
                pass
            result.append({
                "mount": part.mountpoint, "device": part.device,
                "fstype": part.fstype, "total": usage.total,
                "used": usage.used, "free": usage.free,
                "percent": usage.percent, "model": model,
                "media": media_type, "bus": bus_type,
            })
        except (PermissionError, OSError):
            continue
    return result


def show_smart(letter):
    try:
        r1 = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             f"(Get-Partition -DriveLetter '{letter}' -ErrorAction SilentlyContinue | "
             f"Get-Disk -ErrorAction SilentlyContinue).Number"],
            capture_output=True, text=True, timeout=15,
            creationflags=CREATE_NO_WINDOW)
        num = (r1.stdout or "").strip()
        if not num or not num.isdigit():
            messagebox.showinfo("SMART", "Не удалось получить информацию.")
            return
        disk_num = int(num)
        r2 = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             f"Get-PhysicalDisk -DeviceNumber {disk_num} | "
             f"Select-Object FriendlyName,MediaType,HealthStatus,OperationalStatus,Size,BusType | "
             f"ConvertTo-Csv -NoTypeInformation"],
            capture_output=True, text=True, timeout=15,
            creationflags=CREATE_NO_WINDOW)
        lines = (r2.stdout or "").strip().splitlines()
        info = {}
        if len(lines) >= 2:
            hdr = [h.strip('"').strip() for h in lines[0].split(",")]
            vals = [v.strip('"').strip() for v in lines[1].split(",")]
            info = dict(zip(hdr, vals))
        text = f"💾 Диск {letter}:\\\n\n"
        mapping = {"FriendlyName": "Модель", "MediaType": "Тип",
                   "BusType": "Интерфейс", "HealthStatus": "Здоровье",
                   "OperationalStatus": "Состояние", "Size": "Размер"}
        for k, v in info.items():
            label = mapping.get(k, k)
            if v in ("", "None", None):
                continue
            if k == "Size" and str(v).isdigit():
                v = human_size(int(v))
            text += f"  {label}: {v}\n"
        messagebox.showinfo(f"SMART — {letter}:", text)
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


# ================== РАСШИРЕННЫЙ SMART ==================
def _find_smartctl():
    """Ищет smartctl.exe в стандартных местах."""
    candidates = [
        r"C:\Program Files\smartmontools\bin\smartctl.exe",
        r"C:\Program Files (x86)\smartmontools\bin\smartctl.exe",
        os.path.join(BASE_DIR, "smartctl.exe"),
        os.path.join(BASE_DIR, "smartmontools", "bin", "smartctl.exe"),
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    try:
        r = subprocess.run(["where", "smartctl"], capture_output=True,
                           text=True, timeout=5,
                           creationflags=CREATE_NO_WINDOW)
        if r.returncode == 0:
            path = (r.stdout or "").strip().splitlines()[0].strip()
            if os.path.exists(path):
                return path
    except Exception:
        pass
    return None


def _smartctl_get_smart(disk_number):
    """
    Возвращает JSON от smartctl для указанного PhysicalDrive.
    Сначала получает список через `smartctl --scan`,
    маппит /dev/sdX → PhysicalDrive{N},
    затем вызывает smartctl -a -j /dev/sdX -d {type}.
    """
    smartctl = _find_smartctl()
    if not smartctl:
        log_error("_smartctl_get_smart", Exception("smartctl не найден"))
        return None

    # 1. Список дисков
    try:
        r = subprocess.run([smartctl, "--scan"], capture_output=True,
                           text=True, timeout=15,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        scan_out = (r.stdout or "") + "\n" + (r.stderr or "")
    except Exception as e:
        log_error("smartctl_scan", e)
        return None

    # 2. Маппинг: /dev/sda → 0, /dev/sdb → 1, ...
    # Формат: "/dev/sda -d nvme # /dev/sda, NVMe device"
    import re
    mapping = {}   # {disk_number: (dev_path, dev_type)}
    for line in scan_out.splitlines():
        line = line.strip()
        m = re.match(r"(/dev/sd[a-z]+)(?:\s+-d\s+(\S+))?", line)
        if not m:
            continue
        dev_path = m.group(1)
        dev_type = m.group(2) or "auto"
        # sdX → X-ая буква
        letter = dev_path[-1].lower()
        if "a" <= letter <= "z":
            idx = ord(letter) - ord("a")
            mapping[idx] = (dev_path, dev_type)

    target = mapping.get(disk_number)
    if target is None:
        log_error("_smartctl_get_smart",
                  Exception(f"Не найден dev для PhysicalDrive{disk_number}. "
                            f"Scan output:\n{scan_out}"))
        return None

    dev_path, dev_type = target

    # 3. Основной вызов
    try:
        cmd = [smartctl, "-a", "-j", dev_path]
        if dev_type and dev_type != "auto":
            cmd.extend(["-d", dev_type])
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if not out:
            log_error("_smartctl_get_smart",
                      Exception(f"smartctl вернул пустой stdout для {dev_path}. "
                                f"stderr: {r.stderr[:500]}"))
            return None
        try:
            data = json.loads(out)
        except json.JSONDecodeError as je:
            log_error("_smartctl_get_smart_json",
                      Exception(f"{je}. Out: {out[:500]}"))
            return None
        if isinstance(data, dict):
            return data
    except Exception as e:
        log_error(f"smartctl_get({dev_path})", e)

    return None


def _parse_smartctl_data(data):
    """Преобразует JSON от smartctl в наш формат."""
    result = {
        "temperature": None,
        "wear": None,
        "read_errors_total": None,
        "write_errors_total": None,
        "power_on_hours": None,
        "power_cycle_count": None,
        "start_stop_count": None,
        "load_cycle_count": None,
        "health_status": None,
        "operational_status": None,
        "media_type": None,
        "firmware": None,
        "serial": None,
        "friendly_name": None,
        "bus_type": None,
    }
    if not data:
        return result

    import re as _re

    def _raw_int(attr, min_v=None, max_v=None):
        """
        Извлекает целое из raw.string (первое число) или raw.value.
        Опционально проверяет границы.
        """
        if not attr:
            return None
        raw = attr.get("raw") or {}
        # 1) Пробуем строку — она у smartctl самая корректная
        rs = raw.get("string")
        if rs:
            m = _re.match(r"\s*(-?\d+)", str(rs))
            if m:
                try:
                    v = int(m.group(1))
                    if (min_v is None or v >= min_v) and \
                       (max_v is None or v <= max_v):
                        return v
                except Exception:
                    pass
        # 2) Fallback — raw.value, но с проверкой границ
        v = raw.get("value")
        if v is not None:
            try:
                v_int = int(v)
                if (min_v is None or v_int >= min_v) and \
                   (max_v is None or v_int <= max_v):
                    return v_int
            except Exception:
                pass
        return None

    # ───── NVMe ─────
    nvme = data.get("nvme_smart_health_information_log")
    if nvme:
        if nvme.get("temperature") is not None:
            try:
                result["temperature"] = int(nvme["temperature"])
            except Exception:
                pass
        if nvme.get("percentage_used") is not None:
            try:
                result["wear"] = int(nvme["percentage_used"])
            except Exception:
                pass
        if nvme.get("power_on_hours") is not None:
            try:
                result["power_on_hours"] = int(nvme["power_on_hours"])
            except Exception:
                pass
        if nvme.get("power_cycles") is not None:
            try:
                result["power_cycle_count"] = int(nvme["power_cycles"])
            except Exception:
                pass
        if nvme.get("media_errors") is not None:
            try:
                result["read_errors_total"] = int(nvme["media_errors"])
            except Exception:
                pass

    # ───── SATA / ATA ─────
    ata_table = (data.get("ata_smart_attributes") or {}).get("table") or []
    if ata_table:
        attr_map = {}
        for a in ata_table:
            try:
                attr_map[int(a.get("id"))] = a
            except Exception:
                continue

        # HDD или SSD? rotation_rate > 0 → HDD
        is_hdd = False
        try:
            rr = data.get("rotation_rate")
            if rr is not None and int(rr) > 0:
                is_hdd = True
        except Exception:
            pass

        # Температура (194 — Temp_Celsius, 190 — Airflow_Temp)
        if result["temperature"] is None:
            t = _raw_int(attr_map.get(194), 0, 120)
            if t is None:
                t = _raw_int(attr_map.get(190), 0, 120)
            if t is not None:
                result["temperature"] = t

        # Время работы (attr 9)
        if result["power_on_hours"] is None:
            h = _raw_int(attr_map.get(9), 0, 500000)
            if h is not None:
                result["power_on_hours"] = h

        # Циклы включения (attr 12)
        if result["power_cycle_count"] is None:
            pc = _raw_int(attr_map.get(12), 0, 1000000)
            if pc is not None:
                result["power_cycle_count"] = pc

        # Циклы старт/стоп (attr 4)
        if result["start_stop_count"] is None:
            ssc = _raw_int(attr_map.get(4), 0, 10000000)
            if ssc is not None:
                result["start_stop_count"] = ssc

        # Циклы загрузки/выгрузки (attr 193)
        if result["load_cycle_count"] is None:
            lc = _raw_int(attr_map.get(193), 0, 10000000)
            if lc is not None:
                result["load_cycle_count"] = lc

        # Ошибки чтения (attr 187 — Reported_Uncorrect, 197 — Current_Pending)
        if result["read_errors_total"] is None:
            re_cnt = _raw_int(attr_map.get(187))
            if re_cnt is None:
                re_cnt = _raw_int(attr_map.get(197))
            if re_cnt is not None and re_cnt >= 0:
                result["read_errors_total"] = re_cnt

        # Износ — ТОЛЬКО для SSD (не для HDD!)
        if result["wear"] is None and not is_hdd:
            # 231 = SSD_Life_Left, 202 = Percent_Lifetime_Remain
            for wid in (231, 202):
                attr = attr_map.get(wid)
                if not attr:
                    continue
                try:
                    norm = int(attr.get("value", 100))
                    if 0 <= norm <= 100:
                        result["wear"] = max(0, 100 - norm)
                        break
                except Exception:
                    continue

    # ───── Общие поля ─────
    result["friendly_name"] = (data.get("model_name") or
                                data.get("device", {}).get("model_name") or
                                "")
    if not result["friendly_name"]:
        result["friendly_name"] = data.get("model_family") or ""
    result["firmware"] = data.get("firmware_version") or ""
    result["serial"] = data.get("serial_number") or ""

    ss = data.get("smart_status") or {}
    if isinstance(ss, dict) and ss:
        result["health_status"] = "Healthy" if ss.get("passed") else "Failed"

    # Тип носителя и интерфейс
    try:
        rr = data.get("rotation_rate")
        if rr is not None and int(rr) > 0:
            result["media_type"] = f"HDD ({int(rr)} rpm)"
        elif rr is not None and int(rr) == 0:
            result["media_type"] = "SSD"
    except Exception:
        pass
    if not result["media_type"]:
        dev = data.get("device") or {}
        dtype = (dev.get("type") or "").lower()
        if dtype == "nvme":
            result["media_type"] = "SSD (NVMe)"
        elif dtype in ("sat", "ata"):
            result["media_type"] = "SATA"
        else:
            result["media_type"] = dtype

    dev = data.get("device") or {}
    if isinstance(dev, dict):
        proto = dev.get("protocol") or ""
        if proto:
            result["bus_type"] = proto
        elif dev.get("type"):
            result["bus_type"] = dev["type"]

    # Operational status — smartctl отдаёт passed
    result["operational_status"] = "OK"

    return result


def _get_smart_wear_via_wmi(disk_number):
    """
    Fallback: возвращает процент износа SSD через MSStorageDriver_ATAPISmartData.
    """
    wear_percent = None
    try:
        ps = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "$d = Get-WmiObject -Namespace 'root\\wmi' -Class 'MSStorageDriver_ATAPISmartData' -ErrorAction SilentlyContinue; "
            "if ($d) { "
            "  $bytes = $d.VendorSpecific; "
            "  $result = @(); "
            "  for ($i = 2; $i -lt $bytes.Length; $i += 12) { "
            "    $id = $bytes[$i]; "
            "    $val = $bytes[$i + 1]; "
            "    $result += [PSCustomObject]@{ Id = $id; Value = $val } "
            "  } "
            "  $result | ConvertTo-Json -Compress "
            "}"
        )
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace"
        )
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return None
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        for item in data:
            try:
                attr_id = int(item.get("Id", -1))
                val = int(item.get("Value", -1))
                if attr_id in (173, 231) and 0 <= val <= 100:
                    wear_percent = val
                    break
            except Exception:
                continue
    except Exception as e:
        log_error("_get_smart_wear_via_wmi", e)
    return wear_percent


def _get_detailed_smart(disk_number):
    """
    Основной источник: smartctl --json.
    Fallback: Windows Get-StorageReliabilityCounter + MSStorageDriver_ATAPISmartData.
    """
    result = {
        "temperature": None,
        "wear": None,
        "read_errors_total": None,
        "write_errors_total": None,
        "power_on_hours": None,
        "power_cycle_count": None,
        "start_stop_count": None,
        "load_cycle_count": None,
        "health_status": None,
        "operational_status": None,
        "media_type": None,
        "firmware": None,
        "serial": None,
        "friendly_name": None,
        "bus_type": None,
    }

    # 1. smartctl — основной и самый надёжный источник
    smartctl_json = _smartctl_get_smart(disk_number)
    if smartctl_json:
        s = _parse_smartctl_data(smartctl_json)
        for k, v in s.items():
            if v is not None and v != "":
                result[k] = v

    # 2. Windows API — если smartctl что-то не дал
    need_windows = (
        result.get("wear") is None or
        result.get("temperature") is None or
        result.get("power_on_hours") is None
    )
    if need_windows:
        try:
            ps = (
                "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
                f"$pd = Get-PhysicalDisk -DeviceNumber {disk_number} -ErrorAction SilentlyContinue; "
                "if ($pd) { "
                "  $c = Get-StorageReliabilityCounter -PhysicalDisk $pd -ErrorAction SilentlyContinue; "
                "  $pd | Select-Object FriendlyName,MediaType,HealthStatus,OperationalStatus,"
                "Size,BusType,FirmwareVersion,SerialNumber | ConvertTo-Json -Compress; "
                "  if ($c) { $c | Select-Object Temperature,Wear,ReadErrorsTotal,"
                "WriteErrorsTotal,PowerOnHours,PowerCycleCount,StartStopCycleCount,"
                "LoadUnloadCycleCount | ConvertTo-Json -Compress } "
                "}"
            )
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=30,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            out = (r.stdout or "").strip()
            if out.startswith("\ufeff"):
                out = out[1:]
            if out:
                lines = [ln for ln in out.splitlines() if ln.strip()]
                try:
                    disk_json = json.loads(lines[0])
                    if isinstance(disk_json, dict):
                        for k in ["friendly_name", "health_status", "operational_status",
                                  "media_type", "bus_type", "firmware", "serial"]:
                            wk = {"friendly_name": "FriendlyName",
                                  "health_status": "HealthStatus",
                                  "operational_status": "OperationalStatus",
                                  "media_type": "MediaType",
                                  "bus_type": "BusType",
                                  "firmware": "FirmwareVersion",
                                  "serial": "SerialNumber"}[k]
                            if result.get(k) is None or result.get(k) == "":
                                v = disk_json.get(wk)
                                if v:
                                    result[k] = v
                except Exception:
                    pass
                if len(lines) > 1:
                    try:
                        cnt = json.loads(lines[1])
                        if isinstance(cnt, dict):
                            for src, dst in [
                                ("Temperature", "temperature"),
                                ("Wear", "wear"),
                                ("ReadErrorsTotal", "read_errors_total"),
                                ("WriteErrorsTotal", "write_errors_total"),
                                ("PowerOnHours", "power_on_hours"),
                                ("PowerCycleCount", "power_cycle_count"),
                                ("StartStopCycleCount", "start_stop_count"),
                                ("LoadUnloadCycleCount", "load_cycle_count"),
                            ]:
                                if result.get(dst) is None:
                                    v = cnt.get(src)
                                    if v is not None:
                                        try:
                                            result[dst] = int(v)
                                        except Exception:
                                            result[dst] = v
                    except Exception:
                        pass
        except Exception as e:
            log_error("_get_detailed_smart_winapi", e)

    # 3. Fallback: MSStorageDriver_ATAPISmartData — если wear всё ещё пусто/0
    if result.get("wear") is None or result.get("wear") == 0:
        try:
            smart_wear = _get_smart_wear_via_wmi(disk_number)
            if smart_wear is not None:
                result["wear"] = smart_wear
        except Exception:
            pass

    return result


def _get_disk_temperatures():
    """
    Возвращает {device_id: temperature_celsius} для всех физических дисков.
    """
    temps = {}
    try:
        ps = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "Get-PhysicalDisk | ForEach-Object { "
            "  $d = $_; "
            "  $c = Get-StorageReliabilityCounter -PhysicalDisk $d -ErrorAction SilentlyContinue; "
            "  if ($c -and $c.Temperature) { "
            "    [PSCustomObject]@{ DeviceId=$d.DeviceId; Temperature=$c.Temperature } "
            "  } "
            "} | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return temps
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        for item in data:
            device_id = str(item.get("DeviceId", ""))
            t = item.get("Temperature")
            if device_id and t:
                try:
                    temps[device_id] = int(t)
                except Exception:
                    pass
    except Exception as e:
        log_error("_get_disk_temperatures", e)
    return temps


# ================== СРАВНЕНИЕ СНИМКОВ ДИСКА ==================
SNAPSHOTS_DIR = os.path.join(BASE_DIR, "disk_snapshots")


def _snapshots_ensure_dir():
    try:
        os.makedirs(SNAPSHOTS_DIR, exist_ok=True)
        return True
    except Exception as e:
        log_error("_snapshots_ensure_dir", e)
        return False


def _snapshots_list():
    """Возвращает список сохранённых снимков."""
    if not _snapshots_ensure_dir():
        return []
    result = []
    try:
        for f in sorted(os.listdir(SNAPSHOTS_DIR), reverse=True):
            if not f.endswith(".json"):
                continue
            fp = os.path.join(SNAPSHOTS_DIR, f)
            try:
                with open(fp, "r", encoding="utf-8") as fh:
                    data = json.load(fh)
                result.append({
                    "path": fp,
                    "filename": f,
                    "timestamp": data.get("timestamp", "?"),
                    "drive": data.get("drive", "?"),
                    "total_size": data.get("total_size", 0),
                    "free_size": data.get("free_size", 0),
                    "folders_count": len(data.get("folders", {})),
                })
            except Exception:
                continue
    except Exception:
        pass
    return result


def _snapshots_take(drive_letter):
    """
    Создаёт снимок диска — обходит все папки верхнего уровня,
    считает их размер, сохраняет в JSON.
    """
    drive = f"{drive_letter}:\\"
    if not os.path.isdir(drive):
        return None, f"Диск {drive} не найден"

    # Свободное/занятое
    try:
        import psutil
        usage = psutil.disk_usage(drive)
        total_size = usage.total
        free_size = usage.free
    except Exception as e:
        return None, f"Не удалось получить размер диска: {e}"

    folders = {}
    errors = []
    try:
        for name in os.listdir(drive):
            full = os.path.join(drive, name)
            if not os.path.isdir(full):
                continue
            # Пропускаем системные
            if name in ("$Recycle.Bin", "System Volume Information",
                         "Recovery", "$WinREAgent"):
                continue
            try:
                s = folder_size(full)
                if s >= 0:
                    folders[name] = s
            except Exception as e:
                errors.append(f"{name}: {e}")

    except Exception as e:
        return None, f"Ошибка обхода: {e}"

    snapshot = {
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "drive": drive_letter,
        "total_size": total_size,
        "free_size": free_size,
        "folders": folders,
        "errors": errors[:20],
    }

    if not _snapshots_ensure_dir():
        return None, "Не удалось создать папку для снимков"

    ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    filename = f"snap_{drive_letter}_{ts}.json"
    fp = os.path.join(SNAPSHOTS_DIR, filename)
    try:
        with open(fp, "w", encoding="utf-8") as f:
            json.dump(snapshot, f, ensure_ascii=False, indent=2)
    except Exception as e:
        return None, f"Не удалось сохранить снимок: {e}"
    return fp, None


def _snapshots_compare(path_a, path_b):
    """
    Сравнивает два снимка. Возвращает (а, б, дельта по папкам).
    """
    try:
        with open(path_a, "r", encoding="utf-8") as f:
            a = json.load(f)
        with open(path_b, "r", encoding="utf-8") as f:
            b = json.load(f)
    except Exception as e:
        return None, None, None, str(e)

    # Все ключи папок из двух снимков
    keys = set(a.get("folders", {}).keys()) | \
           set(b.get("folders", {}).keys())
    deltas = []
    for k in keys:
        sa = a["folders"].get(k, 0)
        sb = b["folders"].get(k, 0)
        deltas.append({
            "name": k,
            "a": sa,
            "b": sb,
            "delta": sb - sa,
        })
    deltas.sort(key=lambda x: -abs(x["delta"]))
    return a, b, deltas, None


def _snapshots_delete(path):
    """Удаляет снимок."""
    try:
        if os.path.exists(path):
            os.remove(path)
            return True
    except Exception as e:
        log_error("_snapshots_delete", e)
    return False


def _snapshots_forecast(a, b):
    """Прогноз заполнения диска на основе двух снимков."""
    try:
        t_a = datetime.strptime(a["timestamp"], "%Y-%m-%d %H:%M:%S")
        t_b = datetime.strptime(b["timestamp"], "%Y-%m-%d %H:%M:%S")
        days = (t_b - t_a).total_seconds() / 86400.0
        if days <= 0:
            return None
        # Скорость роста занятого места
        used_a = a["total_size"] - a["free_size"]
        used_b = b["total_size"] - b["free_size"]
        delta_used = used_b - used_a
        if delta_used <= 0:
            # Место освобождается — прогноза «заполнится» нет
            return {
                "days_between": days,
                "delta_used": delta_used,
                "freeing": True,
                "free_after_days": None,
            }
        rate_per_day = delta_used / days
        free_now = b["free_size"]
        days_to_full = free_now / rate_per_day if rate_per_day > 0 else None
        return {
            "days_between": days,
            "delta_used": delta_used,
            "rate_per_day": rate_per_day,
            "freeing": False,
            "days_to_full": days_to_full,
            "full_date": (datetime.now() +
                          __import__("datetime").timedelta(
                              days=days_to_full)).strftime("%Y-%m-%d")
                          if days_to_full else None,
        }
    except Exception as e:
        log_error("_snapshots_forecast", e)
        return None


