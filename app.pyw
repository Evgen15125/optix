    ctk.CTkLabel(win, text="🔄  Сравнение двух отчётов (Diff)",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Выберите два JSON-отчёта, сохранённых через "
                      "«📋 JSON». Optix покажет, что изменилось между "
                      "ними.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(
