def _program_show_properties(prog):
    """Открывает системное окно свойств (через explorer /select)."""
    exe = _extract_exe_path(prog.get("uninstall", "") or "")
    target = exe if exe and os.path.exists(exe) else \
        _get_program_install_dir(prog)
    if not target:
        messagebox.showinfo("Нет данных",
            "Не удалось найти файл или папку программы.")
        return
    try:
        if os.path.isdir(target):
            subprocess.Popen(["explorer", target])
        else:
            subprocess.Popen(["explorer", "/select,", target])
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def _program_copy_to_clipboard(text, what="значение"):
    """Копирует в буфер обмена."""
    try:
        app.clipboard_clear()
        app.clipboard_append(str(text))
        show_toast("Optix", f"Скопировано: {what}")
    except Exception:
        pass


def _program_right_click_menu(prog, parent_widget):
    """Создаёт контекстное меню ПКМ для программы."""
    m = tk.Menu(parent_widget, tearoff=0, bg="#1A2A4A", fg="#ffffff",
                activebackground="#1565C0",
                activeforeground="#ffffff",
                font=("Inter", 10))
    m.add_command(label="📂 Открыть папку",
                  command=lambda: _program_open_folder(prog))
    m.add_command(label="🌐 Найти издателя",
                  command=lambda: _program_open_site(prog))
    m.add_command(label="ℹ️ Свойства",
                  command=lambda: _program_show_properties(prog))
    m.add_separator()
    m.add_command(label=f"📋 Копировать имя",
                  command=lambda: _program_copy_to_clipboard(
                      prog.get("name", ""), "имя"))
    m.add_command(label=f"📋 Копировать издателя",
                  command=lambda: _program_copy_to_clipboard(
                      prog.get("publisher", ""), "издателя"))
    m.add_command(label=f"📋 Копировать версию",
                  command=lambda: _program_copy_to_clipboard(
                      prog.get("version", ""), "версию"))
    install_dir = _get_program_install_dir(prog)
    if install_dir:
        m.add_command(label=f"📋 Копировать путь",
                      command=lambda: _program_copy_to_clipboard(
                          install_dir, "путь"))
    m.add_separator()
    m.add_command(label=f"🗑 Удалить программу",
                  foreground="#FF8A8A",
                  command=lambda: _program_uninstall_single(prog))
    return m


