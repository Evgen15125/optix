# ================== ВОССТАНОВЛЕНИЕ УДАЛЁННЫХ ФАЙЛОВ ==================
def _recovery_find_winfr():
    """Ищет winfr.exe в системе."""
    candidates = [
        r"C:\Program Files\Windows File Recovery\winfr.exe",
        r"C:\Program Files (x86)\Windows File Recovery\winfr.exe",
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    try:
        r = subprocess.run(["where", "winfr"], capture_output=True,
                           text=True, timeout=5,
                           creationflags=CREATE_NO_WINDOW)
        if r.returncode == 0:
            lines = (r.stdout or "").strip().splitlines()
            if lines:
                p = lines[0].strip()
                if os.path.exists(p):
                    return p
    except Exception:
        pass
    return None


def _recovery_find_photorec():
    """Ищет PhotoRec или TestDisk."""
    candidates = [
        r"C:\Program Files\TestDisk\photorec_win.exe",
        r"C:\Program Files\TestDisk\testdisk_win.exe",
        r"C:\Program Files (x86)\TestDisk\photorec_win.exe",
        r"C:\Program Files (x86)\TestDisk\testdisk_win.exe",
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    return None


def _recovery_find_recuva():
    """Ищет Recuva."""
    candidates = [
        r"C:\Program Files\Recuva\recuva.exe",
        r"C:\Program Files (x86)\Recuva\recuva.exe",
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    return None


def _recovery_get_disks_info():
    """Возвращает список дисков с их размерами."""
    result = []
    try:
        import psutil
        for part in psutil.disk_partitions(all=False):
            try:
                u = psutil.disk_usage(part.mountpoint)
                result.append({
                    "mount": part.mountpoint.rstrip("\\"),
                    "total": u.total,
                    "free": u.free,
                    "used": u.used,
                })
            except Exception:
                continue
    except Exception:
        pass
    return result


