def _parse_install_date(s):
    """Парсит дату установки в datetime. Поддерживает форматы: YYYYMMDD, YYYY-MM-DD, DD.MM.YYYY."""
    if not s:
        return None
    s = str(s).strip()
    for fmt in ("%Y%m%d", "%Y-%m-%d", "%d.%m.%Y", "%Y/%m/%d"):
        try:
            return datetime.strptime(s, fmt)
        except Exception:
            continue
    return None


def _program_score_rating(name, publisher):
    """
    Оценивает программу: возвращает (icon, label, color, comment).
    🔴 — подозрительно (adware/bundleware)
    🟡 — может быть нежелательной (по ключевым словам)
    🟢 — нормальная
    ⚪ — нет данных об издателе
    """
    name_l = (name or "").lower()
    pub_l = (publisher or "").lower().strip()
    # 1. Явно подозрительный издатель
    for sp in SUSPICIOUS_PUBLISHERS:
        if sp in pub_l:
            return ("🔴", "Нежелательное",
                    "#FF8A8A",
                    f"Издатель «{publisher}» замечен в adware/bundleware")
    # 2. Подозрительное имя + нет издателя
    suspicious_count = sum(1 for kw in SUSPICIOUS_NAME_KEYWORDS
                            if kw in name_l)
    if suspicious_count >= 2 and not pub_l:
        return ("🟡", "Осторожно",
                "#FFD54F",
                "Нет издателя + подозрительное имя")
    # 3. Издатель есть — нормально
    if pub_l:
        return ("🟢", "Нормально", "#7CFC7C", "")
    # 4. Нет издателя, но имя не подозрительное — тоже нормально
    #    (например, портативные приложения без publisher)
    if suspicious_count == 0:
        return ("🟢", "Нормально", "#7CFC7C", "")
    # 5. Совсем ничего не знаем
    return ("⚪", "Неизвестно", "#B0BEC5", "")


def _get_program_install_dir(prog):
    """Пытается найти папку установки программы."""
    loc = (prog.get("install_location") or "").strip().strip('"')
    if loc and os.path.isdir(loc):
        return loc
    # Извлекаем из UninstallString
    un = prog.get("uninstall", "") or ""
    exe = _extract_exe_path(un) if un else ""
    if exe and os.path.exists(exe):
        return os.path.dirname(exe)
    # Пробуем стандартные пути
    name = prog.get("name", "").strip()
    if name:
        for base in (os.environ.get("ProgramFiles", r"C:\Program Files"),
                      os.environ.get("ProgramFiles(x86)",
                                     r"C:\Program Files (x86)"),
                      os.environ.get("LOCALAPPDATA", "")):
            if not base:
                continue
            candidate = os.path.join(base, name)
            if os.path.isdir(candidate):
                return candidate
    return ""


def _program_open_folder(prog):
    """Открывает папку установки в проводнике."""
    d = _get_program_install_dir(prog)
    if not d or not os.path.isdir(d):
        messagebox.showinfo("Папка не найдена",
            f"Не удалось определить папку установки для:\n{prog['name']}")
        return
    try:
        os.startfile(d)
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def _program_open_site(prog):
    """Открывает поиск издателя в Google."""
    pub = (prog.get("publisher") or "").strip()
    if not pub:
        messagebox.showinfo("Нет издателя",
            "У этой программы не указан издатель.")
        return
    import urllib.parse
    url = "https://www.google.com/search?q=" + \
          urllib.parse.quote(f"{pub} official site")
    try:
        subprocess.Popen(["cmd", "/c", "start", "", url],
                         creationflags=CREATE_NO_WINDOW)
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


