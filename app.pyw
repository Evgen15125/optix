def _net_update_conn_info(status_lbl, result_box, btn):
    status_lbl.configure(text="⏳ Сбор информации...", text_color="#FFD54F")
    _start_button_pulse(btn, "#1F2E4A", "#4FC3F7")
    
    def worker():
        try:
            ps = (
                "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
                "$adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1; "
                "if ($adapter) { "
                "  $ip = Get-NetIPAddress -InterfaceIndex $adapter.ifIndex -AddressFamily IPv4 | Select-Object -First 1; "
                "  $gw = Get-NetRoute -InterfaceIndex $adapter.ifIndex -DestinationPrefix '0.0.0.0/0' | Select-Object -First 1; "
                "  [PSCustomObject]@{ "
                "    Name = $adapter.Name; "
                "    Type = if ($adapter.PhysicalMediaType -match '802.11') {'Wi-Fi'} else {'Ethernet'}; "
                "    Speed = $adapter.LinkSpeed; "
                "    IP = $ip.IPAddress; "
                "    Gateway = $gw.NextHop; "
                "    MAC = $adapter.MacAddress "
                "  } | Format-List | Out-String "
                "} else { 'Нет активных подключений' }"
            )
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps], capture_output=True, text=True, timeout=15, encoding="utf-8", errors="replace", creationflags=CREATE_NO_WINDOW)
            out = (r.stdout or "").strip()
            
            def update():
                _stop_button_pulse(btn)
                result_box.configure(state="normal")
                result_box.delete("1.0", "end")
                result_box.insert("1.0", out)
                result_box.configure(state="disabled")
                status_lbl.configure(text="✅ Информация обновлена", text_color="#7CFC7C")
            app.after(0, update)
        except Exception as e:
            app.after(0, lambda: _stop_button_pulse(btn))
            app.after(0, lambda: status_lbl.configure(text=f"❌ Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()


def _net_wifi_scan(status_lbl, result_box, btn):
    status_lbl.configure(text="⏳ Сканирование Wi-Fi...", text_color="#FFD54F")
    _start_button_pulse(btn, "#1F2E4A", "#4FC3F7")
    
    def worker():
        try:
            r = subprocess.run(["netsh", "wlan", "show", "networks", "mode=bssid"], 
                               capture_output=True, timeout=20, creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(r.stdout or b"")
            
            lines = out.splitlines()
            networks = []
            cur_ssid = None
            for line in lines:
                line = line.strip()
                low_line = line.lower()
                # Проверяем и английские, и русские названия ключей
                if (low_line.startswith("ssid") or low_line.startswith("имя сети")) and "bssid" not in low_line:
                    cur_ssid = line.split(":", 1)[-1].strip()
                elif ("signal" in low_line or "сигнал" in low_line) and cur_ssid:
                    sig = line.split(":", 1)[-1].strip()
                    networks.append(f"📶 {cur_ssid[:30]:<30} | Уровень: {sig}")
                    cur_ssid = None
            
            if not networks:
                out = "Сети не найдены (возможно, Wi-Fi отключён)."
            else:
                out = "\n".join(networks)
                
            def update():
                _stop_button_pulse(btn)
                result_box.configure(state="normal")
                result_box.delete("1.0", "end")
                result_box.insert("1.0", out)
                result_box.configure(state="disabled")
                status_lbl.configure(text="✅ Сканирование завершено", text_color="#7CFC7C")
            app.after(0, update)
        except Exception as e:
            app.after(0, lambda: _stop_button_pulse(btn))
            app.after(0, lambda: status_lbl.configure(text=f"❌ Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()


def _net_apply_dns(choice, status_lbl):
    status_lbl.configure(text="⏳ Настройка DNS...", text_color="#FFD54F")
    if "Cloudflare" in choice: dns1, dns2 = "1.1.1.1", "1.0.0.1"
    elif "Google" in choice: dns1, dns2 = "8.8.8.8", "8.8.4.4"
    elif "Quad9" in choice: dns1, dns2 = "9.9.9.9", "149.112.112.112"
    else: dns1, dns2 = None, None

    def worker():
        try:
            r = subprocess.run(["powershell", "-NoProfile", "-Command", 
                                "Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1 -ExpandProperty Name"],
                               capture_output=True, text=True, timeout=10, encoding="utf-8", errors="replace", creationflags=CREATE_NO_WINDOW)
            adapter = (r.stdout or "").strip()
            if not adapter:
                app.after(0, lambda: status_lbl.configure(text="❌ Активный адаптер не найден", text_color="#FF8A8A"))
                return

            if dns1:
                cmd1 = ["netsh", "interface", "ip", "set", "dns", f'name="{adapter}"', "static", dns1, "primary"]
                cmd2 = ["netsh", "interface", "ip", "add", "dns", f'name="{adapter}"', dns2, "index=2"]
                subprocess.run(cmd1, capture_output=True, timeout=10, creationflags=CREATE_NO_WINDOW)
                subprocess.run(cmd2, capture_output=True, timeout=10, creationflags=CREATE_NO_WINDOW)
                msg = f"✅ DNS установлен: {dns1}, {dns2}"
            else:
                cmd = ["netsh", "interface", "ip", "set", "dns", f'name="{adapter}"', "dhcp"]
                subprocess.run(cmd, capture_output=True, timeout=10, creationflags=CREATE_NO_WINDOW)
                msg = "✅ DNS возвращён на автоматический (DHCP)"
                
            app.after(0, lambda: status_lbl.configure(text=msg, text_color="#7CFC7C"))
        except Exception as e:
            app.after(0, lambda: status_lbl.configure(text=f"❌ Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()


def _net_test_mtu(status_lbl, result_box, btn):
    status_lbl.configure(text="⏳ Подбор MTU...", text_color="#FFD54F")
    _start_button_pulse(btn, "#1F2E4A", "#4FC3F7")
    
    def worker():
        try:
            try:
                import psutil
                vpn_active = False
                for p in psutil.process_iter(["name"]):
                    n = (p.info.get("name") or "").lower()
                    if "warp" in n or "zapret" in n or "winws" in n or "wireguard" in n:
                        vpn_active = True
                        break
            except Exception:
                vpn_active = False

            sizes = [1472, 1464, 1450, 1400, 1300]
            optimal = None
            for s in sizes:
                try:
                    r = subprocess.run(["ping", "-f", "-l", str(s), "-n", "1", "8.8.8.8"], capture_output=True, timeout=3, creationflags=CREATE_NO_WINDOW)
                except subprocess.TimeoutExpired:
                    continue
                out = _decode_console_bytes(r.stdout or b"")
                if "TTL" in out or "ttl" in out or "байт=" in out:
                    optimal = s + 28
                    break
            
            if optimal:
                res = f"✅ Оптимальный MTU: {optimal}\n(Размер пакета {optimal-28} + 28 байт заголовков)"
                if vpn_active:
                    res += "\n\n⚠️ Внимание: обнаружен VPN/WARP/Zapret. Для вашего туннеля оптимальный MTU может отличаться (обычно 1280–1420)."
            else:
                if vpn_active:
                    res = ("❌ Не удалось определить MTU.\n\n"
                           "🔍 Обнаружен активный VPN/WARP/Zapret.\n"
                           "Эти программы блокируют ICMP-пакеты (пинги) с флагом 'Не фрагментировать', "
                           "поэтому тест невозможен.\n\n"
                           "💡 Что делать: Отключите WARP/Zapret на время теста, "
                           "либо просто пропустите этот шаг — туннель сам подбирает нужный MTU.")
                else:
                    res = ("❌ Не удалось определить MTU.\n"
                           "Провайдер режет пакеты или ICMP заблокирован.")
                
            def update():
                _stop_button_pulse(btn)
                result_box.configure(state="normal")
                result_box.delete("1.0", "end")
                result_box.insert("1.0", res)
                result_box.configure(state="disabled")
                status_lbl.configure(text="✅ Тест MTU завершён" if optimal else "⚠️ Тест MTU невозможен", 
                                     text_color="#7CFC7C" if optimal else "#FFD54F")
            app.after(0, update)
        except Exception as e:
            app.after(0, lambda: _stop_button_pulse(btn))
            app.after(0, lambda: status_lbl.configure(text=f"❌ Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()


# ─── Вспомогательные функции для Сети ───
def _net_speed_test(status_lbl, result_box, btn):
    status_lbl.configure(text="⏳ Тест скорости...", text_color="#FFD54F")
    _start_button_pulse(btn, "#1F2E4A", "#4FC3F7")
    
    def worker():
        try:
            import socket
            import time
            
            # Используем TCP-соединение (обходит блокировки ICMP)
            hosts = [("1.1.1.1", 53, "Cloudflare DNS"), ("8.8.8.8", 53, "Google DNS")]
            results = []
            
            for host, port, name in hosts:
                try:
                    start = time.time()
                    s = socket.create_connection((host, port), timeout=2)
                    end = time.time()
                    s.close()
                    ms = (end - start) * 1000
                    results.append(f"✅ {name}: {ms:.0f} мс")
                except Exception:
                    results.append(f"❌ {name}: недоступен")
            
            if all("✅" in r for r in results):
                res = "Тест задержки (TCP-подключение):\n\n" + "\n".join(results)
                res += "\n\n🟢 Отличная связь"
                status_color = "#7CFC7C"
                status_text = "✅ Тест завершён"
            elif any("✅" in r for r in results):
                res = "Тест задержки (TCP-подключение):\n\n" + "\n".join(results)
                res += "\n\n🟡 Частичная доступность"
                status_color = "#FFD54F"
                status_text = "⚠️ Частичная связь"
            else:
                res = "❌ Не удалось подключиться к серверам.\n\nПроверьте интернет или отключите VPN/WARP на время теста."
                status_color = "#FF8A8A"
                status_text = "❌ Ошибка связи"
                
            def update():
                _stop_button_pulse(btn)
                result_box.configure(state="normal")
                result_box.delete("1.0", "end")
                result_box.insert("1.0", res)
                result_box.configure(state="disabled")
                status_lbl.configure(text=status_text, text_color=status_color)
            app.after(0, update)
        except Exception as e:
            app.after(0, lambda: _stop_button_pulse(btn))
            app.after(0, lambda: status_lbl.configure(text=f"❌ Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()

