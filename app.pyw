        d_color = "#B0BEC5"
        d_text = "0 Б"

    sum_row("Занято в снимке А:", human_size(used_a))
    sum_row("Занято в снимке Б:", human_size(used_b))
    sum_row("Изменение:", d_text, d_color)
    sum_row("Свободно сейчас:", human_size(b["free_size"]))

    # ─── Прогноз ───
    forecast = _snapshots_forecast(a, b)
    if forecast:
