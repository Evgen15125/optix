def _make_tray_icon_with_badge(n, base_icon_path=None):
    """Рисует иконку Optix с красным кружком и числом активных задач."""
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        return None
    if base_icon_path is None:
        base_icon_path = ICON_PNG
    try:
        if base_icon_path and os.path.exists(base_icon_path):
            img = Image.open(base_icon_path).convert("RGBA")
            img = img.resize((64, 64), Image.LANCZOS)
        else:
            img = Image.new("RGBA", (64, 64), (21, 101, 192, 255))
    except Exception:
        img = Image.new("RGBA", (64, 64), (21, 101, 192, 255))

    if not n or n <= 0:
        return img

    draw = ImageDraw.Draw(img)
    text = str(n) if n < 100 else "99+"
    badge_r = 22
    cx, cy = 46, 46
    draw.ellipse(
        (cx - badge_r, cy - badge_r, cx + badge_r, cy + badge_r),
        fill=(214, 40, 40, 255), outline=(255, 255, 255, 255), width=2
    )
    font = None
    for fp in ("segoeui.ttf", "arial.ttf", "tahoma.ttf"):
        try:
            font = ImageFont.truetype(fp, 22)
            break
        except Exception:
            continue
    if font is None:
        try:
            font = ImageFont.load_default()
        except Exception:
            pass
    if font is not None:
        try:
            bbox = draw.textbbox((0, 0), text, font=font)
            tw = bbox[2] - bbox[0]
            th = bbox[3] - bbox[1]
            draw.text(
                (cx - tw / 2 - bbox[0], cy - th / 2 - bbox[1]),
                text, font=font, fill=(255, 255, 255, 255)
            )
        except Exception:
            try:
                draw.text((cx - 10, cy - 12), text,
                          font=font, fill=(255, 255, 255, 255))
            except Exception:
                pass
    return img


def _count_active_tasks():
    """Считает число активных (включённых) задач Optix."""
    try:
        tasks = load_optix_tasks()
        return sum(1 for t in tasks if t.get("enabled"))
    except Exception:
        return 0


def _update_tray_badge():
    """Обновляет иконку и tooltip трея по числу активных задач."""
    icon = _STATE.get("tray_icon")
    if not icon:
        return
    try:
        n = _count_active_tasks()
        new_img = _make_tray_icon_with_badge(n)
        if new_img is not None:
            try:
                icon.icon = new_img
            except Exception:
                pass
        try:
            if n > 0:
                icon.title = f"Optix — задач активно: {n}"
            else:
                icon.title = "Optix — нет активных задач"
        except Exception:
            pass
    except Exception as e:
        log_error("_update_tray_badge", e)


# ================== ПРОВЕРКА ОБНОВЛЕНИЙ ==================
def _parse_version(v):
    """'v1.5.0' → (1, 5, 0). '1.5' → (1, 5). '' → (0,)."""
    if not v:
        return (0,)
    v = str(v).strip().lstrip("vV")
    parts = re.findall(r"\d+", v)
    return tuple(int(x) for x in parts) if parts else (0,)


def _compare_versions(current, latest):
    """Возвращает 1 если current > latest, -1 если current < latest, 0 если равны."""
    a = _parse_version(current)
    b = _parse_version(latest)
    max_len = max(len(a), len(b))
    a = a + (0,) * (max_len - len(a))
    b = b + (0,) * (max_len - len(b))
    if a < b:
        return -1
    if a > b:
        return 1
    return 0


def _fetch_latest_release():
    """Возвращает (tag, url, name, published_at, body) или None."""
    import urllib.request
    import urllib.error
    import ssl

    if not GITHUB_REPO or "/" not in GITHUB_REPO or \
            GITHUB_REPO.startswith("user/"):
        return None

    api_url = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"
    req = urllib.request.Request(
        api_url,
        headers={
            "User-Agent": f"Optix/{APP_VERSION}",
            "Accept": "application/vnd.github+json",
        })
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=12, context=ctx) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
        data = json.loads(raw)
    except urllib.error.HTTPError as e:
        # 404 = в репозитории нет релизов, 403 = rate limit GitHub
        # (60 запросов/час без авторизации). Оба случая — ожидаемое
        # поведение, а не ошибки приложения. Не пишем в лог.
        if e.code not in (403, 404):
            log_error("_fetch_latest_release", e)
        return None

    tag = str(data.get("tag_name") or "").strip()
    if not tag:
        return None
    url = str(data.get("html_url") or "").strip()
    name = str(data.get("name") or tag).strip()
    published = str(data.get("published_at") or "").strip()
    body = str(data.get("body") or "").strip()
    return tag, url, name, published, body


def _save_last_update_check():
    try:
        with open(LAST_UPDATE_CHECK_PATH, "w", encoding="utf-8") as f:
            json.dump({
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "version": APP_VERSION,
            }, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


def _was_checked_recently(hours=12):
    """True, если проверка была меньше N часов назад."""
    try:
        if not os.path.exists(LAST_UPDATE_CHECK_PATH):
            return False
        with open(LAST_UPDATE_CHECK_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        ts = data.get("timestamp", "")
        dt = datetime.strptime(ts, "%Y-%m-%d %H:%M:%S")
        return (datetime.now() - dt).total_seconds() < hours * 3600
    except Exception:
        return False


def check_updates_async(app_obj, silent=False):
    """
    Проверяет обновления через GitHub Releases API.
    silent=True — не показывает окно, если обновлений нет (для автостарта).
    """
    def worker():
        time.sleep(0.3)

        repo_low = (GITHUB_REPO or "").strip().lower()
        PLACEHOLDERS = ("", "user/optix", "username/repo", "your/repo",
                        "user/repo", "example/optix", "xcont/optix")
        if "/" not in repo_low or repo_low in PLACEHOLDERS:
            def finish_not_configured():
                if not silent:
                    messagebox.showinfo(
                        "Проверка обновлений",
                        f"Optix версия {APP_VERSION}\n\n"
                        "⚠️ Репозиторий обновлений ещё не настроен.\n\n"
                        "Открой app.pyw и укажи свой GitHub-репозиторий\n"
                        "в константе GITHUB_REPO (например: "
                        "\"xcont/optix\").")
            app_obj.after(0, finish_not_configured)
            return

        result = _fetch_latest_release()

        def finish():
            if result is None:
                if not silent:
                    messagebox.showinfo(
                        "Проверка обновлений",
                        f"Optix версия {APP_VERSION}\n\n"
                        "❌ Не удалось проверить обновления.\n\n"
                        "Возможные причины:\n"
                        "• нет интернета;\n"
                        "• репозиторий не существует;\n"
                        "• в репозитории нет ни одного релиза.")
                return

            tag, url, name, published, body = result
            _save_last_update_check()

            cmp = _compare_versions(APP_VERSION, tag)

            if cmp >= 0:
                if not silent:
                    messagebox.showinfo(
                        "Проверка обновлений",
                        f"Optix версия {APP_VERSION}\n\n"
                        f"✅ У вас последняя версия! 🎉\n\n"
                        f"Последний релиз: {tag}")
                return

            # Есть более новая версия
            date_short = published[:10] if published else "?"
            body_short = body[:400] + ("..." if len(body) > 400 else "")

            def ask_open():
                if messagebox.askyesno(
                    "Доступно обновление!",
                    f"Текущая версия: {APP_VERSION}\n"
                    f"Новая версия:   {tag}\n"
                    f"Опубликовано:   {date_short}\n\n"
                    f"{body_short}\n\n"
                    f"Открыть страницу релиза в браузере?"):
                    try:
                        subprocess.Popen(
                            ["cmd", "/c", "start", "", url],
                            creationflags=CREATE_NO_WINDOW)
                    except Exception as e:
                        log_error("open_release_url", e)

            if silent:
                try:
                    show_toast("Optix — доступно обновление",
                               f"{APP_VERSION} → {tag}. "
                               f"Открой «О программе» для деталей.")
                except Exception:
                    pass
            else:
                ask_open()
        app_obj.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def autocheck_updates_on_start():
    """Тихая проверка при старте (не чаще 1 раза в 12 часов)."""
    try:
        if not GITHUB_REPO or "/" not in GITHUB_REPO or \
                GITHUB_REPO.startswith("user/"):
            return
        if _was_checked_recently(hours=12):
            return
        # Запускаем после того, как окно отрисуется
        app.after(5000, lambda: check_updates_async(app, silent=True))
    except Exception as e:
        log_error("autocheck_updates_on_start", e)


