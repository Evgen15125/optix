class CTkToolTip:
    """Красивая всплывающая подсказка для customtkinter."""
    def __init__(self, widget, text, delay=500):
        # Если у виджета уже есть тултип — деактивируем его (убираем дубли)
        if hasattr(widget, "_optix_tooltip"):
            old_tt = getattr(widget, "_optix_tooltip")
            old_tt.active = False
            old_tt.hide()
            
        self.active = True
        self.widget = widget
        self.text = text
        self.delay = delay
        self.tooltip_window = None
        self.id = None
        self.widget._optix_tooltip = self
        
        self.widget.bind("<Enter>", self.schedule, add="+")
        self.widget.bind("<Leave>", self.hide, add="+")
        self.widget.bind("<ButtonPress>", self.hide, add="+")
        self.widget.bind("<MouseWheel>", self.hide, add="+")

    def schedule(self, event=None):
        if not getattr(self, "active", True):
            return
        self.unschedule()
        self.id = self.widget.after(self.delay, self.show)

    def unschedule(self):
        if self.id:
            self.widget.after_cancel(self.id)
            self.id = None

    def show(self, event=None):
        if not getattr(self, "active", True) or self.tooltip_window:
            return
            
        # Проверка, что виджет ещё существует
        if not self.widget.winfo_exists():
            return
            
        x = self.widget.winfo_rootx() + 20
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 5
        
        self.tooltip_window = tk.Toplevel(self.widget)
        self.tooltip_window.wm_overrideredirect(True)
        self.tooltip_window.configure(bg="#1A2A4A")
        self.tooltip_window.attributes("-topmost", True) # Поверх всех окон
        
        frame = tk.Frame(self.tooltip_window, bg="#4FC3F7", padx=1, pady=1)
        frame.pack()
        
        label = tk.Label(frame, text=self.text, justify='left',
                         background="#1A2A4A", foreground="#e0e8f5",
                         relief='flat', font=("Inter", 9),
                         padx=6, pady=4)
        label.pack()
        
        self.tooltip_window.update_idletasks() # Фикс размера
        
        # Проверка на выход за границы экрана
        screen_w = self.widget.winfo_screenwidth()
        screen_h = self.widget.winfo_screenheight()
        win_w = self.tooltip_window.winfo_width()
        win_h = self.tooltip_window.winfo_height()
        
        if x + win_w > screen_w:
            x = screen_w - win_w - 10
        if y + win_h > screen_h:
            y = self.widget.winfo_rooty() - win_h - 5
            
        self.tooltip_window.wm_geometry(f"+{x}+{y}")

    def hide(self, event=None):
        self.unschedule()
        if self.tooltip_window:
            self.tooltip_window.destroy()
            self.tooltip_window = None


# ─── Глобальная подмена CTkButton для тултипов ───
_original_ctk_button = ctk.CTkButton
class _OptixButton(_original_ctk_button):
    def __init__(self, *args, **kwargs):
        # Вытаскиваем кастомный тултип, если он передан
        tooltip_text = kwargs.pop("tooltip", None)
        super().__init__(*args, **kwargs)
        
        # Если тултип не задан явно — берем текст кнопки
        if tooltip_text is None:
            try:
                txt = self.cget("text")
                if txt and 0 < len(txt) < 40:
                    # Убираем эмодзи и лишние символы (используем глобальный re)
                    clean_txt = re.sub(r'[^\w\s\-\.,:;!?()]', '', txt).strip()
                    if clean_txt and len(clean_txt) > 2:
                        tooltip_text = clean_txt
            except Exception:
                pass
                
        if tooltip_text:
            # Задержка 600мс, чтобы тултип не выскакивал при каждом клике
            CTkToolTip(self, tooltip_text, delay=600)

ctk.CTkButton = _OptixButton

