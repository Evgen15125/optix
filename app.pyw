# ================== ОКНО: МЁРТВЫЕ ЯРЛЫКИ ==================
def _find_dead_shortcuts():
    dead = []
    search_dirs = [
        os.path.expandvars(r"%USERPROFILE%\Desktop"),
        os.path.expandvars(r"%PUBLIC%\Desktop"),
        os.path.expandvars(r"%APPDATA%\Microsoft\Windows\Start Menu\Programs"),
        os.path.expandvars(r"%PROGRAMDATA%\Microsoft\Windows\Start Menu\Programs"),
        os.path.expandvars(r"%APPDATA%\Microsoft\Internet Explorer\Quick Launch"),
    ]
    try:
        from win32com.client import Dispatch
    except Exception:
        return None
    for d in search_dirs:
        if not os.path.isdir(d):
            continue
        for r, _, files in os.walk(d):
            for f in files:
                if not f.lower().endswith(".lnk"):
                    continue
                fp = os.path.join(r, f)
                try:
                    shell = Dispatch("WScript.Shell")
                    shortcut = shell.CreateShortCut(fp)
                    target = shortcut.TargetPath
                    if target and not os.path.exists(target):
                        dead.append((fp, target))
                except Exception:
                    continue
    return dead


def open_dead_shortcuts_window():
    win = ctk.CTkToplevel(app)
    win.title("Мёртвые ярлыки")
    win.geometry("900x600")
    win.configure(fg_color="#0A1A30")
