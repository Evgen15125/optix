            selected = self._textbox.get("sel.first", "sel.last")
            if selected:
                self.clipboard_clear()
                self.clipboard_append(selected)
                self._textbox.delete("sel.first", "sel.last")
        except Exception:
            pass
        return "break"

    def _show_context_menu(self, event):
