# ================== ДОЛГОСРОЧНАЯ ИСТОРИЯ ТЕМПЕРАТУР ==================
TEMP_HISTORY_PATH = os.path.join(BASE_DIR, "temp_history.json")
TEMP_HISTORY_INTERVAL = 300      # секунд между сэмплами (5 мин)
TEMP_HISTORY_KEEP_DAYS = 30
_TEMP_HISTORY_STATE = {"started": False}


def _th_load():
    """Загружает список сэмплов: [[ts, cpu, gpu], ...]."""
    try:
        if not os.path.exists(TEMP_HISTORY_PATH):
            return []
        with open(TEMP_HISTORY_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        samples = data.get("samples", []) if isinstance(data, dict) else []
        cleaned = []
        for s in samples:
            if not isinstance(s, list) or len(s) < 1:
                continue
            try:
                ts = int(s[0])
                cpu = (float(s[1])
                       if len(s) > 1 and s[1] is not None else None)
                gpu = (float(s[2])
                       if len(s) > 2 and s[2] is not None else None)
                cleaned.append([ts, cpu, gpu])
            except Exception:
                continue
        return cleaned
    except Exception as e:
        log_error("_th_load", e)
        return []


def _th_save(samples):
    """Атомарно сохраняет сэмплы, обрезая старше KEEP_DAYS."""
    try:
        cutoff = int(time.time()) - TEMP_HISTORY_KEEP_DAYS * 86400
        samples = [s for s in samples if s and s[0] >= cutoff]
        tmp = TEMP_HISTORY_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({
                "version": 1,
                "updated":
                    datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "samples": samples,
            }, f, ensure_ascii=False)
        os.replace(tmp, TEMP_HISTORY_PATH)
        return True
    except Exception as e:
        log_error("_th_save", e)
        return False


def _th_worker():
    """Фоновый поток: каждые 5 минут пишет температуру."""
    samples = _th_load()
    while True:
        try:
            temps = _get_temperatures()
            cpu = temps.get("cpu")
            gpu = temps.get("gpu")
            if cpu is not None or gpu is not None:
                ts = int(time.time())
                if not samples or ts - samples[-1][0] >= 60:
                    samples.append([
                        ts,
                        round(float(cpu), 1) if cpu is not None else None,
                        round(float(gpu), 1) if gpu is not None else None,
                    ])
                    cutoff = ts - TEMP_HISTORY_KEEP_DAYS * 86400
                    samples[:] = [s for s in samples
                                   if s[0] >= cutoff]
                    _th_save(samples)
        except Exception as e:
            log_error("_th_worker", e)
        time.sleep(TEMP_HISTORY_INTERVAL)


def start_temp_history_worker():
    """Запускает фоновую запись температур (один раз)."""
    if _TEMP_HISTORY_STATE.get("started"):
        return
    _TEMP_HISTORY_STATE["started"] = True
    t = threading.Thread(target=_th_worker, daemon=True)
    t.start()


def _th_aggregate(samples, bucket_sec):
    """Группирует сэмплы по bucket_sec и усредняет."""
    from collections import defaultdict
    buckets = defaultdict(lambda: {"cpu": [], "gpu": [], "ts": 0})
    for s in samples:
        if not s:
            continue
        ts = s[0]
        bucket_ts = ts - (ts % bucket_sec)
        b = buckets[bucket_ts]
        b["ts"] = bucket_ts
        if len(s) > 1 and s[1] is not None:
            b["cpu"].append(s[1])
        if len(s) > 2 and s[2] is not None:
            b["gpu"].append(s[2])
    out = []
    for ts in sorted(buckets.keys()):
        b = buckets[ts]
        cpu = b["cpu"]
        gpu = b["gpu"]
        out.append({
            "ts": ts,
            "cpu_avg": sum(cpu) / len(cpu) if cpu else None,
            "gpu_avg": sum(gpu) / len(gpu) if gpu else None,
            "cpu_max": max(cpu) if cpu else None,
            "gpu_max": max(gpu) if gpu else None,
            "count": len(cpu) + len(gpu),
        })
    return out


def _th_stats(samples, threshold=85):
    """Статистика по сэмплам."""
    cpu_vals = [s[1] for s in samples
                 if len(s) > 1 and s[1] is not None]
    gpu_vals = [s[2] for s in samples
                 if len(s) > 2 and s[2] is not None]

    def _stat(vals):
        if not vals:
            return {"min": None, "avg": None, "max": None, "n": 0}
        return {
            "min": round(min(vals), 1),
            "avg": round(sum(vals) / len(vals), 1),
            "max": round(max(vals), 1),
            "n": len(vals),
        }

    overheats = 0
    for s in samples:
        cpu = s[1] if len(s) > 1 else None
        gpu = s[2] if len(s) > 2 else None
        if (cpu is not None and cpu > threshold) or \
           (gpu is not None and gpu > threshold):
            overheats += 1
    return {
        "cpu": _stat(cpu_vals),
        "gpu": _stat(gpu_vals),
        "overheats": overheats,
        "total": len(samples),
    }


def _th_top_hottest(samples, n=5):
    """Топ-N самых горячих моментов."""
    entries = []
    for s in samples:
        cpu = s[1] if len(s) > 1 else None
        gpu = s[2] if len(s) > 2 else None
        peak = max([v for v in (cpu, gpu) if v is not None],
                    default=None)
        if peak is not None:
            entries.append({
                "ts": s[0], "cpu": cpu, "gpu": gpu, "peak": peak,
            })
    entries.sort(key=lambda x: -x["peak"])
    return entries[:n]


def _th_draw_graph(canvas, samples):
    """Рисует график CPU/GPU на canvas."""
    canvas.delete("all")
    try:
        w = canvas.winfo_width() or 900
        h = canvas.winfo_height() or 320
    except Exception:
        w, h = 900, 320
    if w < 50 or h < 50:
        w, h = 900, 320
    canvas.create_rectangle(0, 0, w, h, fill="#0D1B33", outline="")

    if not samples:
        canvas.create_text(w // 2, h // 2,
                            text="Нет данных за выбранный период",
                            fill="#90A4AE", font=("Arial", 12))
        return

    t_min = samples[0]["ts"]
    t_max = samples[-1]["ts"]
    if t_max <= t_min:
        t_max = t_min + 60
    temp_min = 20
    temp_max = 100

    pad_l, pad_r, pad_t, pad_b = 46, 16, 14, 32
    gw = w - pad_l - pad_r
    gh = h - pad_t - pad_b

    for tv in (30, 40, 50, 60, 70, 80, 90):
        y = pad_t + gh - ((tv - temp_min) / (temp_max - temp_min)) * gh
        col = "#455A64"
        dash = (2, 4)
        if tv == 85:
            col = "#FF8A8A"
            dash = None
        canvas.create_line(pad_l, y, w - pad_r, y,
                            fill=col, dash=dash)
        canvas.create_text(pad_l - 4, y, text=f"{tv}",
                            fill="#90A4AE", font=("Consolas", 8),
                            anchor="e")
    canvas.create_line(pad_l, pad_t, pad_l, pad_t + gh,
                        fill="#455A64")
    canvas.create_line(pad_l, pad_t + gh, w - pad_r, pad_t + gh,
                        fill="#455A64")

    def _x(ts):
        return pad_l + ((ts - t_min) / (t_max - t_min)) * gw

    def _y(t):
        t = max(temp_min, min(temp_max, t))
        return pad_t + gh - ((t - temp_min) /
                              (temp_max - temp_min)) * gh

    pts_cpu = [(x["ts"], x["cpu_avg"]) for x in samples
                if x.get("cpu_avg") is not None]
    pts_gpu = [(x["ts"], x["gpu_avg"]) for x in samples
                if x.get("gpu_avg") is not None]

    if len(pts_cpu) >= 2:
        coords = []
        for ts, v in pts_cpu:
            coords.extend([_x(ts), _y(v)])
        canvas.create_line(*coords, fill="#FF8A8A", width=2)
    if len(pts_gpu) >= 2:
        coords = []
        for ts, v in pts_gpu:
            coords.extend([_x(ts), _y(v)])
        canvas.create_line(*coords, fill="#FFB74D", width=2)

    if t_max > t_min:
        n_labels = 5
        for i in range(n_labels):
            ts_lbl = t_min + (t_max - t_min) * i / (n_labels - 1)
            x = _x(ts_lbl)
            try:
                lbl = datetime.fromtimestamp(ts_lbl) \
                              .strftime("%d.%m %H:%M")
            except Exception:
                lbl = "?"
            canvas.create_text(x, pad_t + gh + 14, text=lbl,
                                fill="#90A4AE",
                                font=("Consolas", 8))

    canvas.create_line(pad_l + 10, pad_t + 8,
                        pad_l + 30, pad_t + 8,
                        fill="#FF8A8A", width=3)
    canvas.create_text(pad_l + 36, pad_t + 8, text="CPU",
                        fill="#FF8A8A", font=("Arial", 9, "bold"),
                        anchor="w")
    canvas.create_line(pad_l + 90, pad_t + 8,
                        pad_l + 110, pad_t + 8,
                        fill="#FFB74D", width=3)
    canvas.create_text(pad_l + 116, pad_t + 8, text="GPU",
                        fill="#FFB74D", font=("Arial", 9, "bold"),
                        anchor="w")


def open_temp_history_window():
    """Окно с долгосрочной историей температур."""
    win = ctk.CTkToplevel(app)
    win.title("🌡 История температур")
