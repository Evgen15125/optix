    log_box = ctk.CTkTextbox(log_wrap, height=180, font=("Consolas", 11), fg_color="#0D1B33", text_color="#e0e8f5", corner_radius=8)
    log_box.pack(fill="x", padx=14, pady=(0, 14))
    log_box.insert("1.0", "Ожидание запуска сценария...\n")
    log_box.configure(state="disabled")

    scenarios = [
        ("full", "🌟 Полное обслуживание", "Очистка Temp + Оптимизация (Питание, Телеметрия) + Отчёт", "#2E7D32", "#43A047"),
        ("gaming", "🎮 Игровой буст", "Очистка кэша GPU + Высокая производительность + Отключение GameBar", "#1565C0", "#42A5F5"),
        ("diag", "🩺 Быстрая диагностика", "Проверка SFC + Сбор и сохранение текстового отчёта", "#7B1FA2", "#9C27B0"),
    ]

    def start_scenario(sid):
        progress.set(0)
        log_box.configure(state="normal")
        log_box.delete("1.0", "end")
        log_box.configure(state="disabled")
        status_lbl.configure(text="⏳ Выполняется...", text_color="#FFD54F")
        threading.Thread(target=_run_scenario_logic, args=(sid, log_box, progress, status_lbl), daemon=True).start()

    for sid, title, desc, color, hover in scenarios:
        card = ctk.CTkFrame(f, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
        card.pack(fill="x", padx=15, pady=6)
        
        def on_enter(e, c=card): c.configure(border_color="#4FC3F7")
        def on_leave(e, c=card): c.configure(border_color="#2A3B5C")
        
        card.bind("<Enter>", on_enter)
        card.bind("<Leave>", on_leave)

        top_frame = ctk.CTkFrame(card, fg_color="transparent")
        top_frame.pack(fill="x", padx=14, pady=(14, 4))
        
        ctk.CTkLabel(top_frame, text=title, font=("Inter", 16, "bold"), text_color="#ffffff", anchor="w").pack(side="left")
        ctk.CTkLabel(top_frame, text=desc, font=("Inter", 11), text_color="#B0BEC5", anchor="w").pack(side="left", padx=12)
        
        btn = ctk.CTkButton(card, text="▶ Запустить сценарий", height=38, font=("Inter", 13, "bold"),
                            fg_color=color, hover_color=hover, corner_radius=19,
                            command=lambda s=sid: start_scenario(s))
        btn.pack(fill="x", padx=14, pady=(0, 14))
        CTkToolTip(btn, f"Запустить: {title}")

        def bind_hover(w):
            if isinstance(w, ctk.CTkButton): return
            w.bind("<Enter>", on_enter, add="+")
            w.bind("<Leave>", on_leave, add="+")
            for child in w.winfo_children(): bind_hover(child)
        bind_hover(card)

    def _forward_scroll(widget):
        if isinstance(widget, ctk.CTkTextbox):
            def _on_mousewheel(event):
                f._parent_canvas.yview_scroll(int(-1*(event.delta/120)), "units")
                return "break"
            widget._textbox.bind("<MouseWheel>", _on_mousewheel)
        for child in widget.winfo_children():
            _forward_scroll(child)
    _forward_scroll(f)

    return wrapper


# ================== СТРАНИЦА СЕТЬ ==================
_button_pulse_state = {}

def _start_button_pulse(btn, base_color, pulse_color="#ffffff"):
    """Запускает пульсацию кнопки (меняет цвет), пока идет процесс."""
    if btn in _button_pulse_state:
        return
    _button_pulse_state[btn] = {"active": True, "step": 0, "base": base_color, "pulse": pulse_color}
    
    def _pulse():
        state = _button_pulse_state.get(btn)
        if not state or not state["active"] or not btn.winfo_exists():
            return
        colors = [state["base"], state["pulse"]]
        idx = state["step"] % 2
        try:
            btn.configure(fg_color=colors[idx])
        except Exception:
            pass
        state["step"] += 1
        app.after(400, _pulse)
    _pulse()

def _stop_button_pulse(btn):
    """Останавливает пульсацию и возвращает исходный цвет."""
    state = _button_pulse_state.pop(btn, None)
    if state:
        try:
            btn.configure(fg_color=state["base"])
        except Exception:
            pass


