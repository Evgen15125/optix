                    checkbox_width=20, checkbox_height=20,
                    corner_radius=5).pack(anchor="w", padx=30, pady=4)

    del_dir_var = ctk.IntVar(value=1 if has_dir else 0)
    del_dir_chk = ctk.CTkCheckBox(
        dlg,
        text=f"📁  Папка программы: {install_loc[:70] if install_loc else '(не найдена)'}",
        variable=del_dir_var,
        font=("Inter", 12), text_color="#ffffff" if has_dir else "#90A4AE",
        fg_color="#43A047", hover_color="#66BB6A",
        checkbox_width=20, checkbox_height=20,
        corner_radius=5)
    del_dir_chk.pack(anchor="w", padx=30, pady=4)
    if not has_dir:
        del_dir_chk.configure(state="disabled")

    del_short_var = ctk.IntVar(value=1)
    ctk.CTkCheckBox(
        dlg,
        text="🔗  Ярлыки в меню Пуск / на рабочем столе (по имени)",
        variable=del_short_var,
        font=("Inter", 12), text_color="#ffffff",
        fg_color="#43A047", hover_color="#66BB6A",
        checkbox_width=20, checkbox_height=20,
        corner_radius=5).pack(anchor="w", padx=30, pady=4)

    ctk.CTkLabel(dlg,
                 text="Перед удалением ключ реестра автоматически "
                      "сохраняется в D:\\Optix\\uninstall_backup\\",
                 font=("Inter", 11), text_color="#90A4AE",
                 wraplength=640).pack(anchor="w", padx=30, pady=(12, 0))

    def do_delete():
        if not messagebox.askyesno(
            "Подтверждение",
            f"ТОЧНО удалить запись о программе?\n\n{prog['name']}"):
            return

        results = {"reg": False, "dir": False, "shortcuts": 0,
                   "errors": [], "backup": ""}

        # ─── Бэкап реестра ───
        try:
            backup_dir = os.path.join(BASE_DIR, "uninstall_backup")
            os.makedirs(backup_dir, exist_ok=True)
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            safe = "".join(c if c.isalnum() else "_"
                            for c in prog["name"])[:50]
            reg_file = os.path.join(
                backup_dir, f"force_del_{safe}_{ts}.reg")
            hive = "HKLM" if reg_root == winreg.HKEY_LOCAL_MACHINE \
                else "HKCU"
            full_path = f"{hive}\\{reg_path}\\{reg_subkey}"
            r = subprocess.run(
                ["reg", "export", full_path, reg_file, "/y"],
                capture_output=True, timeout=30,
                creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                results["backup"] = reg_file
        except Exception as e:
            results["errors"].append(f"backup: {e}")

        # ─── Удаление ключа реестра ───
        try:
            winreg.DeleteKey(reg_root, reg_path + "\\" + reg_subkey)
            results["reg"] = True
        except Exception:
            try:
                _cm_delete_tree(reg_root, reg_path + "\\" + reg_subkey)
                results["reg"] = True
            except Exception as e2:
                results["errors"].append(f"reg: {e2}")

        # ─── Удаление папки ───
        if del_dir_var.get() == 1 and has_dir:
            try:
                shutil.rmtree(install_loc, ignore_errors=False)
                results["dir"] = True
            except Exception as e:
                results["errors"].append(f"dir: {e}")

        # ─── Удаление ярлыков ───
        if del_short_var.get() == 1:
            shortcuts_dirs = [
                os.path.expandvars(r"%USERPROFILE%\Desktop"),
                os.path.expandvars(r"%PUBLIC%\Desktop"),
                os.path.expandvars(
                    r"%APPDATA%\Microsoft\Windows\Start Menu\Programs"),
                os.path.expandvars(
                    r"%PROGRAMDATA%\Microsoft\Windows\Start Menu\Programs"),
            ]
            target_norm = _normalize_name(prog["name"])
            count = 0
            for base in shortcuts_dirs:
                if not os.path.isdir(base):
                    continue
                for root_, dirs_, files_ in os.walk(base):
                    for f in files_:
                        if not f.lower().endswith(".lnk"):
                            continue
                        base_name = os.path.splitext(f)[0]
                        lvl = _match_level(base_name, target_norm)
                        if lvl in ("exact", "partial"):
                            try:
                                os.remove(os.path.join(root_, f))
                                count += 1
                            except Exception:
                                pass
            results["shortcuts"] = count

        dlg.destroy()

        # ─── Итог ───
        lines = ["=" * 60,
                 "  ПРИНУДИТЕЛЬНОЕ УДАЛЕНИЕ",
                 "=" * 60, ""]
        lines.append(f"Программа: {prog['name']}")
        lines.append("")
        lines.append(f"Реестр:  "
                     f"{'✅ ключ удалён' if results['reg'] else '❌ ошибка'}")
        if results["backup"]:
            lines.append(f"Бэкап:   {results['backup']}")
        if del_dir_var.get() == 1 and has_dir:
            lines.append(f"Папка:   "
                         f"{'✅ удалена' if results['dir'] else '❌ ошибка'}")
        if results["shortcuts"] > 0:
            lines.append(f"Ярлыков: {results['shortcuts']} удалено")
        if results["errors"]:
            lines.append("")
            lines.append("Ошибки:")
            for e in results["errors"]:
                lines.append(f"  • {e}")

        show_output_dialog("Результат удаления", "\n".join(lines))

        try:
            load_programs_async()
        except Exception:
            pass

