def clear_error_log():
    """Очищает содержимое лога ошибок, не удаляя сам файл."""
    if not os.path.exists(ERRORS_LOG):
        messagebox.showinfo("Лог ошибок", "Файла нет — очищать нечего.")
        return
    try:
        size_before = os.path.getsize(ERRORS_LOG)
        if size_before == 0:
            messagebox.showinfo("Лог ошибок", "Файл уже пустой.")
            return
        if not messagebox.askyesno(
            "Очистить лог?",
            f"Размер: {human_size(size_before)}\n\n"
            f"Всё содержимое будет удалено. Файл останется пустым."):
            return
        with open(ERRORS_LOG, "w", encoding="utf-8") as f:
            f.write("")
        messagebox.showinfo("Готово",
            f"Лог очищен. Было: {human_size(size_before)}")
    except Exception as e:
        log_error("clear_error_log", e)
        messagebox.showerror("Ошибка", str(e))


