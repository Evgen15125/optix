    ctk.CTkLabel(header_frame, text=f"📋  {task_name or task_full}", font=("Inter", 18, "bold"), text_color="#ffffff").pack(pady=8, padx=15)
    
    ctk.CTkLabel(win, text=task_full, font=("Consolas", 11), text_color="#90CAF9").pack(pady=(0, 8))

