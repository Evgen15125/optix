_dashboard_state = {
    "active": False, 
    "last_update": 0,
    "prev_ram": 0,
    "prev_disk_used": 0,
    "prev_cpu_temp": None,
    "prev_gpu_temp": None,
    "first_load_done": False,
}


def _ease_out(t):
    """Функция плавности (ускорение в начале, замедление в конце)."""
    return 1 - (1 - t) ** 3


def _animate_value(label, start, end, color, duration=600, suffix="", decimals=0):
    """Плавная анимация числового значения (count-up)."""
    if not label or not label.winfo_exists():
        return
    steps = 24
    step_time = max(15, duration // steps)
    
    def step(i):
        if not label.winfo_exists():
            return
        t = _ease_out(i / steps)
        current = start + (end - start) * t
        try:
            if decimals > 0:
                text = f"{current:.{decimals}f}{suffix}"
            else:
                text = f"{int(round(current))}{suffix}"
            label.configure(text=text, text_color=color)
        except Exception:
            return
        if i < steps:
            app.after(step_time, step, i+1)
    
    step(0)


def _animate_bar(bar, start, end, duration=600):
    """Плавная анимация прогресс-бара."""
    if not bar or not bar.winfo_exists():
        return
    steps = 24
    step_time = max(15, duration // steps)
    
    def step(i):
        if not bar.winfo_exists():
            return
        t = _ease_out(i / steps)
        current = start + (end - start) * t
        try:
            bar.set(max(0.0, min(1.0, current)))
        except Exception:
            return
        if i < steps:
            app.after(step_time, step, i+1)
    
    step(0)

def _update_dashboard():
    """Обновляет данные на дашборде с плавной анимацией."""
    if not _dashboard_state["active"]:
        return
    try:
        import psutil
        first = not _dashboard_state["first_load_done"]
        
        # ─── 1. RAM ───
        ram = psutil.virtual_memory()
        if "dash_ram_bar" in widgets:
            new_val = ram.percent / 100
            ram_color = "#7CFC7C" if ram.percent < 60 else ("#FFD54F" if ram.percent < 85 else "#FF8A8A")
            
            prev = 0 if first else _dashboard_state["prev_ram"]
            
            if first or abs(new_val - prev) > 0.005:
                _animate_bar(widgets["dash_ram_bar"], prev, new_val)
                _animate_value(widgets["dash_ram_pct"], prev * 100, ram.percent, ram_color, suffix="%")
            
            widgets["dash_ram_gb"].configure(text=f"{ram.used / (1024**3):.1f} / {ram.total / (1024**3):.1f} ГБ")
            _dashboard_state["prev_ram"] = new_val
        
        # ─── 2. Диск ───
        for part in psutil.disk_partitions(all=False):
            if part.mountpoint == "C:\\":
                try:
                    u = psutil.disk_usage(part.mountpoint)
                    free_pct = 100 - u.percent
                    d_color = "#7CFC7C" if free_pct > 20 else ("#FFD54F" if free_pct > 10 else "#FF8A8A")
                    
                    if "dash_disk_bar" in widgets:
                        new_val = u.percent / 100
                        prev = 0 if first else _dashboard_state["prev_disk_used"]
                        
                        if first or abs(new_val - prev) > 0.005:
                            _animate_bar(widgets["dash_disk_bar"], prev, new_val)
                        
                        free_gb = u.free / (1024**3)
                        if first:
                            prev_free_gb = 0
                        else:
                            prev_free_gb = (1 - _dashboard_state["prev_disk_used"]) * (u.total / (1024**3))
                        
                        _animate_value(widgets["dash_disk_free"], prev_free_gb, free_gb, d_color,
                                       decimals=1, suffix=" ГБ")
                        
                        widgets["dash_disk_total"].configure(text=f"свободно из {human_size(u.total)}")
                        _dashboard_state["prev_disk_used"] = new_val
                    break
                except Exception:
                    pass
        
        # ─── 3. Температуры ───
        temps = get_cached_temperatures()
        if "dash_temp_cpu" in widgets:
            t_cpu = temps.get("cpu")
            t_gpu = temps.get("gpu")
            
            if t_cpu:
                c_color = "#FF8A8A" if t_cpu > 85 else "#ffffff"
                prev_cpu = 0 if (first or _dashboard_state["prev_cpu_temp"] is None) else _dashboard_state["prev_cpu_temp"]
                if first or abs(t_cpu - prev_cpu) > 0.5:
                    _animate_value(widgets["dash_temp_cpu"], prev_cpu, t_cpu, c_color, suffix="°C")
                _dashboard_state["prev_cpu_temp"] = t_cpu
            else:
                widgets["dash_temp_cpu"].configure(text="—°C")
                
            if t_gpu:
                g_color = "#FF8A8A" if t_gpu > 85 else "#ffffff"
                prev_gpu = 0 if (first or _dashboard_state["prev_gpu_temp"] is None) else _dashboard_state["prev_gpu_temp"]
                if first or abs(t_gpu - prev_gpu) > 0.5:
                    _animate_value(widgets["dash_temp_gpu"], prev_gpu, t_gpu, g_color, suffix="°C")
                _dashboard_state["prev_gpu_temp"] = t_gpu
            else:
                widgets["dash_temp_gpu"].configure(text="—°C")
        
        _dashboard_state["first_load_done"] = True
                
    except Exception as e:
        log_error("_update_dashboard", e)

    app.after(5000, _update_dashboard)


def _dashboard_quick_clean():
    """Быстрая очистка прямо с дашборда."""
    if "dash_clean_btn" in widgets:
        widgets["dash_clean_btn"].configure(state="disabled", text="⏳ Очистка...")
    
    def worker():
        total = 0
        for cat in CATEGORIES:
            if cat["group"] != "warn" and "Временные файлы" in cat["name"]:
                try:
                    f_, _, _ = clean_category(cat)
                    total += f_
                except Exception:
                    pass
        
        def finish():
            if "dash_clean_btn" in widgets:
                widgets["dash_clean_btn"].configure(state="normal", text="⚡ Быстрая очистка")
            if "dash_clean_label" in widgets:
                color = "#7CFC7C" if total > 0 else "#90A4AE"
                text_msg = f"✅ Освобождено: {human_size(total)}" if total > 0 else "✨ Уже чисто!"
                widgets["dash_clean_label"].configure(text=text_msg, text_color=color)
            try:
                show_toast("Optix — Быстрая очистка", f"Освобождено: {human_size(total)}")
            except Exception:
                pass
            _update_dashboard()
            
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def _dashboard_empty_trash():
    """Безопасная очистка корзины прямо с Дашборда."""
    if not messagebox.askyesno("Очистить Корзину?", "Вы уверены, что хотите безвозвратно удалить все файлы из Корзины?"):
        return
        
    def worker():
        try:
            size = recycle_bin_size()
            if size < 0:
                size = 0
            
            # Очищаем корзину (1 | 2 | 4 = без подтверждения, без прогресс-бара, без звука)
            ctypes.windll.shell32.SHEmptyRecycleBinW(None, None, 1 | 2 | 4)
            
            def finish():
                try:
                    show_toast("Optix — Корзина", f"Освобождено: {human_size(size)}")
                except Exception:
                    pass
                _update_dashboard() # Обновляем цифры на дашборде
            app.after(0, finish)
        except Exception as e:
            log_error("_dashboard_empty_trash", e)
            
    threading.Thread(target=worker, daemon=True).start()


