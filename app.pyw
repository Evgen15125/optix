def _iw_delete_by_traces(sdir):
    """Удаляет всё, что было найдено в сессии (по следам)."""
    diff_path = os.path.join(sdir, "diff.json")
    if not os.path.exists(diff_path):
        messagebox.showerror("Ошибка",
                              "Файл diff.json не найден в сессии.")
        return
    try:
        with open(diff_path, "r", encoding="utf-8") as f:
            diff = json.load(f)
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))
        return

    n_reg = len(diff.get("new_registry", []))
    n_dirs = len(diff.get("new_dirs", []))
    n_files = len(diff.get("new_files", []))

    if not messagebox.askyesno(
        "Удалить следы программы?",
        f"Будет удалено:\n\n"
        f"  • Ключей реестра: {n_reg}\n"
        f"  • Папок: {n_dirs}\n"
        f"  • Файлов: {n_files}\n\n"
        f"⚠️ Это НЕОБРАТИМО! Перед удалением будет сделан "
        f"бэкап реестра.\n\n"
        f"Продолжить?"):
        return
    if not messagebox.askyesno("Подтверждение",
                                "ТОЧНО удалить все следы?"):
        return

    # Бэкап реестра через reg export
    try:
        os.makedirs(os.path.join(BASE_DIR, "uninstall_backup"),
                     exist_ok=True)
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_reg = os.path.join(
            BASE_DIR, "uninstall_backup",
            f"traces_{os.path.basename(sdir)}_{ts}.reg")

        # Экспортируем по одному ключу (reg export не умеет несколько)
        # Собираем во временный список, но не более 200 ключей (защита)
        exported = 0
        for full in diff.get("new_registry", [])[:200]:
            if "|" not in full:
                continue
            hive, path = full.split("|", 1)
            try:
                subprocess.run(
                    ["reg", "export",
                     f"{hive}\\{path}",
                     backup_reg.replace(".reg",
                                         f"_{exported}.reg"),
                     "/y"],
                    capture_output=True, timeout=10,
                    creationflags=CREATE_NO_WINDOW)
                exported += 1
            except Exception:
                pass
    except Exception as e:
        log_error("_iw_backup_reg", e)

    # Удаляем реестр
    reg_deleted = 0
    reg_failed = 0
    # Сортируем по глубине (глубже — раньше) для корректного удаления
    reg_sorted = sorted(diff.get("new_registry", []),
                         key=lambda p: -p.count("\\"))
    for full in reg_sorted:
        if "|" not in full:
            continue
        hive, path = full.split("|", 1)
        root = winreg.HKEY_LOCAL_MACHINE if hive == "HKLM" \
            else winreg.HKEY_CURRENT_USER
        try:
            winreg.DeleteKey(root, path)
            reg_deleted += 1
        except FileNotFoundError:
            continue
        except OSError:
            # Возможно, есть подключи — пропускаем
            reg_failed += 1
        except Exception:
            reg_failed += 1

    # Удаляем файлы (глубже — раньше)
    fs_deleted = 0
    fs_failed = 0
    files_sorted = sorted(diff.get("new_files", []),
                           key=lambda p: -p.count(os.sep))
    for p in files_sorted:
        try:
            if os.path.exists(p):
                try:
                    os.remove(p)
                    fs_deleted += 1
                except Exception:
                    fs_failed += 1
        except Exception:
            pass

    # Удаляем пустые папки
    dirs_sorted = sorted(diff.get("new_dirs", []),
                          key=lambda p: -p.count(os.sep))
    for p in dirs_sorted:
        try:
            if os.path.isdir(p):
                try:
                    os.rmdir(p)
                    fs_deleted += 1
                except OSError:
                    # Папка не пуста — оставляем
                    pass
        except Exception:
            pass

    messagebox.showinfo(
        "Готово",
        f"Удалено:\n"
        f"  • Ключей реестра: {reg_deleted} "
        f"(ошибок: {reg_failed})\n"
        f"  • Файлов и папок: {fs_deleted} "
        f"(пропущено занятых: {fs_failed})\n\n"
        f"Бэкап реестра: {os.path.dirname(backup_reg)}")


def _iw_start_session():
    """Диалог запуска новой сессии наблюдения."""
    dlg = ctk.CTkToplevel(app)
    dlg.title("📸 Начать наблюдение")
    dlg.geometry("560x360")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="📸  Наблюдение за установкой",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)

    ctk.CTkLabel(dlg,
                 text="Optix сделает снимок реестра и файловой системы "
                      "ДО установки.\n"
                      "Затем вы установите программу как обычно, "
                      "и Optix увидит все её следы.",
                 font=("Inter", 11), text_color="#B0BEC5",
                 justify="center", wraplength=500).pack(pady=(0, 10),
                                                         padx=20)

    ctk.CTkLabel(dlg, text="Название сессии:",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF", anchor="w").pack(
        fill="x", padx=30, pady=(4, 2))
    name_entry = ctk.CTkEntry(dlg, height=34, font=("Arial", 12),
                                fg_color="#1A2A4A",
                                text_color="#ffffff")
    name_entry.pack(fill="x", padx=30, pady=(0, 10))
    name_entry.insert(0, f"Наблюдение {datetime.now().strftime('%Y-%m-%d %H-%M')}")

    status_lbl = ctk.CTkLabel(dlg, text="",
                              font=("Inter", 11),
                              text_color="#90CAF9",
                              fg_color="#0D47A1",
                              corner_radius=8, height=24)
    status_lbl.pack(fill="x", padx=30, pady=(0, 8))

    def do_start():
        name = name_entry.get().strip()
        if not name:
            messagebox.showerror("Ошибка", "Введите название.")
            return
        # Безопасное имя папки
        safe = "".join(c if c.isalnum() or c in " -_"
                        else "_" for c in name)[:60]
        ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        session_dir = os.path.join(IW_SESSIONS_DIR, f"{ts}_{safe}")

        status_lbl.configure(text="⏳ Снимок реестра...",
                              text_color="#FFD54F")
        dlg.update()

        def worker():
            try:
                if not _iw_ensure_dir():
                    raise RuntimeError("Не создать папку сессий")
                os.makedirs(session_dir, exist_ok=True)

                def prog(msg):
                    try:
                        app.after(0, lambda m=msg: status_lbl.configure(
                            text=f"⏳ {m[:60]}", text_color="#FFD54F"))
                    except Exception:
                        pass

                reg = _iw_scan_registry(prog)
                app.after(0, lambda: status_lbl.configure(
                    text=f"✅ Реестр: {len(reg)} ключей. Файлы...",
                    text_color="#FFD54F"))
                fs = _iw_scan_filesystem(prog)

                _iw_save_snapshot(session_dir, reg, fs)
                meta = {
                    "name": name,
                    "started_at": datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"),
                    "finished_at": None,
                    "registry_keys": len(reg),
                    "filesystem_entries": len(fs),
                    "state": "watching",
                }
                _iw_save_meta(session_dir, meta)

                def finish():
                    status_lbl.configure(
                        text=f"✅ Готово. Реестр: {len(reg)}, "
                             f"файлов: {len(fs)}",
                        text_color="#7CFC7C")
                    messagebox.showinfo(
                        "Наблюдение активно",
                        f"Снимок сделан:\n\n"
                        f"  • Ключей реестра: {len(reg)}\n"
                        f"  • Файлов и папок: {len(fs)}\n\n"
                        f"Теперь установите программу и нажмите "
                        f"«⏹ Остановить».")
                    dlg.destroy()
                    refresh_programs_ui()
                app.after(0, finish)
            except Exception as e:
                log_error("_iw_start_worker", e)
                app.after(0, lambda: messagebox.showerror(
                    "Ошибка", str(e)))
        threading.Thread(target=worker, daemon=True).start()

    br = ctk.CTkFrame(dlg, fg_color="transparent")
    br.pack(pady=(6, 14), padx=30, fill="x")
    ctk.CTkButton(br, text="📸 Начать", height=40,
                  font=("Inter", 14, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=20,
                  command=do_start).pack(side="left", padx=(0, 4),
                                          fill="x", expand=True)
    ctk.CTkButton(br, text="Отмена", height=40,
                  font=("Inter", 14, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=20,
                  command=dlg.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


def _iw_stop_session(session):
    """Останавливает наблюдение и делает diff."""
    sdir = session["_dir"]
    if not messagebox.askyesno(
        "⏹ Остановить наблюдение?",
        f"Сессия: {session.get('name', '?')}\n\n"
        f"Optix сделает второй снимок системы и сравнит его "
        f"с первым.\n\n"
        f"Убедитесь, что установка программы полностью завершена "
        f"(включая закрытие окна мастера).\n\n"
        f"Продолжить?"):
        return

    win = ctk.CTkToplevel(app)
    win.title("⏹ Остановка наблюдения")
    win.geometry("560x240")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    win.grab_set()
    ctk.CTkLabel(win, text="⏹  Остановка наблюдения",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)
    status_lbl = ctk.CTkLabel(win, text="⏳ Снимок реестра...",
                              font=("Arial", 11, "bold"),
                              text_color="#FFD54F", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(fill="x", padx=20, pady=(0, 10))

    def worker():
        try:
            def prog(msg):
                try:
                    app.after(0, lambda m=msg: status_lbl.configure(
                        text=f"⏳ {m[:60]}", text_color="#FFD54F"))
                except Exception:
                    pass

            reg_after = _iw_scan_registry(prog)
            app.after(0, lambda: status_lbl.configure(
                text=f"✅ Реестр: {len(reg_after)}. Файлы...",
                text_color="#FFD54F"))
            fs_after = _iw_scan_filesystem(prog)

            # Загружаем старые снимки
            reg_before = _iw_load_snapshot(sdir, "registry.json") or []
            fs_before = _iw_load_snapshot(sdir, "filesystem.json") or {}

            # Diff
            diff = _iw_diff(reg_before, reg_after, fs_before, fs_after)

            # Сохраняем «after»
            _iw_save_snapshot(
                os.path.join(sdir, "after"), reg_after, fs_after)
            # Сохраняем diff
            try:
                with open(os.path.join(sdir, "diff.json"),
                          "w", encoding="utf-8") as f:
                    json.dump(diff, f, ensure_ascii=False, indent=2)
            except Exception as e:
                log_error("_iw_save_diff", e)

            # Обновляем meta
            try:
                with open(os.path.join(sdir, "meta.json"),
                          "r", encoding="utf-8") as f:
                    meta = json.load(f)
            except Exception:
                meta = {}
            meta["finished_at"] = datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S")
            meta["state"] = "done"
            meta["new_registry_count"] = len(diff["new_registry"])
            meta["new_dirs_count"] = len(diff["new_dirs"])
            meta["new_files_count"] = len(diff["new_files"])
            meta["modified_count"] = len(diff["modified_files"])
            _iw_save_meta(sdir, meta)

            def finish():
                try:
                    win.grab_release()
                    win.destroy()
                except Exception:
                    pass
                _iw_show_diff_window(session, diff)
                refresh_programs_ui()
            app.after(0, finish)
        except Exception as e:
            log_error("_iw_stop_worker", e)
            app.after(0, lambda: (
                messagebox.showerror("Ошибка", str(e)),
                win.destroy()
            ))
    threading.Thread(target=worker, daemon=True).start()


def _iw_show_diff_window(session, diff):
    """Показывает окно с результатами diff."""
    win = ctk.CTkToplevel(app)
    win.title(f"📊 Следы: {session.get('name', '?')}")
    win.geometry("1000x720")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text=f"📊  Следы: {session.get('name', '?')}",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)

    n_reg = len(diff["new_registry"])
    n_dirs = len(diff["new_dirs"])
    n_files = len(diff["new_files"])
    n_mod = len(diff["modified_files"])
    total = n_reg + n_dirs + n_files
    noise = diff.get("filtered_noise", 0) + \
        diff.get("filtered_registry", 0)

    ctk.CTkLabel(win,
                 text=f"Новых ключей реестра: {n_reg}   •   "
                      f"Новых папок: {n_dirs}   •   "
                      f"Новых файлов: {n_files}   •   "
                      f"Изменено: {n_mod}",
                 font=("Inter", 13, "bold"),
                 text_color="#7CFC7C" if total > 0 else "#FFD54F").pack(
        pady=(0, 4))

    if total == 0 and noise > 0:
        ctk.CTkLabel(win,
                     text=f"ℹ️  Отфильтровано {noise} фоновых изменений "
                          f"(кэши браузеров, логи, temp — это не следы "
                          f"программ)",
                     font=("Inter", 11),
                     text_color="#90A4AE").pack(pady=(0, 8))
    elif noise > 0:
        ctk.CTkLabel(win,
                     text=f"ℹ️  + отфильтровано {noise} фоновых "
                          f"изменений",
                     font=("Inter", 11),
                     text_color="#90A4AE").pack(pady=(0, 8))

    tabs = ctk.CTkTabview(win, fg_color="#0A1A30",
                            segmented_button_selected_color="#1565C0",
                            segmented_button_unselected_color="#1A2A4A")
    tabs.pack(fill="both", expand=True, padx=20, pady=(0, 10))

    def fill_tab(tab, title, items, color="#4FC3F7"):
        ctk.CTkLabel(tab, text=f"{title} ({len(items)})",
                     font=("Inter", 13, "bold"),
                     text_color=color, anchor="w").pack(
            fill="x", pady=(6, 4))
        box = ctk.CTkScrollableFrame(tab, fg_color="#1A2A4A",
                                       corner_radius=8)
        box.pack(fill="both", expand=True, padx=2, pady=2)
        if not items:
            ctk.CTkLabel(box, text="(пусто)",
                         font=("Inter", 12),
                         text_color="#90A4AE").pack(pady=20)
            return
        for p in items[:3000]:
            ctk.CTkLabel(box, text=p, font=("Consolas", 9),
                         text_color="#e0e8f5", anchor="w",
                         justify="left", wraplength=900).pack(
                fill="x", padx=6, pady=1)
        if len(items) > 3000:
            ctk.CTkLabel(box,
                         text=f"... и ещё {len(items) - 3000}",
                         font=("Inter", 11),
                         text_color="#90A4AE").pack(pady=6)

    t1 = tabs.add("🧬 Реестр")
    t2 = tabs.add("📁 Папки")
    t3 = tabs.add("📄 Файлы")
    t4 = tabs.add("✏️ Изменённые")
    fill_tab(t1, "Новые ключи реестра", diff["new_registry"])
    fill_tab(t2, "Новые папки", diff["new_dirs"])
    fill_tab(t3, "Новые файлы", diff["new_files"])
    fill_tab(t4, "Изменённые файлы", diff["modified_files"], "#FFD54F")

    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 14), padx=20, fill="x")

    def do_delete():
        win.destroy()
        _iw_delete_by_traces(session["_dir"])

    ctk.CTkButton(br, text="🗑 Удалить следы", height=38,
                  font=("Inter", 13, "bold"), fg_color="#B71C1C",
                  hover_color="#E53935", corner_radius=19,
                  command=do_delete).pack(side="left", padx=(0, 4),
                                           fill="x", expand=True)
    ctk.CTkButton(br, text="📂 Открыть папку сессии", height=38,
                  font=("Inter", 13, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=19,
                  command=lambda: _iw_open_session_folder(
                      session["_dir"])).pack(side="left", padx=4,
                                              fill="x", expand=True)
    ctk.CTkButton(br, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


def _refresh_install_watch_ui(query=""):
    sessions = _iw_list_sessions()
    if query:
        q = query.lower()
        sessions = [s for s in sessions if q in (s.get("name") or "").lower()]

    lst = programs_ui["list_frame"]
    for w in lst.winfo_children(): w.destroy()

    if not sessions:
        ctk.CTkLabel(lst, text="Сессий наблюдения пока нет.\n\nНажмите «📸 Начать наблюдение».",
                     font=("Inter", 13), text_color="#90A4AE").pack(pady=40)
        programs_ui["status"].configure(text="Сессий наблюдения: 0", text_color="#90A4AE")
        return

    programs_ui["status"].configure(text=f"Сессий наблюдения: {len(sessions)}", text_color="#4FC3F7")

    for s in sessions:
        state = s.get("state", "?")
        if state == "watching": state_icon, state_color, state_text = "🔴", "#FF8A8A", "ИДЁТ НАБЛЮДЕНИЕ"
        elif state == "done": state_icon, state_color, state_text = "✅", "#7CFC7C", "завершено"
        else: state_icon, state_color, state_text = "⚪", "#B0BEC5", state

        default_bg = "#1F2E4A"
        row = ctk.CTkFrame(lst, fg_color=default_bg, corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=2)
        
        def on_enter(e, r=row): r.configure(fg_color="#2E5A8E")
        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                x, y = r.winfo_pointerxy()
                rx, ry = r.winfo_rootx(), r.winfo_rooty()
                rw, rh = r.winfo_width(), r.winfo_height()
                if not (rx <= x <= rx + rw and ry <= y <= ry + rh): r.configure(fg_color=bg)
            r.after(15, check_later)
        def bind_hover(w):
            if isinstance(w, ctk.CTkButton): return
            w.bind("<Enter>", on_enter, add="+"); w.bind("<Leave>", on_leave, add="+")
            for child in w.winfo_children(): bind_hover(child)
        bind_hover(row)

        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=(10, 10), pady=(8, 2))
        ctk.CTkLabel(top, text=state_icon, font=("Inter", 14), text_color=state_color, width=24).pack(side="left")
        ctk.CTkLabel(top, text=f"📸 {s.get('name', '?')[:60]}", font=("Inter", 13, "bold"), text_color="#ffffff", anchor="w", width=340).pack(side="left", padx=4)
        ctk.CTkLabel(top, text=state_text, font=("Inter", 11, "bold"), text_color=state_color, width=160).pack(side="left", padx=4)
        ctk.CTkLabel(top, text=f"▶ {s.get('started_at', '')[:19]}", font=("Consolas", 10), text_color="#90CAF9", anchor="e").pack(side="right", padx=4)

        btns = ctk.CTkFrame(row, fg_color="transparent")
        btns.pack(fill="x", padx=10, pady=(0, 8))
        if state == "watching":
            ctk.CTkButton(btns, text="⏹ Остановить", width=200, height=28, font=("Inter", 11, "bold"), fg_color="#C62828", hover_color="#E53935", corner_radius=14, command=lambda sess=dict(s): _iw_stop_session(sess)).pack(side="left", padx=(0, 4))
        elif state == "done":
            ctk.CTkButton(btns, text="👁 Показать следы", width=150, height=28, font=("Inter", 11, "bold"), fg_color="#1976D2", hover_color="#42A5F5", corner_radius=14, command=lambda sess=dict(s): _iw_show_diff_window(sess, _iw_load_snapshot(sess["_dir"], "diff.json"))).pack(side="left", padx=(0, 4))
            ctk.CTkButton(btns, text="🗑 Удалить следы", width=150, height=28, font=("Inter", 11, "bold"), fg_color="#1F2E4A", hover_color="#C62828", corner_radius=14, command=lambda sess=dict(s): _iw_delete_by_traces(sess["_dir"])).pack(side="left", padx=4)

        def mk_open_folder(sess=dict(s)):
            def do():
                _iw_open_session_folder(sess["_dir"])
            return do

        def mk_del_session(sess=dict(s)):
            def do():
                if _iw_delete_session(sess["_dir"]):
                    refresh_programs_ui()
            return do

        ctk.CTkButton(btns, text="📂 Папка",
                      width=90, height=28,
                      font=("Arial", 10, "bold"),
                      fg_color="#455A64",
                      hover_color="#546E7A",
                      corner_radius=14, command=mk_open_folder()
                      ).pack(side="left", padx=4)
        ctk.CTkButton(btns, text="🗑 Удалить сессию",
                      width=140, height=28,
                      font=("Arial", 10, "bold"),
                      fg_color="#37474F",
                      hover_color="#455A64",
                      corner_radius=14, command=mk_del_session()
                      ).pack(side="left", padx=4)

        ctk.CTkLabel(row, text=s["_dir"],
                     font=("Consolas", 9),
                     text_color="#90A4AE", anchor="w").pack(
            fill="x", padx=(14, 10), pady=(0, 6))


def build_programs_page(parent):
    f = ctk.CTkFrame(parent, fg_color="#0A1A30")

    # ─── Заголовок с иконкой ───
    header_frame = ctk.CTkFrame(f, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(10, 6), padx=15, ipadx=20)
    
    icon_img = _load_sidebar_icon("programs")
    if icon_img:
        ctk.CTkLabel(header_frame, text="", image=icon_img, fg_color="transparent").pack(side="left", padx=(15, 5), pady=8)
    ctk.CTkLabel(header_frame, text="Программы", font=("Inter", 24, "bold"), text_color="#ffffff", fg_color="transparent").pack(side="left", padx=(0 if icon_img else 15, 15), pady=8)

    # ─── Статус (создаём заранее: _load_uwp и _set_tab зависят от него) ───
    status = ctk.CTkLabel(f, text="Загрузка...", font=("Inter", 12, "bold"),
                          text_color="#FFD54F", fg_color="#131E32", corner_radius=12, height=28, border_width=1, border_color="#2A3B5C")
    status.pack(pady=(0, 8), padx=15, fill="x")
    programs_ui["status"] = status

    # ─── Загрузчик UWP (определён ДО _set_tab, который его вызывает) ───
    def _load_uwp():
        status.configure(text="⏳ Загрузка UWP...", text_color="#FFD54F")
        def worker():
            apps = _get_uwp_apps()
            programs_ui["uwp_cache"] = apps
            app.after(0, refresh_programs_ui)
        threading.Thread(target=worker, daemon=True).start()

    # ─── Вкладки ───
    tabs = ctk.CTkFrame(f, fg_color="transparent")
    tabs.pack(pady=(0, 6), padx=15, fill="x")

    def _set_tab(name):
        programs_ui["tab"] = name
        for k, b in programs_ui["tab_btns"].items():
            if k == name:
                b.configure(fg_color="#1565C0", border_width=1, border_color="#4FC3F7")
            else:
                b.configure(fg_color="#1F2E4A", border_width=0)
        if name == "uwp" and not programs_ui.get("uwp_cache"):
            _load_uwp()
        elif name == "portable":
            if "portable_cache" not in programs_ui:
                _load_portable_async()
            else:
                refresh_programs_ui()
        elif name == "watch":
            refresh_programs_ui()
        else:
            refresh_programs_ui()

    programs_ui["tab_btns"] = {}
    for key, label in [("all", "📦 Все"), ("recent", "🆕 Недавние"), ("portable", "🎒 Портативные"),
                        ("watch", "📸 Наблюдение"), ("uwp", "🏪 Store"), ("broken", "⚠️ Битые")]:
        b = ctk.CTkButton(tabs, text=label, height=32, font=("Inter", 12, "bold"),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=16, width=130,
