    _center_window(win)

    header_frame = ctk.CTkFrame(win, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(header_frame, text="🖥  PnP-устройства системы", font=("Inter", 20, "bold"), text_color="#ffffff").pack(pady=8, padx=15)

    ctk.CTkLabel(win, text="Аналог Диспетчера устройств. Показывает статус, код проблемы, версию и дату драйвера.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

