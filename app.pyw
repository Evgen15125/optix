            dm.pack(anchor="w", padx=14, pady=(0, 10))
            trig_widgets["day"] = dm

        if ttype == "once":
            ctk.CTkLabel(trig_fields_frame, text="Дата (ДД/ММ/ГГГГ):", font=("Inter", 12), text_color="#82B1FF", anchor="w").pack(fill="x", padx=14, pady=(4, 2))
            de = ctk.CTkEntry(trig_fields_frame, height=32, font=("Consolas", 12), fg_color="#1F2E4A", text_color="#ffffff", corner_radius=8)
            de.pack(fill="x", padx=14, pady=(0, 10))
            de.insert(0, cur_trig.get("date", "01/01/2030"))
