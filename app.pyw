# ================== АУДИТ БЕЗОПАСНОСТИ ==================
def _sec_check_uac():
    """Проверяет уровень UAC."""
    result = {"level": "?", "enabled": False, "status": "?", "ok": False}
    try:
        k = winreg.OpenKey(
            winreg.HKEY_LOCAL_MACHINE,
            r"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System",
            0, winreg.KEY_READ)
        try:
            enabled, _ = winreg.QueryValueEx(k, "EnableLUA")
            result["enabled"] = int(enabled) == 1
        except FileNotFoundError:
            result["enabled"] = True  # по умолчанию вкл
        try:
            level, _ = winreg.QueryValueEx(k, "ConsentPromptBehaviorAdmin")
            level = int(level)
            # 0 — без UAC, 1 — подтверждение учётных данных,
            # 2 — согласие на безопасном рабочем столе,
            # 3 — ввод учётных данных, 4 — без затемнения,
            # 5 — согласие для сторонних программ
            mapping = {
                0: "Отключён (не спрашивать)",
                1: "Запрашивать учётные данные на рабочем столе",
                2: "Запрашивать согласие на безопасном столе",
                3: "Запрашивать учётные данные (стандарт)",
                4: "Запрашивать согласие без затемнения",
                5: "Запрашивать согласие только для сторонних",
            }
            result["level"] = mapping.get(level, f"Уровень {level}")
            result["ok"] = result["enabled"] and level >= 2
        except FileNotFoundError:
            result["level"] = "По умолчанию"
            result["ok"] = result["enabled"]
        winreg.CloseKey(k)
    except Exception as e:
        log_error("_sec_check_uac", e)
    if result["ok"]:
        result["status"] = "✅ Включён"
    else:
        result["status"] = "🔴 Отключён или ослаблен"
    return result


def _sec_check_admins():
    """Список локальных администраторов через PowerShell."""
    admins = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-LocalGroupMember -Group 'Administrators' "
            "-ErrorAction SilentlyContinue | "
            "Select-Object Name,ObjectClass | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for u in data:
                if not isinstance(u, dict):
                    continue
                name = str(u.get("Name") or "").strip()
                obj_class = str(u.get("ObjectClass") or "").strip()
                if not name:
                    continue
                # Name приходит вида "EVGEN\\xcont" или "EVGEN\\Администратор"
                # Оставляем только часть после бэкслеша
                short = name.split("\\")[-1] if "\\" in name else name
                # Пропускаем встроенную группу "Администраторы" и SID-хвосты
                if short.lower() in ("администраторы", "administrators"):
                    continue
                if obj_class.lower() == "user" or not obj_class:
                    admins.append(short)
    except Exception as e:
        log_error("_sec_check_admins", e)
    # Fallback через net localgroup, если PowerShell не сработал
    if not admins:
        try:
            r = subprocess.run(["net", "localgroup",
                                 "Администраторы"],
                               capture_output=True, timeout=15,
                               creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(r.stdout or b"")
            if "не найдена" in out.lower() or \
               "not found" in out.lower():
                # Попробуем английское имя
                r = subprocess.run(["net", "localgroup",
                                     "Administrators"],
                                   capture_output=True, timeout=15,
                                   creationflags=CREATE_NO_WINDOW)
                out = _decode_console_bytes(r.stdout or b"")
            lines = out.splitlines()
            in_list = False
            for line in lines:
                s = line.strip()
                if not s:
                    continue
                if "---" in s:
                    in_list = True
                    continue
                if in_list:
                    low = s.lower()
                    if low.startswith("команда") or \
                       low.startswith("the command"):
                        in_list = False
                        continue
                    name = s.lstrip("*").strip()
                    # Убираем "Имя группы" если попало
                    if name.lower() in ("администраторы", "administrators"):
                        continue
                    if name and len(name) < 60:
                        admins.append(name)
        except Exception as e:
            log_error("_sec_check_admins_fallback", e)
    return sorted(set(admins))


def _sec_check_empty_passwords():
    """Ищет пользователей без пароля."""
    without = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-LocalUser | Where-Object { $_.Enabled -eq $true } | "
            "Select-Object Name,PasswordRequired | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for u in data:
                if isinstance(u, dict):
                    # PasswordRequired = False → пароль не требуется
                    if u.get("PasswordRequired") is False:
                        without.append(str(u.get("Name", "?")))
    except Exception as e:
        log_error("_sec_check_empty_passwords", e)
    return without


def _sec_check_autologon():
    """Проверяет, включён ли автоматический вход."""
    result = {"enabled": False, "user": "", "ok": True}
    try:
        k = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                           r"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon",
                           0, winreg.KEY_READ)
        try:
            autologon, _ = winreg.QueryValueEx(k, "AutoAdminLogon")
            if str(autologon) == "1":
                result["enabled"] = True
                result["ok"] = False
                try:
                    user, _ = winreg.QueryValueEx(k, "DefaultUserName")
                    result["user"] = str(user)
                except Exception:
                    pass
        except FileNotFoundError:
            pass
        winreg.CloseKey(k)
    except Exception:
        pass
    return result


def _sec_check_bitlocker():
    """
    Статус BitLocker. Сначала пробует Get-BitLockerVolume,
    если пусто — manage-bde -status.
    """
    disks = []
    # ─── Попытка 1: PowerShell Get-BitLockerVolume ───
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$vols = Get-BitLockerVolume -ErrorAction SilentlyContinue; "
            "if ($vols) { "
            "  $vols | ForEach-Object { "
            "    [PSCustomObject]@{ "
            "      Mount = $_.MountPoint; "
            "      Status = [string]$_.VolumeStatus; "
            "      Protection = [string]$_.ProtectionStatus; "
            "      Percent = $_.EncryptionPercentage "
            "    } "
            "  } | ConvertTo-Json -Compress "
            "}"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for d in data:
                if not isinstance(d, dict):
                    continue
                mount = str(d.get("Mount") or "").strip().rstrip("\\")
                status = str(d.get("Status") or "").strip()
                prot = str(d.get("Protection") or "").strip()
                pct = d.get("Percent")
                # Игнорируем полностью пустые записи
                if not status and not prot:
                    continue
                disks.append({
                    "mount": mount or "?",
                    "status": status or "?",
                    "protection": prot or "?",
                    "percent": pct,
                })
    except Exception as e:
        log_error("_sec_check_bitlocker_ps", e)

    # ─── Попытка 2: manage-bde -status (работает и на Home) ───
    if not disks:
        try:
            r = subprocess.run(["manage-bde", "-status"],
                               capture_output=True, timeout=30,
                               creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(r.stdout or b"")
            if "не найден" in out.lower() or \
               "not found" in out.lower() or \
               "BitLocker" not in out:
                # manage-bde отсутствует (Home) — возвращаем пусто
                return []
            # Парсим строки вида:
            #   "Том C: [OS]"
            #   "    Состояние:  Полностью расшифрован"
            #   "    Защита:     Выключена"
            cur = {}
            for line in out.splitlines():
                s = line.strip()
                if not s:
                    if cur.get("mount"):
                        disks.append(cur)
                        cur = {}
                    continue
                low = s.lower()
                # Том C: [OS]
                if ":" in s and ("том" in low or "volume" in low):
                    if cur.get("mount"):
                        disks.append(cur)
                        cur = {}
                    # Вытаскиваем букву диска
                    import re
                    m = re.search(r"([A-Z]):", s)
                    cur["mount"] = (m.group(1) + ":") if m else s[:30]
                elif ("состояние" in low or "conversion status" in low):
                    cur["status"] = s.split(":", 1)[-1].strip() or "?"
                elif ("защита" in low or "protection status" in low):
                    cur["protection"] = s.split(":", 1)[-1].strip() or "?"
            if cur.get("mount"):
                disks.append(cur)
        except Exception as e:
            log_error("_sec_check_bitlocker_managebde", e)

    # Дополняем статусы для manage-bde-вывода
    for d in disks:
        if "status" not in d:
            d["status"] = "?"
        if "protection" not in d:
            d["protection"] = "?"
        d.setdefault("percent", None)
    return disks


def _sec_check_defender():
    """Статус Windows Defender."""
    result = {
        "available": False,
        "antivirus_enabled": False,
        "real_time": False,
        "signature_age_days": None,
        "last_quick_scan": "",
        "ok": False,
    }
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$s = Get-MpComputerStatus -ErrorAction SilentlyContinue; "
            "if ($s) { "
            "  [PSCustomObject]@{ "
            "    AMRunning = $s.AMServiceEnabled; "
            "    AVEnabled = $s.AntivirusEnabled; "
            "    RTEnabled = $s.RealTimeProtectionEnabled; "
            "    SigAge = $s.AntivirusSignatureAge; "
            "    LastQuick = if ($s.QuickScanEndTime) "
            "      { $s.QuickScanEndTime.ToString('yyyy-MM-dd HH:mm') } "
            "      else { '' } "
            "  } | ConvertTo-Json -Compress "
            "}"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                result["available"] = True
                result["antivirus_enabled"] = bool(data.get("AVEnabled"))
                result["real_time"] = bool(data.get("RTEnabled"))
                result["signature_age_days"] = data.get("SigAge")
                result["last_quick_scan"] = str(data.get("LastQuick") or "?")
                # Оценка
                if result["antivirus_enabled"] and result["real_time"]:
                    sig_age = result["signature_age_days"]
                    if sig_age is None or sig_age < 7:
                        result["ok"] = True
    except Exception as e:
        log_error("_sec_check_defender", e)
    return result


def _sec_check_firewall():
    """Статус брандмауэра по профилям."""
    profiles = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-NetFirewallProfile -ErrorAction SilentlyContinue | "
            "Select-Object Name,Enabled | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for p in data:
                if isinstance(p, dict):
                    profiles.append({
                        "name": str(p.get("Name") or "?"),
                        "enabled": bool(p.get("Enabled")),
                    })
    except Exception as e:
        log_error("_sec_check_firewall", e)
    return profiles


def _sec_check_listening_ports():
    """Слушающие порты на внешних IP (не 127.x)."""
    ports = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | "
            "Where-Object { $_.LocalAddress -notmatch '^127\\.' -and "
            "  $_.LocalAddress -ne '::1' } | "
            "ForEach-Object { "
            "  $proc = Get-Process -Id $_.OwningProcess "
            "-ErrorAction SilentlyContinue; "
            "  [PSCustomObject]@{ "
            "    Port = $_.LocalPort; "
            "    Addr = $_.LocalAddress; "
            "    Process = if ($proc) { $proc.ProcessName } else { '?' } "
            "  } "
            "} | Sort-Object Port | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=45,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for p in data:
                if isinstance(p, dict):
                    ports.append({
                        "port": p.get("Port"),
                        "addr": str(p.get("Addr") or "?"),
                        "proc": str(p.get("Process") or "?"),
                    })
    except Exception as e:
        log_error("_sec_check_listening_ports", e)
    return ports


def diag_security_audit():
    """Запускает полный аудит безопасности."""
    diag_ui["status"].configure(text="⏳ Аудит безопасности...",
                                 text_color="#FFD54F")

    def worker():
        # Собираем всё
        uac = _sec_check_uac()
        admins = _sec_check_admins()
        no_pass = _sec_check_empty_passwords()
        autologon = _sec_check_autologon()
        bitlocker = _sec_check_bitlocker()
        defender = _sec_check_defender()
        firewall = _sec_check_firewall()
        ports = _sec_check_listening_ports()

        def finish():
            lines = ["=" * 70,
                     "  АУДИТ БЕЗОПАСНОСТИ СИСТЕМЫ",
                     "=" * 70,
                     "",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     ""]

            # Считаем риски
            risks = 0
            warnings = 0

            # ─── UAC ───
            lines.append("─" * 70)
            lines.append("  🛡 КОНТРОЛЬ УЧЁТНЫХ ЗАПИСЕЙ (UAC)")
            lines.append("─" * 70)
            lines.append(f"  Статус:  {uac['status']}")
            lines.append(f"  Уровень: {uac['level']}")
            if uac["ok"]:
                lines.append("  ✅ UAC работает корректно")
            else:
                lines.append("  ⚠️ UAC отключён или ослаблен — "
                             "программы могут менять систему без спроса")
                risks += 1
            lines.append("")

            # ─── Админы ───
            lines.append("─" * 70)
            lines.append("  👤 АДМИНИСТРАТОРЫ")
            lines.append("─" * 70)
            if admins:
                for a in admins:
                    lines.append(f"  • {a}")
                if len(admins) > 3:
                    lines.append(f"  ⚠️ Много администраторов ({len(admins)}). "
                                 f"Рекомендуется 1–2.")
                    warnings += 1
                else:
                    lines.append("  ✅ Нормальное количество")
            else:
                lines.append("  (не удалось получить)")
            lines.append("")

            # ─── Пустые пароли ───
            lines.append("─" * 70)
            lines.append("  🔑 ПАРОЛИ")
            lines.append("─" * 70)
            if no_pass:
                lines.append(f"  🔴 Пользователи БЕЗ пароля: "
                             f"{len(no_pass)}")
                for u in no_pass:
                    lines.append(f"      • {u}")
                lines.append("  ⚠️ Срочно установите пароли!")
                risks += 1
            else:
                lines.append("  ✅ Все активные пользователи требуют пароль")
            lines.append("")

            # ─── Автовход ───
            lines.append("─" * 70)
            lines.append("  🚪 АВТОМАТИЧЕСКИЙ ВХОД")
            lines.append("─" * 70)
            if autologon["enabled"]:
                lines.append(f"  ⚠️ Автовход ВКЛЮЧЁН для пользователя: "
                             f"{autologon['user'] or '?'}")
                lines.append("      Любой, кто включит ПК, получит доступ "
                             "к системе.")
                warnings += 1
            else:
                lines.append("  ✅ Автовход отключён")
            lines.append("")

            # ─── BitLocker ───
            lines.append("─" * 70)
            lines.append("  🔒 BITLOCKER (ШИФРОВАНИЕ ДИСКОВ)")
            lines.append("─" * 70)
            if bitlocker:
                sys_letter = os.environ.get("SystemDrive", "C:")
                sys_enc = False
                for d in bitlocker:
                    prot = (d["protection"] or "").lower()
                    is_on = ("on" in prot or "включ" in prot
                             or "1" in prot)
                    is_off = ("off" in prot or "выключ" in prot
                              or "0" in prot)
                    if is_on:
                        icon = "✅"
                    elif is_off:
                        icon = "⚠️"
                    else:
                        icon = "ℹ️"
                    pct_txt = ""
                    if d.get("percent") is not None:
                        try:
                            pct_txt = f" ({int(d['percent'])}%)"
                        except Exception:
                            pass
                    lines.append(f"  {icon} {d['mount']}  —  "
                                 f"{d['status']}{pct_txt} / "
                                 f"{d['protection']}")
                    if (d["mount"] or "").rstrip("\\") == sys_letter \
                            and is_on:
                        sys_enc = True
                if not sys_enc:
                    lines.append(f"  ⚠️ Системный диск не зашифрован — "
                                 f"данные уязвимы при краже/потере")
                    warnings += 1
            else:
                lines.append("  ℹ️ BitLocker недоступен. "
                             "В Windows 11 Home есть только «Шифрование "
                             "устройства» (упрощённый BitLocker). "
                             "Проверить можно в Параметры → "
                             "Конфиденциальность → Шифрование устройства.")
            lines.append("")

            # ─── Defender ───
            lines.append("─" * 70)
            lines.append("  🦠 WINDOWS DEFENDER")
            lines.append("─" * 70)
            if defender["available"]:
                lines.append(f"  Антивирус:    "
                             f"{'✅ Включён' if defender['antivirus_enabled'] else '🔴 Отключён'}")
                lines.append(f"  Реальная защита: "
                             f"{'✅ Включена' if defender['real_time'] else '🔴 Отключена'}")
                if defender["signature_age_days"] is not None:
                    age = defender["signature_age_days"]
                    if age < 3:
                        icon = "✅"
                    elif age < 7:
                        icon = "🟡"
                    else:
                        icon = "🔴"
                    lines.append(f"  {icon} Базы: {age} дн. "
                                 f"(норма < 7)")
                    if age > 7:
                        warnings += 1
                if defender["last_quick_scan"]:
                    lines.append(f"  Последняя быстрая проверка: "
                                 f"{defender['last_quick_scan']}")
                if defender["ok"]:
                    lines.append("  ✅ Defender работает нормально")
                else:
                    lines.append("  ⚠️ Проверьте состояние Defender")
                    risks += 1
            else:
                lines.append("  (не удалось получить статус — "
                             "возможно, Defender отключён политикой или "
                             "заменён сторонним антивирусом)")
            lines.append("")

            # ─── Файрвол ───
            lines.append("─" * 70)
            lines.append("  🔥 БРАНДМАУЭР")
            lines.append("─" * 70)
            if firewall:
                all_on = True
                for p in firewall:
                    icon = "✅" if p["enabled"] else "🔴"
                    lines.append(f"  {icon} {p['name']}: "
                                 f"{'Включён' if p['enabled'] else 'Отключён'}")
                    if not p["enabled"]:
                        all_on = False
                if all_on:
                    lines.append("  ✅ Брандмауэр включён на всех профилях")
                else:
                    lines.append("  🔴 На некоторых профилях отключён!")
                    risks += 1
            else:
                lines.append("  (не удалось получить)")
            lines.append("")

            # ─── Порты ───
            lines.append("─" * 70)
            lines.append(f"  🌐 СЛУШАЮЩИЕ ПОРТЫ НА ВНЕШНИХ IP "
                         f"({len(ports)})")
            lines.append("─" * 70)
            if ports:
                for p in ports[:30]:
                    lines.append(f"  • Порт {p['port']:<6} "
                                 f"{p['addr']:<20} {p['proc']}")
                if len(ports) > 30:
                    lines.append(f"  ... и ещё {len(ports) - 30}")
                lines.append("")
                lines.append("  ℹ️ Открытые порты — это нормально, "
                             "если их слушают известные программы. "
                             "Подозрительно, если порт слушает неизвестный "
                             "процесс или порт нестандартный (не 80, 443, "
                             "135, 445 и т.п.).")
            else:
                lines.append("  ✅ На внешних IP ничего не слушает")
            lines.append("")

            # ─── Итог ───
            lines.append("=" * 70)
            if risks == 0 and warnings == 0:
                verdict = "✅ СИСТЕМА БЕЗОПАСНА — критических проблем нет."
                status_text = "✅ Безопасно"
                status_color = "#7CFC7C"
            elif risks == 0 and warnings <= 3:
                verdict = (f"🟡 ЕСТЬ ЗАМЕЧАНИЯ ({warnings}). "
                           f"Проверьте разделы выше.")
                status_text = f"🟡 Замечаний: {warnings}"
                status_color = "#FFD54F"
            else:
                verdict = (f"🔴 НАЙДЕНЫ РИСКИ ({risks}) И ЗАМЕЧАНИЯ "
                           f"({warnings}). Срочно примите меры.")
                status_text = f"🔴 Рисков: {risks}"
                status_color = "#FF8A8A"
            lines.append(f"  {verdict}")
            lines.append(f"  🔴 Критических рисков: {risks}")
            lines.append(f"  🟡 Замечаний: {warnings}")
            lines.append("=" * 70)

            diag_ui["status"].configure(text=status_text,
                                         text_color=status_color)
            show_output_dialog("Аудит безопасности", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def build_diagnostic_page(parent):
    # Оставляем только один прокручиваемый фрейм на всю страницу
    f = ctk.CTkScrollableFrame(parent, fg_color="#0A1A30",
                                scrollbar_button_color="#243A5E",
                                scrollbar_button_hover_color="#4FC3F7")
    f.pack(fill="both", expand=True)
    
    # ─── Заголовок с иконкой ───
    header_frame = ctk.CTkFrame(f, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(10, 10), padx=15, ipadx=20)
    
    icon_img = _load_sidebar_icon("diagnostic")
    if icon_img:
        ctk.CTkLabel(header_frame, text="", image=icon_img, fg_color="transparent").pack(side="left", padx=(15, 5), pady=8)
    ctk.CTkLabel(header_frame, text="Диагностика системы", font=("Inter", 24, "bold"), text_color="#ffffff", fg_color="transparent").pack(side="left", padx=(0 if icon_img else 15, 15), pady=8)
    
    # ─── Статус ───
    status = ctk.CTkLabel(f, text="Готово", font=("Inter", 12, "bold"),
                          text_color="#4FC3F7", fg_color="#131E32",
                          corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status.pack(pady=(0, 10), padx=15, fill="x")

    def mk(title, desc, command, color="#1976D2", hover="#42A5F5"):
        # Карточки крепим напрямую к f
        row = ctk.CTkFrame(f, fg_color="#1F2E4A", corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=3, padx=15)
        row.grid_columnconfigure(0, weight=1)
        
        # Железобетонный ховер
        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E", border_color="#4FC3F7")
            except Exception: pass
        def on_leave(e, r=row):
            def check_later():
