                            fg_color="#1A2A4A",
                            text_color="#ffffff")
        ent.pack(side="left", fill="x", expand=True, padx=(0, 6))

        def choose():
            p = filedialog.askopenfilename(
                title=f"Отчёт {label.strip(':')}",
                filetypes=[("JSON", "*.json"), ("Все", "*.*")],
                initialdir=DIAG_REPORTS_DIR
                if os.path.isdir(DIAG_REPORTS_DIR) else BASE_DIR)
            if p:
                ent.delete(0, "end")
                ent.insert(0, p)
                paths[key] = p
        ctk.CTkButton(row, text="📂", width=42, height=32,
                      font=("Inter", 12), fg_color="#1976D2",
                      hover_color="#42A5F5", corner_radius=8,
                      command=choose).pack(side="left")
        return ent

    ent_a = _make_file_row("A:", "A", "#4FC3F7")
    ent_b = _make_file_row("B:", "B", "#FFB74D")

    status_lbl = ctk.CTkLabel(win, text="Готово к сравнению",
                              font=("Arial", 11, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=26)
    status_lbl.pack(pady=(8, 6), padx=20, fill="x")

    tabs = ctk.CTkTabview(
        win, fg_color="#0A1A30",
        segmented_button_selected_color="#1565C0",
        segmented_button_unselected_color="#1A2A4A")
    tabs.pack(fill="both", expand=True, padx=20, pady=(0, 8))
    t_summary = tabs.add("📊 Обзор")
    t_progs = tabs.add("🗑 Программы")
    t_svcs = tabs.add("🔧 Службы")
    t_auto = tabs.add("🚀 Автозапуск")
    t_disks = tabs.add("💾 Диски")
    t_upd = tabs.add("📥 Обновления")

    def _clear_tab(tab):
        for w in tab.winfo_children():
            w.destroy()

    def _scroll(parent):
        wrap = ctk.CTkScrollableFrame(parent, fg_color="#1A2A4A",
                                        corner_radius=10)
        wrap.pack(fill="both", expand=True, padx=2, pady=2)
        return wrap

    def do_compare():
        pa = ent_a.get().strip()
        pb = ent_b.get().strip()
        if not pa or not os.path.exists(pa):
            messagebox.showerror("Ошибка", "Укажите файл A.")
            return
        if not pb or not os.path.exists(pb):
            messagebox.showerror("Ошибка", "Укажите файл B.")
            return
        if pa == pb:
            messagebox.showerror("Ошибка", "A и B — один и тот же файл.")
            return

        data_a, err_a = _diff_load_json(pa)
        data_b, err_b = _diff_load_json(pb)
        if err_a:
            messagebox.showerror("Ошибка A", err_a)
            return
        if err_b:
            messagebox.showerror("Ошибка B", err_b)
            return

        status_lbl.configure(text="⏳ Сравнение...",
                              text_color="#FFD54F")
        try:
            _render_all(data_a, data_b)
            status_lbl.configure(text="✅ Готово", text_color="#7CFC7C")
        except Exception as e:
            log_error("open_report_diff_window.compare", e)
            status_lbl.configure(text=f"⚠️ {e}", text_color="#FF8A8A")

    def _render_all(a, b):
        ts_a = a.get("generated", "?")
        ts_b = b.get("generated", "?")

        # ─── ПРОГРАММЫ ───
        _clear_tab(t_progs)
        s = _scroll(t_progs)
        added, removed, changed = _diff_lists(
            a.get("programs", []), b.get("programs", []),
            key_fn=lambda p: (p.get("name") or "").strip().lower(),
            change_keys=["version", "size", "publisher"])

        def fmt_prog(it, kind):
            if kind == "changed":
                old = it["old"]
                new = it["new"]
                parts = [f"🔄 {new.get('name', '?')}"]
                for k, (ov, nv) in it["diffs"].items():
                    if k == "size":
                        parts.append(
                            f"   {k}: {_diff_fmt_val(ov)} → "
                            f"{_diff_fmt_val(nv)}")
                    else:
                        parts.append(f"   {k}: {ov or '—'} → {nv or '—'}")
                return "\n".join(parts)
            p = it
            return (f"   {p.get('name', '?')}  "
                    f"v{p.get('version', '') or '—'}  "
                    f"[{p.get('publisher', '') or '—'}]")

        _diff_render_section(s, "Новые программы", added, "added",
                              fmt_prog, "➕", "#7CFC7C")
        _diff_render_section(s, "Удалённые программы", removed, "removed",
                              fmt_prog, "➖", "#FF8A8A")
        _diff_render_section(s, "Изменённые программы", changed, "changed",
                              fmt_prog, "🔄", "#FFD54F")

        # ─── СЛУЖБЫ ───
        _clear_tab(t_svcs)
        s = _scroll(t_svcs)
        added, removed, changed = _diff_lists(
            a.get("services", []), b.get("services", []),
            key_fn=lambda x: (x.get("name") or "").strip().lower(),
            change_keys=["status", "start_type"])

        def fmt_svc(it, kind):
            if kind == "changed":
                new = it["new"]
                parts = [f"🔄 {new.get('name', '?')}  "
                         f"({new.get('display', '')[:60]})"]
                for k, (ov, nv) in it["diffs"].items():
                    parts.append(f"   {k}: {ov or '—'} → {nv or '—'}")
                return "\n".join(parts)
            x = it
            return (f"   {x.get('name', '?')}  "
                    f"({x.get('display', '')[:60]})  "
                    f"[{x.get('status', '')} / "
                    f"{x.get('start_type', '')}]")

        _diff_render_section(s, "Новые службы", added, "added",
                              fmt_svc, "➕", "#7CFC7C")
        _diff_render_section(s, "Удалённые службы", removed, "removed",
                              fmt_svc, "➖", "#FF8A8A")
        _diff_render_section(s, "Изменённые службы", changed, "changed",
                              fmt_svc, "🔄", "#FFD54F")

        # ─── АВТОЗАПУСК ───
        _clear_tab(t_auto)
        s = _scroll(t_auto)
        added, removed, changed = _diff_lists(
            a.get("autostart", []), b.get("autostart", []),
            key_fn=lambda x: (str(x.get("source", "")) + "|" +
                              str(x.get("name", ""))).lower(),
            change_keys=["command"])

        def fmt_auto(it, kind):
            if kind == "changed":
                new = it["new"]
                parts = [f"🔄 [{new.get('source','?')}] "
                         f"{new.get('name','?')}"]
                for k, (ov, nv) in it["diffs"].items():
                    parts.append(f"   Было:  {ov or '—'}")
                    parts.append(f"   Стало: {nv or '—'}")
                return "\n".join(parts)
            x = it
            return (f"   [{x.get('source','?')}] {x.get('name','?')}\n"
                    f"      {x.get('command', '')[:120]}")

        _diff_render_section(s, "Добавлено в автозапуск", added, "added",
                              fmt_auto, "➕", "#7CFC7C")
        _diff_render_section(s, "Удалено из автозапуска", removed,
                              "removed", fmt_auto, "➖", "#FF8A8A")
        _diff_render_section(s, "Изменённые записи", changed, "changed",
                              fmt_auto, "🔄", "#FFD54F")

        # ─── ДИСКИ ───
        _clear_tab(t_disks)
        s = _scroll(t_disks)
        a_disks = {d.get("mount", "?"): d for d in a.get("disks", [])}
        b_disks = {d.get("mount", "?"): d for d in b.get("disks", [])}
        ctk.CTkLabel(s, text="📊  Изменение занятого места",
                     font=("Inter", 13, "bold"),
                     text_color="#82B1FF", anchor="w").pack(
            fill="x", padx=6, pady=(6, 4))
        all_mounts = sorted(set(a_disks) | set(b_disks))
        if not all_mounts:
            ctk.CTkLabel(s, text="   (нет данных о дисках)",
                         font=("Inter", 11),
                         text_color="#90A4AE").pack(fill="x", padx=14)
        for m in all_mounts:
            da = a_disks.get(m, {})
            db = b_disks.get(m, {})
            used_a = da.get("used", 0)
            used_b = db.get("used", 0)
            delta = used_b - used_a
            if delta > 0:
                dc, dt = "#FF8A8A", f"+{human_size(delta)}"
            elif delta < 0:
                dc, dt = "#7CFC7C", f"−{human_size(abs(delta))}"
            else:
                dc, dt = "#B0BEC5", "0 Б"
            row = ctk.CTkFrame(s, fg_color="#0D1B33",
                                corner_radius=6)
            row.pack(fill="x", padx=6, pady=1)
            ctk.CTkLabel(row, text=f"💾 {m}",
                         font=("Consolas", 11, "bold"),
                         text_color="#4FC3F7", width=80,
                         anchor="w").pack(side="left", padx=10, pady=5)
            ctk.CTkLabel(
                row,
                text=f"Было: {human_size(used_a)}   "
                     f"Стало: {human_size(used_b)}",
                font=("Consolas", 12),
                text_color="#B0BEC5", anchor="w").pack(
                side="left", padx=6, pady=5, fill="x", expand=True)
            ctk.CTkLabel(row, text=dt,
                         font=("Consolas", 11, "bold"),
                         text_color=dc, width=140,
                         anchor="e").pack(side="right", padx=10, pady=5)

        # ─── ОБНОВЛЕНИЯ ───
        _clear_tab(t_upd)
        s = _scroll(t_upd)
        added, removed, changed = _diff_lists(
            a.get("updates", []), b.get("updates", []),
            key_fn=lambda u: ((u.get("kb") or "") + "|" +
                              (u.get("title") or "")).lower(),
            change_keys=["severity", "size"])

        def fmt_upd(it, kind):
            if kind == "changed":
                new = it["new"]
                parts = [f"🔄 {new.get('title', '?')[:80]}"]
                for k, (ov, nv) in it["diffs"].items():
                    parts.append(f"   {k}: {ov or '—'} → {nv or '—'}")
                return "\n".join(parts)
            u = it
            kb = u.get("kb", "")
            sz = u.get("size", 0)
            sz_txt = human_size(sz) if sz else "—"
            return (f"   {u.get('title', '?')[:80]}\n"
                    f"      [{kb} • {sz_txt}]")

        _diff_render_section(s, "Появились обновления", added, "added",
                              fmt_upd, "➕", "#7CFC7C")
        _diff_render_section(s, "Установлены (исчезли)", removed,
                              "removed", fmt_upd, "➖", "#7CFC7C")
        _diff_render_section(s, "Изменённые обновления", changed,
                              "changed", fmt_upd, "🔄", "#FFD54F")

        # ─── ОБЗОР ───
        _clear_tab(t_summary)
        s = _scroll(t_summary)

        def _count(label, items):
            return len(items or [])

        def _section_line(title, n_add, n_rem, n_chg):
            return (f"   {title:<22}  "
                    f"➕ {n_add:>3}   ➖ {n_rem:>3}   🔄 {n_chg:>3}")

        # Пересчёт для обзора
        pr_a, pr_r, pr_c = _diff_lists(
            a.get("programs", []), b.get("programs", []),
            key_fn=lambda p: (p.get("name") or "").strip().lower(),
            change_keys=["version", "size", "publisher"])
        sv_a, sv_r, sv_c = _diff_lists(
            a.get("services", []), b.get("services", []),
            key_fn=lambda x: (x.get("name") or "").strip().lower(),
            change_keys=["status", "start_type"])
        au_a, au_r, au_c = _diff_lists(
            a.get("autostart", []), b.get("autostart", []),
            key_fn=lambda x: (str(x.get("source", "")) + "|" +
                              str(x.get("name", ""))).lower(),
            change_keys=["command"])
        up_a, up_r, up_c = _diff_lists(
            a.get("updates", []), b.get("updates", []),
            key_fn=lambda u: ((u.get("kb") or "") + "|" +
                              (u.get("title") or "")).lower(),
            change_keys=["severity", "size"])

        # Диски — считаем количество изменившихся (Δ ≠ 0)
        # ВАЖНО: считаем ДО total_changes, т.к. используется ниже.
        disk_changes = 0
        try:
            a_disks_tmp = {d.get("mount", "?"): d
                           for d in a.get("disks", [])}
            b_disks_tmp = {d.get("mount", "?"): d
                           for d in b.get("disks", [])}
            for mk in set(a_disks_tmp) | set(b_disks_tmp):
                ua = a_disks_tmp.get(mk, {}).get("used", 0)
                ub = b_disks_tmp.get(mk, {}).get("used", 0)
                if ua != ub:
                    disk_changes += 1
        except Exception:
            pass

        total_changes = (len(pr_a) + len(pr_r) + len(pr_c) +
                         len(sv_a) + len(sv_r) + len(sv_c) +
                         len(au_a) + len(au_r) + len(au_c) +
                         len(up_a) + len(up_r) + len(up_c) +
                         disk_changes)

        # Заголовок
        head = ctk.CTkFrame(s, fg_color="#0D47A1",
                             corner_radius=10)
        head.pack(fill="x", padx=6, pady=(6, 10))
        ctk.CTkLabel(head,
                     text=f"📅 A: {ts_a}\n📅 B: {ts_b}",
                     font=("Consolas", 12),
                     text_color="#ffffff",
                     justify="left").pack(anchor="w", padx=14, pady=8)
        if total_changes == 0:
            ctk.CTkLabel(head,
                         text="✅ Изменений НЕ обнаружено — "
                              "состояние системы идентично.",
                         font=("Inter", 13, "bold"),
                         text_color="#7CFC7C").pack(
                anchor="w", padx=14, pady=(0, 10))
        else:
            ctk.CTkLabel(head,
                         text=f"⚡ Всего изменений: {total_changes}",
                         font=("Inter", 13, "bold"),
                         text_color="#FFD54F").pack(
                anchor="w", padx=14, pady=(0, 10))

        # Сводная таблица
        card = ctk.CTkFrame(s, fg_color="#243A5E", corner_radius=10)
        card.pack(fill="x", padx=6, pady=(0, 10))
        ctk.CTkLabel(card, text="📊  Сводка по категориям",
                     font=("Inter", 13, "bold"),
                     text_color="#82B1FF", anchor="w").pack(
            fill="x", padx=14, pady=(10, 6))
        ctk.CTkLabel(card,
                     text="                        + новое    — ушло    "
                          "🔄 изменилось",
                     font=("Consolas", 10, "bold"),
                     text_color="#90CAF9", anchor="w").pack(
            fill="x", padx=14, pady=(0, 4))

        for title, n_a, n_r, n_c in [
            ("🗑 Программы", len(pr_a), len(pr_r), len(pr_c)),
            ("🔧 Службы", len(sv_a), len(sv_r), len(sv_c)),
            ("🚀 Автозапуск", len(au_a), len(au_r), len(au_c)),
            ("💾 Диски", 0, 0, disk_changes),
            ("📥 Обновления", len(up_a), len(up_r), len(up_c)),
        ]:
            ctk.CTkLabel(card, text=_section_line(title, n_a, n_r, n_c),
                         font=("Consolas", 12),
                         text_color="#ffffff", anchor="w").pack(
                fill="x", padx=14, pady=1)
        ctk.CTkLabel(card, text="", height=6).pack()

        # Безопасность
        sec_a = a.get("security") or {}
        sec_b = b.get("security") or {}
        if sec_a or sec_b:
            sec_card = ctk.CTkFrame(s, fg_color="#243A5E",
                                     corner_radius=10)
            sec_card.pack(fill="x", padx=6, pady=(0, 10))
            ctk.CTkLabel(sec_card, text="🛡  Безопасность",
                         font=("Inter", 13, "bold"),
                         text_color="#82B1FF", anchor="w").pack(
                fill="x", padx=14, pady=(10, 6))
            sa = sec_a.get("score", 0)
            sb = sec_b.get("score", 0)
            if sa == sb:
                col = "#7CFC7C" if sa >= 70 else "#FFD54F"
            elif sb > sa:
                col = "#7CFC7C"
            else:
                col = "#FF8A8A"
            ctk.CTkLabel(sec_card,
                         text=f"   Score: {sa} → {sb}   "
                              f"({'без изменений' if sa==sb else ('+' if sb>sa else '') + str(sb-sa)})",
                         font=("Consolas", 11, "bold"),
                         text_color=col, anchor="w").pack(
                fill="x", padx=14, pady=(0, 6))
            iss_a = set(sec_a.get("issues", []) or [])
            iss_b = set(sec_b.get("issues", []) or [])
            new_iss = iss_b - iss_a
            gone_iss = iss_a - iss_b
            if new_iss:
                ctk.CTkLabel(sec_card,
                             text=f"   🔴 Новые замечания: "
                                  f"{len(new_iss)}",
                             font=("Arial", 10, "bold"),
