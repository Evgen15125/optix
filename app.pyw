    lst.pack(fill="both", expand=True, padx=4, pady=4)

    state = {"data": [], "expanded": set()}

    def _is_external(conn):
        raddr = conn.get("raddr", "—")
        if raddr in ("—", "", "0.0.0.0:0", "::", ":::"): return False
        if raddr.startswith("127.") or raddr.startswith("[::1]"): return False
        return True

    def render():
        for w in lst.winfo_children(): w.destroy()
        q = search_var.get().strip().lower()
        f = filter_var.get()
        shown = 0
        
        for e in state["data"]:
            if q and q not in e["name"].lower(): continue
            if f == "Только установленные" and not any(c["state"].upper() == "ESTABLISHED" for c in e["connections"]): continue
            elif f == "Только слушающие" and not any(c["state"].upper() == "LISTEN" for c in e["connections"]): continue
            elif f == "Только внешние" and not any(_is_external(c) for c in e["connections"]): continue

            is_expanded = e["pid"] in state["expanded"]
            row = ctk.CTkFrame(lst, fg_color="#1F2E4A", corner_radius=10)
            row.pack(fill="x", pady=2, padx=2)

            top = ctk.CTkFrame(row, fg_color="transparent")
            top.pack(fill="x", padx=12, pady=(8, 4))

            toggle_btn = ctk.CTkButton(top, text="▼" if is_expanded else "▶", width=28, height=24,
