# ================== МОНИТОРИНГ ТРАФИКА ПО АДАПТЕРАМ ==================
_net_adapters_state = {
    "active": False,
    "window": None,
    "per_nic_prev": {},
    "history": {},
    "selected": None,
    "rows": {},
    "canvas": None,
    "status": None,
    "history_len": 60,
}


def _net_adapters_snapshot():
    """Возвращает {nic: (bytes_sent, bytes_recv)} или {} при ошибке."""
    try:
        import psutil
        return {nic: (c.bytes_sent, c.bytes_recv)
                for nic, c in psutil.net_io_counters(pernic=True).items()}
    except Exception as e:
        log_error("_net_adapters_snapshot", e)
        return {}


def _net_adapters_fmt_speed(bps):
    """Форматирует скорость в Б/с."""
    if bps is None or bps < 0:
        bps = 0
    if bps < 1024:
        return f"{bps:.0f} Б/с"
    if bps < 1024 * 1024:
        return f"{bps / 1024:.1f} КБ/с"
    if bps < 1024 * 1024 * 1024:
        return f"{bps / (1024 * 1024):.2f} МБ/с"
    return f"{bps / (1024 * 1024 * 1024):.2f} ГБ/с"


def _net_adapters_fmt_bytes(b):
    try:
        return human_size(b) if b else "0 Б"
    except Exception:
        return "0 Б"


def _net_adapters_draw_graph(canvas, data_down, data_up, nic_name):
    """Рисует график ↓/↑ для одного адаптера."""
    canvas.delete("all")
    try:
        w = canvas.winfo_width() or 700
        h = canvas.winfo_height() or 160
    except Exception:
        w, h = 700, 160
    if w < 50:
        w = 700
    if h < 50:
        h = 160

    canvas.create_rectangle(0, 0, w, h, fill="#0D1B33", outline="")
    if len(data_down) < 2 and len(data_up) < 2:
        canvas.create_text(w // 2, h // 2,
                            text=f"Нет данных для {nic_name}",
                            fill="#90A4AE", font=("Inter", 12))
        return

    all_vals = list(data_down) + list(data_up)
    max_val = max(all_vals) if all_vals else 1
    if max_val <= 0:
        max_val = 1

    pad_l, pad_r, pad_t, pad_b = 10, 10, 10, 22
    gw = w - pad_l - pad_r
    gh = h - pad_t - pad_b

    for frac in (0.25, 0.5, 0.75):
        y = pad_t + gh * (1 - frac)
        canvas.create_line(pad_l, y, w - pad_r, y,
                            fill="#1A2A4A", dash=(2, 4))

    def _plot(data, color):
        if len(data) < 2:
            return
        n = len(data)
        step = gw / max(1, n - 1)
        pts = []
        for i, v in enumerate(data):
            x = pad_l + i * step
            y = pad_t + gh - (v / max_val) * gh
            pts.extend([x, y])
        canvas.create_line(*pts, fill=color, width=2)

    _plot(list(data_down), "#4FC3F7")
    _plot(list(data_up), "#FFB74D")

    canvas.create_text(pad_l + 4, pad_t + 4,
                        text=_net_adapters_fmt_speed(max_val),
                        fill="#B0BEC5", font=("Consolas", 8),
                        anchor="nw")
    canvas.create_line(pad_l + 10, h - 10,
                        pad_l + 26, h - 10,
                        fill="#4FC3F7", width=2)
    canvas.create_text(pad_l + 30, h - 10, text="скачивание",
                        fill="#4FC3F7",
                        font=("Arial", 9, "bold"), anchor="w")
    canvas.create_line(pad_l + 110, h - 10,
                        pad_l + 126, h - 10,
                        fill="#FFB74D", width=2)
    canvas.create_text(pad_l + 130, h - 10, text="отдача",
                        fill="#FFB74D",
                        font=("Arial", 9, "bold"), anchor="w")


def _net_adapters_select(nic):
    """Выбор адаптера для графика."""
    _net_adapters_state["selected"] = nic
    for name, row in _net_adapters_state["rows"].items():
        try:
            row["frame"].configure(
                fg_color="#2E5A8E" if name == nic else "#243A5E")
        except Exception:
            pass


def _net_adapters_update():
    """Цикл обновления раз в секунду."""
    st = _net_adapters_state
    win = st.get("window")
    if win is None or not st.get("active"):
        return
    try:
        if not win.winfo_exists():
            st["active"] = False
            return
    except Exception:
        st["active"] = False
        return

    now = time.time()
    snapshot = _net_adapters_snapshot()
    prev = st["per_nic_prev"]
    history = st["history"]

    for nic in sorted(snapshot.keys(), key=lambda x: x.lower()):
        cur = snapshot[nic]
        if nic in prev:
            p_sent, p_recv, p_ts = prev[nic]
            dt = now - p_ts
            if dt > 0:
                down_bps = max(0, (cur[1] - p_recv) / dt)
                up_bps = max(0, (cur[0] - p_sent) / dt)
            else:
                down_bps = 0
                up_bps = 0
        else:
            down_bps = 0
            up_bps = 0

        prev[nic] = (cur[0], cur[1], now)
        h = history.setdefault(nic, [])
        h.append((now, down_bps, up_bps))
        if len(h) > st["history_len"]:
            del h[:len(h) - st["history_len"]]

        row = st["rows"].get(nic)
        if row:
            try:
                row["down"].configure(
                    text=f"↓ {_net_adapters_fmt_speed(down_bps)}")
                row["up"].configure(
                    text=f"↑ {_net_adapters_fmt_speed(up_bps)}")
                row["total"].configure(
                    text=f"Σ ↓ {_net_adapters_fmt_bytes(cur[1])}   "
                         f"↑ {_net_adapters_fmt_bytes(cur[0])}")
            except Exception:
                pass

    sel = st.get("selected")
    if sel and sel in history:
        data = history[sel]
        down_series = [d for (_, d, _) in data]
        up_series = [u for (_, _, u) in data]
        cv = st.get("canvas")
        if cv:
            try:
                _net_adapters_draw_graph(cv, down_series,
                                          up_series, sel)
            except Exception as e:
                log_error("_net_adapters_draw_graph", e)

    total_down = sum((c[1] for c in snapshot.values()), 0)
    total_up = sum((c[0] for c in snapshot.values()), 0)
    lbl = st.get("status")
    if lbl:
        try:
            lbl.configure(
                text=f"Адаптеров: {len(snapshot)}   •   "
                     f"Σ принято: {_net_adapters_fmt_bytes(total_down)}   •   "
                     f"Σ отправлено: {_net_adapters_fmt_bytes(total_up)}   •   "
                     f"{datetime.now().strftime('%H:%M:%S')}",
                text_color="#7CFC7C")
        except Exception:
            pass

    try:
        win.after(1000, _net_adapters_update)
    except Exception:
        st["active"] = False


def _close_net_adapters(win):
    _net_adapters_state["active"] = False
    _net_adapters_state["window"] = None
    try:
        win.destroy()
    except Exception:
        pass


