                     text_color="#82B1FF", anchor="w").pack(
            fill="x", padx=14, pady=(10, 6))

        def add_counter_row(label, value, unit="", warn=None, crit=None):
            if value is None:
                return
            color = "#ffffff"
            try:
                v_int = int(value)
                if crit is not None and v_int >= crit: color = "#FF8A8A"
                elif warn is not None and v_int >= warn: color = "#FFD54F"
            except Exception:
                pass
            r_ = ctk.CTkFrame(counters_card, fg_color="transparent")
            r_.pack(fill="x", padx=14, pady=2)
            ctk.CTkLabel(r_, text=label, font=("Inter", 12),
                         text_color="#90CAF9", anchor="w",
                         width=220).pack(side="left")
            val_text = f"{value} {unit}".strip() if unit else str(value)
            ctk.CTkLabel(r_, text=val_text, font=("Consolas", 12, "bold"),
                         text_color=color, anchor="w").pack(
                side="left", fill="x", expand=True)

        add_counter_row("🌡 Температура:", smart.get("temperature"), "°C", warn=50, crit=70)
        
        _media_str = str(smart.get("media_type", "")).upper()
        if "HDD" not in _media_str:
            add_counter_row("⚙️ Износ (Wear):", smart.get("wear"), "%", warn=50, crit=80)
            
        add_counter_row("⏱ Время работы:", smart.get("power_on_hours"), "ч")
        add_counter_row("🔄 Циклов включения:", smart.get("power_cycle_count"))
        add_counter_row("⏹ Циклов старт/стоп:", smart.get("start_stop_count"))
        add_counter_row("📊 Циклов загрузки/выгрузки:", smart.get("load_cycle_count"))
        add_counter_row("⚠️ Ошибок чтения:", smart.get("read_errors_total"), "", warn=1, crit=10)
        add_counter_row("⚠️ Ошибок записи:", smart.get("write_errors_total"), "", warn=1, crit=10)

        if all(smart.get(k) is None for k in ["temperature", "wear", "read_errors_total"]):
            ctk.CTkLabel(lst,
                         text="⚠️ Диск не предоставляет детальных SMART-данных.\n"
                              "Возможно, это старый HDD или виртуальный диск.",
                         font=("Inter", 12), text_color="#FFD54F").pack(pady=20)

        status_lbl.configure(
            text=f"✅ Данные загружены • {datetime.now().strftime('%H:%M:%S')}",
            text_color="#7CFC7C")

    def worker():
        if disk_number is None:
            app.after(0, lambda: status_lbl.configure(text="Не удалось определить номер диска", text_color="#FF8A8A"))
            return
        smart = _get_detailed_smart(disk_number)
        app.after(0, lambda: render(smart))

    threading.Thread(target=worker, daemon=True).start()

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=40, font=("Inter", 12, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5", corner_radius=20,
                  command=lambda: threading.Thread(target=worker, daemon=True).start()
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="📄 Экспорт отчёта", height=40, font=("Inter", 12, "bold"),
                  fg_color="#2E7D32", hover_color="#43A047", corner_radius=20,
                  command=lambda: _export_disk_report(letter)
                  ).pack(side="left", padx=6, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40, font=("Inter", 12, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=20,
                  command=win.destroy).pack(side="left", padx=(6, 0), fill="x", expand=True)


# ================== TREEMAP ==================
def _treemap_layout(entries, x, y, w, h, total_size):
    """Рекурсивно размещает прямоугольники по алгоритму slice-and-dice."""
    rects = []
    if not entries or total_size <= 0:
        return rects
    entries = sorted(entries, key=lambda e: -e["size"])
    horizontal = w >= h
    current = 0
    for i, e in enumerate(entries):
        ratio = e["size"] / total_size
        if horizontal:
            rect_w = w * ratio
            rects.append((x + current, y, rect_w, h, e))
            current += rect_w
        else:
            rect_h = h * ratio
            rects.append((x, y + current, w, rect_h, e))
            current += rect_h
    return rects


def open_disk_treemap(letter):
    """Открывает окно с визуальной картой диска (Treemap)."""
    win = ctk.CTkToplevel(app)
    win.title(f"🗺 Treemap — {letter}:")
    win.geometry("1200x780")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text=f"🗺  Визуальная карта диска: {letter}:\\",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14, height=40).pack(
        pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Размер блока = размер папки/файла. "
                      "Наведите — увидите детали.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text="Готово к сканированию",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    canvas_frame = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    canvas_frame.pack(padx=20, pady=(0, 10), fill="both", expand=True)

    canvas = tk.Canvas(canvas_frame, bg="#0D1B33", highlightthickness=0)
    canvas.pack(fill="both", expand=True, padx=6, pady=6)

    info_frame = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=10)
    info_frame.pack(padx=20, pady=(0, 10), fill="x")
    info_lbl = ctk.CTkLabel(info_frame, text="Наведите на блок",
                            font=("Consolas", 12), text_color="#B0BEC5",
                            anchor="w", justify="left")
    info_lbl.pack(fill="x", padx=12, pady=8)

    state = {"rects": []}

    def draw_treemap(entries, total_size):
        canvas.delete("all")
        state["rects"] = []
        if not entries or total_size <= 0:
            canvas.create_text(600, 300, text="Нет данных",
                               fill="#90A4AE", font=("Arial", 16))
            return
        cw = canvas.winfo_width()
        ch = canvas.winfo_height()
        if cw < 50:
            cw = 1100
        if ch < 50:
            ch = 600
        rects = _treemap_layout(entries, 0, 0, cw, ch, total_size)
        for (rx, ry, rw, rh, item) in rects:
            color = item.get("color", "#455A64")
            try:
                r_c = int(color[1:3], 16)
                g_c = int(color[3:5], 16)
                b_c = int(color[5:7], 16)
                bright = (r_c + g_c + b_c) / 3
                border = "#000000" if bright > 128 else "#ffffff"
            except Exception:
                border = "#ffffff"
            rect_id = canvas.create_rectangle(rx, ry, rx + rw, ry + rh,
                                               fill=color, outline=border,
                                               width=1)
            state["rects"].append((rx, ry, rx + rw, ry + rh, item, rect_id))
            if rw > 70 and rh > 20:
                name = item.get("name", "")
                size_text = human_size(item["size"])
                display = name[:18] + "..." if len(name) > 18 else name
                canvas.create_text(rx + 6, ry + 6,
                                    text=display, anchor="nw",
                                    fill="#ffffff",
                                    font=("Arial", 9, "bold"))
                canvas.create_text(rx + 6, ry + rh - 6,
                                    text=size_text, anchor="sw",
                                    fill="#e0e8f5",
                                    font=("Consolas", 8))
        status_lbl.configure(
            text=f"Всего: {human_size(total_size)}   •   "
                 f"Элементов: {len(entries)}",
            text_color="#7CFC7C")

    def on_motion(event):
        for (x1, y1, x2, y2, item, rid) in state["rects"]:
            if x1 <= event.x <= x2 and y1 <= event.y <= y2:
                t = "📁 Папка" if item.get("type") == "dir" else "📄 Файл"
                info_lbl.configure(
                    text=f"{t}: {item.get('name', '')}\n"
                         f"Размер: {human_size(item['size'])}\n"
                         f"Путь: {item.get('path', '')}",
                    text_color="#ffffff")
                return
        info_lbl.configure(text="Наведите на блок", text_color="#B0BEC5")

    canvas.bind("<Motion>", on_motion)

    def worker(root_path):
        result_q = queue.Queue()

        def scan():
            try:
                entries = []
                total = 0
                with os.scandir(root_path) as it:
                    for entry in it:
                        try:
                            if entry.is_file(follow_symlinks=False):
                                size = entry.stat(follow_symlinks=False).st_size
                                if size > 0:
                                    entries.append({
                                        "name": entry.name,
                                        "size": size,
                                        "type": "file",
                                        "path": entry.path,
                                        "color": "#455A64",
                                    })
                                    total += size
                            elif entry.is_dir(follow_symlinks=False):
                                s = folder_size(entry.path)
                                if s > 0:
                                    entries.append({
                                        "name": entry.name,
                                        "size": s,
                                        "type": "dir",
                                        "path": entry.path,
                                        "color": "#1565C0",
                                    })
                                    total += s
                        except (OSError, PermissionError):
                            continue
                result_q.put(("done", entries, total))
            except Exception as e:
                result_q.put(("error", str(e)))

        threading.Thread(target=scan, daemon=True).start()

        def poll():
            try:
                item = result_q.get_nowait()
            except queue.Empty:
                app.after(100, poll)
                return
            if item[0] == "done":
                _, entries, total = item
                draw_treemap(entries, total)
            elif item[0] == "error":
                status_lbl.configure(text=f"⚠ {item[1]}", text_color="#FF8A8A")
        app.after(100, poll)

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="▶ Сканировать", height=40,
                  font=("Inter", 14, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=20,
                  command=lambda: (status_lbl.configure(
                      text="⏳ Сканирование...", text_color="#FFD54F"),
                      worker(f"{letter}:\\"))
                  ).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=40,
                  font=("Inter", 14, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=20,
                  command=lambda: (status_lbl.configure(
                      text="⏳ Обновление...", text_color="#FFD54F"),
                      worker(f"{letter}:\\"))
                  ).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40,
                  font=("Inter", 14, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=20,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)
    worker(f"{letter}:\\")


# ================== ОКНО: СТАТИСТИКА ПО ТИПАМ ФАЙЛОВ ==================
def open_file_type_stats(letter):
    win = ctk.CTkToplevel(app)
    win.title(f"📊 Статистика по типам — {letter}:")
    win.geometry("850x720")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text=f"📊  Статистика по типам файлов: {letter}:\\",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14, height=40).pack(
        pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Сколько места занимает каждый тип файлов. "
                      "Цвета соответствуют расширениям.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text="Загрузка...",
                              font=("Inter", 13, "bold"),
                              text_color="#FFD54F", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    def render(stats):
        for w in lst.winfo_children():
            w.destroy()
        if not stats:
            status_lbl.configure(text="Файлы не найдены",
                                 text_color="#90A4AE")
            return
        total_size = sum(s["size"] for s in stats)
        total_count = sum(s["count"] for s in stats)
        status_lbl.configure(
            text=f"Всего типов: {len(stats)}   •   "
                 f"Файлов: {total_count}   •   "
                 f"Размер: {human_size(total_size)}",
            text_color="#7CFC7C")

        for s in stats[:100]:
            row = ctk.CTkFrame(lst, fg_color="#243A5E", corner_radius=8)
            row.pack(fill="x", pady=1, padx=2)
            color_box = tk.Canvas(row, width=20, height=20,
                                   bg="#243A5E", highlightthickness=0)
            color_box.create_rectangle(2, 2, 18, 18,
                                        fill=s["color"], outline="")
            color_box.pack(side="left", padx=(10, 6), pady=6)
            ctk.CTkLabel(row, text=s["ext"], font=("Consolas", 11, "bold"),
                         text_color="#ffffff", anchor="w",
                         width=160).pack(side="left", padx=4, pady=6)
            ctk.CTkLabel(row, text=f"{s['count']} шт.",
                         font=("Inter", 11), text_color="#B0BEC5",
                         anchor="w", width=100).pack(side="left", padx=4,
                                                      pady=6)
            pct = (s["size"] / total_size * 100) if total_size > 0 else 0
            bar = ctk.CTkProgressBar(row, height=10,
                                      progress_color=s["color"])
            bar.set(pct / 100)
            bar.pack(side="left", fill="x", expand=True, padx=8, pady=6)
            ctk.CTkLabel(row, text=f"{human_size(s['size'])}  ({pct:.1f}%)",
                         font=("Consolas", 10, "bold"),
                         text_color=s["color"], anchor="e",
                         width=160).pack(side="right", padx=10, pady=6)

    def worker():
        try:
            stats = _get_file_type_stats(letter)
        except Exception as e:
            log_error("file_type_stats", e)
            app.after(0, lambda: status_lbl.configure(
                text=f"⚠ Ошибка: {e}", text_color="#FF8A8A"))
            return
        app.after(0, lambda: render(stats))

    threading.Thread(target=worker, daemon=True).start()

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=19,
                  command=lambda: threading.Thread(
                      target=worker, daemon=True).start()
                  ).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


# ================== ФРАГМЕНТАЦИЯ ==================
def run_fragmentation_analysis(letter):
    if not messagebox.askyesno(
        f"Анализ фрагментации {letter}:",
        "Запустить анализ фрагментации?\n\n"
        "Это может занять несколько минут."
    ):
        return

    def worker():
        try:
            r = subprocess.run(
                ["defrag", f"{letter}:", "/A", "/V"],
                capture_output=True, timeout=600,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(r.stdout or b"")
        except subprocess.TimeoutExpired:
            out = "Таймаут анализа (10 минут)"
        except Exception as e:
            out = f"Ошибка: {e}"

        def finish():
            import re
            frag_pct = None
            for line in out.splitlines():
                m = re.search(r"(\d+)\s*%\s*фрагмент", line, re.IGNORECASE)
                if m:
                    frag_pct = int(m.group(1))
                    break
                m = re.search(r"фрагмент.*?(\d+)\s*%", line, re.IGNORECASE)
                if m:
                    frag_pct = int(m.group(1))
                    break
            title = f"Анализ фрагментации — {letter}:"
            if frag_pct is not None:
                if frag_pct < 5:
                    verdict = "✅ Фрагментация низкая — дефрагментация не нужна."
                elif frag_pct < 15:
                    verdict = "🟡 Умеренная фрагментация — можно дефрагментировать."
                else:
                    verdict = "🔴 Высокая фрагментация — рекомендуется дефрагментация."
                text = f"📊 Фрагментация: {frag_pct}%\n\n{verdict}\n\n" + out[:3000]
            else:
                text = out[:5000]
            show_output_dialog(title, text)
        app.after(0, finish)

    threading.Thread(target=worker, daemon=True).start()


# ================== ЭКСПОРТ ОТЧЁТА О ДИСКЕ ==================
def _export_disk_report(letter):
    default = f"Optix_Disk_{letter}_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
    path = filedialog.asksaveasfilename(
        title="Сохранить отчёт о диске",
        defaultextension=".txt", initialfile=default,
        filetypes=[("TXT", "*.txt")])
    if not path:
        return

    def worker():
        lines = []
        lines.append("=" * 70)
        lines.append(f"  ОТЧЁТ О ДИСКЕ {letter}: — Optix")
        lines.append(f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        lines.append("=" * 70)
        lines.append("")

        try:
            disks = get_disks_info()
            d = next((x for x in disks if x["mount"].startswith(letter)), None)
            if d:
                lines.append("── ОСНОВНАЯ ИНФОРМАЦИЯ ──")
                lines.append(f"  Модель:        {d.get('model', '—')}")
                lines.append(f"  Тип:           {d.get('media', '—')}")
                lines.append(f"  Интерфейс:     {d.get('bus', '—')}")
                lines.append(f"  Файловая с-ма: {d.get('fstype', '—')}")
                lines.append(f"  Всего:         {human_size(d['total'])}")
                lines.append(f"  Занято:        {human_size(d['used'])} ({d['percent']}%)")
                lines.append(f"  Свободно:      {human_size(d['free'])}")
                lines.append("")
        except Exception as e:
            lines.append(f"Ошибка получения инфо: {e}")

        try:
            r = subprocess.run(
                ["powershell", "-NoProfile", "-Command",
                 f"(Get-Partition -DriveLetter '{letter}' -ErrorAction SilentlyContinue | "
                 f"Get-Disk -ErrorAction SilentlyContinue).Number"],
                capture_output=True, text=True, timeout=15,
                creationflags=CREATE_NO_WINDOW)
            num = (r.stdout or "").strip()
            if num.isdigit():
                smart = _get_detailed_smart(int(num))
                lines.append("── SMART ──")
                for k, v in smart.items():
                    if v is not None and v != "":
                        lines.append(f"  {k:25s}: {v}")
                lines.append("")
        except Exception as e:
            lines.append(f"Ошибка SMART: {e}")

        try:
            stats = _get_file_type_stats(letter)
            if stats:
                lines.append("── ТОП-20 ТИПОВ ФАЙЛОВ ──")
                total = sum(s["size"] for s in stats)
                for s in stats[:20]:
                    pct = (s["size"] / total * 100) if total > 0 else 0
                    lines.append(f"  {s['ext']:15s} {human_size(s['size']):>12s}  "
                                 f"({s['count']} шт., {pct:.1f}%)")
                lines.append("")
        except Exception as e:
            lines.append(f"Ошибка статистики: {e}")

        lines.append("=" * 70)
        lines.append("  Отчёт сформирован программой Optix")
        lines.append("=" * 70)
        try:
            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            app.after(0, lambda: messagebox.showinfo(
                "Готово", f"Отчёт сохранён:\n{path}"))
            try:
                os.startfile(os.path.dirname(path))
            except Exception:
                pass
        except Exception as e:
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


# ================== ОКНО: АНАЛИЗ ПАПОК ==================
def show_folder_analysis(letter):
    win = ctk.CTkToplevel(app)
    win.title(f"Анализ {letter}:\\")
    win.geometry("720x600")
    win.configure(fg_color="#0A1A30")
    head = ctk.CTkLabel(win, text=f"📂 Анализ {letter}:\\",
                        font=("Arial", 17, "bold"), text_color="#ffffff",
                        fg_color="#1565C0", corner_radius=14, height=40)
    head.pack(pady=(14, 10), padx=20, ipadx=20)
    status = ctk.CTkLabel(win, text="Сканирование...", font=("Inter", 13, "bold"),
                          text_color="#FFD54F", fg_color="#0D47A1",
                          corner_radius=10, height=26)
    status.pack(pady=(0, 10), padx=20, fill="x")
    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 14), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    def worker():
        results = []
        try:
            for name in os.listdir(f"{letter}:\\"):
                full = os.path.join(f"{letter}:\\", name)
                if not os.path.isdir(full):
                    continue
                s = folder_size(full)
                if s > 0:
                    results.append((name, s))
        except Exception:
            pass
        results.sort(key=lambda x: -x[1])
        results = results[:20]

        def update():
            status.configure(text=f"Топ-20 папок", text_color="#4FC3F7")
            for w in lst.winfo_children():
                w.destroy()
            if not results:
                ctk.CTkLabel(lst, text="Не удалось проанализировать",
                             font=("Arial", 12), text_color="#90A4AE").pack(pady=30)
                return
            max_size = results[0][1] if results else 1
            for name, size in results:
                row = ctk.CTkFrame(lst, fg_color="#243A5E", corner_radius=10)
                row.pack(fill="x", pady=2, padx=2)
                ctk.CTkLabel(row, text=f"📁 {name}",
                             font=("Inter", 13, "bold"),
                             text_color="#ffffff", anchor="w",
                             width=280).pack(side="left", padx=(10, 4), pady=6)
                bar = ctk.CTkProgressBar(row, height=14, progress_color="#4FC3F7")
                bar.set(size / max_size)
                bar.pack(side="left", fill="x", expand=True, padx=8, pady=6)
                ctk.CTkLabel(row, text=human_size(size),
                             font=("Arial", 11, "bold"), text_color="#4FC3F7",
                             width=100, anchor="e").pack(side="right",
                                                          padx=10, pady=6)
        app.after(0, update)
    threading.Thread(target=worker, daemon=True).start()


# ================== ОКНО: БОЛЬШИЕ ФАЙЛЫ НА ДИСКЕ ==================
def show_big_files(letter):
    win = ctk.CTkToplevel(app)
    win.title(f"Большие файлы {letter}:\\")
    win.geometry("820x640")
    win.configure(fg_color="#0A1A30")
    head = ctk.CTkLabel(win, text=f"📁 Файлы > 100 МБ на {letter}:\\",
                        font=("Arial", 17, "bold"), text_color="#ffffff",
                        fg_color="#1565C0", corner_radius=14, height=40)
    head.pack(pady=(14, 10), padx=20, ipadx=20)
    status = ctk.CTkLabel(win, text="Сканирование...", font=("Inter", 13, "bold"),
                          text_color="#FFD54F", fg_color="#0D47A1",
                          corner_radius=10, height=26)
    status.pack(pady=(0, 10), padx=20, fill="x")
    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 14), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    def worker():
        results = []
        min_size = 100 * 1024 * 1024
        try:
            for r, dirs, files in os.walk(f"{letter}:\\"):
                if "Windows\\System32" in r or "$Recycle.Bin" in r:
                    continue
                for f in files:
                    try:
                        fp = os.path.join(r, f)
                        s = os.path.getsize(fp)
                        if s >= min_size:
                            results.append((fp, s))
                    except Exception:
                        continue
        except Exception:
            pass
        results.sort(key=lambda x: -x[1])
        results = results[:100]

        def update():
            status.configure(
                text=f"Найдено: {len(results)}   •   Всего: {human_size(sum(s for _, s in results))}",
                text_color="#4FC3F7")
            for w in lst.winfo_children():
                w.destroy()
            if not results:
                ctk.CTkLabel(lst, text="Больших файлов не найдено",
                             font=("Arial", 12), text_color="#90A4AE").pack(pady=30)
                return
            for path, size in results:
                row = ctk.CTkFrame(lst, fg_color="#243A5E", corner_radius=8)
                row.pack(fill="x", pady=2, padx=2)
                ctk.CTkLabel(row, text=human_size(size),
                             font=("Arial", 11, "bold"), text_color="#4FC3F7",
                             width=90, anchor="w").pack(side="left",
                                                         padx=(10, 4), pady=4)
                ctk.CTkLabel(row, text=path, font=("Consolas", 12),
                             text_color="#ffffff", anchor="w").pack(
                    side="left", padx=4, pady=4, fill="x", expand=True)
        app.after(0, update)
    threading.Thread(target=worker, daemon=True).start()


# ================== ОКНО: АНАЛИЗАТОР (ДЕРЕВО) ==================
def open_disk_analyzer(letter):
    win = ctk.CTkToplevel(app)
    win.title(f"🔍 Анализ занятого места: {letter}:\\")
    win.geometry("1050x720")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text=f"🔍 Анализ занятого места: {letter}:\\",
                 font=("Inter", 20, "bold"),
                 text_color="#ffffff", fg_color="#1565C0",
                 corner_radius=14, height=40).pack(pady=(14, 6),
                                                    padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Топ-папки и файлы по размеру. Раскрывайте узлы для детализации.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text="Готово к сканированию",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)

    style = ttk.Style()
    try:
        style.theme_use("clam")
    except Exception:
        pass
    style.configure("Disk.Treeview",
                    background="#1A2A4A",
                    foreground="#e0e8f5",
                    fieldbackground="#1A2A4A",
                    rowheight=26,
                    font=("Consolas", 12))
    style.configure("Disk.Treeview.Heading",
                    background="#1565C0",
                    foreground="#ffffff",
                    font=("Arial", 11, "bold"),
                    relief="flat")
    style.map("Disk.Treeview",
              background=[("selected", "#1565C0")],
              foreground=[("selected", "#ffffff")])

    tree_frame = tk.Frame(wrap, bg="#1A2A4A")
    tree_frame.pack(fill="both", expand=True, padx=6, pady=6)

    tree = ttk.Treeview(tree_frame,
                        columns=("size", "percent", "files"),
                        style="Disk.Treeview")
    tree.heading("#0", text="📁 Папка / Файл", anchor="w")
    tree.heading("size", text="Размер", anchor="e")
    tree.heading("percent", text="%", anchor="e")
    tree.heading("files", text="Файлов", anchor="e")
    tree.column("#0", width=520, anchor="w")
    tree.column("size", width=130, anchor="e")
    tree.column("percent", width=90, anchor="e")
    tree.column("files", width=110, anchor="e")

    sb = tk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
    tree.configure(yscrollcommand=sb.set)
    tree.pack(side="left", fill="both", expand=True)
    sb.pack(side="right", fill="y")

    result_q = queue.Queue()

    def scan_dir(path, depth, max_depth):
        total_size = 0
        total_files = 0
        entries = []
        try:
            with os.scandir(path) as it:
                for entry in it:
                    try:
                        if entry.is_file(follow_symlinks=False):
                            size = entry.stat(follow_symlinks=False).st_size
                            entries.append((entry.name, size, 1, False, None))
                            total_size += size
                            total_files += 1
                        elif entry.is_dir(follow_symlinks=False):
                            if depth >= max_depth:
                                sub_size = 0
                                sub_files = 0
                                try:
                                    for r_, _, fs in os.walk(entry.path):
                                        for f in fs:
                                            try:
                                                sub_size += os.path.getsize(os.path.join(r_, f))
                                                sub_files += 1
                                            except Exception:
                                                continue
                                except Exception:
                                    pass
                                entries.append((entry.name, sub_size, sub_files, True, None))
                                total_size += sub_size
                                total_files += sub_files
                            else:
                                sub_size, sub_files, children = scan_dir(
                                    entry.path, depth + 1, max_depth
                                )
                                entries.append((entry.name, sub_size, sub_files, True, children))
                                total_size += sub_size
                                total_files += sub_files
                    except (OSError, PermissionError):
                        continue
        except (OSError, PermissionError):
            pass
        entries.sort(key=lambda x: -x[1])
        return total_size, total_files, entries

    def worker(root):
        try:
            result_q.put(("progress", "Сканирую верхний уровень..."))
            total_size, total_files, entries = scan_dir(root, 0, 2)
            result_q.put(("done", root, total_size, total_files, entries))
        except Exception as e:
            log_error("disk_analyzer_scan", e)
            result_q.put(("error", str(e)))

    def populate(parent_node, entries, total_size):
        if not entries:
            return
        for name, size, files, is_dir, children in entries:
            icon = "📁" if is_dir else "📄"
            percent = (size / total_size * 100) if total_size > 0 else 0
            node = tree.insert(
                parent_node, "end",
                text=f" {icon} {name}",
                values=(human_size(size), f"{percent:.1f}%", files),
                open=False
            )
            if is_dir and children:
                populate(node, children, size)

    def poll():
        try:
            item = result_q.get_nowait()
        except queue.Empty:
            app.after(150, poll)
            return
        if item[0] == "progress":
            status_lbl.configure(text=f"⏳ {item[1]}", text_color="#FFD54F")
            app.after(100, poll)
        elif item[0] == "error":
            status_lbl.configure(text=f"⚠ Ошибка: {item[1]}",
                                  text_color="#FF8A8A")
        elif item[0] == "done":
            _, root, total_size, total_files, entries = item
            tree.delete(*tree.get_children())
            if entries:
                populate("", entries, total_size)
            status_lbl.configure(
                text=f"✅ Всего: {human_size(total_size)} • Файлов: {total_files}",
                text_color="#7CFC7C"
            )
            return

    def start_scan():
        tree.delete(*tree.get_children())
        status_lbl.configure(text="⏳ Сканирование...", text_color="#FFD54F")
        threading.Thread(target=worker, args=(f"{letter}:\\",),
                          daemon=True).start()
        app.after(100, poll)

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="▶ Начать сканирование", height=40,
                  font=("Inter", 14, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=20,
                  command=start_scan).pack(side="left", padx=(0, 4),
                                            fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40,
                  font=("Inter", 14, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=20,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)
    start_scan()


# ================== TRIM / DEFRAG ==================
def run_trim(letter):
    if not messagebox.askyesno(f"TRIM {letter}:", "Оптимизировать SSD?"):
        return
    try:
        r = subprocess.run(["defrag", f"{letter}:", "/L"],
                           capture_output=True, timeout=180,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
        messagebox.showinfo("TRIM", out[:1500])
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def run_defrag(letter):
    if not messagebox.askyesno(f"Дефраг {letter}:", "Продолжить?"):
        return
    try:
        r = subprocess.run(["defrag", f"{letter}:", "/O"],
                           capture_output=True, timeout=600,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
        messagebox.showinfo("Дефрагментация", out[:1500])
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


