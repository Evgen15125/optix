            text=f"Драйверов: {len(state['drivers'])}   •   Показано: {len(shown)}   •   Общий размер: {human_size(total_size)}   •   Дубликатов: {sum(1 for d in state['drivers'] if d.get('_duplicate'))} ({human_size(duplicates_size)})",
            text_color="#7CFC7C")

    def worker():
        drivers = _driver_store_get_installed()
        drivers = _driver_store_get_sizes(drivers)
        drivers = _driver_store_find_duplicates(drivers)
        drivers.sort(key=lambda d: (not d.get("_duplicate", False), d.get("original", "").lower()))
        state["drivers"] = drivers
        app.after(0, render)

    def select_duplicates():
        for oem, var in state["checkboxes"].items():
            d = next((x for x in state["drivers"] if x["oem"] == oem), None)
            if d and d.get("_duplicate"): var.set(1)

    def select_all():
        for var in state["checkboxes"].values(): var.set(1)

    def clear_all():
        for var in state["checkboxes"].values(): var.set(0)

    def delete_selected():
        selected = [oem for oem, var in state["checkboxes"].items() if var.get() == 1]
        if not selected:
            messagebox.showinfo("Optix", "Ничего не выбрано.")
            return
        if not messagebox.askyesno("⚠️ Удалить драйверы?", f"Будет удалено из хранилища: {len(selected)}\n\n⚠️ Рекомендуется сначала создать точку восстановления.\n\nПродолжить?"):
            return
        if not _driver_ensure_restore_point(): return
        if not messagebox.askyesno("Подтверждение", "ТОЧНО удалить выбранные драйверы?"): return
        status_lbl.configure(text="⏳ Удаление...", text_color="#FFD54F")

        def do_delete():
            ok, fail, errors = _driver_store_delete(selected, force=True)
            def finish():
                lines = ["=" * 60, "  УДАЛЕНИЕ ДРАЙВЕРОВ", "=" * 60, "", f"  Удалено: {ok}", f"  Ошибок: {fail}", ""]
                if errors:
                    lines.append("Ошибки (первые 10):")
                    for e in errors[:10]: lines.append(f"  • {e}")
                show_output_dialog("Удаление драйверов", "\n".join(lines))
                worker()
            app.after(0, finish)
        threading.Thread(target=do_delete, daemon=True).start()

