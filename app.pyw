        btn_colors = {
            "standard": {"fg": "#1F2E4A", "hover": "#2E5A8E"},
            "green": {"fg": "#2E7D32", "hover": "#43A047"},
            "purple": {"fg": "#6A1B9A", "hover": "#8E24AA"}
        }

        def make_btn(parent, text, cmd, style="standard"):
            c = btn_colors[style]
