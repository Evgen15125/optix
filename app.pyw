def _driver_store_get_installed():
    """Возвращает список драйверов в Driver Store через pnputil /enum-drivers."""
    drivers = []
    try:
        r = subprocess.run(["pnputil", "/enum-drivers"],
                           capture_output=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
    except Exception as e:
        log_error("_driver_store_get_installed", e)
        return []

    # Парсим вывод pnputil
    current = {}
    for line in out.splitlines():
        line = line.strip()
        if not line:
            if current.get("oem"):
                drivers.append(current)
                current = {}
            continue
        low = line.lower()
        # Имя опубликованного драйвера
        if line.startswith("Опубликованное имя") or \
           line.startswith("Published Name"):
            if current.get("oem"):
                drivers.append(current)
                current = {}
            current["oem"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Исходное имя") or \
             line.startswith("Original Name"):
            current["original"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Имя поставщика") or \
             line.startswith("Provider Name"):
            current["provider"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Класс") or line.startswith("Class Name"):
            current["class"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Версия драйвера") or \
             line.startswith("Driver Version"):
            current["version"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Дата драйвера") or \
             line.startswith("Driver Date"):
            current["date"] = line.split(":", 1)[-1].strip()
        elif line.startswith("Подпись") or line.startswith("Signer Name"):
            current["signer"] = line.split(":", 1)[-1].strip()
    if current.get("oem"):
        drivers.append(current)
    return drivers


def _driver_store_get_sizes(drivers):
    """
    Добавляет к каждому драйверу размер папки в FileRepository.
    Использует поиск по имени original (например, nv_dispi.inf).
    """
    for d in drivers:
        original = d.get("original", "").strip().lower()
        size = 0
        if original and os.path.isdir(DRIVER_STORE_DIR):
            base = os.path.splitext(original)[0]
            # Ищем папку, начинающуюся с base_
            try:
                for entry in os.listdir(DRIVER_STORE_DIR):
                    if entry.lower().startswith(base + "_") or \
                       entry.lower() == original:
                        full = os.path.join(DRIVER_STORE_DIR, entry)
                        if os.path.isdir(full):
                            size += folder_size(full)
            except Exception:
                pass
        d["size_bytes"] = max(0, size)
    return drivers


def _driver_store_find_duplicates(drivers):
    """
    Находит драйверы с одинаковым (original, provider), но разными версиями.
    Помечает их как 'duplicate' (кроме самого нового).
    """
    groups = {}
    for d in drivers:
        key = (d.get("original", "").lower().strip(),
               d.get("provider", "").lower().strip())
        if not key[0]:
            continue
        groups.setdefault(key, []).append(d)

    def parse_version(v):
        """Преобразует '1.2.3.4' в кортеж int."""
        try:
            parts = re.findall(r"\d+", v or "")
            return tuple(int(x) for x in parts) if parts else (0,)
        except Exception:
            return (0,)

    for key, items in groups.items():
        if len(items) < 2:
            items[0]["_duplicate"] = False
            continue
        # Сортируем по версии (убывание)
        items.sort(key=lambda x: parse_version(x.get("version", "")),
                    reverse=True)
        for i, d in enumerate(items):
            d["_duplicate"] = (i > 0)  # всё, кроме самого нового

    # Если группы не обрабатывались — проставляем False
    for d in drivers:
        d.setdefault("_duplicate", False)
    return drivers


def _driver_age_icon(date_str):
    """Возвращает (icon, color, text) по дате драйвера."""
    if not date_str:
        return "⚪", "#B0BEC5", "неизвестно"
    # Парсим дату в разных форматах
    parsed = None
    for fmt in ("%d.%m.%Y", "%Y-%m-%d", "%m/%d/%Y"):
        try:
            parsed = datetime.strptime(date_str.strip(), fmt)
            break
        except Exception:
            continue
    if not parsed:
        return "⚪", "#B0BEC5", date_str
    age_days = (datetime.now() - parsed).days
    if age_days < 0:
        return "🟢", "#7CFC7C", f"{date_str} (свежий)"
    years = age_days / 365.25
    if years < 1:
        return "🟢", "#7CFC7C", f"{date_str} (< 1 года)"
    if years < 2:
        return "🟡", "#FFD54F", f"{date_str} ({years:.1f} года)"
    return "🔴", "#FF8A8A", f"{date_str} ({years:.1f} лет)"


def _driver_store_delete(oem_names, force=True):
    """Удаляет драйверы из Driver Store через pnputil /delete-driver."""
    if not oem_names:
        return 0, 0, []
    ok = 0
    fail = 0
    errors = []
    for oem in oem_names:
        try:
            cmd = ["pnputil", "/delete-driver", oem]
            if force:
                cmd += ["/uninstall", "/force"]
            r = subprocess.run(cmd, capture_output=True, timeout=60,
                               creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                ok += 1
            else:
                fail += 1
                msg = _decode_console_bytes(
                    (r.stdout or b"") + b" " + (r.stderr or b""))[:200]
                errors.append(f"{oem}: {msg}")
        except Exception as e:
            fail += 1
            errors.append(f"{oem}: {e}")
    return ok, fail, errors


