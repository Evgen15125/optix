                               fg_color="#1F2E4A", text_color="#ffffff", corner_radius=10)
    name_entry.pack(padx=30, fill="x", pady=(2, 10))
    name_entry.insert(0, default_name)

    ctk.CTkLabel(dlg, text="Команда (путь к файлу):", font=("Inter", 12, "bold"),
                 text_color="#82B1FF", anchor="w").pack(fill="x", padx=30)
    cmd_entry = ctk.CTkEntry(dlg, height=36, font=("Consolas", 11),
                              fg_color="#1F2E4A", text_color="#ffffff", corner_radius=10)
    cmd_entry.pack(padx=30, fill="x", pady=(2, 10))
    cmd_entry.insert(0, f'"{path}"')

    where_var = ctk.StringVar(value="HKCU")
    wr = ctk.CTkFrame(dlg, fg_color="transparent")
    wr.pack(padx=30, fill="x")
    ctk.CTkLabel(wr, text="Куда:", font=("Inter", 12, "bold"),
                 text_color="#82B1FF").pack(side="left", padx=(0, 8))
    ctk.CTkOptionMenu(wr, values=["HKCU", "HKLM"], variable=where_var,
                      width=140, height=34, fg_color="#1F2E4A",
                      button_color="#1976D2", font=("Inter", 12)).pack(side="left")

    def do_add():
        name = name_entry.get().strip()
        cmd = cmd_entry.get().strip()
        where = where_var.get()
        if not name or not cmd:
            messagebox.showerror("Ошибка", "Заполните оба поля.")
            return
        try:
            if where == "HKCU": root = winreg.HKEY_CURRENT_USER
            else: root = winreg.HKEY_LOCAL_MACHINE
            path_r = r"Software\Microsoft\Windows\CurrentVersion\Run"
            try: key = winreg.OpenKey(root, path_r, 0, winreg.KEY_SET_VALUE)
            except FileNotFoundError: key = winreg.CreateKeyEx(root, path_r, 0, winreg.KEY_SET_VALUE)
            winreg.SetValueEx(key, name, 0, winreg.REG_SZ, cmd)
            winreg.CloseKey(key)
            messagebox.showinfo("Готово", f"«{name}» добавлено в автозапуск ({where}).")
            dlg.destroy()
            refresh_autostart_ui()
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    ctk.CTkButton(dlg, text="💾 Добавить", height=44,
                  font=("Inter", 14, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=22,
                  command=do_add).pack(pady=16, padx=30, fill="x")

