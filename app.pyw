def _pnp_list_devices():
    """Список всех PnP-устройств через PowerShell."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "Get-PnpDevice | Select-Object "
        "Status,Class,FriendlyName,InstanceId,DeviceID,"
        "Problem,ProblemDescription | "
        "ConvertTo-Json -Compress -Depth 4"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=300,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        result = []
        for d in data:
            if not isinstance(d, dict):
                continue
            result.append({
                "status": str(d.get("Status") or "Unknown"),
                "class": str(d.get("Class") or ""),
                "name": str(d.get("FriendlyName") or "?"),
                "instance_id": str(d.get("InstanceId") or ""),
                "device_id": str(d.get("DeviceID") or ""),
                "problem": d.get("Problem") or 0,
                "problem_desc": str(d.get("ProblemDescription") or ""),
                "driver_version": str(d.get("DriverVersion") or ""),
                "driver_date": str(d.get("DriverDate") or ""),
                "manufacturer": str(d.get("Manufacturer") or ""),
            })
        return result
    except Exception as e:
        log_error("_pnp_list_devices", e)
        return []


def _pnp_export_csv(devices):
    """Экспорт устройств в CSV."""
    if not devices:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    default = f"Optix_Devices_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.csv"
    path = filedialog.asksaveasfilename(
        title="Экспорт устройств в CSV", defaultextension=".csv",
        initialfile=default, filetypes=[("CSV", "*.csv")])
    if not path:
        return
    try:
        import csv
        with open(path, "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f, delimiter=";")
            w.writerow(["Статус", "Класс", "Имя", "Производитель",
                        "Версия драйвера", "Дата драйвера",
                        "Проблема", "ID устройства"])
            for d in devices:
                w.writerow([
                    d["status"], d["class"], d["name"],
                    d["manufacturer"], d["driver_version"],
                    d["driver_date"], d["problem_desc"] or d["problem"],
                    d["device_id"],
                ])
        messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def _pnp_get_details(instance_id, name):
    """Открывает окно с деталями устройства."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        f"$dev = Get-PnpDevice -InstanceId '{instance_id}' "
        "-ErrorAction SilentlyContinue; "
        "if ($dev) { "
        "  $props = Get-PnpDeviceProperty -InstanceId "
        f"'{instance_id}' -ErrorAction SilentlyContinue; "
        "  $props | Select-Object KeyName,Data | "
        "ConvertTo-Json -Compress -Depth 3 "
        "}"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            messagebox.showinfo("Детали", "Нет данных.")
            return
        props = json.loads(out)
        if isinstance(props, dict):
            props = [props]
        lines = [f"📋 {name}", f"InstanceID: {instance_id}", ""]
        skip_keys = {"DEVPKEY_Device_ContainerID",
                      "DEVPKEY_NAME"}
        for p in props:
            if not isinstance(p, dict):
                continue
            k = str(p.get("KeyName") or "")
            v = p.get("Data")
            if k in skip_keys or v in (None, ""):
                continue
            # Упрощаем ключ
            short = k.replace("DEVPKEY_Device_", "")
            lines.append(f"  {short}: {v}")
        show_output_dialog(f"Детали: {name}", "\n".join(lines))
    except Exception as e:
        log_error("_pnp_get_details", e)
        messagebox.showerror("Ошибка", str(e))


def _pnp_disable(instance_id):
    """Отключает устройство."""
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             f"Disable-PnpDevice -InstanceId '{instance_id}' "
             f"-Confirm:$false"],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        if r.returncode == 0:
            return True, ""
        return False, (r.stderr or r.stdout or "")[:300]
    except Exception as e:
        return False, str(e)


def _pnp_enable(instance_id):
    """Включает устройство."""
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             f"Enable-PnpDevice -InstanceId '{instance_id}' "
             f"-Confirm:$false"],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        if r.returncode == 0:
            return True, ""
        return False, (r.stderr or r.stdout or "")[:300]
    except Exception as e:
        return False, str(e)


def _pnp_rollback(instance_id, name):
    """Откатывает драйвер к предыдущей версии."""
    # Проверяем, есть ли доступные откаты
    ps_check = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        f"$d = Get-PnpDevice -InstanceId '{instance_id}' "
        "-ErrorAction SilentlyContinue; "
        "if ($d) { "
        "  (Get-PnpDeviceProperty -InstanceId "
        f"'{instance_id}' -KeyName "
        "'DEVPKEY_Device_DriverVersion' "
        "-ErrorAction SilentlyContinue).Data "
        "}"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command",
                             ps_check],
                           capture_output=True, text=True, timeout=20,
                           createflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        current_ver = (r.stdout or "").strip()
    except Exception:
        current_ver = "?"

    if not messagebox.askyesno(
        "🔄 Откат драйвера?",
        f"Устройство: {name}\n\n"
        f"Текущая версия: {current_ver}\n\n"
        f"Windows попробует вернуть предыдущую версию драйвера.\n"
        f"Если откат недоступен — выйдет сообщение об ошибке.\n\n"
        f"Продолжить?"):
        return False

    # Откат через pnputil не поддерживается напрямую.
    # Используем PowerShell-командлет или SetupAPI.
    # В Windows есть "Update-Driver" и "Uninstall-PnpDevice" с роллбэком
    # Через PowerShell:
    try:
        ps = (
            f"$d = Get-PnpDevice -InstanceId '{instance_id}' "
            "-ErrorAction SilentlyContinue; "
            "if ($d) { "
            "  $d | Get-PnpDeviceProperty "
            "-KeyName 'DEVPKEY_Device_DriverVersion' | Out-Null; "
            "  # Откат через реестр: удаляем текущий пакет, "
            "  # Windows выберет предыдущий "
            "  pnputil /enum-drivers; "
            "}"
        )
        # В Windows нет чистого командлета Rollback-PnpDevice.
        # Реальный откат = удаление текущего драйвера из DriverStore.
        # После этого Windows при перезагрузке выберет предыдущий.
        msg = ("⚠️ Windows не предоставляет простой команды для отката "
               "драйвера через PowerShell.\n\n"
               "Рекомендуемые способы:\n\n"
               "  1. Диспетчер устройств (devmgmt.msc):\n"
               f"     • Найти «{name}»\n"
               "     • Свойства → Драйвер → Откатить\n\n"
               "  2. Восстановление системы (rstrui.exe)\n\n"
               "Optix откроет Диспетчер устройств — там сделаете "
               "откат вручную.")
        if messagebox.askyesno("Открыть Диспетчер устройств?",
                                msg + "\n\nОткрыть devmgmt.msc?"):
            try:
                subprocess.Popen(["mmc.exe", "devmgmt.msc"],
                                 creationflags=CREATE_NO_WINDOW)
            except Exception:
                try:
                    subprocess.Popen(["devmgmt.msc"])
                except Exception:
                    pass
        return True
    except Exception as e:
        log_error("_pnp_rollback", e)
        messagebox.showerror("Ошибка", str(e))
        return False


# ─── Точка восстановления перед установкой драйвера ───

def _driver_check_restore_point():
    """Проверяет, есть ли свежая точка восстановления (< 1 дня)."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$pts = Get-ComputerRestorePoint -ErrorAction SilentlyContinue | "
        "Sort-Object CreationTime -Descending | Select-Object -First 1; "
        "if ($pts) { $pts.CreationTime } else { '' }"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return None
        return out
    except Exception:
        return None


def _driver_create_restore_point():
    """Создаёт точку восстановления."""
    name = f"Optix_Drivers_{datetime.now().strftime('%Y-%m-%d_%H-%M')}"
    try:
        ps = (f"Checkpoint-Computer -Description '{name}' "
              f"-RestorePointType 'DEVICE_DRIVER_INSTALL'")
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=180,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        if r.returncode == 0:
            return True, name
        return False, (r.stderr or r.stdout or "")[:300]
    except Exception as e:
        return False, str(e)


def _driver_ensure_restore_point():
    """Проверяет точку, если нет — предлагает создать."""
    last = _driver_check_restore_point()
    need_create = False
    if last:
        try:
            # last может быть в формате WMI: /Date(1699999999999)/ или ISO
            import re as _re
            m = _re.search(r"/Date\((\d+)\)/", last)
            if m:
                ts_ms = int(m.group(1))
                dt = datetime.fromtimestamp(ts_ms / 1000)
            else:
                dt = datetime.strptime(last[:19], "%Y-%m-%d %H:%M:%S")
            age_hours = (datetime.now() - dt).total_seconds() / 3600
            if age_hours > 24:
                need_create = True
        except Exception:
            need_create = True
    else:
        need_create = True

    if not need_create:
        return True

    msg = ("⚠️ Нет свежей точки восстановления (< 24 ч).\n\n"
           "Перед установкой/удалением драйверов настоятельно "
           "рекомендуется создать точку восстановления.\n\n"
           "Создать точку сейчас?")
    if not messagebox.askyesno("Точка восстановления", msg):
        return False

    ok, info = _driver_create_restore_point()
    if ok:
        messagebox.showinfo("Готово", f"Точка создана: {info}")
        return True
    else:
        messagebox.showerror("Ошибка", f"Не создать точку:\n{info}")
        return False


# ─── Мониторинг изменений драйверов ───

DRIVER_HISTORY_PATH = os.path.join(BASE_DIR, "driver_history.json")


def _driver_history_load():
    try:
        with open(DRIVER_HISTORY_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"snapshots": []}


def _driver_history_save(data):
    try:
        # Держим не больше 50 снимков
        if len(data.get("snapshots", [])) > 50:
            data["snapshots"] = data["snapshots"][-50:]
        with open(DRIVER_HISTORY_PATH, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log_error("_driver_history_save", e)


def _driver_history_add_snapshot(devices):
    """Сохраняет снимок текущего состояния драйверов."""
    data = _driver_history_load()
    snap = {
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "count": len(devices),
        "devices": {},
    }
    for d in devices:
        iid = d["instance_id"]
        if not iid:
            continue
        snap["devices"][iid] = {
            "name": d["name"],
            "version": d["driver_version"],
            "date": d["driver_date"],
            "class": d["class"],
        }
    data["snapshots"].append(snap)
    _driver_history_save(data)
    return snap


def _driver_history_diff_last():
    """Сравнивает последний снимок с предыдущим."""
    data = _driver_history_load()
    snaps = data.get("snapshots", [])
    if len(snaps) < 2:
        return None
    a = snaps[-2]["devices"]
    b = snaps[-1]["devices"]
    added = []
    removed = []
    updated = []
    for iid, info in b.items():
        if iid not in a:
            added.append((iid, info))
        elif a[iid].get("version") != info.get("version"):
            updated.append((iid, a[iid], info))
    for iid, info in a.items():
        if iid not in b:
            removed.append((iid, info))
    return {
        "a_time": snaps[-2]["timestamp"],
        "b_time": snaps[-1]["timestamp"],
        "added": added,
        "removed": removed,
        "updated": updated,
    }


