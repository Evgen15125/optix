                    if _snapshots_delete(path):
                        if path in state["selected"]:
                            state["selected"].remove(path)
                        refresh()
                return do

            ctk.CTkButton(row, text="🗑", width=36, height=26,
                          font=("Arial", 10, "bold"),
                          fg_color="#B71C1C", hover_color="#E53935",
                          corner_radius=13, command=make_delete()
                          ).pack(side="right", padx=6, pady=4)

        # ─── Кнопка сравнения ───
