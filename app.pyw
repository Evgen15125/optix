# ─── Утилиты ───
def _bench_geomean(values):
    if not values:
        return 0
    product = 1.0
    for v in values:
        if v <= 0:
            v = 0.01
        product *= v
    return product ** (1.0 / len(values))


def _bench_normalize(value, reference, lower_is_better=False):
    if reference <= 0:
        return 500
    if value is None or value <= 0:
        return 1
    if lower_is_better:
        ratio = reference / value
    else:
        ratio = value / reference
    return max(1, min(10000, int(1000 * ratio)))


def _bench_timing(func):
    gc.collect()
    start = time.perf_counter()
    result = func()
    elapsed = time.perf_counter() - start
    return result, elapsed


def _bench_deviation(score):
    """Отклонение от эталона (1000)."""
    return (score - 1000) / 10.0


def _make_result(value, unit, ref_key, lower_is_better=False):
    """Собирает результат в единый формат."""
    ref = BENCH_REFERENCE.get(ref_key, 1000)
    score = _bench_normalize(value, ref, lower_is_better)
    return {"value": value, "unit": unit, "score": score, "ref": ref}


# ─── CPU Integer Single ───
def bench_cpu_integer_single():
    def work():
        total = 0
        for i in range(1, 20_000_001):
            total += (i * i) % 7919 + (i >> 4) - (i % 13)
        return total
    _, elapsed = _bench_timing(work)
    elapsed = max(0.05, elapsed)
    score = int(2000 * 2.0 / elapsed)
    return {"value": score, "unit": "балл", "elapsed": elapsed,
            "score": _bench_normalize(score, BENCH_REFERENCE["cpu_integer_single"]),
            "ref": BENCH_REFERENCE["cpu_integer_single"]}


# ─── CPU Integer Multi ───
def bench_cpu_integer_multi():
    import concurrent.futures
    import psutil
    cores = psutil.cpu_count(logical=True) or 4

    def count_primes(limit):
        c = 0
        for n in range(2, limit):
            is_p = True
            for d in range(2, int(n ** 0.5) + 1):
                if n % d == 0:
                    is_p = False
                    break
            if is_p:
                c += 1
        return c

    def work():
        with concurrent.futures.ThreadPoolExecutor(max_workers=cores) as ex:
            fs = [ex.submit(count_primes, 60000) for _ in range(cores)]
            return sum(f.result() for f in fs)

    _, elapsed = _bench_timing(work)
    elapsed = max(0.1, elapsed)
    score = int(cores * 500 * 1.5 / elapsed)  # без min
    return {"value": score, "unit": "балл", "elapsed": elapsed,
            "cores": cores,
            "score": _bench_normalize(score, BENCH_REFERENCE["cpu_integer_multi"]),
            "ref": BENCH_REFERENCE["cpu_integer_multi"]}


