        make_btn(btn_grid, "📊 Типы файлов", mk(fn=open_file_type_stats)).grid(row=1, column=1, padx=3, pady=3, sticky="ew")
        make_btn(btn_grid, "🗂 Анализатор", mk(fn=open_disk_analyzer)).grid(row=1, column=2, padx=3, pady=3, sticky="ew")

        # Ряд 3
        if media == "hdd":
            make_btn(btn_grid, "📊 Фрагментация", mk(fn=run_fragmentation_analysis)).grid(row=2, column=0, padx=3, pady=3, sticky="ew")
        else:
            make_btn(btn_grid, "📁 Большие файлы", mk(fn=show_big_files)).grid(row=2, column=0, padx=3, pady=3, sticky="ew")
        
