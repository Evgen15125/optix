def _run_cpu_stress(duration_min):
    """Стресс-тест CPU через subprocess (обход GIL)."""
    import psutil

    cores = psutil.cpu_count(logical=True) or 4
    total_seconds = duration_min * 60

    win = ctk.CTkToplevel(app)
    win.title("🔥 Стресс-тест CPU (выполняется)")
    win.geometry("520x300")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    win.grab_set()
    win.protocol("WM_DELETE_WINDOW", lambda: None)

    ctk.CTkLabel(win, text="🔥  Стресс-тест CPU",
                 font=("Arial", 17, "bold"), text_color="#ffffff",
                 fg_color="#B71C1C", corner_radius=14, height=40).pack(
        pady=(14, 8), padx=20, ipadx=20)
    status_lbl = ctk.CTkLabel(win, text="⏳ Подготовка...",
                              font=("Inter", 13, "bold"),
                              text_color="#FFD54F", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")
    progress = ctk.CTkProgressBar(win, height=18, progress_color="#D32F2F")
    progress.set(0)
    progress.pack(pady=(4, 10), padx=20, fill="x")
    temp_lbl = ctk.CTkLabel(win, text="🌡 — °C   •   Прошло: 0:00 / 0:00",
                            font=("Inter", 13, "bold"),
                            text_color="#ffffff")
    temp_lbl.pack(pady=(0, 6))
    peak_lbl = ctk.CTkLabel(win, text="Пиковая: — °C",
                            font=("Inter", 12), text_color="#B0BEC5")
    peak_lbl.pack(pady=(0, 12))

    temp_samples = []
    abort_reason = {"reason": None}
    stress_procs = []

    py_exe = _get_python_console_path()

    child_code = (
        "import time\n"
        f"end = time.time() + {total_seconds + 60}\n"
        "x = 0\n"
        "y = 0.0\n"
        "while time.time() < end:\n"
        "    for i in range(1, 50001):\n"
        "        x = (x + i * i) % 1000003\n"
        "        y += (x % 17) * 0.001\n"
    )

    def update_ui(elapsed, peak):
        try:
            progress.set(min(elapsed / total_seconds, 1.0))
            mm = int(elapsed) // 60
            ss = int(elapsed) % 60
            t_mm = total_seconds // 60
            t_ss = total_seconds % 60
            status_lbl.configure(
                text=f"🔥 Нагрузка (все ядра)... {mm}:{ss:02d} / "
                     f"{t_mm}:{t_ss:02d}",
                text_color="#FF8A8A")
            cur_t = temp_samples[-1] if temp_samples else None
            cur_txt = f"{cur_t:.0f}" if cur_t is not None else "—"
            temp_lbl.configure(text=f"🌡 {cur_txt} °C   •   "
                                     f"Прошло: {mm}:{ss:02d} / "
                                     f"{t_mm}:{t_ss:02d}")
            peak_txt = f"{peak:.0f}" if peak is not None else "—"
            peak_lbl.configure(text=f"Пиковая: {peak_txt} °C")
        except Exception:
            pass

    def monitor_worker():
        # ─── ШАГ 0: Настойчивый запуск OHM с прогревом ───
        app.after(0, lambda: status_lbl.configure(
            text="⏳ Запуск датчиков температуры...",
            text_color="#FFD54F"))
        try:
            _ensure_ohm_running()
        except Exception as e:
            log_error("stress_ensure_ohm", e)

        # Прогрев: ждём до 20 сек, пока OHM начнёт отдавать данные
        warmup_deadline = time.time() + 20
        got_temp = False
        while time.time() < warmup_deadline:
            try:
                temps = _get_temperatures()
                t = temps.get("cpu")
                if t is not None:
                    got_temp = True
                    temp_samples.append(t)
                    break
            except Exception as e:
                log_error("stress_warmup", e)
            left = max(0, int(warmup_deadline - time.time()))
            app.after(0, lambda l=left: status_lbl.configure(
                text=f"⏳ Прогрев датчиков OHM... ({l} сек)",
                text_color="#FFD54F"))
            time.sleep(2)

        if not got_temp:
            # Температура недоступна — спрашиваем пользователя
            decision = {"continue": False}
            ev = threading.Event()

            def ask():
                try:
                    r = messagebox.askyesno(
                        "Датчики температуры недоступны",
                        "Не удалось получить температуру CPU за 20 секунд.\n\n"
                        "Возможные причины:\n"
                        "• OpenHardwareMonitor не установлен (скачайте с "
                        "https://openhardwaremonitor.org).\n"
                        "• Антивирус блокирует WMI-доступ.\n"
                        "• Драйвер MSR не подписан для этой Windows.\n\n"
                        "Продолжить тест БЕЗ мониторинга температуры?\n"
                        "Результат покажет только стабильность нагрузки.")
                    decision["continue"] = r
                except Exception:
                    decision["continue"] = False
                finally:
                    ev.set()
            app.after(0, ask)
            ev.wait(timeout=120)

            if not decision["continue"]:
                def _cancel():
                    try:
                        win.grab_release()
                        win.destroy()
                    except Exception:
                        pass
                    try:
                        diag_ui["status"].configure(
                            text="⏹ Стресс-тест отменён",
                            text_color="#B0BEC5")
                    except Exception:
                        pass
                app.after(0, _cancel)
                return

        # ─── ШАГ 1: Запуск дочерних Python-процессов ───
        try:
            for _ in range(cores):
                p = subprocess.Popen(
                    [py_exe, "-c", child_code],
                    creationflags=CREATE_NO_WINDOW,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
                stress_procs.append(p)
        except Exception as e:
            log_error("stress_spawn", e)

        # ─── ШАГ 2: Мониторинг ───
        start_time = time.time()
        peak = temp_samples[0] if temp_samples else None
        while True:
            elapsed = time.time() - start_time
            if elapsed >= total_seconds:
                break
            try:
                temps = _get_temperatures()
                t = temps.get("cpu")
                if t is not None:
                    temp_samples.append(t)
                    if peak is None or t > peak:
                        peak = t
                    if peak >= 95:
                        abort_reason["reason"] = (
                            f"🔴 КРИТИЧЕСКИЙ ПЕРЕГРЕВ: {peak:.0f} °C. "
                            f"Тест прерван во избежание повреждения CPU.")
                        break
            except Exception:
                pass
            try:
                app.after(0, update_ui, elapsed, peak)
            except Exception:
                pass
            time.sleep(2)

        # ─── ШАГ 3: Остановка процессов ───
        for p in stress_procs:
            try:
                p.kill()
            except Exception:
                pass

        # ─── ШАГ 4: Итог ───
        def finish():
            try:
                win.grab_release()
                win.destroy()
            except Exception:
                pass
            lines = ["=" * 70,
                     "  РЕЗУЛЬТАТ СТРЕСС-ТЕСТА CPU",
                     "=" * 70, "",
                     f"  Длительность: {duration_min} мин "
                     f"({total_seconds} сек)",
                     f"  Нагрузка: {cores} процессов (все логические ядра)",
                     f"  Сэмплов температуры: {len(temp_samples)}",
                     ""]
            if abort_reason["reason"]:
                lines.append(f"  ⚠️ {abort_reason['reason']}")
                lines.append("")

            if temp_samples:
                avg_t = sum(temp_samples) / len(temp_samples)
                max_t = max(temp_samples)
                min_t = min(temp_samples)
                lines.append("─" * 70)
                lines.append("  ТЕМПЕРАТУРА CPU")
                lines.append("─" * 70)
                lines.append(f"  Минимум:  {min_t:.1f} °C")
                lines.append(f"  Средняя:  {avg_t:.1f} °C")
                lines.append(f"  Пиковая:  {max_t:.1f} °C")
                lines.append("")
                if max_t >= 95:
                    lines.append("  🔴 ОПАСНО: перегрев ≥95°C! "
                                 "Проверьте термопасту / кулер / пыль.")
                    result_color = "#FF8A8A"
                elif max_t >= 85:
                    lines.append("  🟡 ВНИМАНИЕ: 85–95°C. "
                                 "Кулер почти не справляется.")
                    result_color = "#FFD54F"
                elif max_t >= 75:
                    lines.append("  🟢 НОРМА (но горячо): 75–85°C.")
                    result_color = "#7CFC7C"
                else:
                    lines.append("  ✅ ОТЛИЧНО: <75°C — "
                                 "охлаждение справляется.")
                    result_color = "#7CFC7C"
                status_text = f"✅ Тест завершён • пик {max_t:.0f} °C"
            else:
                lines.append("⚠️ Температура не измерена (пользователь "
                             "продолжил без датчиков).")
                lines.append("")
                result_color = "#FFD54F"
                status_text = "✅ Тест завершён (без температуры)"

            lines.append("")
            lines.append("─" * 70)
            lines.append("  ВЫВОД")
            lines.append("─" * 70)
            if abort_reason["reason"]:
                lines.append("  ⚠️ Тест прерван — срочно проверьте "
                             "охлаждение!")
            elif temp_samples and max(temp_samples) < 85:
                lines.append("  ✅ Система стабильна, охлаждение "
                             "справляется.")
            elif temp_samples:
                lines.append("  🟡 Система стабильна, но стоит "
                             "проверить охлаждение.")
            else:
                lines.append("  ✅ Нагрузка пройдена без ошибок, но "
                             "температура не измерена.")

            try:
                diag_ui["status"].configure(text=status_text,
                                             text_color=result_color)
            except Exception:
                pass
            show_output_dialog("Результат стресс-теста CPU",
