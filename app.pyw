                           capture_output=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW)
        return _decode_console_bytes(r.stdout or b"").strip()
    except Exception as e:
        log_error("_rp_get_shadow_storage", e)
        return ""


def _rp_get_shadows():
    """Список теневых копий (vssadmin list shadows)."""
    try:
        r = subprocess.run(["vssadmin", "list", "shadows"],
                           capture_output=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW)
        return _decode_console_bytes(r.stdout or b"").strip()
    except Exception as e:
        log_error("_rp_get_shadows", e)
        return ""


def _rp_get_protection_status():
    """Возвращает, включена ли защита системы на дисках."""
    result = {}
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$drives = Get-PSDrive -PSProvider FileSystem | "
            "Where-Object { $_.Name -match '^[A-Z]$' }; "
            "$out = @(); "
            "foreach ($d in $drives) { "
            "  $letter = $d.Name + ':\\'; "
            "  $s = Get-CimInstance -ClassName Win32_ShadowStorage "
            "  -ErrorAction SilentlyContinue; "
            "  $out += [PSCustomObject]@{ Letter = $d.Name } "
            "}; "
            "$out | ConvertTo-Json -Compress"
        )
        # Примечание: Get-CimInstance не даёт прямой статус защиты,
        # используем vssadmin list shadowstorage для размера
        r = subprocess.run(["vssadmin", "list", "shadowstorage"],
                           capture_output=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
        # Парсим строки "Для тома: (C:) ..."
        import re
        for m in re.finditer(
            r"Для тома:\s*\(([A-Z]):\)[^\n]*?\n[^\n]*?Максимальное\s+"
            r"пространство:\s*([\d.,]+ \S+)",
            out, re.IGNORECASE | re.DOTALL
        ):
            letter = m.group(1)
            limit = m.group(2).strip()
            result[letter] = limit
    except Exception as e:
        log_error("_rp_get_protection_status", e)
    return result


def _rp_delete_point(seq):
    """Удаляет точку восстановления по SequenceNumber."""
    if not messagebox.askyesno(
        "Удалить точку?",
        f"Точка #{seq} будет удалена безвозвратно.\n\n"
        f"Продолжить?"):
        return False
    # Через WMI: Win32_ShadowCopy удалить по индексу
    # Надёжный способ — через vssadmin delete shadows
    try:
        # Получаем список теневых копий с их ID
        r = subprocess.run(["vssadmin", "list", "shadows"],
                           capture_output=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
        # Найти все Shadow Copy ID
        import re
        ids = re.findall(
            r"Идентификатор теневой копии:\s*(\{[0-9a-fA-F-]+\})",
            out)
        if not ids:
            ids = re.findall(
                r"Shadow Copy ID:\s*(\{[0-9a-fA-F-]+\})", out)
        # Удаляем по индексу — точки не упорядочены 1:1,
        # поэтому удаляем все и оставляем последнюю как самую свежую
        # (это компромисс; полное сопоставление требует WMI)
        messagebox.showinfo(
            "Совет",
            "Windows не позволяет удалять точки по отдельности "
            "через vssadmin.\n\n"
            "Доступные варианты:\n"
            "• Удалить все точки (очистит всю историю)\n"
            "• В Параметрах системы задать меньший лимит — "
            "старые точки удалятся автоматически.\n\n"
            "Используйте «🗑 Удалить ВСЕ точки», если хотите очистить "
            "историю.")
        return False
    except Exception as e:
        log_error("_rp_delete_point", e)
        return False


# ─── Удаление ОДНОЙ точки восстановления ───

def _rp_get_shadows_structured():
    """Возвращает тени через WMI Win32_ShadowCopy — надёжнее, чем vssadmin."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "$inv = [System.Globalization.CultureInfo]::InvariantCulture; "
        "$shadows = Get-CimInstance -ClassName Win32_ShadowCopy; "
        "if ($shadows) { "
        "  @($shadows) | ForEach-Object { "
        "    [PSCustomObject]@{ "
        "      ID = $_.ID; "
        "      InstallDate = $_.InstallDate.ToString("
        "'yyyy-MM-dd HH:mm:ss', $inv); "
        "      VolumeName = $_.VolumeName; "
        "      DeviceObject = $_.DeviceObject "
        "    } "
        "  } | ConvertTo-Json -Compress "
        "}"
    )
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]

        result = []
        for sh in data:
            if not isinstance(sh, dict):
                continue
            sid = str(sh.get("ID") or "").strip()
            if not sid:
                continue
            dt = _rp_parse_cim_datetime(sh.get("InstallDate"))
            vol = "C"
            try:
                vn = str(sh.get("VolumeName") or "")
                m = re.search(r"([A-Za-z]):", vn)
                if m:
                    vol = m.group(1).upper()
            except Exception:
                pass
            result.append({
                "id": sid,
                "volume": vol,
                "created_dt": dt,
                "created_str": dt.strftime("%Y-%m-%d %H:%M:%S")
                                if dt else "?",
                "volume_name": str(sh.get("VolumeName") or ""),
                "device": str(sh.get("DeviceObject") or ""),
            })
        return result
    except Exception as e:
        log_error("_rp_get_shadows_structured_wmi", e)
        return []


def _rp_parse_cim_datetime(s):
    """Парсит дату тени. Поддерживает:
       'YYYYMMDDHHMMSS.mmm+000'  (CIM_DATETIME)
       'YYYY-MM-DD HH:MM:SS'      (InvariantCulture ToString)
       'YYYY.MM.DD HH.MM.SS'      (русская культура — fallback)
    Возвращает naive datetime в ЛОКАЛЬНОМ времени или None.
    """
    if not s:
        return None
    st = str(s).strip()

    # Вариант 1: уже ISO "2026-10-10 11:55:25"
    if re.match(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$", st):
        try:
            return datetime.strptime(st, "%Y-%m-%d %H:%M:%S")
        except Exception:
            pass

    # Вариант 2: с русскими разделителями "2026.10.10 11.55.25"
    if re.match(r"^\d{4}\.\d{2}\.\d{2} \d{2}\.\d{2}\.\d{2}$", st):
        try:
            return datetime.strptime(st, "%Y.%m.%d %H.%M.%S")
        except Exception:
            pass

    # Вариант 3: с русским форматом "10.10.2026 11:55:25"
    if re.match(r"^\d{2}\.\d{2}\.\d{4} \d{2}:\d{2}:\d{2}$", st):
        try:
            return datetime.strptime(st, "%d.%m.%Y %H:%M:%S")
        except Exception:
            pass

    # Вариант 4: CIM_DATETIME "20261010085519.000000+000"
    offset_min = 0
    m = re.search(r"([+-])(\d{3,4})$", st)
    if m:
        sign = 1 if m.group(1) == "+" else -1
        try:
            offset_min = sign * int(m.group(2))
        except Exception:
            offset_min = 0
        st = st[:m.start()]

    if "." in st:
        st = st.split(".")[0]

    if len(st) >= 14 and st[:14].isdigit():
        try:
            dt = datetime.strptime(st[:14], "%Y%m%d%H%M%S")
            from datetime import timezone, timedelta
            if offset_min == 0:
                return dt.replace(tzinfo=timezone.utc) \
                         .astimezone() \
                         .replace(tzinfo=None)
            tz = timezone(timedelta(minutes=offset_min))
            return dt.replace(tzinfo=tz) \
                     .astimezone() \
                     .replace(tzinfo=None)
        except Exception:
            return None

    return None


def _rp_match_shadow(restore_created, shadows, tolerance_sec=180):
    """Находит теневую копию, ближайшую по времени к точке восстановления."""
    # restore_created приходит из _parse_wmi_datetime в ISO-формате
    target = None
    try:
        target = datetime.strptime(restore_created, "%Y-%m-%d %H:%M:%S")
    except Exception:
        # Попробуем другие форматы
        for fmt in ("%d.%m.%Y %H:%M:%S", "%m/%d/%Y %H:%M:%S"):
            try:
                target = datetime.strptime(restore_created, fmt)
                break
            except Exception:
                continue
    if target is None:
        return None

    best = None
    best_diff = None
    for sh in shadows:
        dt = sh.get("created_dt")
        if dt is None:
            continue
        diff = abs((dt - target).total_seconds())
        if diff <= tolerance_sec:
            if best_diff is None or diff < best_diff:
                best = sh
                best_diff = diff

    # Если совсем рядом (≤5 сек) — почти 100% совпадение
    if best is not None and best_diff is not None and best_diff <= 5:
        return best

    # Если разница больше — попробуем вторую попытку:
    # на русской Windows иногда "Время создания" точки и тени
    # расходятся на несколько минут
    if best is None and shadows:
        # Найдём ближайшую вообще, если разница < 15 минут
        closest = None
        closest_diff = None
        for sh in shadows:
            dt = sh.get("created_dt")
            if dt is None:
                continue
            diff = abs((dt - target).total_seconds())
            if closest_diff is None or diff < closest_diff:
                closest = sh
                closest_diff = diff
        if closest is not None and closest_diff is not None \
                and closest_diff <= 900:
            return closest

    return best


def _rp_delete_one_point(seq, created_str, desc):
    """Удаляет одну точку восстановления (через shadow copy)."""
    shadows = _rp_get_shadows_structured()
    if not shadows:
        messagebox.showwarning(
            "Нет теневых копий",
            "WMI не отдал список теневых копий Win32_ShadowCopy.\n\n"
            "Возможные причины:\n"
            "• защита системы отключена;\n"
            "• нет ни одной теневой копии (только точки,\n"
            "  созданные сторонними программами);\n"
            "• служба VSS остановлена.\n\n"
            "Проверить можно командой в PowerShell:\n"
            "  Get-CimInstance Win32_ShadowCopy | "
            "Select-Object ID, InstallDate")
        return False

    sh = _rp_match_shadow(created_str, shadows)
    if not sh:
        messagebox.showwarning(
            "Не удалось сопоставить",
            f"Точка #{seq} ({created_str}) не связана "
            f"с теневой копией Windows.\n\n"
            f"Скорее всего, эта точка создана другим "
            f"приложением (например, бэкапом), и удалить её "
            f"можно только через Диспетчер теневых копий.\n\n"
            f"Попробуйте удалить ВСЕ точки кнопкой "
            f"«🗑 Удалить ВСЕ точки».")
        return False

    if not messagebox.askyesno(
        "Удалить точку восстановления?",
        f"Точка #{seq}\n"
        f"Описание: {desc[:80]}\n"
        f"Создана: {created_str}\n\n"
        f"⚠️ Удаление НЕОБРАТИМО. Откатить систему к этой "
        f"точке больше нельзя.\n\n"
        f"Продолжить?"):
        return False

    vol = sh.get("volume") or "C"
    shadow_id = sh["id"]

    try:
        cmd = ["vssadmin", "delete", "shadows",
               f"/for={vol}:", f"/shadow={shadow_id}", "/quiet"]
        r = subprocess.run(cmd, capture_output=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b"\n" + (r.stderr or b""))
        if r.returncode == 0:
            return True

        # Fallback через WMI
        ps = (
            f"$s = Get-CimInstance -ClassName Win32_ShadowCopy "
            f"| Where-Object {{ $_.ID -eq '{shadow_id}' }}; "
            f"if ($s) {{ $s | Remove-CimInstance -ErrorAction Stop }}"
        )
        r2 = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True, timeout=60,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        if r2.returncode == 0:
            return True

        messagebox.showerror(
            "Ошибка удаления",
            f"vssadmin: код {r.returncode}\n"
            f"{out[:400]}\n\n"
            f"WMI: код {r2.returncode}\n"
            f"{((r2.stderr or r2.stdout or '')[:400])}")
        return False
    except Exception as e:
        log_error("_rp_delete_one_point", e)
        messagebox.showerror("Ошибка", str(e))
        return False


def _rp_delete_all():
    """Удаляет все точки восстановления через vssadmin delete shadows /all."""
    if not messagebox.askyesno(
        "⚠️ Удалить ВСЕ точки восстановления?",
        "Все точки восстановления на всех дисках будут удалены.\n\n"
        "⚠️ Откатить это нельзя. Вы больше не сможете восстановить "
        "систему к прошлому состоянию.\n\n"
        "Продолжить?"):
        return
    if not messagebox.askyesno(
        "Подтверждение",
        "ТОЧНО удалить все точки восстановления?"):
        return
    try:
        r = subprocess.run(["vssadmin", "delete", "shadows",
                            "/all", "/quiet"],
                           capture_output=True, timeout=120,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b"\n" + (r.stderr or b""))
        code = r.returncode
        show_output_dialog(
            "Удаление всех точек",
            f"Код возврата: {code}\n\n{out or '(пусто)'}")
    except Exception as e:
        log_error("_rp_delete_all", e)
        messagebox.showerror("Ошибка", str(e))


def _rp_resize_storage():
    """Диалог настройки лимита для точек восстановления."""
    dlg = ctk.CTkToplevel(app)
    dlg.title("Лимит места для точек восстановления")
    dlg.geometry("560x360")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="⚙  Лимит места для точек",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)
    ctk.CTkLabel(dlg,
                 text="Windows автоматически удаляет старые точки, "
                      "когда размер превышает лимит.",
                 font=("Inter", 11), text_color="#B0BEC5",
                 wraplength=500).pack(pady=(0, 10))

    ctk.CTkLabel(dlg, text="Диск:",
                 font=("Inter", 13, "bold"),
                 text_color="#82B1FF").pack(anchor="w", padx=30, pady=(4, 2))
    disk_var = ctk.StringVar(value="C:")
    disk_menu = ctk.CTkOptionMenu(dlg, values=["C:", "D:", "E:"],
                                    variable=disk_var, width=120, height=34,
                                    fg_color="#1A2A4A", button_color="#1565C0")
    disk_menu.pack(anchor="w", padx=30, pady=(0, 8))

    ctk.CTkLabel(dlg, text="Лимит в ГБ (сколько места под точки):",
                 font=("Inter", 13, "bold"),
                 text_color="#82B1FF").pack(anchor="w", padx=30, pady=(4, 2))
    limit_var = ctk.StringVar(value="10")
    ctk.CTkEntry(dlg, textvariable=limit_var, width=120, height=34,
                 font=("Arial", 12), fg_color="#1A2A4A",
                 text_color="#ffffff").pack(anchor="w", padx=30, pady=(0, 12))

    def apply_limit():
        letter = disk_var.get().rstrip(":")
        try:
            gb = int(limit_var.get())
            if gb < 1 or gb > 500:
                raise ValueError
        except Exception:
            messagebox.showerror("Ошибка",
                                  "Введите число от 1 до 500 ГБ.")
            return
        mb = gb * 1024
        # vssadmin resize shadowstorage /for=C: /on=C: /maxsize=10GB
        cmd = ["vssadmin", "resize", "shadowstorage",
               f"/for={letter}:", f"/on={letter}:",
               f"/maxsize={mb}MB"]
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=60,
                               creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b"\n" + (r.stderr or b""))
            if r.returncode == 0:
                messagebox.showinfo("Готово",
                    f"Лимит для {letter}: установлен: {gb} ГБ")
                dlg.destroy()
            else:
                messagebox.showerror("Ошибка",
                    f"Код {r.returncode}\n\n{out[:500]}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    br = ctk.CTkFrame(dlg, fg_color="transparent")
    br.pack(pady=(0, 14), padx=30, fill="x")
    ctk.CTkButton(br, text="💾 Применить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=19,
                  command=apply_limit).pack(side="left", padx=(0, 4),
                                             fill="x", expand=True)
    ctk.CTkButton(br, text="Отмена", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=dlg.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


def _rp_toggle_protection():
    """Включает/выключает защиту системы на диске C:."""
    dlg = ctk.CTkToplevel(app)
    dlg.title("Защита системы")
    dlg.geometry("560x300")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="🛡  Защита системы",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)
    ctk.CTkLabel(dlg,
                 text="Защита системы создаёт точки восстановления "
                      "автоматически при важных изменениях.",
                 font=("Inter", 11), text_color="#B0BEC5",
                 wraplength=500).pack(pady=(0, 12))

    ctk.CTkLabel(dlg, text="Диск:",
                 font=("Inter", 13, "bold"),
                 text_color="#82B1FF").pack(anchor="w", padx=30)
    disk_var = ctk.StringVar(value="C:")
    ctk.CTkOptionMenu(dlg, values=["C:", "D:", "E:"],
                       variable=disk_var, width=120, height=34,
                       fg_color="#1A2A4A",
                       button_color="#1565C0").pack(anchor="w",
                                                     padx=30, pady=(2, 12))

    def enable_protection():
        letter = disk_var.get().rstrip(":")
        try:
            subprocess.run(
                ["powershell", "-NoProfile", "-Command",
                 f"Enable-ComputerRestore -Drive '{letter}:\\'"],
                capture_output=True, timeout=60,
                creationflags=CREATE_NO_WINDOW)
            messagebox.showinfo("Готово",
                f"Защита включена для {letter}:")
            dlg.destroy()
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    def disable_protection():
        letter = disk_var.get().rstrip(":")
        if not messagebox.askyesno(
            "Отключить защиту?",
            f"Защита системы для {letter}: будет отключена, "
            f"все точки восстановления удалены.\n\nПродолжить?"):
            return
        try:
            subprocess.run(
                ["powershell", "-NoProfile", "-Command",
                 f"Disable-ComputerRestore -Drive '{letter}:\\'"],
                capture_output=True, timeout=60,
                creationflags=CREATE_NO_WINDOW)
            messagebox.showinfo("Готово",
                f"Защита отключена для {letter}:")
            dlg.destroy()
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    br = ctk.CTkFrame(dlg, fg_color="transparent")
    br.pack(pady=(0, 14), padx=30, fill="x")
    ctk.CTkButton(br, text="✅ Включить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=19,
                  command=enable_protection).pack(side="left",
                                                    padx=(0, 4),
                                                    fill="x", expand=True)
    ctk.CTkButton(br, text="⏹ Отключить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#B71C1C",
                  hover_color="#E53935", corner_radius=19,
                  command=disable_protection).pack(side="left",
                                                     padx=(4, 0),
                                                     fill="x", expand=True)


