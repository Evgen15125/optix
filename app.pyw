def _run_netsh(cmd, timeout=60):
    """Запускает netsh/ipconfig и умно декодирует вывод."""
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           creationflags=CREATE_NO_WINDOW)
        raw = (r.stdout or b"") + b"\n" + (r.stderr or b"")
        text = _decode_console_bytes(raw)
        return r.returncode, text.strip()
    except subprocess.TimeoutExpired:
        return -1, f"Таймаут ({timeout} сек)"
    except Exception as e:
        return -2, str(e)


def _net_show_state():
    """Собирает текущее состояние сетевых компонентов."""
    diag_ui["status"].configure(text="⏳ Сбор информации...",
                                 text_color="#FFD54F")

    def worker():
        results = {
            "winsock": "",
            "ipv4": "",
            "ipv6": "",
            "dns_servers": "",
            "adapters": "",
            "errors": [],
        }

        # netsh winsock show catalog (очень длинный — берём только заголовок)
        try:
            code, out = _run_netsh(["netsh", "winsock", "show", "catalog"],
                                    timeout=30)
            lines = out.splitlines()
            # Оставляем только строки, где есть "Описание" / "Winsock"
            keep = [ln for ln in lines
                    if "Winsock" in ln or "winsock" in ln
                    or "Описание" in ln or "Provider" in ln
                    or "Каталог" in ln]
            results["winsock"] = "\n".join(keep[:15]) or \
                f"(всего строк в каталоге: {len(lines)})"
        except Exception as e:
            results["errors"].append(f"winsock: {e}")

        # netsh int ipv4 show subinterfaces
        try:
            code, out = _run_netsh(
                ["netsh", "int", "ipv4", "show", "subinterfaces"],
                timeout=15)
            results["ipv4"] = out
        except Exception as e:
            results["errors"].append(f"ipv4: {e}")

        # netsh int ipv6 show subinterfaces
        try:
            code, out = _run_netsh(
                ["netsh", "int", "ipv6", "show", "subinterfaces"],
                timeout=15)
            results["ipv6"] = out
        except Exception as e:
            results["errors"].append(f"ipv6: {e}")

        # DNS-серверы всех адаптеров
        try:
            ps = (
                "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
                "Get-DnsClientServerAddress -AddressFamily IPv4 | "
                "Where-Object { $_.ServerAddresses.Count -gt 0 } | "
                "ForEach-Object { "
                "  $_.InterfaceAlias + ': ' + "
                "($_.ServerAddresses -join ', ') "
                "} | Out-String"
            )
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=30,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            results["dns_servers"] = (r.stdout or "").strip()
        except Exception as e:
            results["errors"].append(f"dns: {e}")

        # Список адаптеров
        try:
            ps = (
                "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
                "Get-NetAdapter -ErrorAction SilentlyContinue | "
                "Where-Object { $_.Status -eq 'Up' } | "
                "ForEach-Object { "
                "  $_.Name + ' | ' + $_.InterfaceDescription + "
                "  ' | ' + $_.LinkSpeed "
                "} | Out-String"
            )
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=30,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            results["adapters"] = (r.stdout or "").strip()
        except Exception as e:
            results["errors"].append(f"adapters: {e}")

        def finish():
            lines = ["=" * 70,
                     "  СОСТОЯНИЕ СЕТЕВЫХ КОМПОНЕНТОВ",
                     "=" * 70, "",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     ""]
            lines.append("─" * 70)
            lines.append("  АКТИВНЫЕ АДАПТЕРЫ")
            lines.append("─" * 70)
            lines.append(results["adapters"] or "  (нет активных)")
            lines.append("")
            lines.append("─" * 70)
            lines.append("  DNS-СЕРВЕРЫ (IPv4)")
            lines.append("─" * 70)
            lines.append(results["dns_servers"] or "  (не настроены)")
            lines.append("")
            lines.append("─" * 70)
            lines.append("  IPv4 СУБИНТЕРФЕЙСЫ (MTU и метрика)")
            lines.append("─" * 70)
            lines.append(results["ipv4"] or "  (пусто)")
            lines.append("")
            lines.append("─" * 70)
            lines.append("  IPv6 СУБИНТЕРФЕЙСЫ")
            lines.append("─" * 70)
            lines.append(results["ipv6"] or "  (пусто)")
            lines.append("")
            lines.append("─" * 70)
            lines.append("  WINSOCK (каталог)")
            lines.append("─" * 70)
            lines.append(results["winsock"] or "  (пусто)")
            lines.append("")
            if results["errors"]:
                lines.append("─" * 70)
                lines.append("  ОШИБКИ СБОРА")
                lines.append("─" * 70)
                for e in results["errors"]:
                    lines.append(f"  • {e}")
            diag_ui["status"].configure(text="✅ Готово",
                                         text_color="#7CFC7C")
            show_output_dialog("Состояние сетевых компонентов",
                                "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def _net_backup_settings():
    """Сохраняет текущие настройки сети в TXT-файл."""
    default = f"Optix_Network_Backup_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
    path = filedialog.asksaveasfilename(
        title="Сохранить бэкап настроек сети",
        defaultextension=".txt", initialfile=default,
        filetypes=[("TXT", "*.txt")])
    if not path:
        return

    diag_ui["status"].configure(text="⏳ Сбор настроек...",
                                 text_color="#FFD54F")

    def worker():
        lines = ["=" * 70,
                 "  БЭКАП НАСТРОЕК СЕТИ — Optix",
                 "=" * 70,
                 f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                 ""]

        cmds = [
            ("IP-КОНФИГУРАЦИЯ", ["ipconfig", "/all"]),
            ("DNS-КЭШ", ["ipconfig", "/displaydns"]),
            ("WINSOCK КАТАЛОГ", ["netsh", "winsock", "show", "catalog"]),
            ("TCP ГЛОБАЛЬНЫЕ", ["netsh", "int", "tcp", "show", "global"]),
            ("IPv4 СУБИНТЕРФЕЙСЫ",
             ["netsh", "int", "ipv4", "show", "subinterfaces"]),
            ("IPv6 СУБИНТЕРФЕЙСЫ",
             ["netsh", "int", "ipv6", "show", "subinterfaces"]),
            ("ИНТЕРФЕЙСЫ", ["netsh", "interface", "show", "interface"]),
        ]

        for title, cmd in cmds:
            lines.append("─" * 70)
            lines.append(f"  {title}")
            lines.append("─" * 70)
            code, out = _run_netsh(cmd, timeout=30)
            lines.append(out or "(пусто)")
            lines.append("")

        try:
            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            app.after(0, lambda: (
                diag_ui["status"].configure(
                    text="✅ Бэкап сохранён", text_color="#7CFC7C"),
                messagebox.showinfo("Готово",
                    f"Настройки сети сохранены:\n{path}")
            ))
        except Exception as e:
            log_error("_net_backup_settings", e)
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


def _net_run_command(title, cmd, needs_reboot=False):
    """Выполняет одну команду сброса и показывает результат."""
    if not messagebox.askyesno(
        title,
        f"Выполнить команду:\n\n{' '.join(cmd)}\n\n" +
        ("⚠️ После выполнения потребуется ПЕРЕЗАГРУЗКА.\n\n"
         if needs_reboot else "") +
        "Продолжить?"):
        return

    diag_ui["status"].configure(text=f"⏳ {title}...",
                                 text_color="#FFD54F")

    def worker():
        try:
            code, out = _run_netsh(cmd, timeout=60)

            def finish():
                diag_ui["status"].configure(
                    text=f"✅ {title}: код {code}" if code == 0
                         else f"⚠️ {title}: код {code}",
                    text_color="#7CFC7C" if code == 0 else "#FFD54F")
                lines = ["=" * 70,
                         f"  {title}",
                         "=" * 70,
                         "",
                         f"  Команда: {' '.join(cmd)}",
                         f"  Код возврата: {code}",
                         ""]
                if needs_reboot:
                    lines.append("  ⚠️ Требуется перезагрузка Windows.")
                    lines.append("")
                lines.append("─" * 70)
                lines.append("  ВЫВОД")
                lines.append("─" * 70)
                lines.append(out or "(пусто)")
                show_output_dialog(title, "\n".join(lines))
            app.after(0, finish)
        except Exception as e:
            log_error(f"_net_run_command({title})", e)
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


def _net_reset_all():
    """Полный сброс сети: все 4 команды + flushdns + перезагрузка."""
    if not messagebox.askyesno(
        "⚠️ ПОЛНЫЙ СБРОС СЕТИ",
        "Будут выполнены по порядку:\n\n"
        "  1. netsh winsock reset\n"
        "  2. netsh int ip reset\n"
        "  3. netsh int ipv4 reset\n"
        "  4. netsh int ipv6 reset\n"
        "  5. ipconfig /flushdns\n\n"
        "⚠️ После этого ИНТЕРНЕТ пропадёт до перезагрузки!\n"
        "⚠️ Рекомендуется сначала сделать Бэкап настроек.\n\n"
        "Продолжить?"):
        return

    if not messagebox.askyesno(
        "Подтверждение",
        "ТОЧНО выполнить полный сброс сети?\n\n"
        "Windows перезагрузится через 60 секунд после сброса.\n"
        "Можно отменить перезагрузку командой: shutdown /a"):
        return

    diag_ui["status"].configure(text="⏳ Полный сброс сети...",
                                 text_color="#FFD54F")

    def worker():
        cmds = [
            ("winsock reset", ["netsh", "winsock", "reset"]),
            ("int ip reset", ["netsh", "int", "ip", "reset"]),
            ("int ipv4 reset", ["netsh", "int", "ipv4", "reset"]),
            ("int ipv6 reset", ["netsh", "int", "ipv6", "reset"]),
            ("flushdns", ["ipconfig", "/flushdns"]),
        ]
        log_lines = ["=" * 70,
                     "  ПОЛНЫЙ СБРОС СЕТИ",
                     "=" * 70, "",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     ""]
        for title, cmd in cmds:
            log_lines.append("─" * 70)
            log_lines.append(f"  {title}")
            log_lines.append("─" * 70)
            code, out = _run_netsh(cmd, timeout=60)
            log_lines.append(f"  Код: {code}")
            log_lines.append(out or "(пусто)")
            log_lines.append("")

        # Планируем перезагрузку через 60 секунд (можно отменить shutdown /a)
        try:
            subprocess.run(["shutdown", "/r", "/t", "60",
                            "/c", "Optix: сброс сети — перезагрузка через 60 сек"],
                           capture_output=True, timeout=10,
                           creationflags=CREATE_NO_WINDOW)
            log_lines.append("=" * 70)
            log_lines.append("  Перезагрузка запланирована через 60 секунд.")
            log_lines.append("  Отменить: shutdown /a")
            log_lines.append("=" * 70)
        except Exception as e:
            log_lines.append(f"  Не удалось запланировать перезагрузку: {e}")

        def finish():
            diag_ui["status"].configure(text="✅ Сброс выполнен",
                                         text_color="#7CFC7C")
            show_output_dialog("Полный сброс сети", "\n".join(log_lines))
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


