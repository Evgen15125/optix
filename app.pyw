def _wu_list_software_updates():
    """Возвращает список ожидающих обновлений Windows (не драйверов)."""
    ps = r"""
[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;
$ErrorActionPreference = 'Stop'
try {
    $s = New-Object -ComObject Microsoft.Update.Session
    $q = $s.CreateUpdateSearcher()
    $q.ServerSelection = 2
    $r = $q.Search("IsInstalled=0 AND IsHidden=0 AND Type='Software'")
    $items = @()
    foreach ($u in $r.Updates) {
        $items += [PSCustomObject]@{
            Title = $u.Title
            KB = if ($u.KBArticleIDs.Count -gt 0)
                 { "KB" + $u.KBArticleIDs[0] } else { "" }
            Severity = $u.MsrcSeverity
            SizeBytes = $u.MaxDownloadSize
            IsDownloaded = $u.IsDownloaded
            RebootRequired = $u.InstallationBehavior.RebootBehavior
            Description = $u.Description
        }
    }
    $items | ConvertTo-Json -Compress -Depth 3
} catch { Write-Output ("ERROR: " + $_.Exception.Message) }
"""
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=180,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if not out or out.startswith("ERROR:"):
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        return data
    except Exception as e:
        log_error("_wu_list_software_updates", e)
        return []


def _wu_get_history(limit=30):
    """История установленных обновлений через Get-WinEvent (KB + дата)."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "Get-WinEvent -LogName 'System' -MaxEvents 500 | "
        "Where-Object { $_.ProviderName -match "
        "'WindowsUpdateClient|Servicing' -and "
        "($_.Id -eq 19 -or $_.Id -eq 20 -or $_.Id -eq 43) } | "
        "Select-Object -First " + str(limit) + " "
        "@{n='Time';e={$_.TimeCreated.ToString('yyyy-MM-dd HH:mm')}},"
        "Id,Message | ConvertTo-Json -Compress -Depth 3"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        result = []
        import re
        for e in data:
            if not isinstance(e, dict):
                continue
            msg = str(e.get("Message", "") or "")
            kbs = re.findall(r"KB\d{6,7}", msg, re.IGNORECASE)
            result.append({
                "time": str(e.get("Time", ""))[:16],
                "kb": kbs[0] if kbs else "—",
                "id": e.get("Id", 0),
                "text": " ".join(msg.split())[:120],
            })
        return result
    except Exception as e:
        log_error("_wu_get_history", e)
        return []


def _wu_get_cache_size():
    """Размер кэша обновлений (SoftwareDistribution\\Download)."""
    path = r"C:\Windows\SoftwareDistribution\Download"
    if not os.path.isdir(path):
        return -1
    try:
        return folder_size(path)
    except Exception:
        return -1


def _wu_install_software_updates():
    """Устанавливает все ожидающие обновления."""
    if not messagebox.askyesno(
        "Установить обновления?",
        "Будут скачаны и установлены все ожидающие обновления Windows "
        "(не драйверы).\n\n"
        "⚠️ Это может занять 10–60 минут в зависимости от количества "
        "и размера обновлений.\n\n"
        "⚠️ Не выключайте ПК во время установки.\n\n"
        "Продолжить?"):
        return
    if not messagebox.askyesno(
        "Подтверждение",
        "ТОЧНО установить обновления?\n\n"
        "Система может запросить перезагрузку после завершения."):
        return

    ps = r"""
$ErrorActionPreference = 'Continue'
try {
    $s = New-Object -ComObject Microsoft.Update.Session
    $q = $s.CreateUpdateSearcher()
    $q.ServerSelection = 2
    $r = $q.Search("IsInstalled=0 AND IsHidden=0 AND Type='Software'")
    if ($r.Updates.Count -eq 0) {
        Write-Output "NOTHING_TO_INSTALL"; exit 0
    }
    $c = New-Object -ComObject Microsoft.Update.UpdateColl
    foreach ($u in $r.Updates) {
        if (-not $u.EulaAccepted) { try { $u.AcceptEula() } catch {} }
        $c.Add($u) | Out-Null
    }
    Write-Output ("Скачивание: " + $c.Count + " обновлений...")
    $d = $s.CreateUpdateDownloader(); $d.Updates = $c; $d.Download() | Out-Null
    Write-Output "Установка..."
    $i = $s.CreateUpdateInstaller(); $i.Updates = $c; $res = $i.Install()
    Write-Output ("Код результата: " + $res.ResultCode)
    Write-Output ("Требуется перезагрузка: " + $res.RebootRequired)
    Write-Output "DONE"
} catch { Write-Output ("ERROR: " + $_.Exception.Message) }
"""
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=7200,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = ((r.stdout or "") + "\n" + (r.stderr or "")).strip()
        if "NOTHING_TO_INSTALL" in out:
            messagebox.showinfo("Готово",
                "Нет ожидающих обновлений — всё уже установлено.")
            return
        if out.startswith("ERROR:"):
            messagebox.showerror("Ошибка", out[:800])
            return
        show_output_dialog("Установка обновлений", out[:4000])
    except subprocess.TimeoutExpired:
        messagebox.showerror("Ошибка",
            "Превышено время ожидания (2 часа).\n\n"
            "Установка может продолжаться в фоне — проверьте "
            "Центр обновления Windows.")
    except Exception as e:
        log_error("_wu_install_software_updates", e)
        messagebox.showerror("Ошибка", str(e))


