    def _select_task(task_id):
        scheduler_ui["selected_id"] = task_id
        _refresh_tasks_ui()

    def _refresh_tasks_ui():
        tasks = load_optix_tasks()
        tasks.sort(key=lambda t: t.get("order", 9999))

        for w in lst.winfo_children():
            w.destroy()

        if not tasks:
            empty_frame = ctk.CTkFrame(lst, fg_color="transparent")
            empty_frame.pack(pady=60)
            ctk.CTkLabel(empty_frame, text="⏰", font=("Inter", 48)).pack()
            ctk.CTkLabel(empty_frame, text="Задач пока нет", font=("Inter", 18, "bold"), text_color="#ffffff").pack(pady=(10, 5))
            ctk.CTkLabel(empty_frame, text="Нажмите «➕ Новая задача» или выберите шаблон.", font=("Inter", 12), text_color="#90A4AE").pack()
            status.configure(text="Задач: 0", text_color="#90A4AE")
            try: _update_tray_badge()
            except Exception: pass
            return

        registered = sum(1 for t in tasks if _task_is_registered(t))
        enabled = sum(1 for t in tasks if t.get("enabled"))
        sel_id = scheduler_ui.get("selected_id")
        sel_note = ""
        if sel_id:
            cur = next((t for t in tasks if t.get("id") == sel_id), None)
            if cur: sel_note = f"   •   🎯 Выбрана: {cur.get('name', '?')[:30]}"
            
        status.configure(
            text=f"Задач: {len(tasks)}   •   Включено: {enabled}   •   Зарегистрировано: {registered}{sel_note}",
            text_color="#7CFC7C")

        rows = []
        drag_state = {"index": -1, "start_y": 0, "row": None}

        for idx, t in enumerate(tasks):
            t["order"] = idx
            
            enabled_t = t.get("enabled", True)
            tag = t.get("tag", "regular")
            tag_icon = dict(TASK_TAGS).get(tag, "🟡")
            is_selected = (scheduler_ui.get("selected_id") == t.get("id"))

            if is_selected:
                default_bg = "#2E5A8E"
                border_w = 2
            elif enabled_t:
                default_bg = "#1F2E4A"
                border_w = 1
            else:
                default_bg = "#2A2F3A"
                border_w = 1

            row = ctk.CTkFrame(lst, fg_color=default_bg, corner_radius=10,
                               border_width=border_w, border_color="#4FC3F7")
            row.pack(fill="x", pady=2, padx=2)
            rows.append(row)

            def on_enter(e, r=row):
                try: r.configure(border_color="#4FC3F7")
                except Exception: pass
            def on_leave(e, r=row):
                try: 
                    if not is_selected: r.configure(border_color="#2A3B5C")
                except Exception: pass
                
            def bind_hover(widget):
                if isinstance(widget, ctk.CTkButton): return
                try:
                    widget.bind("<Enter>", on_enter, add="+")
                    widget.bind("<Leave>", on_leave, add="+")
                except Exception: pass
                for child in widget.winfo_children(): bind_hover(child)
            bind_hover(row)

            top = ctk.CTkFrame(row, fg_color="transparent")
            top.pack(fill="x", padx=(10, 10), pady=(8, 2))

            drag_handle = ctk.CTkLabel(top, text="⋮⋮", font=("Inter", 16, "bold"), text_color="#90A4AE", cursor="fleur")
            drag_handle.pack(side="left", padx=(0, 6))

            ctk.CTkLabel(top, text=tag_icon, font=("Inter", 14), width=22).pack(side="left")
            ctk.CTkLabel(top, text=t.get("name", "?")[:60], font=("Inter", 13, "bold"),
                         text_color="#ffffff" if enabled_t else "#FFB0B0",
                         anchor="w", width=320).pack(side="left", padx=4)
                         
            trig = (t.get("triggers") or [{}])[0]
            trig_label = next((tr[1] for tr in TRIGGER_TYPES if tr[0] == trig.get("type", "?")), "?")
            ctk.CTkLabel(top, text=trig_label[:40], font=("Inter", 10),
                         text_color="#90CAF9", anchor="w", width=280).pack(side="left", padx=4)
                         
            reg_ok = _task_is_registered(t)
            reg_icon = "🟢" if reg_ok else "⚪"
            ctk.CTkLabel(top, text=reg_icon, font=("Inter", 12), width=20).pack(side="right", padx=4)
            ctk.CTkLabel(top, text="вкл" if enabled_t else "выкл", font=("Inter", 10, "bold"),
                         text_color="#7CFC7C" if enabled_t else "#FF8A8A").pack(side="right", padx=4)

            desc = t.get("desc", "")
            if desc:
                ctk.CTkLabel(row, text=desc[:120], font=("Inter", 11),
                             text_color="#B0BEC5", anchor="w").pack(fill="x", padx=(34, 10), pady=(0, 2))
                             
            n_actions = len(t.get("actions", []))
            n_conds = len(t.get("conditions", []))
            ctk.CTkLabel(row, text=f"⚡ {n_actions} действий   •   🔍 {n_conds} условий   •   🎯 {t.get('priority', 'Normal')}",
                         font=("Inter", 10), text_color="#90CAF9", anchor="w").pack(fill="x", padx=(34, 10), pady=(0, 4))

            btns = ctk.CTkFrame(row, fg_color="transparent")
            btns.pack(fill="x", padx=(34, 10), pady=(0, 8))

            def mk_run(tt=dict(t)):
                def do(): _task_run_now(tt, on_done=_refresh_tasks_ui)
                return do
            ctk.CTkButton(btns, text="▶ Сейчас", width=100, height=28, font=("Inter", 11, "bold"),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=mk_run()
                          ).pack(side="left", padx=(0, 4))

            def mk_toggle(tt=dict(t)):
                def do():
                    tt["enabled"] = not tt.get("enabled", True)
                    tasks_all = load_optix_tasks()
                    for i, x in enumerate(tasks_all):
                        if x.get("id") == tt.get("id"):
                            tasks_all[i] = tt
                            break
                    save_optix_tasks(tasks_all)
                    if tt["enabled"]: _task_register(tt)
                    else: _task_unregister(tt)
                    _refresh_tasks_ui()
                return do
            toggle_text = "⏹ Выкл" if enabled_t else "✅ Вкл"
            toggle_color = "#C62828" if enabled_t else "#2E7D32"
            ctk.CTkButton(btns, text=toggle_text, width=80, height=28, font=("Inter", 11, "bold"),
                          fg_color=toggle_color, hover_color="#546E7A", corner_radius=14, command=mk_toggle()
                          ).pack(side="left", padx=4)

            def mk_edit(tt=dict(t)):
                def do(): open_scheduler_task_dialog(existing=tt); _refresh_tasks_ui()
                return do
            ctk.CTkButton(btns, text="✏️ Изменить", width=110, height=28, font=("Inter", 11, "bold"),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=mk_edit()
                          ).pack(side="left", padx=4)

            def mk_save_tpl(tt=dict(t)):
                def do():
                    name = f"Шаблон: {tt.get('name', '?')}"
                    cur = load_templates()
                    tpl = dict(tt); tpl["id"] = f"tpl_{int(time.time()*1000)}"; tpl["name"] = name
                    cur.append(tpl); save_templates(cur)
                    show_toast("Optix", "Шаблон сохранён")
                return do
            ctk.CTkButton(btns, text="📋 В шаблон", width=110, height=28, font=("Inter", 11, "bold"),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=mk_save_tpl()
                          ).pack(side="left", padx=4)

            def mk_del(tt=dict(t)):
                def do():
                    if not messagebox.askyesno("Удалить задачу?", f"Удалить «{tt.get('name', '?')}»?"): return
                    _task_unregister(tt)
                    tasks_all = [x for x in load_optix_tasks() if x.get("id") != tt.get("id")]
                    save_optix_tasks(tasks_all)
                    if scheduler_ui.get("selected_id") == tt.get("id"): scheduler_ui["selected_id"] = None
                    _refresh_tasks_ui()
                return do
            ctk.CTkButton(btns, text="🗑 Удалить", width=100, height=28, font=("Inter", 11, "bold"),
                          fg_color="#C62828", hover_color="#E53935", corner_radius=14, command=mk_del()
                          ).pack(side="left", padx=4)

            def _make_select_handler(tid=t.get("id")):
                def do(event=None): _select_task(tid)
                return do
            _click = _make_select_handler()

            def _attach_click(widget):
                try:
                    if isinstance(widget, ctk.CTkButton): return
                    if widget == drag_handle: return
                    widget.bind("<Button-1>", _click)
                except Exception: pass
                try:
                    for ch in widget.winfo_children(): _attach_click(ch)
                except Exception: pass
            _attach_click(row)

            def on_drag_start(event, index=idx, r=row):
                drag_state["index"] = index
                drag_state["start_y"] = event.y_root
                drag_state["row"] = r
                r.configure(border_color="#FFD54F")
                app.config(cursor="fleur")

            def on_drag_motion(event): pass

            def on_drag_drop(event):
                if drag_state["index"] == -1: return
                target_idx = drag_state["index"]
                for i, r in enumerate(rows):
                    ry = r.winfo_rooty()
                    rh = r.winfo_height()
                    if ry <= event.y_root <= ry + rh:
                        if event.y_root < ry + rh / 2: target_idx = i
                        else: target_idx = i + 1
                        break
                app.config(cursor="")
                drag_state["row"].configure(border_color="#2A3B5C")
                if target_idx == drag_state["index"] or target_idx == drag_state["index"] + 1:
                    drag_state["index"] = -1
                    return
                moved_task = tasks.pop(drag_state["index"])
                if target_idx > drag_state["index"]: target_idx -= 1
                tasks.insert(target_idx, moved_task)
                for i, t_ in enumerate(tasks): t_["order"] = i
                save_optix_tasks(tasks)
                drag_state["index"] = -1
                _refresh_tasks_ui()

            drag_handle.bind("<ButtonPress-1>", on_drag_start)
            drag_handle.bind("<B1-Motion>", on_drag_motion)
            drag_handle.bind("<ButtonRelease-1>", on_drag_drop)

        try: _update_tray_badge()
        except Exception: pass

    # ─── Горячие клавиши ───
    def _hk_new(event=None):
        if not f.winfo_ismapped(): return
        try: open_scheduler_task_dialog(None); _refresh_tasks_ui()
        except Exception as e: log_error("hotkey_new_task", e)

    def _hk_refresh(event=None):
        if not f.winfo_ismapped(): return
        _refresh_tasks_ui()

    def _hk_run(event=None):
        if not f.winfo_ismapped(): return
        tid = scheduler_ui.get("selected_id")
        if not tid: return
        t = next((x for x in load_optix_tasks() if x.get("id") == tid), None)
        if t: _task_run_now(t, on_done=_refresh_tasks_ui)

    def _hk_delete(event=None):
        if not f.winfo_ismapped(): return
        try:
            focused = app.focus_get()
            if focused is not None and focused.winfo_class() in ("Entry", "TEntry", "Text", "TText"): return
        except Exception: pass

        tid = scheduler_ui.get("selected_id")
        if not tid:
            messagebox.showinfo("Optix", "Кликните по задаче, чтобы выбрать её, затем нажмите Ctrl+D.")
            return
        tasks = load_optix_tasks()
        t = next((x for x in tasks if x.get("id") == tid), None)
        if not t: return
        if not messagebox.askyesno("Удалить задачу?", f"Удалить «{t.get('name', '?')}»?"): return
        _task_unregister(t)
        save_optix_tasks([x for x in tasks if x.get("id") != tid])
        scheduler_ui["selected_id"] = None
        _refresh_tasks_ui()

    try:
        f.bind("<Button-1>", lambda e: f.focus_set())
        f.configure(takefocus=True)
    except Exception: pass

    try:
        app.bind_all("<Control-n>", _hk_new, add="+")
        app.bind_all("<Control-N>", _hk_new, add="+")
        app.bind_all("<Control-r>", _hk_run, add="+")
        app.bind_all("<Control-R>", _hk_run, add="+")
        app.bind_all("<F5>", _hk_refresh, add="+")
        app.bind_all("<Control-d>", _hk_delete, add="+")
        app.bind_all("<Control-D>", _hk_delete, add="+")
    except Exception as e:
        log_error("bind_scheduler_hotkeys", e)

    _refresh_tasks_ui()
    return f


