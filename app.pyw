# ─── CPU AES ───
def bench_cpu_aes():
    """AES-шифрование. Fallback — SHA-256, если cryptography нет."""
    import hashlib
    data = os.urandom(10 * 1024 * 1024)
    try:
        from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
        from cryptography.hazmat.backends import default_backend
        key = os.urandom(32)
        cipher = Cipher(algorithms.AES(key), modes.ECB(),
                         backend=default_backend())
        encryptor = cipher.encryptor()
        payload = data[: 16 * (len(data) // 16)]

        def work():
            encryptor.update(payload)
        _, elapsed = _bench_timing(work)
        elapsed = max(0.005, elapsed)
        mbps = (len(payload) / (1024 * 1024)) / elapsed
        return {"value": round(mbps, 1), "unit": "МБ/с", "elapsed": elapsed,
                "score": _bench_normalize(mbps, BENCH_REFERENCE["cpu_aes"]),
                "ref": BENCH_REFERENCE["cpu_aes"]}
    except Exception:
        _, elapsed = _bench_timing(lambda: hashlib.sha256(data).digest())
        elapsed = max(0.005, elapsed)
        mbps = (len(data) / (1024 * 1024)) / elapsed
        return {"value": round(mbps, 1), "unit": "МБ/с", "elapsed": elapsed,
                "fallback": True,
                "score": _bench_normalize(mbps / 3, BENCH_REFERENCE["cpu_aes"]),
                "ref": BENCH_REFERENCE["cpu_aes"]}


