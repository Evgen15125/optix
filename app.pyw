def _center_window(win):
    """Центрирует всплывающее окно относительно главного окна Optix."""
    try:
        win.update_idletasks()
        w = win.winfo_width()
        h = win.winfo_height()
        
        # Получаем размеры и позицию главного окна
        main_w = app.winfo_width()
        main_h = app.winfo_height()
        main_x = app.winfo_x()
        main_y = app.winfo_y()
        
        # Вычисляем позицию для центра
        x = main_x + (main_w - w) // 2
        y = main_y + (main_h - h) // 2
        
        win.geometry(f"+{max(0, x)}+{max(0, y)}")
    except Exception:
        pass


