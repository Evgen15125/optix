def _task_action_script(task, action, log):
    """Запуск скрипта из библиотеки или файла."""
    script_id = action.get("script_id", "")
    if script_id:
        lib = load_scripts_lib()
        s = next((x for x in lib if x.get("id") == script_id), None)
        if not s:
            log.append(f"   ✗ Скрипт не найден: {script_id}")
            return {}
        fpath = s.get("path", "")
        lang = s.get("lang", "ps1")
    else:
        fpath = action.get("script_path", "")
        lang = "ps1" if fpath.lower().endswith(".ps1") else "py"

    if not fpath or not os.path.exists(fpath):
        log.append(f"   ✗ Файл не найден: {fpath}")
        return {}

    try:
        if lang == "ps1":
            r = subprocess.run(
                ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
                 "-File", fpath],
                capture_output=True, timeout=action.get("timeout", 600),
                creationflags=CREATE_NO_WINDOW)
        elif lang == "bat":
            r = subprocess.run(["cmd", "/c", fpath],
                                capture_output=True,
                                timeout=action.get("timeout", 600),
                                creationflags=CREATE_NO_WINDOW)
        else:
            py = _get_python_console_path()
            r = subprocess.run([py, fpath], capture_output=True,
                                timeout=action.get("timeout", 600),
                                creationflags=CREATE_NO_WINDOW)
        log.append(f"   ✓ Скрипт {os.path.basename(fpath)}: "
                    f"код {r.returncode}")
    except subprocess.TimeoutExpired:
        log.append(f"   ✗ Таймаут скрипта")
    except Exception as e:
        log.append(f"   ✗ Скрипт: {e}")
    return {}


def _task_action_command(task, action, log):
    """Прямая команда shell."""
    cmd = action.get("command", "")
    if not cmd:
        return {}
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True,
                            timeout=action.get("timeout", 300),
                            creationflags=CREATE_NO_WINDOW)
        log.append(f"   ✓ Команда: код {r.returncode}")
    except Exception as e:
        log.append(f"   ✗ Команда: {e}")
    return {}


def _task_action_delay(task, action, log):
    sec = int(action.get("delay_sec", 5))
    time.sleep(sec)
    log.append(f"   ✓ Пауза {sec} сек")
    return {}


def _task_execute(task, run_id=None):
    """Выполняет цепочку действий задачи. Возвращает dict результата."""
    run_id = run_id or f"run_{int(time.time() * 1000)}"
    started = datetime.now()
    log = []
    log.append(f"▶ Задача: {task.get('name', '?')}")
    log.append(f"   Запущено: {started.strftime('%Y-%m-%d %H:%M:%S')}")

    # Проверяем условия
    conditions = task.get("conditions", [])
    ok, reason = _task_check_conditions(conditions)
    if not ok:
        log.append(f"   ⏹ Пропущено: {reason}")
        result = {
            "run_id": run_id,
            "task_id": task.get("id"),
            "task_name": task.get("name"),
            "started": started.strftime("%Y-%m-%d %H:%M:%S"),
            "duration": 0,
            "success": False,
            "skipped": True,
            "reason": reason,
            "log": "\n".join(log),
        }
        return result

    # Выполняем действия
    summary = {"freed": 0, "files": 0}
    actions = task.get("actions", [])
    actions_done = 0
    actions_failed = 0
    for i, act in enumerate(actions):
        atype = act.get("type")
        log.append(f"   [{i+1}/{len(actions)}] {atype}")
        try:
            if atype == "clean":
                r = _task_action_clean(task, act, log)
                summary["freed"] += r.get("freed", 0)
                summary["files"] += r.get("files", 0)
            elif atype == "optimize":
                _task_action_optimize(task, act, log)
            elif atype == "backup":
                _task_action_backup(task, act, log)
            elif atype == "notify":
                _task_action_notify(task, act, log)
            elif atype == "script":
                _task_action_script(task, act, log)
            elif atype == "command":
                _task_action_command(task, act, log)
            elif atype == "delay":
                _task_action_delay(task, act, log)
            actions_done += 1
        except Exception as e:
            actions_failed += 1
            log.append(f"   ✗ Ошибка действия: {e}")

    finished = datetime.now()
    duration = (finished - started).total_seconds()
    log.append(f"   Готово за {duration:.1f} сек")
    if summary["freed"] > 0:
        log.append(f"   Освобождено: {human_size(summary['freed'])}")

    success = actions_failed == 0
    result = {
        "run_id": run_id,
        "task_id": task.get("id"),
        "task_name": task.get("name"),
        "started": started.strftime("%Y-%m-%d %H:%M:%S"),
        "duration": duration,
        "success": success,
        "skipped": False,
        "actions_done": actions_done,
        "actions_failed": actions_failed,
        "freed": summary["freed"],
        "files": summary["files"],
        "log": "\n".join(log),
    }
    return result


def _task_execute_with_retry(task):
    """Выполняет задачу с повторными попытками."""
    retry = task.get("retry", {})
    max_attempts = int(retry.get("max_attempts", 1))
    delay_min = int(retry.get("delay_min", 5))
    if max_attempts < 1:
        max_attempts = 1

    last_result = None
    for attempt in range(1, max_attempts + 1):
        result = _task_execute(task)
        result["attempt"] = attempt
        last_result = result
        # Пишем в историю каждую попытку
        h = load_task_history()
        h.append(result)
        save_task_history(h)

        if result.get("success") or result.get("skipped"):
            break
        if attempt < max_attempts:
            log_scheduler(f"Попытка {attempt} неудачна, "
                           f"повтор через {delay_min} мин")
            time.sleep(delay_min * 60)

    # Уведомление о завершении
    if task.get("notify_on_finish") and last_result:
        try:
            if last_result.get("success"):
                show_toast(f"Optix — {task.get('name', '?')}",
                            "✅ Задача выполнена")
            elif last_result.get("skipped"):
                show_toast(f"Optix — {task.get('name', '?')}",
                            f"⏹ Пропущено: "
                            f"{last_result.get('reason', '')}")
            else:
                show_toast(f"Optix — {task.get('name', '?')}",
                            "⚠️ Задача завершилась с ошибками")
        except Exception:
            pass

    return last_result


# ─── schtasks: регистрация задачи ───

def _task_build_schtasks_args(task):
    """Формирует аргументы schtasks /Create для регистрации задачи.
    /PRIORITY и /Z здесь НЕ используются — они задаются отдельно
    через PowerShell (см. _task_apply_extended_settings)."""
    pyw = _get_pythonw_path()
    app_path = os.path.abspath(__file__)

    task_id = task.get("id", "")
    tr = f'"{pyw}" "{app_path}" --run-task "{task_id}"'

    args = ["schtasks", "/Create",
            "/TN", f"Optix_Task_{task_id}",
            "/TR", tr, "/F",
            "/RL", "HIGHEST"]

    triggers = task.get("triggers", [])
    t_main = triggers[0] if triggers else {}
    ttype = t_main.get("type", "time_daily")

    if ttype == "time_daily":
        args += ["/SC", "DAILY", "/ST", t_main.get("time", "03:00")]
    elif ttype == "time_weekly":
        args += ["/SC", "WEEKLY",
                 "/D", t_main.get("day", "MON"),
                 "/ST", t_main.get("time", "03:00")]
    elif ttype == "time_monthly":
        args += ["/SC", "MONTHLY",
                 "/D", str(t_main.get("day", 1)),
                 "/ST", t_main.get("time", "03:00")]
    elif ttype == "once":
        args += ["/SC", "ONCE",
                 "/ST", t_main.get("time", "03:00"),
                 "/SD", t_main.get("date", "01/01/2030")]
    elif ttype == "on_logon":
        args += ["/SC", "ONLOGON"]
    elif ttype == "on_startup":
        args += ["/SC", "ONSTART"]
    elif ttype == "on_idle":
        args += ["/SC", "ONIDLE",
                 "/I", str(t_main.get("idle_min", 10))]
    elif ttype in ("on_unlock", "on_wake", "on_net", "on_event"):
        # Эти триггеры через schtasks /Create не выставляются.
        # Ставим ежедневный запуск в 03:00 как заглушку.
        # Реальный триггер обрабатывается при старте самой задачи.
        args += ["/SC", "DAILY", "/ST", "03:00"]

    return args


def _task_apply_extended_settings(task):
    """
    Применяет расширенные настройки к уже созданной задаче
    через PowerShell-командлет Set-ScheduledTask:
      • Priority (приоритет)
      • StartWhenAvailable (догон пропущенных)
    schtasks /Create этого НЕ умеет — поэтому отдельным шагом.
    """
    task_id = task.get("id", "")
    tn = f"Optix_Task_{task_id}"

    prio = task.get("priority", "Normal")
    prio_value = {
        "High": 4,
        "Above Normal": 6,
        "Below Normal": 8,
        "Normal": 7,
    }.get(prio, 7)

    catch_up_str = "true" if task.get("catch_up") else "false"

    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; "
        f"$t = Get-ScheduledTask -TaskName '{tn}' "
        "-ErrorAction SilentlyContinue; "
        "if ($t) { "
        f"  $t.Settings.Priority = {prio_value}; "
        f"  $t.Settings.StartWhenAvailable = ${catch_up_str}; "
        "  Set-ScheduledTask -InputObject $t | Out-Null; "
        "}"
    )
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        return r.returncode == 0, ((r.stdout or "") +
                                    (r.stderr or "")).strip()
    except Exception as e:
        log_error("_task_apply_extended_settings", e)
        return False, str(e)


def _task_register(task):
    """Создаёт задачу через schtasks и применяет расширенные настройки."""
    args = _task_build_schtasks_args(task)
    try:
        r = subprocess.run(args, capture_output=True, timeout=30,
                            creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b" " + (r.stderr or b""))
        if r.returncode != 0:
            return False, out
    except Exception as e:
        return False, str(e)

    # Задача создана — применяем Priority + StartWhenAvailable.
    # Ошибки этого шага не критичны (задача уже работает).
    try:
        _task_apply_extended_settings(task)
    except Exception as e:
        log_error("_task_register_extended", e)

    return True, out


def _task_unregister(task):
    tn = f"Optix_Task_{task.get('id', '')}"
    try:
        r = subprocess.run(["schtasks", "/Delete", "/TN", tn, "/F"],
                            capture_output=True, timeout=20,
                            creationflags=CREATE_NO_WINDOW)
        return r.returncode == 0
    except Exception:
        return False


def _task_is_registered(task):
    tn = f"Optix_Task_{task.get('id', '')}"
    try:
        r = subprocess.run(["schtasks", "/Query", "/TN", tn],
                            capture_output=True, timeout=15,
                            creationflags=CREATE_NO_WINDOW)
        return r.returncode == 0
    except Exception:
        return False


