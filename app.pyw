    status_lbl = ctk.CTkLabel(win, text="Загрузка...", font=("Inter", 12, "bold"),
                              text_color="#FFD54F", fg_color="#131E32",
                              corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    search_var = ctk.StringVar()
    filter_var = ctk.StringVar(value="Все")
    ctrl = ctk.CTkFrame(win, fg_color="transparent")
    ctrl.pack(pady=(0, 8), padx=20, fill="x")
    
    search_entry = ctk.CTkEntry(ctrl, placeholder_text="🔍 Поиск по процессу / IP / порту...",
                                 height=36, font=("Inter", 12), fg_color="#1F2E4A",
                                 text_color="#ffffff", corner_radius=10, textvariable=search_var)
    search_entry.pack(side="left", fill="x", expand=True, padx=(0, 8))
    
    filter_menu = ctk.CTkOptionMenu(ctrl, values=["Все", "ESTABLISHED", "LISTEN", "TIME_WAIT", "UDP"],
                                     variable=filter_var, width=160, height=36,
                                     fg_color="#1F2E4A", button_color="#1976D2", font=("Inter", 12))
    filter_menu.pack(side="left")

    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)

    style = ttk.Style()
    try: style.theme_use("clam")
    except Exception: pass
    style.configure("Net.Treeview", background="#0D1B33", foreground="#e0e8f5",
                    fieldbackground="#0D1B33", rowheight=28, font=("Consolas", 11))
    style.configure("Net.Treeview.Heading", background="#1565C0", foreground="#ffffff",
                    font=("Inter", 12, "bold"), relief="flat")
    style.map("Net.Treeview", background=[("selected", "#1565C0")], foreground=[("selected", "#ffffff")])

    tree_frame = tk.Frame(wrap, bg="#131E32")
    tree_frame.pack(fill="both", expand=True, padx=6, pady=6)
    tree = ttk.Treeview(tree_frame, columns=("proto", "local", "remote", "state", "pid"), style="Net.Treeview")
    tree.heading("#0", text="Процесс", anchor="w")
    tree.heading("proto", text="Протокол", anchor="w")
    tree.heading("local", text="Локальный адрес", anchor="w")
    tree.heading("remote", text="Удалённый адрес", anchor="w")
    tree.heading("state", text="Состояние", anchor="w")
    tree.heading("pid", text="PID", anchor="e")
    tree.column("#0", width=200, anchor="w")
    tree.column("proto", width=80, anchor="w")
    tree.column("local", width=200, anchor="w")
    tree.column("remote", width=220, anchor="w")
    tree.column("state", width=130, anchor="w")
    tree.column("pid", width=70, anchor="e")

    sb = tk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
    tree.configure(yscrollcommand=sb.set)
    tree.pack(side="left", fill="both", expand=True)
    sb.pack(side="right", fill="y")

    state = {"all": []}

    def fmt_addr(addr):
        if not addr: return "—"
        ip, port = addr
        if ":" in ip: return f"[{ip}]:{port}"
        return f"{ip}:{port}"

    def load_connections():
        conns = []
        try:
            for c in psutil.net_connections(kind="inet"):
                try:
                    proc_name = "—"
                    if c.pid:
                        try: proc_name = psutil.Process(c.pid).name()
                        except Exception: proc_name = "?"
                    proto = "TCP" if c.type == 1 else ("UDP" if c.type == 2 else "?")
                    conns.append({"proc": proc_name, "pid": c.pid or 0, "proto": proto,
                                  "local": fmt_addr(c.laddr), "remote": fmt_addr(c.raddr),
                                  "state": c.status or "—"})
                except Exception: continue
        except Exception as e:
            log_error("net_connections", e)
        conns.sort(key=lambda x: (x["proc"].lower(), x["proto"]))
        state["all"] = conns

    def render():
        q = search_var.get().strip().lower()
        f = filter_var.get()
        for w in tree.get_children(): tree.delete(w)
        shown = 0
        for c in state["all"]:
            if f != "Все":
                if f == "UDP":
                    if c["proto"] != "UDP": continue
                elif c["state"] != f: continue
            if q:
                hay = f"{c['proc']} {c['local']} {c['remote']} {c['pid']}".lower()
                if q not in hay: continue
            tag = ""
            st = c["state"].upper()
            if st == "ESTABLISHED": tag = "est"
            elif st == "LISTEN": tag = "listen"
            elif st == "TIME_WAIT": tag = "wait"
            tree.insert("", "end", text=f" {c['proc']}", values=(c["proto"], c["local"], c["remote"], c["state"], c["pid"]), tags=(tag,))
            shown += 1
        try:
            tree.tag_configure("est", foreground="#7CFC7C")
            tree.tag_configure("listen", foreground="#4FC3F7")
            tree.tag_configure("wait", foreground="#FFD54F")
        except Exception: pass
        status_lbl.configure(text=f"Всего: {len(state['all'])}  •  Показано: {shown}  •  Обновлено: {datetime.now().strftime('%H:%M:%S')}", text_color="#7CFC7C")

    def refresh_async():
        def worker():
            load_connections()
            app.after(0, render)
        threading.Thread(target=worker, daemon=True).start()

    def auto_refresh():
        if not win.winfo_exists(): return
        refresh_async()
        app.after(3000, auto_refresh)

    search_entry.bind("<KeyRelease>", lambda e: render())
    filter_menu.configure(command=lambda v: render())

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=40, font=("Inter", 12, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5", corner_radius=20, command=refresh_async
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40, font=("Inter", 12, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=20, command=win.destroy
                  ).pack(side="left", padx=(6, 0), fill="x", expand=True)
    auto_refresh()


# ================== СЕТЬ ПО ПРОЦЕССАМ ==================
def _netproc_get_data():
    """
    Возвращает список процессов с их сетевыми соединениями.
    Формат: [{pid, name, exe, tcp_count, udp_count, total,
              connections: [{proto, laddr, raddr, state}]}]
    """
    import psutil
    by_pid = {}
    try:
        for c in psutil.net_connections(kind="inet"):
            try:
                pid = c.pid or 0
                if pid == 0:
                    continue
                if pid not in by_pid:
                    by_pid[pid] = {
                        "pid": pid,
                        "name": "?",
                        "exe": "",
                        "tcp": 0,
                        "udp": 0,
                        "connections": [],
                    }
                entry = by_pid[pid]
                # Определяем протокол
                if c.type == 1:
                    proto = "TCP"
                    entry["tcp"] += 1
                elif c.type == 2:
                    proto = "UDP"
                    entry["udp"] += 1
                else:
                    proto = "?"
                # Локальный адрес
                laddr = "—"
                if c.laddr:
                    try:
                        ip, port = c.laddr
                        laddr = f"{ip}:{port}"
                    except Exception:
                        laddr = str(c.laddr)
                # Удалённый
                raddr = "—"
                if c.raddr:
                    try:
                        ip, port = c.raddr
                        raddr = f"{ip}:{port}"
                    except Exception:
                        raddr = str(c.raddr)
                entry["connections"].append({
                    "proto": proto,
                    "laddr": laddr,
                    "raddr": raddr,
                    "state": c.status or "—",
                })
            except Exception:
                continue
    except Exception as e:
        log_error("_netproc_get_data", e)

    # Дополняем имя процесса
    result = []
    for pid, entry in by_pid.items():
        try:
            p = psutil.Process(pid)
            entry["name"] = p.name() or "?"
            try:
                entry["exe"] = p.exe() or ""
            except Exception:
                pass
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            pass
        entry["total"] = entry["tcp"] + entry["udp"]
        result.append(entry)
    result.sort(key=lambda x: -x["total"])
    return result


def _netproc_kill(pid, name):
    """Завершает процесс с подтверждением."""
    if not messagebox.askyesno(
        "Завершить процесс?",
        f"Процесс будет завершён:\n\n{name} (PID {pid})\n\n"
        f"⚠️ Это может привести к потере несохранённых данных "
        f"в программе.\n\nПродолжить?"):
        return False
    if not messagebox.askyesno(
        "Подтверждение",
        f"ТОЧНО завершить {name} (PID {pid})?"):
        return False
    try:
        import psutil
        p = psutil.Process(pid)
        p.terminate()
        try:
            p.wait(timeout=3)
        except psutil.TimeoutExpired:
            p.kill()
        messagebox.showinfo("Готово", f"Процесс {name} завершён.")
        return True
    except Exception as e:
        log_error("_netproc_kill", e)
        messagebox.showerror("Ошибка", str(e))
        return False


def _netproc_export_csv(data):
    """Экспорт списка в CSV."""
    if not data:
        messagebox.showinfo("Optix", "Нечего экспортировать.")
        return
    default = f"Optix_NetByProc_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.csv"
    path = filedialog.asksaveasfilename(
        title="Экспорт в CSV", defaultextension=".csv",
        initialfile=default, filetypes=[("CSV", "*.csv")])
    if not path:
        return
    try:
        import csv
        with open(path, "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f, delimiter=";")
            w.writerow(["PID", "Процесс", "TCP", "UDP", "Всего",
                        "Локальный адрес", "Удалённый адрес",
                        "Состояние", "Путь к exe"])
            for e in data:
                if not e["connections"]:
                    w.writerow([e["pid"], e["name"], e["tcp"],
                                e["udp"], e["total"], "", "", "",
                                e.get("exe", "")])
                    continue
                for c in e["connections"]:
                    w.writerow([e["pid"], e["name"], e["tcp"],
                                e["udp"], e["total"],
                                c["laddr"], c["raddr"], c["state"],
                                e.get("exe", "")])
        messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
    except Exception as e:
        log_error("_netproc_export_csv", e)
        messagebox.showerror("Ошибка", str(e))


