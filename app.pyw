def _task_check_conditions(conditions):
    """Проверяет условия. Возвращает (ok, reason)."""
    import psutil
    for c in conditions or []:
        cid = c.get("id")
        if cid == "ac_power":
            try:
                bat = psutil.sensors_battery()
                if bat and not bat.power_plugged:
                    return False, "Работа от батареи"
            except Exception:
                pass
        elif cid == "internet":
            try:
                r = subprocess.run(["ping", "-n", "1", "-w", "1000",
                                     "8.8.8.8"],
                                    capture_output=True, timeout=3,
                                    creationflags=CREATE_NO_WINDOW)
                if r.returncode != 0:
                    return False, "Нет интернета"
            except Exception:
                return False, "Нет интернета"
        elif cid == "user_logged":
            try:
                r = subprocess.run(["query", "user"],
                                    capture_output=True, timeout=5,
                                    creationflags=CREATE_NO_WINDOW)
                if b"Active" not in r.stdout and \
                   "Активн".encode("cp866") not in r.stdout:
                    return False, "Никто не вошёл"
            except Exception:
                pass
        elif cid == "not_battery_low":
            try:
                bat = psutil.sensors_battery()
                if bat and bat.percent < 30 and not bat.power_plugged:
                    return False, "Батарея < 30%"
            except Exception:
                pass
    return True, ""


