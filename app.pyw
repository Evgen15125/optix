    # ─── Действия ───
    actions_state = list(base.get("actions", []))
    actions_list_frame = ctk.CTkScrollableFrame(tab_act, fg_color="#131E32", corner_radius=10, height=320, border_width=1, border_color="#2A3B5C")
    actions_list_frame.pack(fill="both", expand=True, pady=(4, 6))

    def render_actions():
        for w in actions_list_frame.winfo_children(): w.destroy()
        if not actions_state:
            ctk.CTkLabel(actions_list_frame, text="Нет действий.\n\nНажмите «➕ Добавить действие».",
                         font=("Inter", 12), text_color="#90A4AE").pack(pady=30)
            return
        for idx, act in enumerate(actions_state):
            row = ctk.CTkFrame(actions_list_frame, fg_color="#1F2E4A", corner_radius=8, border_width=1, border_color="#2A3B5C")
            row.pack(fill="x", pady=2, padx=2)
            atype = act.get("type", "?")
            atype_label = next((a[1] for a in ACTION_TYPES if a[0] == atype), atype)
            ctk.CTkLabel(row, text=f"{idx+1}. {atype_label}", font=("Inter", 12, "bold"),
                         text_color="#ffffff", anchor="w").pack(side="left", padx=(10, 4), pady=6)
            
            info = ""
            if atype == "clean": info = f"{len(act.get('categories', []))} категорий"
            elif atype == "optimize": info = f"{len(act.get('tweaks', []))} твиков"
            elif atype == "delay": info = f"{act.get('delay_sec', 5)} сек"
            elif atype == "notify": info = act.get("notify_title", "")[:30]
            elif atype == "command": info = act.get("command", "")[:40]
            elif atype == "script": info = os.path.basename(act.get("script_path", ""))[:30]
            
            ctk.CTkLabel(row, text=info, font=("Inter", 11), text_color="#90CAF9", anchor="w").pack(side="left", padx=6)

            def mk_up(i=idx):
                def do():
                    if i > 0:
                        actions_state[i], actions_state[i-1] = actions_state[i-1], actions_state[i]
                        render_actions()
                return do
            def mk_down(i=idx):
                def do():
                    if i < len(actions_state) - 1:
                        actions_state[i], actions_state[i+1] = actions_state[i+1], actions_state[i]
                        render_actions()
                return do
            def mk_edit(i=idx):
                def do():
                    _task_edit_action(actions_state[i], lambda a: (actions_state.__setitem__(i, a), render_actions()))
                return do
            def mk_del(i=idx):
                def do():
                    actions_state.pop(i)
                    render_actions()
                return do
                
            ctk.CTkButton(row, text="⬆", width=32, height=24, fg_color="#1F2E4A", corner_radius=8, font=("Inter", 10), command=mk_up()).pack(side="right", padx=2)
            ctk.CTkButton(row, text="⬇", width=32, height=24, fg_color="#1F2E4A", corner_radius=8, font=("Inter", 10), command=mk_down()).pack(side="right", padx=2)
            ctk.CTkButton(row, text="✏️", width=32, height=24, fg_color="#1F2E4A", corner_radius=8, font=("Inter", 10), command=mk_edit()).pack(side="right", padx=2)
            ctk.CTkButton(row, text="🗑", width=32, height=24, fg_color="#C62828", corner_radius=8, font=("Inter", 10), command=mk_del()).pack(side="right", padx=2)

    def add_action():
        _task_edit_action(None, lambda a: (actions_state.append(a) if a else None, render_actions()))
    ctk.CTkButton(tab_act, text="➕ Добавить действие", height=36, font=("Inter", 13, "bold"),
                  fg_color="#2E7D32", hover_color="#43A047", corner_radius=18, command=add_action).pack(fill="x", pady=(0, 6))
    render_actions()

    # ─── Дополнительно ───
    ctk.CTkLabel(tab_extra, text="Приоритет:", font=("Inter", 12, "bold"), text_color="#82B1FF", anchor="w").pack(fill="x", pady=(8, 2))
    prio_var = ctk.StringVar(value=base.get("priority", "Normal"))
    ctk.CTkOptionMenu(tab_extra, values=PRIORITIES, variable=prio_var, width=200, height=36,
                       font=("Inter", 12), fg_color="#1F2E4A", button_color="#1976D2").pack(anchor="w", pady=(0, 8))

    ctk.CTkLabel(tab_extra, text="При сбое повторить попыток:", font=("Inter", 12, "bold"), text_color="#82B1FF", anchor="w").pack(fill="x", pady=(8, 2))
    retry_max_var = ctk.StringVar(value=str(base.get("retry", {}).get("max_attempts", 1)))
    ctk.CTkOptionMenu(tab_extra, values=["1", "2", "3", "5"], variable=retry_max_var, width=100, height=32,
                       font=("Inter", 12), fg_color="#1F2E4A", button_color="#1976D2").pack(anchor="w", pady=(0, 8))

    ctk.CTkLabel(tab_extra, text="Задержка между попытками (мин):", font=("Inter", 12, "bold"), text_color="#82B1FF", anchor="w").pack(fill="x", pady=(4, 2))
    retry_delay_var = ctk.StringVar(value=str(base.get("retry", {}).get("delay_min", 5)))
    ctk.CTkOptionMenu(tab_extra, values=["1", "5", "10", "30", "60"], variable=retry_delay_var, width=100, height=32,
                       font=("Inter", 12), fg_color="#1F2E4A", button_color="#1976D2").pack(anchor="w", pady=(0, 12))

    def do_save():
        name = name_entry.get().strip()
        if not name:
            messagebox.showerror("Ошибка", "Введите название.")
            return
        ttype = next((t[0] for t in TRIGGER_TYPES if t[1] == trig_var.get()), "time_daily")
        trig = {"type": ttype}
        for k, w in trig_widgets.items():
            if k == "time": trig["time"] = w.get().strip() or "03:00"
            elif k == "day": trig["day"] = w.get().strip()
            elif k == "date": trig["date"] = w.get().strip()
            elif k == "idle_min":
                try: trig["idle_min"] = int(w.get())
                except Exception: trig["idle_min"] = 10
            elif k == "log_name": trig["log_name"] = w.get().strip() or "System"
            elif k == "event_id":
                try: trig["event_id"] = int(w.get())
                except Exception: trig["event_id"] = 0

        conds = [{"id": cid} for cid, v in cond_vars.items() if v.get() == 1]
        tag_id = "regular"
        for tid, tlbl in TASK_TAGS:
            if tlbl == tag_menu.get():
                tag_id = tid
                break

        task_data = {
            "id": base.get("id") or _task_id(), "name": name,
            "desc": desc_entry.get().strip(), "tag": tag_id,
            "enabled": bool(enable_var.get()), "catch_up": bool(catch_var.get()),
            "notify_on_finish": bool(notify_var.get()),
            "triggers": [trig], "conditions": conds, "actions": actions_state,
            "priority": prio_var.get(),
            "retry": {"max_attempts": int(retry_max_var.get() or 1), "delay_min": int(retry_delay_var.get() or 5)},
            "created": base.get("created") or datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        }

        tasks = load_optix_tasks()
        if existing:
            for i, t in enumerate(tasks):
                if t.get("id") == existing.get("id"):
                    tasks[i] = task_data
                    break
            else: tasks.append(task_data)
        else: tasks.append(task_data)
        save_optix_tasks(tasks)

        if task_data["enabled"]:
            ok, msg = _task_register(task_data)
            if not ok: messagebox.showwarning("Задача сохранена, но не зарегистрирована", f"Ошибка регистрации в Windows Scheduler:\n{msg[:300]}")

        dlg.destroy()
        try: show_toast("Optix", f"Задача сохранена: {name}")
        except Exception: pass

    br = ctk.CTkFrame(dlg, fg_color="transparent")
    br.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(br, text="💾 Сохранить", height=44, font=("Inter", 14, "bold"),
                  fg_color="#2E7D32", hover_color="#43A047", corner_radius=22, command=do_save).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(br, text="Отмена", height=44, font=("Inter", 14, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=22, command=dlg.destroy).pack(side="left", padx=(6, 0), fill="x", expand=True)


def _task_edit_action(action, on_save):
    """Диалог редактирования одного действия."""
    act = action or {}
    dlg = ctk.CTkToplevel(app)
    dlg.title("Действие")
    dlg.geometry("640x620")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="⚡  Действие",
                 font=("Arial", 15, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 8), padx=20, ipadx=20)

    ctk.CTkLabel(dlg, text="Тип действия:",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF", anchor="w").pack(
        fill="x", padx=30, pady=(4, 2))
    cur_type = act.get("type", "clean")
    cur_label = next((a[1] for a in ACTION_TYPES if a[0] == cur_type),
                      ACTION_TYPES[0][1])
    type_var = ctk.StringVar(value=cur_label)
    type_menu = ctk.CTkOptionMenu(
        dlg, values=[a[1] for a in ACTION_TYPES],
        variable=type_var, width=400, height=32,
        font=("Inter", 12), fg_color="#1A2A4A",
        button_color="#1565C0")
    type_menu.pack(anchor="w", padx=30, pady=(0, 8))

    body = ctk.CTkScrollableFrame(dlg, fg_color="#1A2A4A",
                                    corner_radius=10)
    body.pack(fill="both", expand=True, padx=30, pady=(4, 8))

    fields = {}

    def rebuild():
        for w in body.winfo_children():
            w.destroy()
        fields.clear()
        ttype = next((a[0] for a in ACTION_TYPES
                       if a[1] == type_var.get()), "clean")

        if ttype == "clean":
            cat_vars = {}
            for cat in CATEGORIES:
                v = ctk.IntVar(
                    value=1 if cat["name"] in act.get("categories", [])
                    else 0)
                ctk.CTkCheckBox(body, text=cat["name"], variable=v,
                                 font=("Inter", 11),
                                 text_color="#ffffff",
                                 fg_color="#29B6F6").pack(
                    anchor="w", pady=2)
                cat_vars[cat["name"]] = v
            fields["categories"] = cat_vars

        elif ttype == "optimize":
            tw_vars = {}
            for tid, tlbl in [("power_high", "🔋 Схема питания: Высокая"),
                                ("visual_off", "🎨 Визуальные: откл."),
                                ("telemetry_off", "📊 Телеметрия: откл."),
                                ("gamebar_off", "🎮 Game Bar: откл.")]:
                v = ctk.IntVar(value=1 if tid in act.get("tweaks", [])
                                else 0)
                ctk.CTkCheckBox(body, text=tlbl, variable=v,
                                 font=("Inter", 11),
                                 text_color="#ffffff",
                                 fg_color="#29B6F6").pack(
                    anchor="w", pady=2)
                tw_vars[tid] = v
            fields["tweaks"] = tw_vars

        elif ttype == "backup":
            ctk.CTkLabel(body, text="Что бэкапить:",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            bvar = ctk.StringVar(value=act.get("backup_target", "tweaks"))
            for v_, lbl in [("tweaks", "Настройки твиков"),
                             ("drivers", "Драйверы"),
                             ("autostart", "Автозапуск")]:
                ctk.CTkRadioButton(body, text=lbl, variable=bvar,
                                    value=v_, font=("Inter", 11),
                                    text_color="#ffffff").pack(
                    anchor="w", pady=2)
            fields["backup_target"] = bvar

        elif ttype == "notify":
            ctk.CTkLabel(body, text="Заголовок:",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            te = ctk.CTkEntry(body, height=30,
                                font=("Inter", 12),
                                fg_color="#0D1B33",
                                text_color="#ffffff")
            te.pack(fill="x", pady=(0, 6))
            te.insert(0, act.get("notify_title", "Optix — задача"))
            fields["notify_title"] = te
            ctk.CTkLabel(body, text="Текст:",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            te2 = ctk.CTkEntry(body, height=30,
                                 font=("Inter", 12),
                                 fg_color="#0D1B33",
                                 text_color="#ffffff")
            te2.pack(fill="x", pady=(0, 6))
            te2.insert(0, act.get("notify_text", "Задача завершена"))
            fields["notify_text"] = te2

        elif ttype == "script":
            ctk.CTkLabel(body, text="Путь к скрипту:",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            row = ctk.CTkFrame(body, fg_color="transparent")
            row.pack(fill="x", pady=(0, 6))
            te = ctk.CTkEntry(row, height=30,
                                font=("Consolas", 12),
                                fg_color="#0D1B33",
                                text_color="#ffffff")
            te.pack(side="left", fill="x", expand=True)
            te.insert(0, act.get("script_path", ""))
            fields["script_path"] = te

            def browse():
                p = filedialog.askopenfilename(
                    title="Скрипт",
                    filetypes=[("PowerShell", "*.ps1"),
                                ("Batch", "*.bat *.cmd"),
                                ("Python", "*.py"),
                                ("Все", "*.*")])
                if p:
                    te.delete(0, "end")
                    te.insert(0, p)
            ctk.CTkButton(row, text="📂", width=40, height=30,
                          fg_color="#1976D2", corner_radius=8,
                          command=browse).pack(side="left", padx=4)

        elif ttype == "command":
            ctk.CTkLabel(body, text="Команда:",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            te = ctk.CTkEntry(body, height=30,
                                font=("Consolas", 12),
                                fg_color="#0D1B33",
                                text_color="#ffffff")
            te.pack(fill="x", pady=(0, 6))
            te.insert(0, act.get("command", ""))
            fields["command"] = te

        elif ttype == "delay":
            ctk.CTkLabel(body, text="Пауза (секунд):",
                         font=("Inter", 12),
                         text_color="#82B1FF").pack(anchor="w")
            te = ctk.CTkEntry(body, height=30,
                                font=("Consolas", 12),
                                fg_color="#0D1B33",
                                text_color="#ffffff")
            te.pack(fill="x", pady=(0, 6))
            te.insert(0, str(act.get("delay_sec", 5)))
            fields["delay_sec"] = te

    type_menu.configure(command=lambda v: rebuild())
    rebuild()

    def do_save():
        ttype = next((a[0] for a in ACTION_TYPES
                       if a[1] == type_var.get()), "clean")
        new_act = {"type": ttype}
        if ttype == "clean":
            new_act["categories"] = [n for n, v in
                                       fields["categories"].items()
                                       if v.get() == 1]
        elif ttype == "optimize":
            new_act["tweaks"] = [n for n, v in
                                   fields["tweaks"].items()
                                   if v.get() == 1]
        elif ttype == "backup":
            new_act["backup_target"] = fields["backup_target"].get()
        elif ttype == "notify":
            new_act["notify_title"] = fields["notify_title"].get().strip()
            new_act["notify_text"] = fields["notify_text"].get().strip()
        elif ttype == "script":
            new_act["script_path"] = fields["script_path"].get().strip()
        elif ttype == "command":
            new_act["command"] = fields["command"].get().strip()
        elif ttype == "delay":
            try:
                new_act["delay_sec"] = int(fields["delay_sec"].get())
            except Exception:
                new_act["delay_sec"] = 5

        on_save(new_act)
        dlg.destroy()

    br = ctk.CTkFrame(dlg, fg_color="transparent")
    br.pack(pady=(0, 14), padx=30, fill="x")
    ctk.CTkButton(br, text="💾 Сохранить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=19,
                  command=do_save).pack(side="left", padx=(0, 4),
                                          fill="x", expand=True)
    ctk.CTkButton(br, text="Отмена", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=dlg.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


