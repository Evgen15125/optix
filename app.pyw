def collect_full_report():
    import platform
    import psutil
    r = {"generated": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
    try:
        build = platform.win32_ver()[1] or ""
    except Exception:
        build = ""
    r["os"] = {"computer_name": platform.node() or "?",
                "user": os.environ.get("USERNAME", "?"),
                "system": platform.system(),
                "release": platform.release(),
                "version": platform.version(),
                "build": build, "arch": platform.machine()}
    cpu_name = "Неизвестно"
    cpu_freq = ""
    try:
        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                             r"HARDWARE\DESCRIPTION\System\CentralProcessor\0")
        try:
            cpu_name, _ = winreg.QueryValueEx(key, "ProcessorNameString")
        except Exception:
            pass
        try:
            mhz, _ = winreg.QueryValueEx(key, "~MHz")
            cpu_freq = f"{mhz} МГц"
        except Exception:
            pass
        winreg.CloseKey(key)
    except Exception:
        pass
    r["cpu"] = {"name": cpu_name.strip(),
                "cores": psutil.cpu_count(logical=False) or 0,
                "threads": psutil.cpu_count(logical=True) or 0,
                "freq": cpu_freq}
    ram = psutil.virtual_memory()
    swap = psutil.swap_memory()
    r["ram"] = {"total": ram.total, "available": ram.available,
                "used_percent": ram.percent, "swap_total": swap.total}
    disks = []
    for part in psutil.disk_partitions(all=False):
        try:
            u = psutil.disk_usage(part.mountpoint)
            disks.append({"mount": part.mountpoint, "device": part.device,
                          "fstype": part.fstype, "total": u.total,
                          "used": u.used, "free": u.free, "percent": u.percent})
        except Exception:
            continue
    r["disks"] = disks
    try:
        ut = time.time() - psutil.boot_time()
        r["uptime"] = f"{int(ut // 3600)} ч {int((ut % 3600) // 60)} мин"
    except Exception:
        r["uptime"] = "?"
    try:
        r["tweaks_count"] = len(load_tweaks_backup())
    except Exception:
        r["tweaks_count"] = 0
    return r


def _collect_report_extras(data):
    """
    Дополняет data программ/службами/автозапуском для последующего diff.
    Вызывается из generate_report_worker.
    """
    # ─── Программы ───
    try:
        progs = load_installed_programs()
        data["programs"] = [
            {
                "name": p.get("name", ""),
                "version": p.get("version", ""),
                "publisher": p.get("publisher", ""),
                "size": int(p.get("size_bytes", 0) or 0),
                "install_date": p.get("install_date", ""),
            }
            for p in progs if p.get("name")
        ]
    except Exception as e:
        log_error("_collect_report_extras.programs", e)
        data["programs"] = []

    # ─── Службы ───
    try:
        svcs = get_services_list()
        data["services"] = [
            {
                "name": s.get("name", ""),
                "display": s.get("display_name", ""),
                "status": str(s.get("status", "")),
                "start_type": str(s.get("start_type", "")),
            }
            for s in svcs if s.get("name")
        ]
    except Exception as e:
        log_error("_collect_report_extras.services", e)
        data["services"] = []

    # ─── Автозапуск ───
    try:
        items, _ = get_autostart_items()
        data["autostart"] = [
            {
                "name": it.get("name", ""),
                "source": it.get("source", ""),
                "command": it.get("command", ""),
                "impact": it.get("impact_label", ""),
            }
            for it in items if it.get("name")
        ]
    except Exception as e:
        log_error("_collect_report_extras.autostart", e)
        data["autostart"] = []

    return data


def report_to_text(r):
    L = []
    L.append("=" * 70)
    L.append("  📋  ПАСПОРТ ПК — отчёт Optix")
    L.append("=" * 70)
    L.append(f"Дата: {r['generated']}")
    L.append("")
    L.append("─" * 70)
    L.append("  🖥  СИСТЕМА")
    L.append("─" * 70)
    o = r["os"]
    L.append(f"  Компьютер:    {o['computer_name']}")
    L.append(f"  Пользователь: {o['user']}")
    L.append(f"  ОС:           {o['system']} {o['release']}")
    L.append(f"  Версия:       {o['version']}")
    L.append(f"  Архитектура:  {o['arch']}")
    L.append(f"  Аптайм:       {r['uptime']}")
    L.append("")
    c = r["cpu"]
    L.append("  ⚙  ПРОЦЕССОР")
    L.append(f"  Модель:       {c['name']}")
    L.append(f"  Ядра:         {c['cores']} физ. / {c['threads']} лог.")
    if c["freq"]:
        L.append(f"  Частота:      {c['freq']}")
    L.append("")
    ram = r["ram"]
    L.append("  🧠 ОЗУ")
    L.append(f"  Всего:        {human_size(ram['total'])}")
    L.append(f"  Доступно:     {human_size(ram['available'])}")
    L.append(f"  Занято:       {ram['used_percent']}%")
    L.append("")
    L.append("  💾 ДИСКИ")
    for d in r["disks"]:
        L.append(f"  {d['mount']}  {human_size(d['used'])} / "
                 f"{human_size(d['total'])}  ({d['percent']}%)")
    L.append("")
    if r.get("tweaks_count", 0) > 0:
        L.append(f"  ⚡ Твиков применено: {r['tweaks_count']}")
    L.append("")

    # ─── 🛡 Плашка безопасности ───
    sec = r.get("security")
    if sec:
        L.append("─" * 70)
        L.append("  🛡  БЕЗОПАСНОСТЬ СИСТЕМЫ")
        L.append("─" * 70)
        score = sec.get("score", 0)
        icon = sec.get("icon", "?")
        verdict = sec.get("verdict", "?")
        L.append(f"  {icon} Security Score: {score}/100 — {verdict}")
        issues = sec.get("issues", [])
        if issues:
            L.append("")
            L.append("  Замечания:")
            for i in issues:
                L.append(f"    ⚠ {i}")
        else:
            L.append("  ✅ Все проверки пройдены")
        L.append("")

    # ─── 📥 Ожидающие обновления Windows ───
    upd = r.get("updates")
    if upd is not None:
        L.append("─" * 70)
        L.append("  📥  ОЖИДАЮЩИЕ ОБНОВЛЕНИЯ WINDOWS")
        L.append("─" * 70)
        err = r.get("updates_error")
        if err:
            L.append(f"  ⚠️ Не удалось получить список: {err}")
        elif not upd:
            L.append("  ✅ Все обновления установлены — система актуальна")
        else:
            total_size = sum(u.get("size", 0) or 0 for u in upd)
            L.append(f"  Найдено: {len(upd)}   •   "
                     f"Суммарный размер: {human_size(total_size)}")
            L.append("")
            for u in upd[:30]:
                kb_txt = u.get("kb", "") or ""
                sev = u.get("severity", "") or ""
                sz = u.get("size", 0) or 0
                meta = []
                if kb_txt:
                    meta.append(kb_txt)
                if sev:
                    meta.append(sev)
                if sz > 0:
                    meta.append(human_size(sz))
                meta_txt = ("   [" + " • ".join(meta) + "]") if meta else ""
                L.append(f"    📦 {u.get('title','?')[:85]}{meta_txt}")
            if len(upd) > 30:
                L.append(f"    ... и ещё {len(upd) - 30}")
        L.append("")

    L.append("=" * 70)
    L.append("  Отчёт сформирован программой Optix")
    L.append("=" * 70)
    return "\n".join(L)


def report_to_html(r):
    o = r["os"]
    c = r["cpu"]
    ram = r["ram"]

    def esc(s):
        return (str(s).replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace('"', "&quot;"))

    parts = ['<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8">'
             '<title>Паспорт ПК — Optix</title><style>'
             'body{font-family:"Inter",Arial;background:#0A1A30;color:#e0e8f5;padding:30px;margin:0}'
             '.header{background:linear-gradient(135deg,#1565C0,#0D47A1);padding:24px 30px;'
             'border-radius:16px;margin-bottom:20px}'
             '.header h1{margin:0;font-size:28px}'
             '.card{background:#1A2A4A;border-radius:14px;padding:20px 24px;margin-bottom:16px}'
             '.card h2{margin:0 0 14px;font-size:18px;color:#82B1FF}'
             'table{width:100%;border-collapse:collapse}'
             'td{padding:7px 4px;font-size:13px}'
             'td.k{color:#90CAF9;width:180px}'
             'td.v{color:#fff;font-family:Consolas,monospace}'
             '.score{font-size:36px;font-weight:700;padding:16px 20px;'
             'border-radius:14px;text-align:center;margin-bottom:12px}'
             '</style></head><body>'
             f'<div class="header"><h1>📋 Паспорт ПК</h1>'
             f'<p>Optix • {esc(r["generated"])}</p></div>']

    def card(title, rows):
        out = [f'<div class="card"><h2>{title}</h2><table>']
        for k, v in rows:
            out.append(f'<tr><td class="k">{esc(k)}</td>'
                       f'<td class="v">{v}</td></tr>')
        out.append('</table></div>')
        return "".join(out)

    parts.append(card("🖥 Система", [
        ("Компьютер", esc(o["computer_name"])),
        ("Пользователь", esc(o["user"])),
        ("ОС", esc(o["system"] + " " + o["release"])),
        ("Версия", esc(o["version"])),
        ("Архитектура", esc(o["arch"])),
        ("Аптайм", esc(r["uptime"])),
    ]))
    parts.append(card("⚙ Процессор", [
        ("Модель", esc(c["name"])),
        ("Ядра", f"{c['cores']} физ. / {c['threads']} лог."),
        ("Частота", esc(c["freq"] or "—")),
    ]))
    parts.append(card("🧠 ОЗУ", [
        ("Всего", human_size(ram["total"])),
        ("Доступно", human_size(ram["available"])),
        ("Занято", f"{ram['used_percent']}%"),
    ]))
    disks_rows = [(d["mount"],
                    f"{human_size(d['used'])} / {human_size(d['total'])} ({d['percent']}%)")
                  for d in r["disks"]]
    parts.append(card("💾 Диски", disks_rows))

    # ─── 🛡 Плашка Security Score ───
    sec = r.get("security")
    if sec:
        score = sec.get("score", 0)
        color = sec.get("color", "#B0BEC5")
        icon = sec.get("icon", "?")
        verdict = sec.get("verdict", "?")
        issues = sec.get("issues", [])
        parts.append('<div class="card"><h2>🛡 Безопасность системы</h2>')
        parts.append(
            f'<div class="score" style="background:{color}22;color:{color}">'
            f'{esc(icon)} Security Score: {score}/100 — {esc(verdict)}</div>')
        if issues:
            parts.append('<ul style="margin:0;padding-left:22px">')
            for i in issues:
                parts.append(f'<li style="color:#FFD54F;margin:4px 0">'
                             f'{esc(i)}</li>')
            parts.append('</ul>')
        else:
            parts.append('<p style="color:#7CFC7C;margin:0">'
                         '✅ Все проверки пройдены</p>')
        parts.append('</div>')

    # ─── 📥 Ожидающие обновления Windows ───
    upd = r.get("updates")
    if upd is not None:
        parts.append('<div class="card"><h2>📥 Ожидающие обновления '
                     'Windows</h2>')
        err = r.get("updates_error")
        if err:
            parts.append(f'<p style="color:#FF8A8A;margin:0">'
                         f'⚠️ Не удалось получить список: {esc(err)}</p>')
        elif not upd:
            parts.append('<p style="color:#7CFC7C;margin:0">'
                         '✅ Все обновления установлены — '
                         'система актуальна</p>')
        else:
            total_size = sum(u.get("size", 0) or 0 for u in upd)
            parts.append(
                f'<p style="color:#90CAF9;margin:0 0 10px">'
                f'Найдено: <b>{len(upd)}</b> &nbsp;•&nbsp; '
                f'Суммарный размер: <b>{human_size(total_size)}</b></p>')
            parts.append('<table><tr><th>Название</th><th>KB</th>'
                         '<th>Важность</th><th>Размер</th></tr>')
            for u in upd[:50]:
                kb_txt = esc(u.get("kb", "") or "—")
                sev = esc(u.get("severity", "") or "—")
                sz = u.get("size", 0) or 0
                sz_txt = human_size(sz) if sz else "—"
                parts.append(
                    f'<tr><td>{esc(u.get("title","?")[:100])}</td>'
                    f'<td class="v">{kb_txt}</td>'
                    f'<td>{sev}</td>'
                    f'<td class="v">{sz_txt}</td></tr>')
            parts.append('</table>')
            if len(upd) > 50:
                parts.append(f'<p style="color:#90A4AE;font-size:11px;'
                             f'margin:8px 0 0">... и ещё {len(upd) - 50}</p>')
        parts.append('</div>')

    parts.append('</body></html>')
    return "".join(parts)


def _build_summary(data):
    L = []
    L.append("📅 " + data["generated"])
    L.append("🖥 " + data["os"]["computer_name"])
    L.append("💿 " + data["os"]["system"] + " " + data["os"]["release"])
    L.append("")
    L.append("⚙  " + data["cpu"]["name"])
    L.append("🧠 " + str(data["cpu"]["cores"]) + " физ. / " +
             str(data["cpu"]["threads"]) + " лог.")
    L.append("💾 ОЗУ: " + human_size(data["ram"]["total"]))
    L.append("⏱  " + data["uptime"])
    L.append("")
    L.append("💽 Дисков: " + str(len(data["disks"])))
    # ─── 🛡 Строка безопасности ───
    sec = data.get("security")
    if sec:
        L.append("")
        score = sec.get("score", 0)
        icon = sec.get("icon", "?")
        verdict = sec.get("verdict", "?")
        L.append(f"🛡 Security Score: {score}/100 — {icon} {verdict}")

    # ─── 📥 Обновления ───
    upd = data.get("updates")
    if upd is not None:
        L.append("")
        if data.get("updates_error"):
            L.append("📥 Обновления: ⚠️ не удалось получить")
        elif not upd:
            L.append("📥 Обновления: ✅ всё установлено")
        else:
            total_size = sum(u.get("size", 0) or 0 for u in upd)
            L.append(f"📥 Обновления: {len(upd)} шт. "
                     f"({human_size(total_size)})")
    L.append("")
    L.append("✅ Отчёт готов!")
    return "\n".join(L)


def generate_report_worker():
    reports_ui["status"].configure(text="⏳ Сбор...", text_color="#FFD54F")
    
    # Пульсация кнопки
    btn = reports_ui["generate_btn"]
    _start_button_pulse(btn, "#2E7D32", "#43A047")
    btn.configure(state="disabled", text="⏳ Сбор...")
    
    reports_ui["progress"].set(0)
    result_q = queue.Queue()

    def _animate_progress(target, current=None):
        if current is None:
            current = reports_ui["progress"].get()
        step = (target - current) / 10
        if abs(target - current) < 0.01:
            reports_ui["progress"].set(target)
            return
        reports_ui["progress"].set(current + step)
        app.after(40, lambda: _animate_progress(target, current + step))

    def worker():
        def _set_status(msg, color="#FFD54F", prog=None):
            try:
                def _ui():
                    reports_ui["status"].configure(text=msg, text_color=color)
                    if prog is not None:
                        _animate_progress(prog)
                app.after(0, _ui)
            except Exception:
                pass

        try:
            _set_status("⏳ Сбор информации о системе...", prog=0.1)
            data = collect_full_report()

            _set_status("⏳ Проверка безопасности...", prog=0.3)
            try:
                data["security"] = _inv_security_summary()
            except Exception as _e:
                log_error("generate_report_worker.security", _e)
                data["security"] = None

            _set_status("⏳ Проверка обновлений Windows (30–60 сек)...", prog=0.5)
            try:
                updates = _wu_list_software_updates()
                norm = []
                for u in updates or []:
                    if not isinstance(u, dict): continue
                    kb = str(u.get("KB") or "").strip()
                    try: size = int(u.get("SizeBytes") or 0)
                    except Exception: size = 0
                    norm.append({
                        "title": str(u.get("Title") or "?"),
                        "kb": kb,
                        "severity": str(u.get("Severity") or ""),
                        "size": size,
                        "description": " ".join(str(u.get("Description") or "").split())[:200],
                    })
                data["updates"] = norm
            except Exception as _e:
                log_error("generate_report_worker.updates", _e)
                data["updates"] = []
                data["updates_error"] = str(_e)[:200]

            _set_status("⏳ Сбор программ, служб, автозапуска...", prog=0.7)
            try:
                _collect_report_extras(data)
            except Exception as _e:
                log_error("generate_report_worker.extras", _e)

            _set_status("⏳ Формирование отчёта...", prog=0.9)
            text = report_to_text(data)
            summary = _build_summary(data)
            result_q.put(("done", data, text, summary))
            _set_status("✅ Готово", color="#7CFC7C", prog=1.0)
        except Exception as e:
            log_error("generate_report_worker", e)
            result_q.put(("error", f"{type(e).__name__}: {e}"))

    threading.Thread(target=worker, daemon=True).start()
    start_time = time.time()

    def poll():
        if time.time() - start_time > 300:
            _stop_button_pulse(btn)
            btn.configure(state="normal", text="📊 Сформировать отчёт")
            reports_ui["status"].configure(text="⚠️ Таймаут (5 мин)", text_color="#FF8A8A")
            reports_ui["progress"].set(0)
            return
        try:
            item = result_q.get_nowait()
        except queue.Empty:
            app.after(150, poll)
            return
            
        if item[0] == "done":
            _, data, text, summary = item
            _reports_cache["text"] = text
            _reports_cache["data"] = data
            _reports_cache["summary"] = summary
            _reports_cache["html"] = ""
            
            try:
                reports_ui["summary_box"].configure(state="normal")
                reports_ui["summary_box"].delete("1.0", "end")
                reports_ui["summary_box"].insert("1.0", summary)
                reports_ui["summary_box"].configure(state="disabled")
            except Exception:
                pass
                
            reports_ui["status"].configure(
                text=f"✅ Готово • {data['generated']}", text_color="#7CFC7C")
                
            _stop_button_pulse(btn)
            btn.configure(state="normal", text="📊 Сформировать отчёт")
            
            for k in ["save_txt_btn", "save_html_btn", "save_pdf_btn",
                      "save_json_btn", "save_md_btn",
                      "copy_btn", "show_btn"]:
                reports_ui[k].configure(state="normal")
        else:
            _stop_button_pulse(btn)
            btn.configure(state="normal", text="📊 Сформировать отчёт")
            reports_ui["status"].configure(text=f"⚠️ {item[1][:200]}", text_color="#FF8A8A")
            reports_ui["progress"].set(0)
    app.after(100, poll)


