    refresh()


# ================== ОКНО: РЕЕСТР ==================
def _find_registry_issues():
    issues = []
    for root, path, view in [
        (winreg.HKEY_LOCAL_MACHINE,
         r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
         winreg.KEY_WOW64_64KEY),
        (winreg.HKEY_LOCAL_MACHINE,
         r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall",
         winreg.KEY_WOW64_64KEY),
    ]:
        try:
            key = winreg.OpenKey(root, path, 0, winreg.KEY_READ | view)
        except Exception:
            continue
        i = 0
        while True:
            try:
                sub_name = winreg.EnumKey(key, i)
                i += 1
            except OSError:
                break
            try:
                sub = winreg.OpenKey(key, sub_name, 0,
                                     winreg.KEY_READ | winreg.KEY_WOW64_64KEY)
            except Exception:
                continue
            try:
                def gv(n, default=""):
                    try:
                        v, _ = winreg.QueryValueEx(sub, n)
                        return v
                    except Exception:
                        return default
                display = gv("DisplayName", "").strip()
                uninstall = gv("UninstallString", "").strip()
                install_loc = gv("InstallLocation", "").strip()
                broken = False
                if not uninstall and not install_loc:
                    broken = True
                elif uninstall:
                    exe = uninstall.strip('"').split('"')[0].split(" ")[0]
                    if exe and not os.path.exists(exe):
                        broken = True
                if broken and display:
                    issues.append({
                        "root": "HKLM", "path": path, "subkey": sub_name,
                        "name": display, "reason": "Деинсталлятор не найден",
                    })
            finally:
                try:
                    winreg.CloseKey(sub)
                except Exception:
                    pass
        try:
            winreg.CloseKey(key)
        except Exception:
            pass
    return issues


def open_registry_cleaner():
    win = ctk.CTkToplevel(app)
    win.title("Очистка реестра")
    win.geometry("900x640")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    head = ctk.CTkLabel(win, text="🧬 Очистка реестра",
                        font=("Arial", 17, "bold"),
                        text_color="#ffffff", fg_color="#1565C0",
                        corner_radius=14, height=40)
    head.pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win, text="Ищет битые Uninstall-записи. ⚠️ Удаление необратимо.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))
    status_lbl = ctk.CTkLabel(win, text="Нажмите «Сканировать»",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=26)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")
    list_wrapper = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    list_wrapper.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    list_frame = ctk.CTkScrollableFrame(list_wrapper, fg_color="#1A2A4A",
                                        corner_radius=0)
    list_frame.pack(fill="both", expand=True, padx=3, pady=3)
    state = {"issues": []}

    def scan():
        status_lbl.configure(text="⏳ Сканирование реестра...", text_color="#FFD54F")
        for w in list_frame.winfo_children():
            w.destroy()

        def worker():
            issues = _find_registry_issues()

            def update():
                state["issues"] = issues
                if not issues:
                    status_lbl.configure(text="✅ Проблем не найдено",
                                         text_color="#7CFC7C")
                    return
                status_lbl.configure(text=f"⚠️ Найдено: {len(issues)}",
                                     text_color="#FFD54F")
                for issue in issues:
                    row = ctk.CTkFrame(list_frame, fg_color="#3A2430",
                                       corner_radius=8)
                    row.pack(fill="x", pady=1, padx=2)
                    ctk.CTkLabel(row, text=f"⚠️ {issue['name'][:70]}",
                                 font=("Arial", 11, "bold"),
                                 text_color="#FFB0B0", anchor="w").pack(
                        side="left", padx=(10, 4), pady=4, fill="x", expand=True)
                    ctk.CTkLabel(row, text=issue["reason"],
                                 font=("Inter", 11), text_color="#90CAF9",
                                 anchor="w", width=200).pack(side="left",
                                                              padx=4, pady=4)
            app.after(0, update)
        threading.Thread(target=worker, daemon=True).start()

    def clean():
        issues = state["issues"]
        if not issues:
            messagebox.showinfo("Optix", "Сначала просканируйте.")
            return
        if not messagebox.askyesno("Удалить?",
                                    f"Будет удалено записей: {len(issues)}\n\n"
                                    "Продолжить?"):
            return
        deleted = 0
        for issue in issues:
            try:
                if DRY_RUN.get("enabled", False):
                    deleted += 1
                    continue
                root = winreg.HKEY_LOCAL_MACHINE
                if issue["subkey"]:
                    winreg.DeleteKey(root, issue["path"] + "\\" + issue["subkey"])
                    deleted += 1
            except Exception:
                continue
        prefix = "Могло быть удалено" if DRY_RUN.get("enabled") else "Удалено"
        messagebox.showinfo("Готово", f"{prefix} записей: {deleted}")
        scan()

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔍 Сканировать", height=38,
                  font=("Inter", 13, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=19, command=scan
                  ).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="🧬 Очистить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#B71C1C",
                  hover_color="#E53935", corner_radius=19, command=clean
                  ).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


# ================== ОКНО: ТОЧКИ ВОССТАНОВЛЕНИЯ ==================
def _parse_wmi_datetime(s):
    """Парсит 'YYYYMMDDHHMMSS.mmm+000' (UTC) → 'YYYY-MM-DD HH:MM:SS' (локальное)."""
    try:
        if not s:
            return "—"
        st = str(s).strip()

        # Уже в ISO-формате?
        if re.match(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$", st):
            return st

        # CIM_DATETIME
        offset_min = 0
        m = re.search(r"([+-])(\d{3,4})$", st)
        if m:
            sign = 1 if m.group(1) == "+" else -1
            try:
                offset_min = sign * int(m.group(2))
            except Exception:
                offset_min = 0
            st = st[:m.start()]

        if "." in st:
            st = st.split(".")[0]

        if len(st) >= 14:
            dt = datetime.strptime(st[:14], "%Y%m%d%H%M%S")
            from datetime import timezone, timedelta
            if offset_min == 0:
                dt = dt.replace(tzinfo=timezone.utc) \
                       .astimezone() \
                       .replace(tzinfo=None)
            else:
                tz = timezone(timedelta(minutes=offset_min))
                dt = dt.replace(tzinfo=tz) \
                       .astimezone() \
                       .replace(tzinfo=None)
            return dt.strftime("%Y-%m-%d %H:%M:%S")
        return st
    except Exception:
        return str(s)


# ================== РАСШИРЕННЫЕ ТОЧКИ ВОССТАНОВЛЕНИЯ ==================
def _rp_get_points_detailed():
    """Возвращает точки восстановления с типом и последовательностью."""
    points = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-ComputerRestorePoint | "
            "Select-Object SequenceNumber,Description,CreationTime,"
            "RestorePointType | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=45,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out:
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            type_map = {
                0: "Приложение",
                1: "Установка драйвера",
                10: "Запуск приложения",
                12: "Восстановление",
                13: "Проверка обновления",
                14: "Восстановление после сбоя",
                16: "Отмена операции",
                17: "Отмена установки",
            }
            for p in data:
                if not isinstance(p, dict):
                    continue
                rt = p.get("RestorePointType", -1)
                try:
                    rt_int = int(rt)
                except Exception:
                    rt_int = -1
                points.append({
                    "seq": p.get("SequenceNumber", "?"),
                    "desc": p.get("Description", "—") or "—",
                    "created": _parse_wmi_datetime(
                        p.get("CreationTime", "")),
                    "type": type_map.get(rt_int, f"Тип {rt_int}"),
                })
    except Exception as e:
        log_error("_rp_get_points_detailed", e)
    return points


def _rp_get_shadow_storage():
    """Возвращает информацию о размере точек (vssadmin list shadowstorage)."""
    try:
