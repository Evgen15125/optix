# ─── RAM Write (memset через slice assignment) ───
def bench_ram_write():
    """Скорость записи через slice assignment."""
    size = 256 * 1024 * 1024
    ba = bytearray(size)
    pattern = b"\xAA" * size

    def work():
        ba[:] = pattern

    _, elapsed = _bench_timing(work)
    elapsed = max(0.001, elapsed)
    mbps = (size / (1024 * 1024)) / elapsed
    return {"value": round(mbps, 0), "unit": "МБ/с", "elapsed": elapsed,
            "score": _bench_normalize(mbps, BENCH_REFERENCE["ram_write"]),
            "ref": BENCH_REFERENCE["ram_write"]}


