def _update_global_footer():
    try:
        import psutil
        cpu = psutil.cpu_percent(interval=None)
        ram = psutil.virtual_memory()
        
        # Умные цвета для CPU
        c_col = "#7CFC7C" if cpu < 50 else ("#FFD54F" if cpu < 80 else "#FF8A8A")
        footer_cpu.configure(text=f"CPU: {cpu:.0f}%", text_color=c_col)
        
        # Умные цвета для RAM
        r_col = "#7CFC7C" if ram.percent < 60 else ("#FFD54F" if ram.percent < 85 else "#FF8A8A")
        footer_ram.configure(text=f"RAM: {ram.percent:.0f}%", text_color=r_col)
        
        # Температура (из фонового кэша, без WMI)
        temps = get_cached_temperatures()
        t_cpu = temps.get("cpu")
        if t_cpu:
            t_col = "#FF8A8A" if t_cpu > 85 else "#7CFC7C"
            footer_temp.configure(text=f"🌡 CPU: {t_cpu}°C", text_color=t_col)
        else:
            footer_temp.configure(text="🌡 —", text_color="#90A4AE")
            
    except Exception:
        pass
    app.after(5000, _update_global_footer)

