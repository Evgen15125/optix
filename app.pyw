                  fg_color="#1976D2", hover_color="#42A5F5",
                  corner_radius=19, command=refresh
                  ).pack(side="left", padx=4, fill="x",
                          expand=True)
    ctk.CTkButton(act1, text="🗑 Удалить ВСЕ точки",
                  height=38, font=("Inter", 13, "bold"),
                  fg_color="#B71C1C", hover_color="#E53935",
                  corner_radius=19, command=_rp_delete_all
                  ).pack(side="left", padx=(4, 0), fill="x",
                          expand=True)

    act2 = ctk.CTkFrame(win, fg_color="transparent")
    act2.pack(pady=(0, 6), padx=20, fill="x")
    ctk.CTkButton(act2, text="⚙ Настроить лимит места",
                  height=36, font=("Arial", 11, "bold"),
                  fg_color="#7B1FA2", hover_color="#9C27B0",
                  corner_radius=18, command=_rp_resize_storage
                  ).pack(side="left", padx=(0, 4), fill="x",
                          expand=True)
    ctk.CTkButton(act2, text="🛡 Управление защитой системы",
                  height=36, font=("Arial", 11, "bold"),
                  fg_color="#00695C", hover_color="#00897B",
                  corner_radius=18, command=_rp_toggle_protection
                  ).pack(side="left", padx=(4, 0), fill="x",
                          expand=True)

    ctk.CTkButton(win, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"),
                  fg_color="#455A64", hover_color="#546E7A",
                  corner_radius=19, command=win.destroy
                  ).pack(pady=(0, 14), padx=20, fill="x")

    refresh()


