# ─── Disk: RND4K Q32T16 (16 потоков по 32 ops в очереди) ───
def _bench_disk_rnd_parallel(test_size_mb=256, write=False,
                              ops=200000, threads=16):
    """Q32T16: 16 потоков × ~32 параллельных I/O."""
    import random
    from concurrent.futures import ThreadPoolExecutor
    test_file = os.path.join(BASE_DIR, "bench_tmp_rnd.bin")
    block_size = 4096
    total_mb = test_size_mb
    try:
        with open(test_file, "wb") as fp:
            chunk = os.urandom(1024 * 1024)
            for _ in range(total_mb):
                fp.write(chunk)
        random.seed(42)
        total_blocks = (total_mb * 1024 * 1024) // block_size
        all_offsets = [random.randint(0, total_blocks - 1) * block_size
                        for _ in range(ops)]
        chunk_size = max(1, ops // threads)
        chunks = [all_offsets[i:i + chunk_size]
                   for i in range(0, ops, chunk_size)]

        def worker(offsets):
            f = UnbufferedFile(test_file, mode="rw" if write else "r")
            try:
                f.open()
                if write:
                    f.write_random(offsets, block_size)
                else:
                    f.read_random(offsets, block_size)
            finally:
                f.close()

        gc.collect()
        start = time.perf_counter()
        with ThreadPoolExecutor(max_workers=threads) as ex:
            list(ex.map(worker, chunks))
        elapsed = time.perf_counter() - start
        elapsed = max(0.005, elapsed)
        iops = ops / elapsed
        mbps = (ops * block_size) / (1024 * 1024) / elapsed
        return {"value": round(mbps, 1), "unit": "МБ/с",
                "elapsed": elapsed, "iops": iops, "mbps": mbps}
    finally:
        try:
            if os.path.exists(test_file):
                os.remove(test_file)
        except Exception:
            pass


def bench_disk_rnd4k_q32t16_read():
