def _is_already_running():
    """Быстрая проверка (без прав админа): запущен ли уже Optix."""
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect(("127.0.0.1", 58921))
        s.sendall(b"SHOW")
        s.close()
        return True
    except Exception:
        try:
            s.close()
        except Exception:
            pass
        return False


def log_error(where, exc=None):
    try:
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with open(ERRORS_LOG, "a", encoding="utf-8",
                  errors="replace") as f:
            f.write(f"\n[{ts}] === {where} ===\n")
            if exc is not None:
                f.write(f"{type(exc).__name__}: {exc}\n")
                f.write(traceback.format_exc())
    except Exception:
        pass


def _get_pythonw_path():
    """
    Возвращает путь к pythonw.exe рядом с sys.executable.
    Если pythonw.exe нет — возвращает sys.executable.
    Безопаснее, чем sys.executable.replace(), т.к. не зависит
    от подстроки в пути.
    """
    try:
        exe = sys.executable
        base = os.path.basename(exe).lower()
        if base == "pythonw.exe":
            return exe
        py_dir = os.path.dirname(exe)
        pyw = os.path.join(py_dir, "pythonw.exe")
        if os.path.exists(pyw):
            return pyw
        return exe
    except Exception:
        return sys.executable


def _get_python_console_path():
    """
    Возвращает путь к python.exe (консольному) рядом с sys.executable.
    Нужен для subprocess, которым всё равно, есть ли консоль.
    Если python.exe нет — возвращает sys.executable.
    """
    try:
        exe = sys.executable
        base = os.path.basename(exe).lower()
        if base == "python.exe":
            return exe
        py_dir = os.path.dirname(exe)
        py = os.path.join(py_dir, "python.exe")
        if os.path.exists(py):
            return py
        return exe
    except Exception:
        return sys.executable


def is_admin():
    try:
        return ctypes.windll.shell32.IsUserAnAdmin()
    except Exception:
        return False


if not is_admin():
    _log_path = os.path.join(BASE_DIR, "startup_debug.log")
    def _dbg(msg):
        try:
            with open(_log_path, "a", encoding="utf-8") as lf:
                lf.write(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}\n")
        except Exception:
            pass

    _dbg("--- Старт (не админ) ---")

    if _is_already_running():
        _dbg("Найдена работающая копия. Выход.")
        sys.exit(0)

    task_exists = False
    try:
        r = subprocess.run(
            ["schtasks", "/Query", "/TN", MANUAL_TASK_NAME],
            capture_output=True, creationflags=CREATE_NO_WINDOW
        )
        task_exists = (r.returncode == 0)
    except Exception as e:
        _dbg(f"Ошибка проверки задачи: {e}")

    _dbg(f"Задача существует: {task_exists}")

    if task_exists:
        try:
            _dbg("Пишем событие через PowerShell...")
            ps_cmd = (
                "Write-EventLog -LogName Application -Source OptixTrigger "
                "-EventId 1001 -EntryType Information -Message 'Launch Optix'"
            )
            r = subprocess.run(
                ["powershell", "-NoProfile", "-Command", ps_cmd],
                capture_output=True, timeout=10, text=True,
                creationflags=CREATE_NO_WINDOW, encoding="cp866"
            )
            _dbg(f"PowerShell завершён. Код: {r.returncode}. Вывод: {r.stdout} {r.stderr}")
            sys.exit(0)
        except Exception as e:
            _dbg(f"Ошибка PowerShell: {e}")
            log_error("event_trigger_launch", e)

    _dbg("Переход к UAC...")
    _exe = sys.executable
    _base = os.path.basename(_exe).lower()
    if _base == "python.exe":
        _cand = os.path.join(os.path.dirname(_exe), "pythonw.exe")
        _pyw = _cand if os.path.exists(_cand) else _exe
    else:
        _pyw = _exe
    _script = os.path.abspath(__file__)
    _ret = ctypes.windll.shell32.ShellExecuteW(
        None, "runas", _pyw, f'"{_script}"',
        os.path.dirname(_script), 1
    )
    if _ret <= 32:
        _dbg(f"UAC не удался. Код: {_ret}")
        try:
            ctypes.windll.user32.MessageBoxW(
                0, f"Не удалось запустить с правами администратора.\nКод ошибки: {_ret}",
                "Optix", 0x10
            )
        except Exception:
            pass
    sys.exit(0)

