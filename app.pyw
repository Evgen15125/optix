# ================== ДРАЙВЕРЫ ==================
def wu_search_drivers():
    ps = r"""
$ErrorActionPreference = 'Stop'
try {
    $s = New-Object -ComObject Microsoft.Update.Session
    $q = $s.CreateUpdateSearcher()
    $q.ServerSelection = 2
    $r = $q.Search("IsInstalled=0 AND IsHidden=0 AND Type='Driver'")
    $items = @()
    foreach ($u in $r.Updates) {
        $items += [PSCustomObject]@{
            Title = $u.Title
            DriverModel = $u.DriverModel
            DriverManufacturer = $u.DriverManufacturer
            SizeBytes = $u.MaxDownloadSize
        }
    }
    $items | ConvertTo-Json -Compress -Depth 3
} catch { Write-Output ("ERROR: " + $_.Exception.Message) }
"""
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=180,
                           creationflags=CREATE_NO_WINDOW)
        out = (r.stdout or "").strip()
        if not out or out.startswith("ERROR:"):
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        return data
    except Exception:
        return []


def wu_install_updates():
    ps = r"""
$ErrorActionPreference = 'Continue'
try {
    $s = New-Object -ComObject Microsoft.Update.Session
    $q = $s.CreateUpdateSearcher()
    $q.ServerSelection = 2
    $r = $q.Search("IsInstalled=0 AND IsHidden=0 AND Type='Driver'")
    if ($r.Updates.Count -eq 0) { Write-Output "NOTHING_TO_INSTALL"; exit 0 }
    $c = New-Object -ComObject Microsoft.Update.UpdateColl
    foreach ($u in $r.Updates) {
        if (-not $u.EulaAccepted) { try { $u.AcceptEula() } catch {} }
        $c.Add($u) | Out-Null
    }
    $d = $s.CreateUpdateDownloader(); $d.Updates = $c; $d.Download() | Out-Null
    $i = $s.CreateUpdateInstaller(); $i.Updates = $c; $res = $i.Install()
    Write-Output ("REBOOT_REQUIRED: " + $res.RebootRequired)
    Write-Output "DONE"
} catch { Write-Output ("ERROR: " + $_.Exception.Message) }
"""
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=3600,
                           creationflags=CREATE_NO_WINDOW)
        return True, (r.stdout or "") + ("\n" + r.stderr if r.stderr else "")
    except Exception as e:
        return False, str(e)


def refresh_drivers_updates_ui():
    for w in drivers_updates_ui["list_frame"].winfo_children():
        w.destroy()
        
    if not drivers_updates:
        # Красивое пустое состояние
        empty_frame = ctk.CTkFrame(drivers_updates_ui["list_frame"], fg_color="transparent")
        empty_frame.pack(pady=40)
        ctk.CTkLabel(empty_frame, text="✅", font=("Inter", 48)).pack()
        ctk.CTkLabel(empty_frame, text="Обновлений не найдено", font=("Inter", 16, "bold"), text_color="#ffffff").pack(pady=(10, 4))
        ctk.CTkLabel(empty_frame, text="Все драйверы в актуальном состоянии.", font=("Inter", 12), text_color="#90A4AE").pack()
        
        drivers_updates_ui["status"].configure(
            text="Обновлений не найдено", text_color="#7CFC7C")
        drivers_updates_ui["install_all_btn"].configure(state="disabled")
        return
        
    total_size = sum(int(d.get("SizeBytes", 0) or 0) for d in drivers_updates)
    drivers_updates_ui["status"].configure(
        text=f"🎯 Найдено: {len(drivers_updates)}   •   Размер: {human_size(total_size)}",
        text_color="#7CFC7C")
    drivers_updates_ui["install_all_btn"].configure(state="normal")
    
    for d in drivers_updates:
        default_bg = "#1F2E4A"
        row = ctk.CTkFrame(drivers_updates_ui["list_frame"], fg_color=default_bg, 
                           corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=2)
        
        # Железобетонный ховер
        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E")
            except Exception: pass
        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                try:
                    x, y = r.winfo_pointerxy()
                    rx, ry = r.winfo_rootx(), r.winfo_rooty()
                    rw, rh = r.winfo_width(), r.winfo_height()
                    if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                        r.configure(fg_color=bg)
                except Exception: pass
            r.after(15, check_later)

        def bind_hover(widget):
            if isinstance(widget, ctk.CTkButton): return
            try:
                widget.bind("<Enter>", on_enter, add="+")
                widget.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_canvas"):
                    widget._canvas.bind("<Enter>", on_enter, add="+")
                    widget._canvas.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_label"):
                    widget._label.bind("<Enter>", on_enter, add="+")
                    widget._label.bind("<Leave>", on_leave, add="+")
            except Exception: pass
            for child in widget.winfo_children(): bind_hover(child)
        bind_hover(row)

        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=14, pady=(10, 4))
        
        ctk.CTkLabel(top, text=f"📦 {d.get('Title', '—')[:90]}",
                     font=("Inter", 13, "bold"), text_color="#ffffff",
                     anchor="w", justify="left").pack(fill="x")
                     
        meta_parts = []
        if d.get("DriverModel"): meta_parts.append(f"🏢 {d['DriverModel'][:30]}")
        if d.get("DriverManufacturer"): meta_parts.append(f"🏭 {d['DriverManufacturer'][:30]}")
        try:
            sz = int(d.get("SizeBytes", 0) or 0)
            if sz > 0: meta_parts.append(human_size(sz))
        except Exception: pass
        
        if meta_parts:
            ctk.CTkLabel(row, text="   •   ".join(meta_parts),
                         font=("Inter", 11), text_color="#90CAF9",
                         anchor="w").pack(fill="x", padx=(14, 14), pady=(0, 10))


def wu_search_drivers_async():
    drivers_updates_ui["search_btn"].configure(state="disabled", text="⏳...")
    drivers_updates_ui["status"].configure(text="🔍 Поиск...",
                                            text_color="#FFD54F")

    def worker():
        global drivers_updates
        drivers_updates = wu_search_drivers()
        app.after(0, lambda: drivers_updates_ui["search_btn"].configure(
            state="normal", text="🔍 Найти"))
        app.after(0, refresh_drivers_updates_ui)
    threading.Thread(target=worker, daemon=True).start()


def wu_install_drivers_async():
    if not drivers_updates:
        return
    if not messagebox.askyesno("Установить?",
                                f"Обновлений: {len(drivers_updates)}\n\nПродолжить?"):
        return
    drivers_updates_ui["install_all_btn"].configure(state="disabled", text="⏳...")

    def worker():
        ok, out = wu_install_updates()

        def finish():
            drivers_updates_ui["install_all_btn"].configure(
                state="normal", text="📥 Установить все")
            if ok:
                drivers_updates_ui["status"].configure(
                    text="✅ Установлено", text_color="#7CFC7C")
                messagebox.showinfo("Готово", out[:1000])
                wu_search_drivers_async()
            else:
                messagebox.showerror("Ошибка", out[:1000])
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


# ================== БЭКАП ДРАЙВЕРОВ ==================
def _drivers_list_installed():
    """Возвращает список сторонних драйверов через Get-WindowsDriver."""
    drivers = []
    try:
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "Get-WindowsDriver -Online -ErrorAction SilentlyContinue | "
            "Where-Object { $_.ProviderName -and "
            "  $_.ProviderName -notmatch 'Microsoft' } | "
            "Select-Object Driver, OriginalFileName, ProviderName, "
            "  ClassName, Date, Version | "
            "ConvertTo-Json -Compress -Depth 3"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=120,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        for d in data:
            if not isinstance(d, dict):
                continue
            # Извлекаем имя oem-файла из Driver (типа "oem11.inf")
            oem = str(d.get("Driver") or "").strip()
            # Дата приходит как WMI-строка /Date(...)/ — парсим
            raw_date = d.get("Date")
            date_str = "?"
            if raw_date:
                try:
                    s_date = str(raw_date)
                    if s_date.startswith("/Date(") and s_date.endswith(")/"):
                        ms = int(s_date[6:-2])
                        # Отрицательные или нулевые — драйвер без даты
                        if ms > 0:
                            date_str = datetime.fromtimestamp(
                                ms / 1000).strftime("%Y-%m-%d")
                        else:
                            date_str = "не указана"
                    else:
                        date_str = s_date[:10]
                except Exception:
                    date_str = "не указана"
            drivers.append({
                "oem": oem,
                "source": str(d.get("OriginalFileName") or "").strip(),
                "provider": str(d.get("ProviderName") or "").strip(),
                "class": str(d.get("ClassName") or "Без класса").strip(),
                "version": str(d.get("Version") or "?").strip(),
                "date": date_str,
            })
    except Exception as e:
        log_error("_drivers_list_installed", e)
    return drivers


def _drivers_backup():
    """Бэкап всех сторонних драйверов в выбранную папку."""
    if not messagebox.askyesno(
        "Бэкап драйверов",
        "Будут сохранены все сторонние драйверы системы.\n\n"
        "Это займёт 1–3 минуты и может потребовать 500 МБ–2 ГБ места.\n\n"
        "Продолжить?"):
        return

    folder = filedialog.askdirectory(
        title="Куда сохранить бэкап драйверов?")
    if not folder:
        return

    # Создаём подпапку с датой
    ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
    backup_dir = os.path.join(folder, f"Optix_Drivers_Backup_{ts}")
    try:
        os.makedirs(backup_dir, exist_ok=True)
    except Exception as e:
        messagebox.showerror("Ошибка",
                              f"Не удалось создать папку:\n{e}")
        return

    if "status" in drivers_updates_ui:
        drivers_updates_ui["status"].configure(
            text="⏳ Бэкап драйверов (1–3 мин)...",
            text_color="#FFD54F")

    def worker():
        try:
            r = subprocess.run(
                ["pnputil", "/export-driver", "*", backup_dir],
                capture_output=True, timeout=600,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b"\n" + (r.stderr or b""))
            code = r.returncode

            # Считаем, сколько драйверов выгружено
            exported = 0
            try:
                for root, dirs, files in os.walk(backup_dir):
                    for f in files:
                        if f.lower().endswith(".inf"):
                            exported += 1
            except Exception:
                pass

            def finish():
                if "status" in drivers_updates_ui:
                    if code == 0:
                        drivers_updates_ui["status"].configure(
                            text=f"✅ Бэкап: {exported} драйверов",
                            text_color="#7CFC7C")
                    else:
                        drivers_updates_ui["status"].configure(
                            text=f"⚠️ Код {code}",
                            text_color="#FFD54F")
                lines = ["=" * 70,
                         "  БЭКАП ДРАЙВЕРОВ",
                         "=" * 70,
                         "",
                         f"  Папка бэкапа: {backup_dir}",
                         f"  Драйверов (.inf): {exported}",
                         f"  Код возврата: {code}",
                         ""]
                lines.append("─" * 70)
                lines.append("  ВЫВОД pnputil")
                lines.append("─" * 70)
                lines.append(out[:3000] if out else "(пусто)")
                show_output_dialog("Бэкап драйверов", "\n".join(lines))
                if code == 0 and messagebox.askyesno(
                    "Готово",
                    f"Бэкап сохранён в:\n{backup_dir}\n\n"
                    f"Драйверов: {exported}\n\nОткрыть папку?"):
                    try:
                        os.startfile(backup_dir)
                    except Exception:
                        pass
            app.after(0, finish)
        except subprocess.TimeoutExpired:
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", "Таймаут 10 минут"))
        except Exception as e:
            log_error("_drivers_backup", e)
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


