        write_txt("00_README.txt", readme)

        # упаковка
        try:
            with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
                for name in os.listdir(tmp):
                    z.write(os.path.join(tmp, name), arcname=name)
