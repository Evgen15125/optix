    last = h[-1]
    default = f"Optix_Bench_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.csv"
    path = filedialog.asksaveasfilename(
        title="Экспорт в CSV", defaultextension=".csv",
        initialfile=default, filetypes=[("CSV", "*.csv")])
    if not path:
        return
    try:
        import csv
        with open(path, "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f, delimiter=";")
            w.writerow(["Тест", "Значение", "Единица",
                        "Балл (1000 = эталон)", "Эталон", "Отклонение %"])
            for key, res in last.get("results", {}).items():
                if not isinstance(res, dict):
                    continue
                info = BENCH_TEST_MAP.get(key)
                name = info[0] if info else key
                if "error" in res:
                    w.writerow([name, "ОШИБКА", "", "", "", ""])
                    continue
                dev = _bench_deviation(res.get("score", 0))
                w.writerow([name, res.get("value", ""),
                            res.get("unit", ""),
                            res.get("score", ""),
                            res.get("ref", ""),
                            f"{dev:+.1f}"])
        messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def compare_two_runs():
    h = load_bench_history()
    if len(h) < 2:
        messagebox.showinfo("Optix", "Нужно минимум 2 прогона.")
        return
    a, b = h[-2], h[-1]

    common = set(a.get("results", {}).keys()) & \
             set(b.get("results", {}).keys())
    if not common:
        messagebox.showinfo(
            "Optix",
            "У двух последних прогонов нет общих тестов.\n\n"
            f"A: {a.get('profile_name', '?')}\n"
            f"B: {b.get('profile_name', '?')}\n\n"
            "Сравнивать нечего. Запустите один и тот же профиль дважды.")
        return

    pa, pb = a.get("profile", "?"), b.get("profile", "?")
    if pa != pb:
        if not messagebox.askyesno(
            "Разные профили",
            f"Прогоны используют разные профили:\n"
            f"A: {a.get('profile_name', pa)}\n"
            f"B: {b.get('profile_name', pb)}\n\n"
            f"Общих тестов: {len(common)}.\n"
            f"Итог будет посчитан только по ним.\n\nПродолжить?"
        ):
            return

    win = ctk.CTkToplevel(app)
    win.title("📊 Сравнение прогонов")
    win.geometry("900x680")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    ctk.CTkLabel(win, text="📊  Сравнение двух прогонов",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text=f"A: {a.get('timestamp', '?')} ({a.get('profile_name', '')})\n"
                      f"B: {b.get('timestamp', '?')} ({b.get('profile_name', '')})",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 10))

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 12), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    hdr = ctk.CTkFrame(lst, fg_color="#0D47A1", corner_radius=8)
    hdr.pack(fill="x", pady=(0, 4), padx=2)
    for txt, wdt in [("Тест", 260), ("A", 80), ("B", 80), ("Δ", 80)]:
        ctk.CTkLabel(hdr, text=txt, font=("Arial", 11, "bold"),
                     text_color="#ffffff", width=wdt,
                     anchor="w").pack(side="left", padx=4, pady=6)

    scores_a, scores_b = [], []
    for key in sorted(common):
        info = BENCH_TEST_MAP.get(key)
        name = info[0] if info else key
        ra = a.get("results", {}).get(key, {})
        rb = b.get("results", {}).get(key, {})
        sa = ra.get("score", 0)
        sb = rb.get("score", 0)
        if sa:
            scores_a.append(sa)
        if sb:
            scores_b.append(sb)
        delta = sb - sa
        if delta > 0:
            d_color, d_txt = "#7CFC7C", f"+{delta}"
        elif delta < 0:
            d_color, d_txt = "#FF8A8A", f"{delta}"
        else:
            d_color, d_txt = "#B0BEC5", "0"

        row = ctk.CTkFrame(lst, fg_color="#243A5E", corner_radius=6)
        row.pack(fill="x", pady=1, padx=2)
        ctk.CTkLabel(row, text=name, font=("Inter", 11),
                     text_color="#ffffff", width=260,
                     anchor="w").pack(side="left", padx=4, pady=4)
        ctk.CTkLabel(row, text=str(sa), font=("Consolas", 12),
                     text_color="#90CAF9", width=80,
                     anchor="w").pack(side="left", padx=4, pady=4)
        ctk.CTkLabel(row, text=str(sb), font=("Consolas", 12),
                     text_color="#90CAF9", width=80,
                     anchor="w").pack(side="left", padx=4, pady=4)
        ctk.CTkLabel(row, text=d_txt, font=("Consolas", 10, "bold"),
                     text_color=d_color, width=80,
                     anchor="w").pack(side="left", padx=4, pady=4)

    ta = int(_bench_geomean(scores_a)) if scores_a else 0
    tb = int(_bench_geomean(scores_b)) if scores_b else 0
    td = tb - ta
    ctk.CTkLabel(lst,
                 text=f"ИТОГО по общим тестам ({len(common)}):  "
                      f"A={ta}   B={tb}   Δ={td:+d}",
                 font=("Inter", 14, "bold"),
                 text_color="#7CFC7C" if td >= 0 else "#FF8A8A",
                 fg_color="#0D47A1", corner_radius=8,
                 height=32).pack(fill="x", pady=(12, 0), padx=4)

    ctk.CTkButton(win, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(pady=(0, 14), padx=20, fill="x")


