                    ctk.CTkLabel(cr, text=c["raddr"][:32], font=("Consolas", 10), text_color=remote_color, width=220, anchor="w").pack(side="left", padx=4)
                    st_color = {"ESTABLISHED": "#7CFC7C", "LISTEN": "#4FC3F7", "TIME_WAIT": "#FFD54F", "CLOSE_WAIT": "#FF8A8A"}.get(c["state"].upper(), "#B0BEC5")
                    ctk.CTkLabel(cr, text=c["state"], font=("Inter", 10), text_color=st_color, width=130, anchor="w").pack(side="left", padx=4)
            shown += 1

        status_lbl.configure(text=f"Процессов: {len(state['data'])}  •  Показано: {shown}  •  Обновлено: {datetime.now().strftime('%H:%M:%S')}", text_color="#7CFC7C")

    def _toggle(pid):
        if pid in state["expanded"]: state["expanded"].discard(pid)
        else: state["expanded"].add(pid)
        render()

    def _refresh():
        status_lbl.configure(text="⏳ Сбор данных...", text_color="#FFD54F")
        def worker():
            data = _netproc_get_data()
            state["data"] = data
            app.after(0, render)
        threading.Thread(target=worker, daemon=True).start()

    search_entry.bind("<KeyRelease>", lambda e: render())

    def auto_refresh():
        if not win.winfo_exists(): return
        _refresh()
        app.after(4000, auto_refresh)

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
