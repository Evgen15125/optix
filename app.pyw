    search_var = ctk.StringVar()
    ctrl = ctk.CTkFrame(win, fg_color="transparent")
    ctrl.pack(pady=(0, 8), padx=20, fill="x")
    se = ctk.CTkEntry(ctrl, placeholder_text="🔍 Поиск...",
                       height=34, font=("Arial", 12), fg_color="#1A2A4A",
                       text_color="#ffffff", corner_radius=10,
                       textvariable=search_var)
    se.pack(side="left", fill="x", expand=True)

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 12), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    state = {"data": []}

    def render():
        q = search_var.get().strip().lower()
        for w in lst.winfo_children():
            w.destroy()
        filtered = [s for s in state["data"]
                    if not q or q in s["name"].lower() or q in s["display"].lower()]
        if not filtered:
            ctk.CTkLabel(lst, text="Ничего не найдено",
                         font=("Arial", 12), text_color="#90A4AE").pack(pady=20)
            return
        for s in filtered:
            protected = s["name"] in PROTECTED_SERVICES
            row = ctk.CTkFrame(lst,
                               fg_color="#2A1F33" if protected else "#243A5E",
                               corner_radius=10)
            row.pack(fill="x", pady=2, padx=2)
            st = str(s["status"]).lower()
            dot = "🟢" if st == "running" else ("🔴" if st == "stopped" else "⚪")
            ctk.CTkLabel(row, text=dot, font=("Arial", 13), width=24).pack(
                side="left", padx=(10, 4), pady=6)
            name_text = s["display"] or s["name"]
            if protected:
                name_text = "🔒 " + name_text
            ctk.CTkLabel(row, text=name_text[:60],
                         font=("Inter", 13, "bold"),
                         text_color="#E0C0FF" if protected else "#ffffff",
                         anchor="w", width=380).pack(side="left", padx=4, pady=6)
            ctk.CTkLabel(row, text=s["name"],
                         font=("Consolas", 12), text_color="#90CAF9",
                         anchor="w", width=200).pack(side="left", padx=4, pady=6)
            if protected:
                ctk.CTkLabel(row, text="🔒 защищена",
                             font=("Arial", 10, "bold"),
                             text_color="#E0C0FF").pack(side="right", padx=10, pady=6)

    def worker():
        try:
            import psutil
            data = []
            for svc in psutil.win_service_iter():
                try:
                    info = svc.as_dict()
                    st = str(info.get("start_type", "")).lower()
                    if "auto" in st:
                        data.append({
                            "name": info.get("name", ""),
                            "display": info.get("display_name", "") or info.get("name", ""),
                            "status": info.get("status", ""),
                        })
                except Exception:
                    continue
            data.sort(key=lambda x: (x["name"] in PROTECTED_SERVICES, x["display"].lower()))
            state["data"] = data
            app.after(0, lambda: status_lbl.configure(
                text=f"Авто-служб: {len(data)}   •   "
                     f"Работает: {sum(1 for s in data if str(s['status']).lower() == 'running')}",
                text_color="#7CFC7C"))
            app.after(0, render)
        except Exception as e:
            app.after(0, lambda: status_lbl.configure(
                text=f"Ошибка: {e}", text_color="#FF8A8A"))
    threading.Thread(target=worker, daemon=True).start()
    se.bind("<KeyRelease>", lambda e: render())


