# ================== АНАЛИЗ БАТАРЕИ ==================
def _get_battery_info():
    """
    Собирает данные о батарее через WMI (BatteryStaticData + BatteryFullChargedCapacity).
    Возвращает dict с реальным износом.
    """
    info = {
        "present": False,
        "percent": 0,
        "plugged": False,
        "time_left": None,
        "design_capacity": None,
        "full_capacity": None,
        "wear_percent": None,
        "cycle_count": None,
        "chemistry": None,
        "manufacturer": None,
    }

    # 1. Базовая информация через psutil
    try:
        import psutil
        bat = psutil.sensors_battery()
        if bat:
            info["present"] = True
            info["percent"] = bat.percent
            info["plugged"] = bat.power_plugged
            info["time_left"] = bat.secsleft if bat.secsleft > 0 else None
    except Exception:
        pass

    # 2. Реальная ёмкость и износ через WMI
    try:
        ps_cmd = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "$d = Get-WmiObject -Class 'BatteryStaticData' -Namespace 'root\\wmi' -ErrorAction SilentlyContinue; "
            "$f = Get-WmiObject -Class 'BatteryFullChargedCapacity' -Namespace 'root\\wmi' -ErrorAction SilentlyContinue; "
            "if ($d -and $f) { "
            "  [PSCustomObject]@{ "
            "    Designed = $d.DesignedCapacity; "
            "    Full = $f.FullChargedCapacity "
            "  } | ConvertTo-Json -Compress "
            "}"
        )
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps_cmd],
            capture_output=True, text=True, timeout=30,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace"
        )
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out:
            data = json.loads(out)
            if isinstance(data, dict):
                designed = data.get("Designed")
                full = data.get("Full")
                if designed and full and int(designed) > 0:
                    info["design_capacity"] = int(designed)
                    info["full_capacity"] = int(full)
                    wear = 100 - (int(full) / int(designed) * 100)
                    info["wear_percent"] = round(wear, 1)
    except Exception as e:
        log_error("_get_battery_info_wmi", e)

    # 3. Цикл перезарядки (если доступен)
    try:
        ps_cyc = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "(Get-WmiObject -Class 'BatteryCycleCount' -Namespace 'root\\wmi' -ErrorAction SilentlyContinue).CycleCount"
        )
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps_cyc],
            capture_output=True, text=True, timeout=15,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace"
        )
        cyc = (r.stdout or "").strip()
        if cyc.isdigit():
            info["cycle_count"] = int(cyc)
    except Exception:
        pass

    return info

