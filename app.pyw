import statistics
import gc

import ctypes
from ctypes import wintypes

# ─── WinAPI: доступ к диску без кэша ОС (FILE_FLAG_NO_BUFFERING) ───
_GENERIC_READ = 0x80000000
_GENERIC_WRITE = 0x40000000
_FILE_SHARE_READ = 0x00000001
_FILE_SHARE_WRITE = 0x00000002
_OPEN_EXISTING = 3
_CREATE_ALWAYS = 2
_FILE_FLAG_NO_BUFFERING = 0x20000000
_FILE_FLAG_WRITE_THROUGH = 0x80000000
_FILE_ATTRIBUTE_NORMAL = 0x80
_MEM_COMMIT = 0x1000
_MEM_RESERVE = 0x2000
_MEM_RELEASE = 0x8000
_PAGE_READWRITE = 0x04
_INVALID_HANDLE = ctypes.c_void_p(-1).value

_k32 = ctypes.WinDLL("kernel32", use_last_error=True)
_k32.CreateFileW.restype = wintypes.HANDLE
_k32.CreateFileW.argtypes = [
    wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
    wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE,
]
_k32.CloseHandle.argtypes = [wintypes.HANDLE]
_k32.ReadFile.argtypes = [
    wintypes.HANDLE, wintypes.LPVOID, wintypes.DWORD,
    ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID,
]
_k32.WriteFile.argtypes = [
    wintypes.HANDLE, wintypes.LPCVOID, wintypes.DWORD,
    ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID,
]
_k32.VirtualAlloc.restype = wintypes.LPVOID
_k32.VirtualAlloc.argtypes = [
    wintypes.LPVOID, ctypes.c_size_t, wintypes.DWORD, wintypes.DWORD,
]
_k32.VirtualFree.argtypes = [
    wintypes.LPVOID, ctypes.c_size_t, wintypes.DWORD,
]
_k32.SetFilePointerEx.argtypes = [
    wintypes.HANDLE, ctypes.c_longlong,
    ctypes.POINTER(ctypes.c_longlong), wintypes.DWORD,
]


class UnbufferedFile:
    """
    Файл без кэша ОС через FILE_FLAG_NO_BUFFERING.
    Если Open не удался (сетевой диск, exFAT) — тихо падает
    в buffered-режим через обычный open().
    """

    SECTOR = 4096

    def __init__(self, path, mode="r"):
        self.path = str(path)
        self.mode = mode
        self.handle = None
        self._buf = None
        self._buf_size = 0
        self._fallback = None  # обычный файл, если NO_BUFFERING не сработал

    def open(self):
        if self.mode == "r":
            access = _GENERIC_READ
            disposition = _OPEN_EXISTING
        elif self.mode == "w":
            access = _GENERIC_WRITE
            disposition = _CREATE_ALWAYS
        else:  # "rw"
            access = _GENERIC_READ | _GENERIC_WRITE
            disposition = _OPEN_EXISTING
        flags = _FILE_ATTRIBUTE_NORMAL | _FILE_FLAG_NO_BUFFERING | _FILE_FLAG_WRITE_THROUGH
        share_mode = _FILE_SHARE_READ | _FILE_SHARE_WRITE
        h = _k32.CreateFileW(self.path, access, share_mode, None,
                              disposition, flags, None)
        if h is None or h == _INVALID_HANDLE:
            # Fallback: buffered
            fb_mode = {"r": "rb", "w": "wb", "rw": "r+b"}[self.mode]
            self._fallback = open(self.path, fb_mode)
            return self
        self.handle = h
        return self

    def close(self):
        if self.handle:
            _k32.CloseHandle(self.handle)
            self.handle = None
        if self._buf:
            _k32.VirtualFree(self._buf, 0, _MEM_RELEASE)
            self._buf = None
            self._buf_size = 0
        if self._fallback:
            try:
                self._fallback.close()
            except Exception:
                pass
            self._fallback = None

    def _ensure_buf(self, size):
        if self._fallback:
            return None
        if self._buf_size >= size and self._buf:
            return self._buf
        if self._buf:
            _k32.VirtualFree(self._buf, 0, _MEM_RELEASE)
        self._buf = _k32.VirtualAlloc(None, size,
                                       _MEM_COMMIT | _MEM_RESERVE,
                                       _PAGE_READWRITE)
        if not self._buf:
            raise MemoryError("VirtualAlloc failed")
        self._buf_size = size
        return self._buf

    def _seek(self, offset):
        if self._fallback:
            self._fallback.seek(offset)
            return
        _k32.SetFilePointerEx(self.handle, offset, None, 0)

    def write_sequential(self, total_size, block_size):
        if self._fallback:
            chunk = b"\xAA" * block_size
            written = 0
            while written < total_size:
                self._fallback.write(chunk)
                written += block_size
            return
        buf = self._ensure_buf(block_size)
        pattern = b"\xAA" * block_size
        ctypes.memmove(buf, pattern, block_size)
        w = wintypes.DWORD(0)
        blocks = total_size // block_size
        for _ in range(blocks):
            if not _k32.WriteFile(self.handle, buf, block_size,
                                    ctypes.byref(w), None):
                raise OSError(f"WriteFile: {ctypes.get_last_error()}")

    def read_sequential(self, total_size, block_size):
        if self._fallback:
            read = 0
            while read < total_size:
                if not self._fallback.read(block_size):
                    break
                read += block_size
            return
        buf = self._ensure_buf(block_size)
        r = wintypes.DWORD(0)
        blocks = total_size // block_size
        for _ in range(blocks):
            if not _k32.ReadFile(self.handle, buf, block_size,
                                   ctypes.byref(r), None):
                raise OSError(f"ReadFile: {ctypes.get_last_error()}")

    def read_random(self, offsets, block_size):
        if self._fallback:
            for off in offsets:
                self._fallback.seek(off)
                self._fallback.read(block_size)
            return
        buf = self._ensure_buf(block_size)
        r = wintypes.DWORD(0)
        for off in offsets:
            self._seek(off)
            if not _k32.ReadFile(self.handle, buf, block_size,
                                   ctypes.byref(r), None):
                raise OSError(f"ReadFile: {ctypes.get_last_error()}")

    def write_random(self, offsets, block_size):
        if self._fallback:
            chunk = b"\x55" * block_size
            for off in offsets:
                self._fallback.seek(off)
                self._fallback.write(chunk)
            return
        buf = self._ensure_buf(block_size)
        pattern = b"\x55" * block_size
        ctypes.memmove(buf, pattern, block_size)
        w = wintypes.DWORD(0)
        for off in offsets:
            self._seek(off)
            if not _k32.WriteFile(self.handle, buf, block_size,
                                    ctypes.byref(w), None):
                raise OSError(f"WriteFile: {ctypes.get_last_error()}")

