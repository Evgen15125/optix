def _task_action_clean(task, action, log):
    """Очистка указанных категорий."""
    names = set(action.get("categories", []))
    total_freed = 0
    total_files = 0
    for cat in CATEGORIES:
        if cat["name"] in names:
            try:
                f_, n_, _ = clean_category(cat)
                total_freed += f_
                total_files += n_
                log.append(f"   ✓ {cat['name']}: "
                            f"{human_size(f_)}, файлов: {n_}")
            except Exception as e:
                log.append(f"   ✗ {cat['name']}: {e}")
    return {"freed": total_freed, "files": total_files}


def _task_action_optimize(task, action, log):
    """Применение твиков."""
    tw = action.get("tweaks", [])
    for t in tw:
        try:
            if t == "power_high":
                set_power_plan_high()
                log.append("   ✓ Схема питания: Высокая")
            elif t == "visual_off":
                apply_visual_effects_off()
                log.append("   ✓ Визуальные эффекты: откл.")
            elif t == "telemetry_off":
                apply_telemetry_off()
                log.append("   ✓ Телеметрия: откл.")
            elif t == "gamebar_off":
                apply_gamebar_off()
                log.append("   ✓ Game Bar: откл.")
        except Exception as e:
            log.append(f"   ✗ {t}: {e}")
    return {}


def _task_action_backup(task, action, log):
    """Бэкап реестра или папок."""
    target = action.get("backup_target", "tweaks")
    try:
        if target == "tweaks":
            backup = load_tweaks_backup()
            ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
            path = os.path.join(BASE_DIR,
                                 f"backup_tweaks_{ts}.json")
            with open(path, "w", encoding="utf-8") as f:
                json.dump(backup, f, ensure_ascii=False, indent=2)
            log.append(f"   ✓ Бэкап твиков: {path}")
        elif target == "drivers":
            folder = action.get("backup_folder")
            if folder:
                os.makedirs(folder, exist_ok=True)
                subprocess.run(
                    ["pnputil", "/export-driver", "*", folder],
                    capture_output=True, timeout=600,
                    creationflags=CREATE_NO_WINDOW)
                log.append(f"   ✓ Бэкап драйверов: {folder}")
        elif target == "autostart":
            items, _ = get_autostart_items()
            ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
            path = os.path.join(BASE_DIR,
                                 f"backup_autostart_{ts}.json")
            with open(path, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False, indent=2,
                          default=str)
            log.append(f"   ✓ Бэкап автозапуска: {path}")
    except Exception as e:
        log.append(f"   ✗ Бэкап: {e}")
    return {}


def _task_action_notify(task, action, log):
