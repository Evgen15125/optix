                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 10))
                 
    list_wrapper = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    list_wrapper.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    list_frame = ctk.CTkScrollableFrame(list_wrapper, fg_color="transparent", corner_radius=0)
    list_frame.pack(fill="both", expand=True, padx=4, pady=4)

    def refresh():
        for w in list_frame.winfo_children():
            w.destroy()
        items = load_exclusions()
        if not items:
            ctk.CTkLabel(list_frame, text="Исключений пока нет",
                         font=("Inter", 14), text_color="#90A4AE").pack(pady=30)
            return
        for idx, path in enumerate(items):
            row = ctk.CTkFrame(list_frame, fg_color="#1F2E4A", corner_radius=10)
            row.pack(fill="x", pady=2, padx=2)
            ctk.CTkLabel(row, text=f"📁 {path}", font=("Consolas", 11), 
                         text_color="#e0e8f5", anchor="w").pack(side="left", padx=12, pady=8, fill="x", expand=True)

            def mk_remove(i=idx):
                def do():
                    items = load_exclusions()
                    if 0 <= i < len(items):
                        items.pop(i)
                        save_exclusions(items)
                        refresh()
                return do

            ctk.CTkButton(row, text="✕", width=36, height=28, font=("Inter", 12, "bold"),
                          fg_color="#B71C1C", hover_color="#E53935",
                          corner_radius=14, command=mk_remove()).pack(side="right", padx=6, pady=4)

    def add_folder():
        path = filedialog.askdirectory(title="Выберите папку для исключения")
        if not path: return
        items = load_exclusions()
        if path not in items:
            items.append(path)
            save_exclusions(items)
            refresh()

    def add_file():
        path = filedialog.askopenfilename(title="Выберите файл для исключения")
        if not path: return
        items = load_exclusions()
        if path not in items:
            items.append(path)
            save_exclusions(items)
            refresh()

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="📁 Добавить папку", height=40, font=("Inter", 12, "bold"),
                  fg_color="#43A047", hover_color="#66BB6A", corner_radius=20, command=add_folder
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="📄 Добавить файл", height=40, font=("Inter", 12, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5", corner_radius=20, command=add_file
                  ).pack(side="left", padx=6, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40, font=("Inter", 12, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=20, command=win.destroy
                  ).pack(side="left", padx=(6, 0), fill="x", expand=True)
    refresh()


