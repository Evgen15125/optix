def load_tweaks_backup():
    try:
        with open(TWEAKS_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save_tweaks_backup(data):
    try:
        with open(TWEAKS_PATH, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        print(f"save_tweaks error: {e}")


def set_reg(root, path, name, value, value_type=winreg.REG_DWORD):
    backup = load_tweaks_backup()
    root_str = "HKCU" if root == winreg.HKEY_CURRENT_USER else "HKLM"
    key_id = f"{root_str}|{path}|{name}"
    try:
        try:
            key = winreg.OpenKey(root, path, 0, winreg.KEY_READ | winreg.KEY_SET_VALUE)
        except FileNotFoundError:
            key = winreg.CreateKeyEx(root, path, 0,
                                     winreg.KEY_READ | winreg.KEY_SET_VALUE)
        if key_id not in backup:
            try:
                old_value, old_type = winreg.QueryValueEx(key, name)
                backup[key_id] = {"exists": True, "value": old_value,
                                   "type": old_type}
            except FileNotFoundError:
                backup[key_id] = {"exists": False}
        winreg.SetValueEx(key, name, 0, value_type, value)
        winreg.CloseKey(key)
        save_tweaks_backup(backup)
        return True, ""
    except Exception as e:
        return False, str(e)


def restore_tweaks():
    backup = load_tweaks_backup()
    restored = errors = 0
    hkcu_u = winreg.HKEY_CURRENT_USER & 0xFFFFFFFF
    hklm_u = winreg.HKEY_LOCAL_MACHINE & 0xFFFFFFFF
    for key_id, data in backup.items():
        try:
            parts = key_id.split("|", 2)
            if len(parts) != 3:
                continue
            root_str, path, name = parts

            root = None
            if root_str == "HKCU":
                root = winreg.HKEY_CURRENT_USER
            elif root_str == "HKLM":
                root = winreg.HKEY_LOCAL_MACHINE
            else:
                try:
                    root_int = int(root_str) & 0xFFFFFFFF
                    if root_int == hkcu_u:
                        root = winreg.HKEY_CURRENT_USER
                    elif root_int == hklm_u:
                        root = winreg.HKEY_LOCAL_MACHINE
                except (ValueError, TypeError):
                    pass
            if root is None:
                continue

            try:
                key = winreg.OpenKey(root, path, 0,
                                     winreg.KEY_READ | winreg.KEY_SET_VALUE)
            except FileNotFoundError:
                continue

            if data.get("exists"):
                winreg.SetValueEx(key, name, 0, data["type"], data["value"])
                restored += 1
            else:
                try:
                    winreg.DeleteValue(key, name)
                    restored += 1
                except FileNotFoundError:
                    restored += 1
            winreg.CloseKey(key)
        except Exception:
            errors += 1
    save_tweaks_backup({})
    return restored, errors


