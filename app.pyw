                        font=("Inter", 20, "bold"),
                        text_color="#ffffff", fg_color="#1565C0",
                        corner_radius=14, height=44, border_width=1, border_color="#4FC3F7")
    head.pack(pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win, text="Ярлыки на рабочем столе и в меню Пуск, ведущие на удалённые программы.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 10))
                 
    status_lbl = ctk.CTkLabel(win, text="Сканирование...", font=("Inter", 12, "bold"),
                              text_color="#FFD54F", fg_color="#131E32", corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")
    
    list_wrapper = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    list_wrapper.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    list_frame = ctk.CTkScrollableFrame(list_wrapper, fg_color="transparent", corner_radius=0)
    list_frame.pack(fill="both", expand=True, padx=4, pady=4)

    def refresh():
        for w in list_frame.winfo_children(): w.destroy()
        status_lbl.configure(text="Сканирование...", text_color="#FFD54F")

        def worker():
            dead = _find_dead_shortcuts()

            def update():
                if dead is None:
                    status_lbl.configure(text="⚠️ Требуется pywin32: pip install pywin32", text_color="#FF8A8A")
                    return
                if not dead:
                    status_lbl.configure(text="✅ Мёртвых ярлыков не найдено", text_color="#7CFC7C")
                    return
                status_lbl.configure(text=f"Найдено: {len(dead)}", text_color="#7CFC7C")
                for fp, target in dead:
                    row = ctk.CTkFrame(list_frame, fg_color="#3A1F1F", corner_radius=8)
                    row.pack(fill="x", pady=2, padx=2)
                    ctk.CTkLabel(row, text=f"🔗 {os.path.basename(fp)}", font=("Inter", 11, "bold"),
                                 text_color="#FFB0B0", anchor="w", width=200).pack(side="left", padx=(10, 4), pady=6)
                    ctk.CTkLabel(row, text=f"→ {target}", font=("Consolas", 10), text_color="#B0BEC5", anchor="w").pack(
                        side="left", padx=4, pady=6, fill="x", expand=True)

                    def mk_del(p=fp):
                        def do():
                            try:
                                os.remove(p)
                                refresh()
                            except Exception as e:
                                messagebox.showerror("Ошибка", str(e))
                        return do

                    ctk.CTkButton(row, text="🗑", width=36, height=28, font=("Inter", 12, "bold"),
                                  fg_color="#B71C1C", hover_color="#E53935", corner_radius=14, command=mk_del()
                                  ).pack(side="right", padx=6, pady=4)
            app.after(0, update)
