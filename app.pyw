def _find_ohm_exe():
    candidates = [
        os.path.join(BASE_DIR, "OpenHardwareMonitor", "OpenHardwareMonitor.exe"),
        os.path.join(BASE_DIR, "OpenHardwareMonitor.exe"),
        r"D:\OpenHardwareMonitor\OpenHardwareMonitor.exe",
        r"D:\OpenHardwareMonitor.exe",
        r"C:\Program Files\OpenHardwareMonitor\OpenHardwareMonitor.exe",
        r"C:\Program Files (x86)\OpenHardwareMonitor\OpenHardwareMonitor.exe",
    ]
    for p in candidates:
        if p and os.path.exists(p):
            return p

    # Поиск в папках пользователя (Загрузки, Рабочий стол, Документы)
    try:
        user = os.environ.get("USERNAME", "")
        folders = ["Downloads", "Загрузки", "Desktop", "Рабочий стол",
                   "Documents", "Документы"]
        for folder in folders:
            p = f"C:\\Users\\{user}\\{folder}\\OpenHardwareMonitor\\OpenHardwareMonitor.exe"
            if os.path.exists(p):
                return p
            p2 = f"C:\\Users\\{user}\\{folder}\\OpenHardwareMonitor.exe"
            if os.path.exists(p2):
                return p2
    except Exception:
        pass

    # Поиск по всем локальным дискам (C, D, E, F...) в корне и Program Files
    try:
        for drive in string.ascii_uppercase:
            if not os.path.exists(f"{drive}:\\"):
                continue
            paths_to_check = [
                f"{drive}:\\OpenHardwareMonitor\\OpenHardwareMonitor.exe",
                f"{drive}:\\OpenHardwareMonitor.exe",
                f"{drive}:\\Program Files\\OpenHardwareMonitor\\OpenHardwareMonitor.exe",
                f"{drive}:\\Program Files (x86)\\OpenHardwareMonitor\\OpenHardwareMonitor.exe",
                f"{drive}:\\Программы\\OpenHardwareMonitor\\OpenHardwareMonitor.exe",
            ]
            for p in paths_to_check:
                if os.path.exists(p):
                    return p
    except Exception:
        pass

    return None


_OHM_STARTED_BY_US = {"value": False}


def _ensure_ohm_running():
    try:
        import psutil
        # 1. Уже запущен?
        for p in psutil.process_iter(["name"]):
            try:
                n = (p.info.get("name") or "").lower()
                if n == "openhardwaremonitor.exe":
                    return True
            except Exception:
                continue
                
        exe = _find_ohm_exe()
        if not exe:
            log_error("_ensure_ohm_running", Exception("OHM не найден ни в одном из путей"))
            return False
            
        task_name = "Optix_OHM_Hidden"
        
        # 2. Проверяем, есть ли задача в Планировщике. Если нет — создаем (один раз).
        r = subprocess.run(["schtasks", "/query", "/tn", task_name], capture_output=True, creationflags=CREATE_NO_WINDOW)
        if r.returncode != 0:
            # Задачи нет — создаем её
            cmd_create = ["schtasks", "/create", "/tn", task_name, 
                          "/tr", f'"{exe}" -minimized', 
                          "/sc", "once", "/st", "00:00", "/ru", "SYSTEM", "/f"]
            subprocess.run(cmd_create, capture_output=True, timeout=10, creationflags=CREATE_NO_WINDOW)
        
        # 3. Запускаем задачу (теперь это происходит мгновенно)
        r_run = subprocess.run(["schtasks", "/run", "/tn", task_name], capture_output=True, timeout=10, creationflags=CREATE_NO_WINDOW)
        
        if r_run.returncode != 0:
            # Если не удалось запустить от SYSTEM (например, нет прав), 
            # запускаем обычным способом и скрываем окно через WinAPI
            p = subprocess.Popen([exe, "-minimized"], cwd=os.path.dirname(exe), creationflags=CREATE_NO_WINDOW)
            try:
                import win32gui, win32process, win32con
                time.sleep(0.5) # Минимальная задержка для появления окна
                def callback(hwnd, extra):
                    _, pid = win32process.GetWindowThreadProcessId(hwnd)
                    if pid == p.pid:
                        win32gui.ShowWindow(hwnd, win32con.SW_HIDE)
                    return True
                win32gui.EnumWindows(callback, None)
            except Exception:
                pass
                
        _OHM_STARTED_BY_US["value"] = True
        
        # Убрали жесткий sleep(3). Программа сама подхватит данные, 
        # как только OHM их отдаст (WMI обновляется каждые 2-3 секунды).
        return True
    except Exception as e:
        log_error("_ensure_ohm_running", e)
        return False


def _kill_ohm():
    """
    Убивает OpenHardwareMonitor ТОЛЬКО если его запустил Optix.
    Если OHM был запущен пользователем до Optix — не трогаем.
    """
    if not _OHM_STARTED_BY_US.get("value"):
        return
    try:
        import psutil
        for p in psutil.process_iter(["name"]):
            try:
                n = (p.info.get("name") or "").lower()
                if n == "openhardwaremonitor.exe":
                    p.kill()
            except Exception:
                continue
        _OHM_STARTED_BY_US["value"] = False
    except Exception:
        pass


def _start_single_instance_server():
    """Фоновый сервер, который слушает команду 'SHOW' от второй копии."""
    def server_worker():
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("127.0.0.1", 58921))
            s.listen(1)
            while True:
                try:
                    conn, addr = s.accept()
                    data = conn.recv(1024).decode("utf-8", errors="ignore")
                    if "SHOW" in data:
                        # Безопасно вызываем показ окна в главном потоке Tkinter
                        app.after(0, _do_show_window)
                    conn.close()
                except Exception:
                    pass
        except Exception as e:
            log_error("single_instance_server_bind", e)

    threading.Thread(target=server_worker, daemon=True).start()


def _check_single_instance():
    """
    Проверяет, запущен ли уже Optix.
    Если да — шлёт сигнал 'SHOW' и завершает текущий процесс.
    """
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1.0)
    try:
        # Пытаемся подключиться к уже запущенной копии
        s.connect(("127.0.0.1", 58921))
        s.sendall(b"SHOW")
        s.close()
        # Если подключились — значит, первая копия уже работает.
        # Отправляем её окну команду "показаться" и выходим.
        sys.exit(0)
    except (ConnectionRefusedError, socket.timeout, OSError):
        # Никто не слушает порт -> мы первая копия.
        # Запускаем сервер для будущих копий.
        s.close()
        _start_single_instance_server()

def _get_gpu_temp_nvidia():
    """
    Возвращает температуру GPU в °C через nvidia-smi.exe.
    Работает только для GPU NVIDIA. Если ничего не нашёл — возвращает None.
    """
    candidates = [
        r"C:\Windows\System32\nvidia-smi.exe",
        r"C:\Program Files\NVIDIA Corporation\NVSMI\nvidia-smi.exe",
    ]
    smi_path = None
    for p in candidates:
        if os.path.exists(p):
            smi_path = p
            break
    if smi_path is None:
        try:
            r = subprocess.run(["where", "nvidia-smi"], capture_output=True,
                               text=True, timeout=5,
                               creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                lines = (r.stdout or "").strip().splitlines()
                if lines:
                    smi_path = lines[0].strip()
        except Exception:
            pass
    if not smi_path or not os.path.exists(smi_path):
        return None
    try:
        r = subprocess.run(
            [smi_path, "--query-gpu=temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace"
        )
        out = (r.stdout or "").strip().splitlines()
        if not out:
            return None
        temps = []
        for line in out:
            line = line.strip()
            if not line:
                continue
            try:
                temps.append(int(line))
            except ValueError:
                continue
        if temps:
            return max(temps)
    except Exception as e:
        log_error("_get_gpu_temp_nvidia", e)
    return None



def get_system_info():
    import platform
    import psutil
    cpu_name = "Неизвестно"
    try:
        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                             r"HARDWARE\DESCRIPTION\System\CentralProcessor\0")
        cpu_name, _ = winreg.QueryValueEx(key, "ProcessorNameString")
        winreg.CloseKey(key)
    except Exception:
        try:
            cpu_name = platform.processor() or "Неизвестно"
        except Exception:
            pass
    total_ram = psutil.virtual_memory().total / (1024 ** 3)
    return {
        "os": f"{platform.system()} {platform.release()}",
        "cpu": cpu_name.strip(),
        "ram_total": f"{total_ram:.1f} ГБ",
        "cores": psutil.cpu_count(logical=False),
        "threads": psutil.cpu_count(logical=True),
    }


def _get_temperatures():
    """Улучшенный поиск температур CPU/GPU из OHM + WMI fallback + nvidia-smi."""
    temps = {"cpu": None, "gpu": None}

    # ─── Инициализация COM для текущего потока ───
    # Без этого wmi.WMI() из фонового threading.Thread молча падает,
    # потому что каждый поток должен сам инициализировать COM.
    try:
        import pythoncom
        pythoncom.CoInitialize()
    except Exception:
        pass

    if not WMI_AVAILABLE:
        try:
            nv = _get_gpu_temp_nvidia()
            if nv is not None:
                temps["gpu"] = nv
        except Exception:
            pass
        return temps

    try:
        w = wmi.WMI(namespace="root\\OpenHardwareMonitor")
        cpu_candidates = []
        gpu_candidates = []
        for s in w.Sensor():
            if s.SensorType != "Temperature":
                continue
            name = (s.Name or "").lower()
            parent = (getattr(s, "Parent", "") or "").lower()
            hay = name + " " + parent
            val = s.Value
            if val is None:
                continue
            if any(k in hay for k in ["cpu", "core", "package", "pkg",
                                       "intel", "amd", "ryzen", "core i"]):
                cpu_candidates.append(val)
            elif any(k in hay for k in ["gpu", "nvidia", "geforce", "radeon",
                                         "amd gpu", "intel gpu"]):
                gpu_candidates.append(val)
        if cpu_candidates:
            temps["cpu"] = round(max(cpu_candidates), 1)
        if gpu_candidates:
            temps["gpu"] = round(max(gpu_candidates), 1)
    except Exception as e:
        log_error("_get_temperatures_ohm", e)

    if temps["cpu"] is None:
        try:
            w = wmi.WMI(namespace="root\\WMI")
            for zone in w.MSAcpi_ThermalZoneTemperature():
                c = (zone.CurrentTemperature / 10.0) - 273.15
                if 0 < c < 150:
                    temps["cpu"] = round(c, 1)
                    break
        except Exception as e:
            log_error("_get_temperatures_acpi", e)

    # ─── nvidia-smi — если OHM и WMI не дали температуру GPU ───
    if temps["gpu"] is None:
        try:
            nv = _get_gpu_temp_nvidia()
            if nv is not None:
                temps["gpu"] = nv
        except Exception:
            pass

    return temps


# ─── Фоновый кэш температур (чтобы не грузить UI-поток WMI) ───
_TEMP_CACHE = {"cpu": None, "gpu": None, "timestamp": 0}

def get_cached_temperatures():
    """Мгновенно возвращает температуры из кэша (без WMI)."""
    return {"cpu": _TEMP_CACHE["cpu"], "gpu": _TEMP_CACHE["gpu"]}

def _temp_cache_worker():
    global _TEMP_CACHE
    while True:
        try:
            temps = _get_temperatures()
            # Атомарная замена всего словаря целиком
            new_cache = {
                "cpu": temps.get("cpu"),
                "gpu": temps.get("gpu"),
                "timestamp": time.time()
            }
            _TEMP_CACHE = new_cache
        except Exception:
            pass
        time.sleep(10)


def _get_gpu_info():
    if not WMI_AVAILABLE:
        return []
    try:
        import pythoncom
        pythoncom.CoInitialize()
    except Exception:
        pass
    gpus = []
    try:
        w = wmi.WMI()
        for g in w.Win32_VideoController():
            vram = 0
            try:
                if g.AdapterRAM:
                    vram = int(g.AdapterRAM)
                    # WMI AdapterRAM — 32-битное unsigned,
                    # но через COM приходит как signed. Для карт >2 ГБ
                    # получаем отрицательное. Корректируем.
                    if vram < 0:
                        vram = vram & 0xFFFFFFFF
            except Exception:
                vram = 0
            # Дополнительно: для NVIDIA попробуем взять VRAM из реестра,
            # если WMI дал подозрительно мало (< 1 ГБ при непустом имени)
            if vram < 512 * 1024 * 1024:
                try:
                    name_low = (g.Name or "").lower()
                    if "nvidia" in name_low or "geforce" in name_low \
                            or "radeon" in name_low or "amd" in name_low:
                        reg_vram = _get_vram_from_registry(g.Name)
                        if reg_vram and reg_vram > vram:
                            vram = reg_vram
                except Exception:
                    pass
            gpus.append({"name": g.Name or "?", "vram": vram})
    except Exception as e:
        log_error("_get_gpu_info", e)
    finally:
        try:
            import pythoncom
            pythoncom.CoUninitialize()
        except Exception:
            pass
    return gpus


def _get_vram_from_registry(gpu_name):
    """Пытается вытащить объём VRAM из реестра (для NVIDIA / AMD)."""
    try:
        base = r"SYSTEM\CurrentControlSet\Control\Class"
        # Класс Display = {4d36e968-e325-11ce-bfc1-08002be10318}
        display_class = r"{4d36e968-e325-11ce-bfc1-08002be10318}"
        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                             base + "\\" + display_class,
                             0, winreg.KEY_READ)
        try:
            i = 0
            while True:
                try:
                    sub_name = winreg.EnumKey(key, i)
                    i += 1
                except OSError:
                    break
                if not sub_name.isdigit():
                    continue
                try:
                    sub = winreg.OpenKey(key, sub_name, 0, winreg.KEY_READ)
                except Exception:
                    continue
                try:
                    try:
                        desc, _ = winreg.QueryValueEx(sub, "DriverDesc")
                    except Exception:
                        desc = ""
                    # Ищем запись по совпадению с именем
                    if not desc:
                        winreg.CloseKey(sub)
                        continue
                    short_desc = desc.lower().split("(")[0].strip()
                    short_name = gpu_name.lower().split("(")[0].strip()
                    if short_desc not in short_name and \
                       short_name not in short_desc:
                        winreg.CloseKey(sub)
                        continue
                    # HardWareInformation.MemorySize — 32-bit DWORD
                    # в байтах или МБ
                    for vram_attr in ("HardWareInformation.MemorySize",
                                       "HardwareInformation.MemorySize"):
                        try:
                            v, _ = winreg.QueryValueEx(sub, vram_attr)
                            if isinstance(v, bytes) and len(v) == 4:
                                val = int.from_bytes(v, "little")
                                if val > 0:
                                    winreg.CloseKey(sub)
                                    winreg.CloseKey(key)
                                    return val
                            elif isinstance(v, int) and v > 0:
                                # Иногда в МБ
                                if v < 1024 * 1024:
                                    v = v * 1024 * 1024
                                winreg.CloseKey(sub)
                                winreg.CloseKey(key)
                                return v
                        except Exception:
                            continue
                finally:
                    try:
                        winreg.CloseKey(sub)
                    except Exception:
                        pass
        finally:
            try:
                winreg.CloseKey(key)
            except Exception:
                pass
    except Exception as e:
        log_error("_get_vram_from_registry", e)
    return 0


def _get_top_processes(n=5):
    try:
        import psutil
        # Исключаем "мусорные" — Idle и System
        SKIP = {"System Idle Process", "Idle", "System"}
        procs = []
        for p in psutil.process_iter(["pid", "name", "cpu_percent", "memory_percent"]):
            try:
                i = p.info
                name = i["name"] or "?"
                if name in SKIP:
                    continue
                procs.append({"name": name,
                              "cpu": i["cpu_percent"] or 0.0,
                              "ram": i["memory_percent"] or 0.0})
            except Exception:
                continue
        top_cpu = sorted(procs, key=lambda x: -x["cpu"])[:n]
        top_ram = sorted(procs, key=lambda x: -x["ram"])[:n]
        return top_cpu, top_ram
    except Exception:
        return [], []


def _get_system_extended():
    info = {}
    if not WMI_AVAILABLE:
        return info
    try:
        w = wmi.WMI()
        for b in w.Win32_BaseBoard():
            info["motherboard"] = f"{b.Manufacturer} {b.Product}"
            break
        for bios in w.Win32_BIOS():
            info["bios"] = f"{bios.Manufacturer} {bios.SMBIOSBIOSVersion}"
            break
        for cs in w.Win32_ComputerSystem():
            info["manufacturer"] = cs.Manufacturer
            info["model"] = cs.Model
            break
    except Exception:
        pass
    return info


def _export_monitor_report():
    try:
        import psutil
        lines = ["=" * 60, "  ОТЧЁТ МОНИТОРИНГА Optix", "=" * 60, ""]
        lines.append(f"Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        lines.append("")
        cpu = psutil.cpu_percent(interval=None)
        freq = psutil.cpu_freq()
        lines.append(f"CPU: {cpu:.1f}%  |  Частота: {freq.current:.0f} МГц")
        temps = _get_temperatures()
        if temps["cpu"]:
            lines.append(f"  Температура CPU: {temps['cpu']} °C")
        if temps["gpu"]:
            lines.append(f"  Температура GPU: {temps['gpu']} °C")
        lines.append("")
        ram = psutil.virtual_memory()
        lines.append(f"RAM: {ram.percent:.1f}%  "
                     f"({human_size(ram.used)} / {human_size(ram.total)})")
        lines.append("")
        for part in psutil.disk_partitions(all=False):
            try:
                u = psutil.disk_usage(part.mountpoint)
                lines.append(f"{part.mountpoint}: {u.percent:.1f}%  "
                             f"({human_size(u.used)} / {human_size(u.total)})")
            except Exception:
                continue
        lines.append("")
        top_cpu, top_ram = _get_top_processes()
        lines.append("Топ-5 по CPU:")
        for p in top_cpu:
            lines.append(f"  {p['name']}: {p['cpu']:.1f}%")
        lines.append("")
        lines.append("Топ-5 по RAM:")
        for p in top_ram:
            lines.append(f"  {p['name']}: {p['ram']:.1f}%")
        lines.append("")
        lines.append("=" * 60)
        path = os.path.join(BASE_DIR,
                            f"monitor_report_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt")
        with open(path, "w", encoding="utf-8-sig") as f:
            f.write("\n".join(lines))
        messagebox.showinfo("Готово", f"Отчёт сохранён:\n{path}")
        os.startfile(os.path.dirname(path))
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def _draw_graph(canvas, data, color, max_val=100, min_val=0, warn_line=None, unit=""):
    canvas.delete("all")
    if len(data) < 2:
        return
    w = canvas.winfo_width()
    h = canvas.winfo_height()
    if w < 10: w = 300
    if h < 10: h = 80

    canvas.create_rectangle(0, 0, w, h, fill="#0D1B33", outline="")
    pad_left = 42
    pad_top = 10
    pad_bottom = 15
    gw = w - pad_left - 10
    gh = h - pad_top - pad_bottom

    # Сетка
    for frac in (0, 0.25, 0.5, 0.75, 1.0):
        y = pad_top + gh - (gh * frac)
        val = int(min_val + (max_val - min_val) * frac)
        canvas.create_line(pad_left, y, w - 10, y, fill="#1A2A4A", dash=(2, 4))
        canvas.create_text(pad_left - 8, y, text=f"{val}{unit}", 
                           fill="#90A4AE", font=("Inter", 9), anchor="e")

    # Порог
    if warn_line is not None and min_val <= warn_line <= max_val:
        wy = pad_top + gh - ((warn_line - min_val) / max(1, max_val - min_val)) * gh
        canvas.create_line(pad_left, wy, w - 10, wy, fill="#FF8A8A", dash=(3, 3))
        canvas.create_text(w - 12, wy - 6, text=f"Порог {warn_line}{unit}", 
                           fill="#FF8A8A", font=("Inter", 8), anchor="e")

    step = gw / max(1, len(data) - 1)
    rng = max(1, max_val - min_val)
    points = []
    for i, v in enumerate(data):
        x = pad_left + i * step
        clamped = max(min_val, min(v, max_val))
        y = pad_top + gh - ((clamped - min_val) / rng) * gh
        points.append((x, y))

    # 1. Заливка под графиком (полупрозрачный эффект)
    if len(points) > 1:
        # Создаем цвет заливки на основе основного, но темнее
        # Простой способ: берем основной цвет и меняем прозрачность через hex (если поддерживается) 
        # или используем заранее заданный темный оттенок. В Tkinter нет alpha, поэтому используем темный цвет.
        fill_color = "#0A2030" # Темно-синий для фона
        if color == "#7CFC7C": fill_color = "#0A2A10" # Темно-зеленый
        elif color == "#FF8A8A" or color == "#FFB74D": fill_color = "#2A1010" # Темно-красный
        
        poly_points = [pad_left, pad_top + gh] + [coord for pt in points for coord in pt] + [w - 10, pad_top + gh]
        canvas.create_polygon(poly_points, fill=fill_color, outline="")

    # 2. Свечение линии (рисуем толстую линию с прозрачностью)
    if len(points) > 1:
        flat_points = [coord for pt in points for coord in pt]
        # Рисуем широкую линию (свечение)
        canvas.create_line(*flat_points, fill=color, width=4, capstyle="round", joinstyle="round")
        # Рисуем тонкую яркую линию сверху
        canvas.create_line(*flat_points, fill="#ffffff", width=1.5, capstyle="round", joinstyle="round")

    # 3. Точка на конце
    if points:
        lx, ly = points[-1]
        canvas.create_oval(lx - 4, ly - 4, lx + 4, ly + 4, fill="#ffffff", outline=color, width=2)
        
        cur_val = data[-1]
        text_y = ly - 12 if ly > 20 else ly + 15
        canvas.create_text(lx - 10, text_y, text=f"{cur_val:.0f}{unit}", 
                           fill=color, font=("Inter", 12, "bold"), anchor="se")


def _monitor_update_loop():
    if not _monitor_state["active"]:
        return
    try:
        import psutil
        cpu = psutil.cpu_percent(interval=None)
        ram = psutil.virtual_memory()
        _monitor_state["history_cpu"].append(cpu)
        _monitor_state["history_ram"].append(ram.percent)
        if len(_monitor_state["history_cpu"]) > 60:
            _monitor_state["history_cpu"].pop(0)
            _monitor_state["history_ram"].pop(0)

        w = _monitor_widgets
        if "cpu_value" in w:
            cpu_color = "#7CFC7C" if cpu < 50 else ("#FFD54F" if cpu < 80 else "#FF8A8A")
            # Плавная анимация цифры и бара
            _animate_value(w["cpu_value"], 0, cpu, cpu_color, duration=400, suffix="%") # передаем 0, т.к. лучше анимировать от текущего, но упростим для счетчика
            _animate_bar(w["cpu_bar"], w["cpu_bar"].get(), cpu / 100, duration=400)
            
        if "ram_value" in w:
            ram_color = "#7CFC7C" if ram.percent < 60 else ("#FFD54F" if ram.percent < 85 else "#FF8A8A")
            w["ram_value"].configure(text=f"{ram.used / (1024**3):.1f} / {ram.total / (1024**3):.1f} ГБ", text_color=ram_color)
            _animate_bar(w["ram_bar"], w["ram_bar"].get(), ram.percent / 100, duration=400)

        disks_text = ""
        for part in psutil.disk_partitions(all=False):
            try:
                u = psutil.disk_usage(part.mountpoint)
                disks_text += f"💾 {part.mountpoint}  {u.used/(1024**3):.1f}/{u.total/(1024**3):.1f} ГБ  ({u.percent:.0f}%)\n"
            except Exception: continue
        if "disks_label" in w:
            w["disks_label"].configure(text=disks_text.strip() or "—")

        net = psutil.net_io_counters()
        now = time.time()
        if _last_net["time"] > 0:
            dt = now - _last_net["time"]
            if dt > 0:
                sent_bps = (net.bytes_sent - _last_net["sent"]) / dt
                recv_bps = (net.bytes_recv - _last_net["recv"]) / dt
                if "net_label" in w:
                    def _fmt(bps):
                        if bps < 1024: return f"{bps:.0f} Б/с"
                        elif bps < 1024 * 1024: return f"{bps/1024:.1f} КБ/с"
                        else: return f"{bps/(1024*1024):.2f} МБ/с"
                    w["net_label"].configure(
                        text=f"⬆ {_fmt(sent_bps)}   ⬇ {_fmt(recv_bps)}   (всего: {human_size(net.bytes_sent)} / {human_size(net.bytes_recv)})")
        _last_net["sent"] = net.bytes_sent
        _last_net["recv"] = net.bytes_recv
        _last_net["time"] = now

        up = time.time() - psutil.boot_time()
        if "uptime_label" in w:
            w["uptime_label"].configure(text=f"⏱ Аптайм: {int(up//3600)} ч {int((up%3600)//60)} мин")

    except Exception as e:
        log_error("monitor_loop_1", e)

    # ─── Температуры ───
    try:
        # Используем фоновый кэш, чтобы не тормозить главный поток
        temps = get_cached_temperatures()
        if temps["cpu"] is not None:
            _monitor_state["history_temp_cpu"].append(temps["cpu"])
            if len(_monitor_state["history_temp_cpu"]) > _monitor_state["temp_history_limit"]:
                _monitor_state["history_temp_cpu"].pop(0)
        if temps["gpu"] is not None:
            _monitor_state["history_temp_gpu"].append(temps["gpu"])
            if len(_monitor_state["history_temp_gpu"]) > _monitor_state["temp_history_limit"]:
                _monitor_state["history_temp_gpu"].pop(0)

        w = _monitor_widgets
        if "temp_cpu" in w:
            w["temp_cpu"].configure(
                text=f"🌡 CPU: {temps['cpu']} °C" if temps['cpu'] else "🌡 CPU: —",
                text_color="#FF8A8A" if (temps['cpu'] and temps['cpu'] > _monitor_state["temp_threshold"]) else "#7CFC7C")
        if "temp_gpu" in w:
            w["temp_gpu"].configure(
                text=f"🌡 GPU: {temps['gpu']} °C" if temps['gpu'] else "🌡 GPU: —",
                text_color="#FF8A8A" if (temps['gpu'] and temps['gpu'] > _monitor_state["temp_threshold"]) else "#7CFC7C")

        if "graph_temp_cpu" in w:
            if _monitor_state["history_temp_cpu"]:
                _draw_graph(w["graph_temp_cpu"], _monitor_state["history_temp_cpu"], "#FF8A8A", max_val=100, min_val=20, warn_line=_monitor_state["temp_threshold"], unit=" °C")
            else:
                w["graph_temp_cpu"].delete("all")
                w["graph_temp_cpu"].create_text(150, 35, text="Нет данных о температуре", fill="#90A4AE", font=("Inter", 10))
        if "graph_temp_gpu" in w:
            if _monitor_state["history_temp_gpu"]:
                _draw_graph(w["graph_temp_gpu"], _monitor_state["history_temp_gpu"], "#FFB74D", max_val=100, min_val=20, warn_line=_monitor_state["temp_threshold"], unit=" °C")
            else:
                w["graph_temp_gpu"].delete("all")
                w["graph_temp_gpu"].create_text(150, 35, text="Нет данных о температуре", fill="#90A4AE", font=("Inter", 10))
    except Exception as e:
        log_error("monitor_loop_temps", e)

    # ─── Графики ───
    try:
        w = _monitor_widgets
        if "graph_cpu" in w:
            _draw_graph(w["graph_cpu"], _monitor_state["history_cpu"], "#4FC3F7", unit=" %")
        if "graph_ram" in w:
            _draw_graph(w["graph_ram"], _monitor_state["history_ram"], "#7CFC7C", unit=" %")
    except Exception as e:
        log_error("monitor_loop_graphs", e)

    # ─── Топ процессов ───
    try:
        top_cpu, top_ram = _get_top_processes()
        w = _monitor_widgets
        
        if "top_cpu_rows" in w:
            for i, row in enumerate(w["top_cpu_rows"]):
                if i < len(top_cpu):
                    p = top_cpu[i]
                    row["name"].configure(text=p['name'][:20])
                    # Плавно обновляем полосу и текст
                    _animate_bar(row["bar"], row["bar"].get(), p["cpu"]/100, duration=300)
                    row["pct"].configure(text=f"{p['cpu']:.1f}%")
                else:
                    row["name"].configure(text="—")
                    row["bar"].set(0)
                    row["pct"].configure(text="—")

        if "top_ram_rows" in w:
            for i, row in enumerate(w["top_ram_rows"]):
                if i < len(top_ram):
                    p = top_ram[i]
                    row["name"].configure(text=p['name'][:20])
                    _animate_bar(row["bar"], row["bar"].get(), p["ram"]/100, duration=300)
                    row["pct"].configure(text=f"{p['ram']:.1f}%")
                else:
                    row["name"].configure(text="—")
                    row["bar"].set(0)
                    row["pct"].configure(text="—")
                    
    except Exception as e:
        log_error("monitor_loop_tops", e)

    # Увеличили интервал до 3 сек, чтобы снизить нагрузку от psutil
    app.after(3000, _monitor_update_loop)


