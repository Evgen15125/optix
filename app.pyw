def load_bench_history():
    try:
        with open(BENCH_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return []


def save_bench_history(history):
    try:
        with open(BENCH_PATH, "w", encoding="utf-8") as f:
            json.dump(history, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log_error("save_bench_history", e)


def run_benchmark(profile_key="full"):
    if bench_running["active"]:
        return
    bench_running["active"] = True

    profile = BENCH_PROFILES.get(profile_key, BENCH_PROFILES["full"])
    test_keys = profile["tests"]

    bench_ui["status"].configure(text="⏳ Запуск...", text_color="#FFD54F")
    for w in bench_ui["results_frame"].winfo_children():
        w.destroy()

    results = {}
    total_tests = len(test_keys)
    t_start = time.time()
    
    for idx, key in enumerate(test_keys):
        info = BENCH_TEST_MAP.get(key)
        if not info:
            continue
        name, func = info
        
        # Считаем ETA
        elapsed = time.time() - t_start
        eta = (elapsed / (idx + 1)) * (total_tests - (idx + 1)) if idx > 0 else 0
        
        def _update_ui(n, i, t, e):
            bench_ui["status"].configure(
                text=f"⏳ {n} ({i+1}/{t})  •  Осталось: ~{int(e)} сек",
                text_color="#FFD54F")
            bench_ui["progress"].set((i + 1) / t)
            
        app.after(0, _update_ui, name, idx, total_tests, eta)
        app.update()
        
        try:
            result = func()
            results[key] = result
        except Exception as e:
            log_error(f"bench_{key}", e)
            results[key] = {"error": str(e), "score": 0, "value": 0, "unit": "ошибка"}

    scores = [r.get("score", 0) for r in results.values() if isinstance(r, dict) and "error" not in r]
    total_score = int(_bench_geomean(scores)) if scores else 0

    entry = {
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "profile": profile_key,
        "profile_name": profile["name"],
        "total_score": total_score,
        "results": results,
    }

    h = load_bench_history()
    h.append(entry)
    save_bench_history(h[-30:])

    app.after(0, lambda: render_bench_results(entry))
    app.after(0, lambda: bench_ui["status"].configure(
        text=f"✅ Готово • Оценка: {total_score}", text_color="#7CFC7C"))
    bench_ui["progress"].set(0)
    bench_running["active"] = False
    app.after(0, lambda: bench_ui["start_btn"].configure(
        state="normal", text="▶ ЗАПУСТИТЬ"))


def render_bench_results(entry):
    for w in bench_ui["results_frame"].winfo_children():
        w.destroy()

    total = entry.get("total_score", 0)
    if total >= 1200: v, vc = "🏆 Отличная", "#7CFC7C"
    elif total >= 900: v, vc = "✅ Хорошая", "#4FC3F7"
    elif total >= 600: v, vc = "⚙️ Средняя", "#FFD54F"
    else: v, vc = "🐢 Ниже среднего", "#FF8A8A"

    # Красивая карточка с оценкой
    box = ctk.CTkFrame(bench_ui["results_frame"], fg_color="#1F2E4A", 
                       corner_radius=14, border_width=1, border_color="#4FC3F7")
    box.pack(fill="x", pady=(0, 12), padx=4)
    
    ctk.CTkLabel(box, text=f"🏅 Оценка: {total}",
                 font=("Inter", 26, "bold"),
                 text_color="#ffffff").pack(pady=(16, 4))
    ctk.CTkLabel(box,
                 text=f"{v} • эталон = 1000 • {entry.get('profile_name', '')}",
                 font=("Inter", 12, "bold"),
                 text_color=vc).pack(pady=(0, 16))

    # Шапка таблицы
    hdr = ctk.CTkFrame(bench_ui["results_frame"], fg_color="#1565C0",
                       corner_radius=6)
    hdr.pack(fill="x", pady=(0, 4), padx=4)
    hdr.grid_columnconfigure(0, weight=1)
    for col, (txt, wdt) in enumerate([("Тест", 0), ("Значение", 140), ("Δ", 70), ("Балл", 60)]):
        ctk.CTkLabel(hdr, text=txt, font=("Inter", 11, "bold"),
                     text_color="#ffffff", anchor="w" if col == 0 else "e",
                     width=wdt if col > 0 else 0).grid(
            row=0, column=col, sticky="ew", padx=6, pady=6)

    results = entry.get("results", {})
    for key, res in results.items():
        if not isinstance(res, dict): continue
        info = BENCH_TEST_MAP.get(key)
        if not info: continue
        name = info[0]

        row = ctk.CTkFrame(bench_ui["results_frame"], fg_color="#1F2E4A", corner_radius=8, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=4)
        row.grid_columnconfigure(0, weight=1)

        if "error" in res:
            ctk.CTkLabel(row, text=f"❌ {name}", font=("Inter", 12, "bold"),
                         text_color="#FF8A8A", anchor="w").grid(
                row=0, column=0, sticky="w", padx=10, pady=6)
            ctk.CTkLabel(row, text=str(res["error"])[:50], font=("Inter", 10),
                         text_color="#B0BEC5", anchor="e").grid(
                row=0, column=1, columnspan=3, sticky="e", padx=10, pady=6)
            continue

        value = res.get("value", 0)
        unit = res.get("unit", "")
        score = res.get("score", 0)
        dev = _bench_deviation(score) if score else 0

        if dev >= 10: d_color = "#7CFC7C"
        elif dev >= -10: d_color = "#FFD54F"
        else: d_color = "#FF8A8A"

        ctk.CTkLabel(row, text=name, font=("Inter", 12, "bold"),
                     text_color="#ffffff", anchor="w").grid(
            row=0, column=0, sticky="w", padx=10, pady=6)
        ctk.CTkLabel(row, text=f"{value} {unit}", font=("Consolas", 12, "bold"),
                     text_color="#4FC3F7", anchor="e", width=140).grid(
            row=0, column=1, sticky="e", padx=6, pady=6)
        ctk.CTkLabel(row, text=f"{dev:+.1f}%", font=("Consolas", 11, "bold"),
                     text_color=d_color, anchor="e", width=70).grid(
            row=0, column=2, sticky="e", padx=4, pady=6)
        ctk.CTkLabel(row, text=f"{score}", font=("Consolas", 11),
                     text_color="#90CAF9", anchor="e", width=60).grid(
            row=0, column=3, sticky="e", padx=6, pady=6)


