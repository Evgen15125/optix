_original_ctk_entry = ctk.CTkEntry
class _OptixEntry(_original_ctk_entry):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        # Привязываемся к общему нажатию Ctrl и проверяем код клавиши (работает для любой раскладки)
        self._entry.bind("<Control-KeyPress>", self._on_ctrl_keypress)
        self._entry.bind("<Button-3>", self._show_context_menu)
        
    def _on_ctrl_keypress(self, event):
        # 86 = V (русская М), 67 = C (русская С), 88 = X (русская Ч), 65 = A (русская Ф)
        if event.keycode == 86:
            self._paste()
            return "break"
        elif event.keycode == 67:
            self._copy()
            return "break"
        elif event.keycode == 88:
            self._cut()
            return "break"
        elif event.keycode == 65:
            self._select_all()
            return "break"
            
    def _select_all(self, event=None):
        self._entry.select_range(0, 'end')
        self._entry.icursor('end')
        return "break"

    def _copy(self, event=None):
        try:
            selected = self._entry.selection_get()
            if selected:
                self.clipboard_clear()
                self.clipboard_append(selected)
        except Exception:
            pass
        return "break"

    def _paste(self, event=None):
        try:
            text = self.clipboard_get()
            if text:
                self._entry.insert(self._entry.index(tk.INSERT), text)
        except Exception:
            pass
        return "break"

    def _cut(self, event=None):
        try:
            selected = self._entry.selection_get()
            if selected:
                self.clipboard_clear()
                self.clipboard_append(selected)
                self._entry.delete(tk.SEL_FIRST, tk.SEL_LAST)
        except Exception:
            pass
        return "break"

    def _show_context_menu(self, event):
        self._entry.focus_set()
        menu = tk.Menu(self, tearoff=0, bg="#1A2A4A", fg="#ffffff",
                       activebackground="#1565C0", activeforeground="#ffffff",
                       font=("Inter", 10))
        menu.add_command(label="✂ Вырезать", command=self._cut)
        menu.add_command(label="📋 Копировать", command=self._copy)
        menu.add_command(label="📥 Вставить", command=self._paste)
        menu.add_separator()
        menu.add_command(label="🔍 Выделить всё", command=self._select_all)
        menu.tk_popup(event.x_root, event.y_root)
        menu.grab_release()

ctk.CTkEntry = _OptixEntry


