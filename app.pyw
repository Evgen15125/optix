    # ─── Красивый заголовок с иконкой ───
    header_frame = ctk.CTkFrame(f, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(10, 6), padx=15, ipadx=20)
    
    icon_img = _load_sidebar_icon("autostart")
    if icon_img:
        ctk.CTkLabel(header_frame, text="", image=icon_img, fg_color="transparent").pack(side="left", padx=(15, 5), pady=8)
    ctk.CTkLabel(header_frame, text="Автозапуск", font=("Inter", 24, "bold"), text_color="#ffffff", fg_color="transparent").pack(side="left", padx=(0 if icon_img else 15, 15), pady=8)

    top = ctk.CTkFrame(f, fg_color="transparent")
    top.pack(pady=(0, 4), padx=15, fill="x")

    ctk.CTkButton(top, text="📥 Добавить", height=34,
                  font=("Inter", 12, "bold"), fg_color="#2E7D32",
                  hover_color="#43A047", corner_radius=17, width=110,
                  command=add_autostart_dialog).pack(side="left", padx=(0, 4))
    ctk.CTkButton(top, text="💾 Бэкап", height=34,
                  font=("Inter", 12, "bold"), fg_color="#1F2E4A",
                  hover_color="#2E5A8E", corner_radius=17, width=100,
                  command=backup_autostart).pack(side="left", padx=4)

    baseline_items, baseline_ts = _autostart_get_baseline_items()
    changes_count = _autostart_count_changes()
    if not baseline_items:
        compare_text = "🔍 Сравнить (нет baseline)"
        compare_color = "#455A64"
    elif changes_count == 0:
        compare_text = "🔍 Сравнить • изменений: 0"
        compare_color = "#2E7D32"
    else:
        compare_text = f"🔍 Сравнить • изменений: {changes_count}"
        compare_color = "#C62828" if changes_count > 0 else "#2E7D32"

    ctk.CTkButton(top, text=compare_text, height=34,
                  font=("Inter", 12, "bold"),
                  fg_color=compare_color, hover_color="#2E5A8E" if changes_count == 0 else "#E53935",
                  corner_radius=17, width=210,
                  command=open_autostart_diff_window
                  ).pack(side="left", padx=4)

