# ─── Офлайн-установка .inf ───

def _driver_offline_install():
    """Установка драйверов из папки с .inf-файлами."""
    folder = filedialog.askdirectory(
        title="Выберите папку с драйверами (.inf)")
    if not folder:
        return
    # Считаем .inf
    infs = []
    try:
        for root, dirs, files in os.walk(folder):
            for f in files:
                if f.lower().endswith(".inf"):
                    infs.append(os.path.join(root, f))
    except Exception:
        pass
    if not infs:
        messagebox.showerror(
            "Ошибка",
            "В выбранной папке нет .inf-файлов.\n\n"
            "Укажите папку с драйверами (например, "
            "созданную через «Бэкап драйверов»).")
        return
    if not messagebox.askyesno(
        "Установить драйверы?",
        f"Найдено .inf-файлов: {len(infs)}\n\n"
        f"Папка: {folder}\n\n"
        f"Установка может занять несколько минут.\n\n"
        f"⚠️ Рекомендуется создать точку восстановления.\n\n"
        f"Продолжить?"):
        return

    if not _driver_ensure_restore_point():
        return

    drivers_updates_ui["status"].configure(
        text=f"⏳ Установка {len(infs)} драйверов...",
        text_color="#FFD54F")

    def worker():
        try:
            r = subprocess.run(
                ["pnputil", "/add-driver",
                 os.path.join(folder, "*.inf"),
                 "/subdirs", "/install"],
                capture_output=True, timeout=1800,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b"\n" + (r.stderr or b""))
            code = r.returncode

            def finish():
                if "status" in drivers_updates_ui:
                    drivers_updates_ui["status"].configure(
                        text=f"✅ Установка: код {code}",
                        text_color="#7CFC7C" if code == 0
                        else "#FFD54F")
                lines = ["=" * 70,
                         "  ОФЛАЙН-УСТАНОВКА ДРАЙВЕРОВ",
                         "=" * 70,
                         "",
                         f"  Папка: {folder}",
                         f"  .inf-файлов: {len(infs)}",
                         f"  Код возврата: {code}",
                         ""]
                if code == 0:
                    lines.append("  ✅ Установка завершена успешно.")
                    lines.append("  Рекомендуется перезагрузить ПК.")
                else:
                    lines.append("  ⚠️ Есть ошибки. Смотри вывод ниже.")
                lines.append("")
                lines.append("─" * 70)
                lines.append("  ВЫВОД pnputil")
                lines.append("─" * 70)
                lines.append(out[:6000] if out else "(пусто)")
                show_output_dialog("Офлайн-установка драйверов",
                                    "\n".join(lines))
            app.after(0, finish)
        except subprocess.TimeoutExpired:
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", "Таймаут 30 минут"))
        except Exception as e:
            log_error("_driver_offline_install", e)
            app.after(0, lambda: messagebox.showerror("Ошибка", str(e)))

    threading.Thread(target=worker, daemon=True).start()


