def _load_services_with_pulse(btn):
    """Обновляет список служб с пульсацией кнопки."""
    _start_button_pulse(btn, "#1976D2", "#42A5F5")
    btn.configure(state="disabled")
    
    def worker():
        global services_all
        services_all = get_services_list()
        def finish():
            _stop_button_pulse(btn)
            btn.configure(state="normal")
            try:
                services_ui["status"].configure(
                    text=f"Всего: {len(services_all)}   •   "
                         f"Работает: {sum(1 for s in services_all if str(s['status']).lower() == 'running')}   •   "
                         f"Остановлено: {sum(1 for s in services_all if str(s['status']).lower() == 'stopped')}   •   "
                         f"Можно отключить: {sum(1 for s in services_all if s.get('can_disable'))}",
                    text_color="#4FC3F7")
                services_ui.update({"shown_count": SERVICES_PAGE_SIZE})
                refresh_services_ui()
            except Exception:
                pass
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


def _run_disable_recommended(btn):
    """Запускает отключение рекомендованных служб с пульсацией."""
    if not messagebox.askyesno(
        "⚠️ Отключить рекомендованные?",
        "Будут отключены службы, которые Optix считает безопасными для отключения.\n\n"
        "Это может занять некоторое время.\n\nПродолжить?"):
        return
    
    _start_button_pulse(btn, "#C62828", "#FF8A8A")
    btn.configure(state="disabled")
    
    def worker():
        try:
            items = get_services_list()
            targets = [s for s in items if s.get("can_disable")]
            ok = 0
            for t in targets:
                try:
                    service_action(t["name"], "disable")
                    ok += 1
                except Exception:
                    pass
            app.after(0, lambda: messagebox.showinfo("Готово", f"Отключено служб: {ok}"))
        finally:
            def finish():
                _stop_button_pulse(btn)
                btn.configure(state="normal")
                load_services_async()
            app.after(0, finish)
            
    threading.Thread(target=worker, daemon=True).start()


