def _show_splash_screen():
    """Показывает красивую заставку при запуске."""
    app.withdraw() # Прячем главное окно
    
    splash = ctk.CTkToplevel()
    splash.overrideredirect(True) # Убираем стандартные рамки Windows
    splash.geometry("400x280")
    splash.configure(fg_color="#0A1A30")
    
    # Центрируем заставку на экране
    splash.update_idletasks()
    x = (splash.winfo_screenwidth() - 400) // 2
    y = (splash.winfo_screenheight() - 280) // 2
    splash.geometry(f"+{x}+{y}")
    
    # Рисуем тонкую неоновую рамку вокруг заставки
    frame = ctk.CTkFrame(splash, fg_color="#0A1A30", border_width=2, border_color="#4FC3F7", corner_radius=0)
    frame.pack(fill="both", expand=True)

    # Логотип
    if os.path.exists(ICON_PNG):
        try:
            from PIL import Image, ImageTk
            img = Image.open(ICON_PNG).resize((96, 96), Image.LANCZOS)
            photo = ImageTk.PhotoImage(img)
            lbl_img = ctk.CTkLabel(frame, text="", image=photo, fg_color="transparent")
            lbl_img.image = photo # сохраняем ссылку, чтобы не удалилось сборщиком мусора
            lbl_img.pack(pady=(30, 10))
        except Exception:
            pass

    ctk.CTkLabel(frame, text="Optix", font=("Inter", 32, "bold"), text_color="#ffffff").pack()
    ctk.CTkLabel(frame, text="Загрузка модулей...", font=("Inter", 12), text_color="#B0BEC5").pack(pady=(5, 20))

    pb = ctk.CTkProgressBar(frame, width=300, height=8, progress_color="#4FC3F7", corner_radius=4)
    pb.pack()
    pb.set(0)
    pb.start() # Запускаем бегающую полоску

    # Закрываем заставку через 2 секунды и показываем главное окно
    def close_splash():
        splash.destroy()
        # В режиме --minimized / headless / silent окно
        # не показываем — иначе ломается автозапуск в трей
        if not (HEADLESS or CLI_SILENT or MINIMIZED_STARTUP):
            app.deiconify()
            app.lift()
            app.focus_force()

    app.after(2200, close_splash)


