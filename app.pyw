def load_cookies_keep():
    try:
        with open(COOKIES_KEEP_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"domains": []}


def save_cookies_keep(data):
    try:
        with open(COOKIES_KEEP_PATH, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log_error("save_cookies_keep", e)


def _read_chrome_cookies(browser_path):
    domains = set()
    try:
        if not os.path.exists(browser_path):
            return []
        tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".db")
        tmp.close()
        shutil.copy2(browser_path, tmp.name)
        try:
            con = sqlite3.connect(tmp.name)
            cur = con.cursor()
            cur.execute("SELECT DISTINCT host_key FROM cookies")
            for (host,) in cur.fetchall():
                if host:
                    domains.add(host.lstrip("."))
            con.close()
        finally:
            try:
                os.remove(tmp.name)
            except Exception:
                pass
    except Exception as e:
        log_error("_read_chrome_cookies", e)
    return sorted(domains)


def _read_firefox_cookies(profile_dir):
    domains = set()
    try:
        if not os.path.isdir(profile_dir):
            return []
        for name in os.listdir(profile_dir):
            if name == "cookies.sqlite":
                db = os.path.join(profile_dir, name)
                tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".db")
                tmp.close()
                shutil.copy2(db, tmp.name)
                try:
                    con = sqlite3.connect(tmp.name)
                    cur = con.cursor()
                    cur.execute("SELECT DISTINCT host FROM moz_cookies")
                    for (host,) in cur.fetchall():
                        if host:
                            domains.add(host.lstrip("."))
                    con.close()
                finally:
                    try:
                        os.remove(tmp.name)
                    except Exception:
                        pass
    except Exception as e:
        log_error("_read_firefox_cookies", e)
    return sorted(domains)


def open_cookie_manager():
    win = ctk.CTkToplevel(app)
    win.title("Менеджер куки")
    win.geometry("900x680")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)

    head = ctk.CTkLabel(win, text="🍪 Менеджер куки",
                        font=("Inter", 20, "bold"),
                        text_color="#ffffff", fg_color="#1565C0",
                        corner_radius=14, height=44, border_width=1, border_color="#4FC3F7")
    head.pack(pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win, text="Отметьте домены, куки которых СОХРАНИТЬ.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 10))
                 
    browser_var = ctk.StringVar(value="Chrome")
    bm_row = ctk.CTkFrame(win, fg_color="transparent")
    bm_row.pack(pady=(0, 8), padx=20, fill="x")
    ctk.CTkLabel(bm_row, text="Браузер:", font=("Inter", 13, "bold"), text_color="#82B1FF").pack(side="left", padx=(0, 8))
    bm_menu = ctk.CTkOptionMenu(bm_row, values=["Chrome", "Edge", "Opera", "Opera GX", "Yandex", "Firefox"],
                                 width=160, height=34, fg_color="#1F2E4A", button_color="#1976D2",
                                 button_hover_color="#42A5F5", font=("Inter", 12), variable=browser_var)
    bm_menu.pack(side="left")
    
    status_lbl = ctk.CTkLabel(win, text="Загрузка...", font=("Inter", 12), text_color="#FFD54F")
    status_lbl.pack(pady=(0, 6))
    
    scroll = ctk.CTkScrollableFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    scroll.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    check_vars = {}

    def paths_for(browser):
        la = os.path.expandvars(r"%LOCALAPPDATA%")
        ap = os.path.expandvars(r"%APPDATA%")
        if browser == "Chrome": return os.path.join(la, r"Google\Chrome\User Data\Default\Network\Cookies")
        if browser == "Edge": return os.path.join(la, r"Microsoft\Edge\User Data\Default\Network\Cookies")
        if browser == "Opera": return os.path.join(ap, r"Opera Software\Opera Stable\Network\Cookies")
        if browser == "Opera GX": return os.path.join(ap, r"Opera Software\Opera GX Stable\Network\Cookies")
        if browser == "Yandex": return os.path.join(la, r"Yandex\YandexBrowser\User Data\Default\Network\Cookies")
        if browser == "Firefox":
            base = os.path.join(ap, r"Mozilla\Firefox\Profiles")
            if os.path.isdir(base):
                for p in os.listdir(base):
                    full = os.path.join(base, p)
                    if os.path.isdir(full) and "cookies.sqlite" in os.listdir(full):
                        return full
            return ""
        return ""

    def load_domains(_=None):
        for w in scroll.winfo_children(): w.destroy()
        check_vars.clear()
        browser = browser_var.get()
        status_lbl.configure(text=f"Читаю куки: {browser}...", text_color="#FFD54F")

        def worker():
            if browser == "Firefox": domains = _read_firefox_cookies(paths_for(browser))
            else: domains = _read_chrome_cookies(paths_for(browser))
            keep = set(load_cookies_keep().get("domains", []))

            def update():
                if not domains:
                    status_lbl.configure(text=f"Куки {browser} не найдены (браузер закрыт?)", text_color="#90A4AE")
                    return
                status_lbl.configure(text=f"Найдено доменов: {len(domains)}  •  Сохранено: {len(keep)}", text_color="#7CFC7C")
                for d in domains:
                    row = ctk.CTkFrame(scroll, fg_color="#1F2E4A", corner_radius=8)
                    row.pack(fill="x", pady=2, padx=2)
                    var = ctk.IntVar(value=1 if d in keep else 0)
                    ctk.CTkCheckBox(row, text=d, variable=var, font=("Consolas", 11),
                                    text_color="#ffffff", fg_color="#43A047", hover_color="#66BB6A",
                                    checkbox_width=20, checkbox_height=20, corner_radius=5).pack(side="left", padx=12, pady=6)
                    check_vars[d] = var
            app.after(0, update)
        threading.Thread(target=worker, daemon=True).start()

    bm_menu.configure(command=load_domains)

    def save_all():
        keep = [d for d, v in check_vars.items() if v.get()]
        data = load_cookies_keep()
        data["domains"] = keep
        save_cookies_keep(data)
        messagebox.showinfo("Готово", f"Сохранено доменов: {len(keep)}")

