def _start_bench_profile_with_pulse(btn):
    """Запускает бенчмарк с пульсацией кнопки."""
    key = bench_ui.get("active_profile", "full")
    
    _start_button_pulse(btn, "#2E7D32", "#43A047")
    btn.configure(state="disabled", text="⏳ Выполняется...")
    
    def worker():
        try:
            run_benchmark(key)
        except Exception as e:
            log_error("start_bench_profile", e)
            app.after(0, lambda: bench_ui["status"].configure(
                text=f"Ошибка: {e}", text_color="#FF8A8A"))
            bench_running["active"] = False
        finally:
            def finish():
                _stop_button_pulse(btn)
                btn.configure(state="normal", text="▶ ЗАПУСТИТЬ")
            app.after(0, finish)

    threading.Thread(target=worker, daemon=True).start()


