    dst = bytearray(size)

    def work():
        dst[:] = src

    _, elapsed = _bench_timing(work)
    elapsed = max(0.001, elapsed)
    mbps = (size / (1024 * 1024)) / elapsed
    return {"value": round(mbps, 0), "unit": "МБ/с", "elapsed": elapsed,
            "score": _bench_normalize(mbps, BENCH_REFERENCE["ram_copy"]),
            "ref": BENCH_REFERENCE["ram_copy"]}


# ─── RAM Latency (pointer chasing) ───
def bench_ram_latency():
    import random
    n = 8 * 1024 * 1024  # 8 млн указателей (64 МБ)
    indices = list(range(n))
    random.seed(42)
    random.shuffle(indices)
    ptr = [0] * n
    for i in range(n):
        ptr[indices[i]] = indices[(i + 1) % n]

    # Прогрев
    current = 0
    for _ in range(1000):
        current = ptr[current]

    iterations = 500_000
    start = time.perf_counter()
    current = 0
    for _ in range(iterations):
        current = ptr[current]
    elapsed = time.perf_counter() - start
    ns_per_access = (elapsed / iterations) * 1e9
    return {"value": round(ns_per_access, 1), "unit": "нс", "elapsed": elapsed,
            "score": _bench_normalize(ns_per_access,
                                       BENCH_REFERENCE["ram_latency"],
                                       lower_is_better=True),
            "ref": BENCH_REFERENCE["ram_latency"]}


# ─── Cache L1/L2/L3 ───
def _bench_cache_level(size_bytes, ref_key):
    """Read через adler32, write/copy через slice — на C-скорости."""
    import zlib
    data = os.urandom(size_bytes)
    dst = bytearray(size_bytes)

    def read_work():
        return zlib.adler32(data)

    def write_work():
        ba = bytearray(size_bytes)
        pat = b"\x55" * size_bytes
        ba[:] = pat
        return ba

    def copy_work():
        dst[:] = data

    _, r_elapsed = _bench_timing(read_work)
    _, w_elapsed = _bench_timing(write_work)
    _, c_elapsed = _bench_timing(copy_work)
    r_elapsed = max(1e-6, r_elapsed)
    w_elapsed = max(1e-6, w_elapsed)
    c_elapsed = max(1e-6, c_elapsed)
    mb = size_bytes / (1024 * 1024)
    read_mbps = mb / r_elapsed
    write_mbps = mb / w_elapsed
    copy_mbps = mb / c_elapsed
    avg_mbps = (read_mbps + write_mbps + copy_mbps) / 3
    return {"value": round(avg_mbps, 0), "unit": "МБ/с",
            "read_mbps": round(read_mbps, 0),
            "write_mbps": round(write_mbps, 0),
            "copy_mbps": round(copy_mbps, 0),
            "elapsed": r_elapsed,
            "score": _bench_normalize(avg_mbps, BENCH_REFERENCE[ref_key]),
            "ref": BENCH_REFERENCE[ref_key]}


def bench_cache_l1():
    return _bench_cache_level(32 * 1024, "cache_l1")


def bench_cache_l2():
    return _bench_cache_level(256 * 1024, "cache_l2")


def bench_cache_l3():
    return _bench_cache_level(8 * 1024 * 1024, "cache_l3")


# ─── Disk: SEQ1M ───
def _bench_disk_seq(block_mb, test_size_mb=512, write=False):
    """Последовательный тест через NO_BUFFERING (без кэша ОС)."""
    test_file = os.path.join(BASE_DIR, "bench_tmp_seq.bin")
    block_size = block_mb * 1024 * 1024
    total_size = test_size_mb * 1024 * 1024
    try:
        if write:
            f = UnbufferedFile(test_file, mode="w")
            try:
                f.open()
                gc.collect()
                start = time.perf_counter()
                f.write_sequential(total_size, block_size)
                elapsed = time.perf_counter() - start
            finally:
                f.close()
        else:
            # Сначала создаём файл-источник (buffered запись)
            if not os.path.exists(test_file) or \
               os.path.getsize(test_file) < total_size:
                with open(test_file, "wb") as fp:
                    chunk = os.urandom(block_size)
                    for _ in range(total_size // block_size):
                        fp.write(chunk)
            f = UnbufferedFile(test_file, mode="r")
            try:
                f.open()
                gc.collect()
                start = time.perf_counter()
                f.read_sequential(total_size, block_size)
                elapsed = time.perf_counter() - start
            finally:
                f.close()
        elapsed = max(0.005, elapsed)
        mbps = (total_size / (1024 * 1024)) / elapsed
        return {"value": round(mbps, 0), "unit": "МБ/с",
                "elapsed": elapsed, "mbps": mbps}
    finally:
        try:
            if os.path.exists(test_file):
                os.remove(test_file)
