def open_category_contents(cat):
    win = ctk.CTkToplevel(app)
    win.title(f"Содержимое: {cat['name']}")
    win.geometry("900x620")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)
    
    head = ctk.CTkLabel(win, text=f"📂 {cat['name']}",
                        font=("Inter", 20, "bold"),
                        text_color="#ffffff", fg_color="#1565C0",
                        corner_radius=14, height=44, border_width=1, border_color="#4FC3F7")
    head.pack(pady=(16, 8), padx=20, ipadx=20)
    
    status = ctk.CTkLabel(win, text="Сканирование...", font=("Inter", 12, "bold"),
                          text_color="#FFD54F", fg_color="#131E32", corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status.pack(pady=(0, 8), padx=20, fill="x")
    
    list_wrapper = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    list_wrapper.pack(padx=20, pady=(0, 12), fill="both", expand=True)
    list_frame = ctk.CTkScrollableFrame(list_wrapper, fg_color="transparent", corner_radius=0)
    list_frame.pack(fill="both", expand=True, padx=4, pady=4)
    
    paths = []
    if cat.get("type") == "packages_cache":
        for base in _expand_packages(""):
            for sub in ["LocalCache", "AC\\INetCache", "LocalState\\Cache"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p): paths.append(p)
    elif cat.get("type") == "packages_temp":
        for base in _expand_packages(""):
            for sub in ["TempState", "AC\\Temp"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p): paths.append(p)
    elif cat.get("path"):
        paths = expand_paths(cat["path"])

    def worker():
        files = []
        for p in paths:
            if not os.path.isdir(p): continue
            for r, _, fs in os.walk(p):
                for f in fs:
                    try:
                        fp = os.path.join(r, f)
                        s = os.path.getsize(fp)
                        files.append((fp, s))
                    except Exception: continue
        files.sort(key=lambda x: -x[1])
        files = files[:50]

        def update():
            for w in list_frame.winfo_children(): w.destroy()
            if not files:
                status.configure(text="Файлы не найдены", text_color="#90A4AE")
                return
            total = sum(s for _, s in files)
            status.configure(text=f"Показано топ-50 файлов  •  Всего в топе: {human_size(total)}", text_color="#4FC3F7")
            for fp, sz in files:
                row = ctk.CTkFrame(list_frame, fg_color="#1F2E4A", corner_radius=8)
                row.pack(fill="x", pady=2, padx=2)
                ctk.CTkLabel(row, text=human_size(sz), font=("Inter", 12, "bold"),
                             text_color="#4FC3F7", width=90, anchor="w").pack(side="left", padx=(10, 4), pady=6)
                ctk.CTkLabel(row, text=fp, font=("Consolas", 10), text_color="#e0e8f5", anchor="w").pack(
                    side="left", padx=4, pady=6, fill="x", expand=True)
        app.after(0, update)
    threading.Thread(target=worker, daemon=True).start()


