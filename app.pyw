def _sched_get_task_xml(task_full):
    """Возвращает XML-описание задачи через schtasks /query /xml."""
    try:
        r = subprocess.run(
            ["schtasks", "/query", "/tn", task_full, "/xml"],
            capture_output=True, timeout=20,
            creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(r.stdout or b"")
        if r.returncode != 0:
            return None, _decode_console_bytes(r.stderr or b"")
        return out.strip(), None
    except Exception as e:
        log_error("_sched_get_task_xml", e)
        return None, str(e)


def _sched_show_details(task_full, task_name=""):
