        b.pack(side="left", padx=(0, 6))
        programs_ui["tab_btns"][key] = b
    programs_ui["tab"] = "all"
    programs_ui["tab_btns"]["all"].configure(fg_color="#1565C0", border_width=1, border_color="#4FC3F7")
    
    programs_ui["uwp_cache"] = []
    programs_ui.setdefault("batch_selected", set())
    programs_ui["portable_cache"] = []
    programs_ui["portable_scanning"] = False
    programs_ui["_portable_icon_refs"] = {}

