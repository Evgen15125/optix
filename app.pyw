def disable_all_high_impact(silent=False):
    items, _ = get_autostart_items()
    targets = [it for it in items if it["enabled"] and it.get("impact_icon") == "🔴"]
    if not targets:
        if not silent:
            messagebox.showinfo("Optix", "Нет записей с высоким влиянием.")
        return
    if not silent:
        if not messagebox.askyesno(
            "Отключить высокое влияние?",
            f"Будет отключено записей: {len(targets)}\n\n"
            + "\n".join([f"• {t['name']}" for t in targets[:15]])
            + ("\n..." if len(targets) > 15 else "")
            + "\n\nПродолжить?"
        ):
            return
    disabled = load_disabled_list()
    ok = 0
    for t in targets:
        try:
            if t["source"] in ("registry", "runonce", "explorer"):
                root = (winreg.HKEY_CURRENT_USER if t["root"] == "HKCU"
                        else winreg.HKEY_LOCAL_MACHINE)
                key = winreg.OpenKey(root, t["reg_path"], 0,
                                     winreg.KEY_SET_VALUE |
                                     t.get("view", winreg.KEY_WOW64_64KEY))
                try:
                    winreg.DeleteValue(key, t["name"])
                except FileNotFoundError:
                    pass
                winreg.CloseKey(key)
                disabled.append({
                    "name": t["name"], "command": t["command"],
                    "source": t["source"], "root": t["root"],
                    "reg_path": t["reg_path"],
                    "view": t.get("view", winreg.KEY_WOW64_64KEY),
                })
                ok += 1
            elif t["source"] in ("folder", "folder_common"):
                backup_dir = os.path.join(BASE_DIR, "startup_backup")
                os.makedirs(backup_dir, exist_ok=True)
                full = os.path.join(t["folder_path"], t["name"])
                if os.path.exists(full):
                    shutil.move(full, os.path.join(backup_dir, t["name"]))
                disabled.append({
                    "name": t["name"], "command": t["command"],
                    "source": t["source"],
                    "folder_path": t.get("folder_path", ""),
                    "backup_path": os.path.join(backup_dir, t["name"]),
                })
                ok += 1
            elif t["source"] == "scheduled":
                if t.get("task_full"):
                    subprocess.run(["schtasks", "/Change", "/TN",
                                    t["task_full"], "/DISABLE"],
                                   capture_output=True, text=True, timeout=20,
                                   creationflags=CREATE_NO_WINDOW)
                    disabled.append({
                        "name": t["name"], "command": t["command"],
                        "source": "scheduled",
                        "task_path": t.get("task_path", ""),
                        "task_full": t["task_full"],
                    })
                    ok += 1
        except Exception as e:
            log_error(f"disable_all_high_impact({t['name']})", e)
    save_disabled_list(disabled)
    app.after(0, refresh_autostart_ui)
    if not silent:
        messagebox.showinfo("Готово", f"Отключено: {ok}")
    else:
        try:
            show_toast("Optix — автозапуск", f"Отключено записей: {ok}")
        except Exception:
            pass


def get_boot_time_history(limit=10):
    try:
        ps = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "Get-WinEvent -LogName 'Microsoft-Windows-Diagnostics-Performance/Operational' "
            "-MaxEvents 60 -ErrorAction SilentlyContinue | "
            "Where-Object {$_.Id -eq 100} | Select-Object -First " + str(limit) + " | "
            "ForEach-Object { "
            "  $xml = [xml]$_.ToXml(); "
            "  $data = $xml.Event.EventData.Data; "
            "  $bootms = 0; "
            "  foreach ($d in $data) { "
            "    if ($d.Name -eq 'BootTime' -and $d.'#text') { $bootms = [int]$d.'#text' } "
            "  } "
            "  [PSCustomObject]@{ "
            "    Time = $_.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss'); "
            "    BootMs = $bootms "
            "  } "
            "} | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=90,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        result = []
        for d in data:
            try:
                sec = int(d.get("BootMs", 0) or 0) / 1000.0
                if sec <= 0:
                    continue
                result.append({
                    "time": str(d.get("Time", "")),
                    "boot_sec": sec,
                })
            except Exception:
                continue
        return result
    except Exception as e:
        log_error("get_boot_time_history", e)
        return []


def show_boot_time_dialog():
    dlg = ctk.CTkToplevel(app)
    dlg.title("Время загрузки Windows")
    dlg.geometry("680x520")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)

    ctk.CTkLabel(dlg, text="📊  История загрузок Windows",
                 font=("Inter", 20, "bold"),
                 text_color="#ffffff", fg_color="#1565C0",
                 corner_radius=14, height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(dlg,
                 text="Данные из журнала Diagnostics-Performance. "
                      "Показывает время от старта до готовности системы.",
                 font=("Inter", 11), text_color="#B0BEC5").pack(pady=(0, 10))
    status_lbl = ctk.CTkLabel(dlg, text="Загрузка...", font=("Inter", 13, "bold"),
                              text_color="#FFD54F", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")
    wrap = ctk.CTkFrame(dlg, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 12), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    def worker():
        data = get_boot_time_history(15)

        def update():
            for w in lst.winfo_children():
                w.destroy()
            if not data:
                status_lbl.configure(
                    text="Нет данных (журнал пуст или отключён)",
                    text_color="#90A4AE")
                return
            min_sec = min(d["boot_sec"] for d in data)
            max_sec = max(d["boot_sec"] for d in data)
            avg_sec = sum(d["boot_sec"] for d in data) / len(data)
            status_lbl.configure(
                text=f"Загрузок: {len(data)}   •   "
                     f"Мин: {min_sec:.1f}с   •   Сред: {avg_sec:.1f}с   •   "
                     f"Макс: {max_sec:.1f}с",
                text_color="#7CFC7C")
            for d in data:
                sec = d["boot_sec"]
                if sec < 15:
                    color = "#7CFC7C"
                    icon = "🟢"
                elif sec < 30:
                    color = "#FFD54F"
                    icon = "🟡"
                else:
                    color = "#FF8A8A"
                    icon = "🔴"
                row = ctk.CTkFrame(lst, fg_color="#243A5E", corner_radius=8)
                row.pack(fill="x", pady=2, padx=2)
                ctk.CTkLabel(row, text=f"{icon}  {d['time']}",
                             font=("Consolas", 12), text_color="#ffffff",
                             anchor="w").pack(side="left", padx=(10, 4), pady=6)
                ctk.CTkLabel(row, text=f"{sec:.1f} сек",
                             font=("Inter", 13, "bold"),
                             text_color=color, anchor="e",
                             width=100).pack(side="right", padx=10, pady=6)
        app.after(0, update)
    threading.Thread(target=worker, daemon=True).start()

    ctk.CTkButton(dlg, text="🔄 Обновить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=19,
                  command=lambda: threading.Thread(target=worker, daemon=True).start()
                  ).pack(pady=(0, 14), padx=20, fill="x")


