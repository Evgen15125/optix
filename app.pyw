def _clean_browser_cache(exe_name):
    dirs = BROWSER_CACHE_DIRS.get(exe_name.lower(), [])
    freed = 0
    for pattern in dirs:
        for path in glob.glob(pattern):
            if not os.path.isdir(path):
                continue
            try:
                for entry in os.listdir(path):
                    full = os.path.join(path, entry)
                    try:
                        if os.path.isfile(full):
                            freed += os.path.getsize(full)
                            os.remove(full)
                        elif os.path.isdir(full):
                            for r, _, fs in os.walk(full):
                                for f in fs:
                                    try:
                                        freed += os.path.getsize(os.path.join(r, f))
                                    except Exception:
                                        pass
                            shutil.rmtree(full, ignore_errors=True)
                    except Exception:
                        continue
            except Exception:
                continue
    return freed


def _browser_monitor_loop():
    try:
        import psutil
    except Exception:
        return
    was_running = set()
    while True:
        try:
            if not _STATE["auto_clean_browser"]:
                time.sleep(15)
                continue
            current = set()
            for p in psutil.process_iter(["name"]):
                try:
                    n = (p.info.get("name") or "").lower()
                    if n in BROWSER_CACHE_DIRS:
                        current.add(n)
                except Exception:
                    continue
            just_closed = was_running - current
            for exe in just_closed:
                freed = _clean_browser_cache(exe)
                if freed > 0:
                    try:
                        show_toast("Optix — авт. очистка браузера",
                                   f"{exe}: освобождено {freed // 1024 // 1024} МБ")
                    except Exception:
                        pass
            was_running = current
        except Exception:
            pass
        time.sleep(10)


def autostart_browser_monitor():
    if _STATE["browser_monitor_started"]:
        return
    _STATE["browser_monitor_started"] = True
    t = threading.Thread(target=_browser_monitor_loop, daemon=True)
    t.start()


