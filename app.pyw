def _apply_glass_effects(widget, depth=0):
    """Рекурсивно применяет hover-свечение и эффект появления к карточкам."""
    if isinstance(widget, ctk.CTkFrame):
        try:
            bw = widget.cget("border_width")
            bc = widget.cget("border_color")
            # Применяем только к "карточкам" (у которых есть рамка)
            if bw == 1 and bc in ("#2A3B5C", "#1A2A4A", "#243A5E"):
                
                # 1. Эффект свечения при наведении
                def on_enter(e, w=widget):
                    try: w.configure(border_color="#4FC3F7", border_width=2)
                    except: pass
                def on_leave(e, w=widget, obc=bc):
                    def check_later():
                        try:
                            x, y = w.winfo_pointerxy()
                            rx, ry = w.winfo_rootx(), w.winfo_rooty()
                            rw, rh = w.winfo_width(), w.winfo_height()
                            if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                                w.configure(border_color=obc, border_width=1)
                        except: pass
                    w.after(15, check_later)
                
                if not getattr(widget, "_has_glow", False):
                    widget.bind("<Enter>", on_enter, add="+")
                    widget.bind("<Leave>", on_leave, add="+")
                    widget._has_glow = True

                # 2. Эффект вспышки при загрузке страницы (staggered)
                try:
                    widget.configure(border_color="#4FC3F7", border_width=2)
                    delay = 250 + depth * 80 # Задержка зависит от вложенности
                    app.after(delay, lambda w=widget, obc=bc: w.configure(border_color=obc, border_width=1) if w.winfo_exists() else None)
                except: pass
        except: pass
        
    for child in widget.winfo_children():
        _apply_glass_effects(child, depth+1)

def show_page(name):
    if name not in page_frames:
        info = page_builders.get(name)
        if info is None:
            return
        kind = info[0]
        try:
            if kind == "build":
                page_frames[name] = info[1](content)
            elif kind == "placeholder":
                page_frames[name] = make_placeholder(content, info[1], info[2])
        except Exception as e:
            log_error(f"show_page({name})", e)
            page_frames[name] = make_placeholder(content, "⚠️ Ошибка", str(e))
            
    # Скрываем все остальные страницы
    for key, frame in page_frames.items():
        if key != name:
            frame.pack_forget()
            frame.place_forget()
            
    target_frame = page_frames.get(name)
    if not target_frame:
        return

    # Обновляем кнопки навигации
    for key, btn in nav_buttons.items():
        if key == name:
            btn.configure(fg_color="#1565C0", border_width=2, border_color="#4FC3F7")
        else:
            btn.configure(fg_color="#1A2A4A", border_width=0)

    # ─── Анимация выезда справа-снизу ───
    try:
        # Сбрасываем предыдущее состояние
        target_frame.pack_forget()
        target_frame.place_forget()
        
        cw = content.winfo_width()
        if cw < 100:
            cw = 800 # fallback, если окно еще не отрисовано
            
        # Начальная позиция: справа за экраном и ниже на 30px
        target_frame.place(x=cw, y=30, relwidth=1, relheight=1)
        
        # Отменяем старую анимацию, если пользователь быстро кликает
        if "_page_anim_id" in globals() and _page_anim_id.get("id"):
            try: app.after_cancel(_page_anim_id["id"])
            except: pass
        else:
            globals()["_page_anim_id"] = {"id": None}
            
        def _animate_step(i=0):
            steps = 12
            if i > steps:
                target_frame.place_forget()
                target_frame.pack(fill="both", expand=True)
                _page_anim_id["id"] = None
                
                # Запускаем эффекты карточек после того, как страница встала на место
                _apply_glass_effects(target_frame)
                return
            
            # Плавность (ease-out cubic)
            t = i / steps
            ease = 1 - (1 - t) ** 3
            cur_x = int(cw * (1 - ease))
            cur_y = int(30 * (1 - ease)) # Всплытие вверх
            
            target_frame.place(x=cur_x, y=cur_y, relwidth=1, relheight=1)
            _page_anim_id["id"] = app.after(12, _animate_step, i+1)
            
        _animate_step(0)
    except Exception as e:
        log_error("show_page_animation", e)
        target_frame.pack(fill="both", expand=True)
        _apply_glass_effects(target_frame)


