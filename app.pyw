IW_REGISTRY_ROOTS = [
    (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE", 4),
    (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\WOW6432Node", 4),
    (winreg.HKEY_CURRENT_USER, r"SOFTWARE", 4),
]
