# ================== ПРОВЕРКА ПОВЕРХНОСТИ ДИСКА ==================
def _surface_test_worker(letter, progress_q, stop_flag):
    """
    Фоновый воркер чтения поверхности диска.
    Читает весь диск блоками по 4 МБ через unbuffered файл.
    Отправляет в progress_q кортежи ('progress', read_mb, total_mb, mbps, slow_count).
    """
    import time as _time
    # Открываем физический диск \\.\C:
    # Нужно FILE_FLAG_NO_BUFFERING — иначе кэш ОС скроет все медленные блоки
    path = f"\\\\.\\{letter}:"

    # Определяем размер тома
    total_size = 0
    try:
        import psutil
        for part in psutil.disk_partitions(all=False):
            if part.device.upper().startswith(f"{letter}:"):
                total_size = psutil.disk_usage(part.mountpoint).total
                break
    except Exception:
        pass

    if total_size == 0:
        progress_q.put(("error", "Не удалось определить размер диска"))
        return

    # Открываем через WinAPI
    access = _GENERIC_READ
    share = _FILE_SHARE_READ | _FILE_SHARE_WRITE
    flags = _FILE_ATTRIBUTE_NORMAL | _FILE_FLAG_NO_BUFFERING

    h = _k32.CreateFileW(path, access, share, None,
                          _OPEN_EXISTING, flags, None)
    fallback = False
    if h is None or h == _INVALID_HANDLE:
        # Fallback: обычный файл (медленнее, но работает)
        fallback = True
        progress_q.put(("info", "Открываю без NO_BUFFERING — "
                                 "тест может быть медленнее"))

    block_size = 4 * 1024 * 1024  # 4 МБ
    buf = None
    fh = None
    try:
        if fallback:
            # Читаем через обычный Python
            fh = open(path.replace("\\\\.\\", ""), "rb",
                       buffering=block_size)
        else:
            buf = _k32.VirtualAlloc(None, block_size,
                                     _MEM_COMMIT | _MEM_RESERVE,
                                     _PAGE_READWRITE)
            if not buf:
                progress_q.put(("error", "VirtualAlloc failed"))
                return

        total_mb = total_size // (1024 * 1024)
        read_mb = 0
        slow_blocks = []
        start_time = _time.time()
        r = wintypes.DWORD(0)

        # Порог «медленного» блока — 10 МБ/с (норма для SSD: 500+)
        # Реально медленные блоки читаются за > 0.4 сек
        SLOW_THRESHOLD_SEC = 0.4

        while read_mb < total_mb:
            if stop_flag["stop"]:
                break

            t0 = _time.time()
            try:
                if fallback:
                    data = fh.read(block_size)
                    if not data:
                        break
                else:
                    ok = _k32.ReadFile(h, buf, block_size,
                                        ctypes.byref(r), None)
                    if not ok or r.value == 0:
                        break
            except Exception:
                break

            t1 = _time.time()
            dt = t1 - t0
            if dt > SLOW_THRESHOLD_SEC:
                slow_blocks.append((read_mb, round(dt, 2)))

            read_mb += 4
            # Прогресс раз в ~10 блоков (40 МБ)
            if read_mb % 40 == 0 or read_mb >= total_mb:
                elapsed = max(0.001, t1 - start_time)
                mbps = read_mb / elapsed
                # Не даём read_mb превысить total_mb
                shown_mb = min(read_mb, total_mb)
                progress_q.put(("progress", shown_mb, total_mb,
                                 mbps, len(slow_blocks)))

        # Итог
        elapsed = max(0.001, _time.time() - start_time)
        avg_mbps = read_mb / elapsed
        progress_q.put(("done", read_mb, total_mb, avg_mbps, slow_blocks))
    except Exception as e:
        progress_q.put(("error", str(e)))
    finally:
        try:
            if not fallback and h:
                _k32.CloseHandle(h)
        except Exception:
            pass
        try:
            if buf:
                _k32.VirtualFree(buf, 0, _MEM_RELEASE)
        except Exception:
            pass
        try:
            if fh:
                fh.close()
        except Exception:
            pass


def open_disk_surface_test(letter):
    """Окно проверки поверхности диска."""
    win = ctk.CTkToplevel(app)
    win.title(f"🔬 Проверка поверхности: {letter}:")
    win.geometry("800x600")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text=f"🔬  Проверка поверхности {letter}:\\",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14, height=44,
                 border_width=1, border_color="#4FC3F7").pack(
        pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Полное чтение диска блоками по 4 МБ находит "
                      "медленные участки и сбойные сектора.\n"
                      "⚠️ Тест может занять 10–60 минут. Не выключайте ПК.",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 10))

    status_lbl = ctk.CTkLabel(win, text="Готово к запуску",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    progress = ctk.CTkProgressBar(win, height=18, progress_color="#1976D2")
    progress.set(0)
    progress.pack(pady=(4, 8), padx=20, fill="x")

    stats_lbl = ctk.CTkLabel(win, text="—",
                              font=("Consolas", 12, "bold"),
                              text_color="#e0e8f5")
    stats_lbl.pack(pady=(0, 8))

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A",
                                   corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)
    ctk.CTkLabel(lst,
                 text="Медленные блоки появятся здесь...",
                 font=("Inter", 12), text_color="#90A4AE").pack(pady=20)

    progress_q = queue.Queue()
    stop_flag = {"stop": False}
    state = {"running": False}

    def start_test():
        if state["running"]:
            return
        if not messagebox.askyesno(
            "Начать проверку?",
            f"Будет прочитан весь диск {letter}: по 4 МБ за раз.\n\n"
            f"⚠️ Это может занять 10–60 минут. Отменить можно "
            f"кнопкой «⏹ Остановить».\n\n"
            f"Продолжить?"):
            return
        state["running"] = True
        stop_flag["stop"] = False
        start_btn.configure(state="disabled", text="Работает...")
        stop_btn.configure(state="normal")
        for w in lst.winfo_children():
            w.destroy()
        status_lbl.configure(text="⏳ Чтение диска...",
                              text_color="#FFD54F")
        progress.set(0)

        # Запускаем воркер
        threading.Thread(
            target=_surface_test_worker,
            args=(letter, progress_q, stop_flag),
            daemon=True).start()

        def poll():
            if not win.winfo_exists():
                return
            try:
                item = progress_q.get_nowait()
            except queue.Empty:
                app.after(200, poll)
                return

            if item[0] == "info":
                status_lbl.configure(text=f"ℹ️ {item[1]}",
                                      text_color="#FFD54F")
                app.after(200, poll)
            elif item[0] == "progress":
                _, read_mb, total_mb, mbps, slow = item
                pct = read_mb / max(1, total_mb)
                progress.set(pct)
                if read_mb >= total_mb:
                    eta_text = "завершение"
                else:
                    eta_sec = max(0, (total_mb - read_mb) / max(0.1, mbps))
                    eta_m = int(eta_sec // 60)
                    eta_s = int(eta_sec % 60)
                    eta_text = f"~{eta_m}м {eta_s}с"
                stats_lbl.configure(
                    text=f"Прочитано: {read_mb} / {total_mb} МБ "
                         f"({pct*100:.1f}%)  •  Скорость: {mbps:.0f} МБ/с  "
                         f"•  Осталось: {eta_text}  "
                         f"•  Медленных: {slow}",
                    text_color="#e0e8f5")
                status_lbl.configure(text="⏳ Чтение диска...",
                                      text_color="#FFD54F")
                app.after(200, poll)
            elif item[0] == "done":
                _, read_mb, total_mb, mbps, slow = item
                progress.set(1.0)
                state["running"] = False
                start_btn.configure(state="normal", text="▶ Запустить")
                stop_btn.configure(state="disabled")
                stats_lbl.configure(
                    text=f"Готово: прочитано {read_mb} МБ "
                         f"за ~{read_mb / max(0.1, mbps):.0f} сек  •  "
                         f"Средняя: {mbps:.0f} МБ/с  •  "
                         f"Медленных: {len(slow)}",
                    text_color="#7CFC7C")

                if not slow:
                    status_lbl.configure(
                        text="✅ Проверка завершена — медленных блоков нет",
                        text_color="#7CFC7C")
                    verdict = ("✅ Поверхность в отличном состоянии. "
                               "Медленных блоков не найдено.")
                    verdict_color = "#7CFC7C"
                else:
                    worst = max(slow, key=lambda x: x[1])
                    status_lbl.configure(
                        text=f"⚠️ Найдено медленных блоков: {len(slow)}",
                        text_color="#FFD54F")
                    verdict = (f"⚠️ Найдено медленных блоков: {len(slow)}\n"
                               f"Самый медленный: {worst[1]:.2f} сек "
                               f"на позиции {worst[0]} МБ.\n\n"
                               f"Это может говорить о начинающихся "
                               f"проблемах с диском. Рекомендуется "
                               f"сделать бэкап важных данных.")
                    verdict_color = "#FFD54F"

                # Показываем медленные блоки
                for w in lst.winfo_children():
                    w.destroy()
                if slow:
                    ctk.CTkLabel(lst,
                                 text=f"Медленные блоки ({len(slow)}):",
                                 font=("Inter", 13, "bold"),
                                 text_color="#FFD54F").pack(
                        anchor="w", padx=10, pady=(6, 4))
                    for pos_mb, sec in slow[:200]:
                        row = ctk.CTkFrame(lst, fg_color="#3A2430",
                                            corner_radius=6)
                        row.pack(fill="x", pady=1, padx=2)
                        ctk.CTkLabel(row,
                                     text=f"Позиция {pos_mb} МБ",
                                     font=("Consolas", 12),
                                     text_color="#ffffff",
                                     width=200, anchor="w").pack(
                            side="left", padx=8, pady=4)
                        ctk.CTkLabel(row,
                                     text=f"{sec:.2f} сек",
                                     font=("Consolas", 10, "bold"),
                                     text_color="#FF8A8A").pack(
                            side="right", padx=8, pady=4)
                    if len(slow) > 200:
                        ctk.CTkLabel(lst,
                                     text=f"... и ещё {len(slow) - 200}",
                                     font=("Inter", 11),
                                     text_color="#90A4AE").pack(
                            anchor="w", padx=10, pady=4)
                else:
                    ctk.CTkLabel(lst,
                                 text="✅ Все блоки прочитаны "
                                      "с нормальной скоростью",
                                 font=("Arial", 12),
                                 text_color="#7CFC7C").pack(pady=20)

                show_output_dialog(
                    f"Проверка поверхности {letter}:",
                    f"РЕЗУЛЬТАТ ПРОВЕРКИ ПОВЕРХНОСТИ\n"
                    f"{'=' * 60}\n\n"
                    f"Диск:        {letter}:\n"
                    f"Прочитано:   {read_mb} МБ из {total_mb} МБ\n"
                    f"Средняя скорость: {mbps:.0f} МБ/с\n"
                    f"Медленных блоков: {len(slow)}\n\n"
                    f"{verdict}")

            elif item[0] == "error":
                state["running"] = False
                start_btn.configure(state="normal", text="▶ Запустить")
                stop_btn.configure(state="disabled")
                status_lbl.configure(text=f"❌ {item[1][:80]}",
                                      text_color="#FF8A8A")
                messagebox.showerror("Ошибка", item[1])

        app.after(200, poll)

    def stop_test():
        stop_flag["stop"] = True
        status_lbl.configure(text="⏹ Останавливаю...",
                              text_color="#FFD54F")

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    start_btn = ctk.CTkButton(btn_row, text="▶ Запустить проверку",
                               height=42, font=("Inter", 13, "bold"),
                               fg_color="#43A047", hover_color="#66BB6A",
                               corner_radius=21, command=start_test)
    start_btn.pack(side="left", padx=(0, 6), fill="x", expand=True)
    stop_btn = ctk.CTkButton(btn_row, text="⏹ Остановить",
                              height=42, font=("Inter", 13, "bold"),
                              fg_color="#C62828", hover_color="#E53935",
                              corner_radius=21, state="disabled",
                              command=stop_test)
    stop_btn.pack(side="left", padx=6, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=42,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=21,
                  command=win.destroy).pack(side="left", padx=(6, 0),
                                             fill="x", expand=True)


