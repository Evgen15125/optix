def set_tray_callbacks(on_show, on_quick_clean, on_quit):
    _STATE["tray_callbacks"]["on_show"] = on_show
    _STATE["tray_callbacks"]["on_quick_clean"] = on_quick_clean
    _STATE["tray_callbacks"]["on_quit"] = on_quit


def setup_tray(icon_path):
    try:
        import pystray
        from PIL import Image
    except Exception:
        return False
    try:
        if icon_path and os.path.exists(icon_path):
            img = Image.open(icon_path).convert("RGBA")
            img = img.resize((64, 64), Image.LANCZOS)
        else:
            img = Image.new("RGBA", (64, 64), (21, 101, 192, 255))
    except Exception:
        return False

    def on_show(icon, item):
        cb = _STATE["tray_callbacks"].get("on_show")
        if cb:
            try:
                cb()
            except Exception:
                pass

    def on_quick(icon, item):
        cb = _STATE["tray_callbacks"].get("on_quick_clean")
        if cb:
            try:
                cb()
            except Exception:
                pass

    def on_quit(icon, item):
        cb = _STATE["tray_callbacks"].get("on_quit")
        try:
            if cb:
                cb()
            else:
                icon.stop()
        except Exception:
            try:
                icon.stop()
            except Exception:
                pass

    def on_hide(icon, item):
        try:
            app.withdraw()
        except Exception:
            pass

    menu = pystray.Menu(
        pystray.MenuItem("Открыть Optix", on_show, default=True),
        pystray.MenuItem("⚡ Быстрая очистка", on_quick),
        pystray.MenuItem("Свернуть в трей", on_hide),
        pystray.Menu.SEPARATOR,
        pystray.MenuItem("❌ Выход (полный)", on_quit),
    )
    try:
