    path = filedialog.asksaveasfilename(
        title="Сохранить Markdown",
        defaultextension=".md",
        initialfile=default_name,
        filetypes=[("Markdown", "*.md"), ("Text", "*.txt")])
    if not path:
        return
    try:
        md = report_to_markdown(_reports_cache["data"])
        with open(path, "w", encoding="utf-8") as f:
            f.write(md)
        if messagebox.askyesno("Готово",
                                f"Markdown сохранён:\n{path}\n\nОткрыть?"):
            try:
                os.startfile(path)
            except Exception:
                pass
    except Exception as e:
        log_error("save_report_md", e)
        messagebox.showerror("Ошибка", str(e))


def copy_report_to_clipboard():
    if not _reports_cache["text"]:
        messagebox.showinfo("Optix", "Сначала сформируйте отчёт.")
        return
    app.clipboard_clear()
    app.clipboard_append(_reports_cache["text"])
    messagebox.showinfo("Готово", "Скопировано.")


# ================== ДИАГНОСТИЧЕСКИЙ ОТЧЁТ ПО СЧЁТЧИКАМ ==================
DIAG_REPORTS_DIR = os.path.join(BASE_DIR, "diagnostics_reports")


def _diag_ensure_dir():
    try:
        os.makedirs(DIAG_REPORTS_DIR, exist_ok=True)
        return True
    except Exception as e:
        log_error("_diag_ensure_dir", e)
        return False


_DIAG_COUNTERS = [
    r"\Processor(_Total)\% Processor Time",
    r"\Memory\Available MBytes",
    r"\Memory\Committed Bytes",
    r"\Memory\% Committed Bytes In Use",
    r"\Memory\Cache Bytes",
    r"\PhysicalDisk(_Total)\% Disk Time",
    r"\PhysicalDisk(_Total)\Avg. Disk Queue Length",
    r"\PhysicalDisk(_Total)\Disk Reads/sec",
    r"\PhysicalDisk(_Total)\Disk Writes/sec",
    r"\System\Processor Queue Length",
    r"\System\Context Switches/sec",
    r"\System\System Calls/sec",
]


def _collect_diag_counters(duration_sec=30, progress_cb=None):
    """Собирает счётчики через Get-Counter. Возвращает dict {path: [значения]}.

    Важно: на русской Windows имена счётчиков возвращаются локализованными
    («Процессор», «Память»), поэтому матчим не по строке, а по индексу —
    Get-Counter возвращает счётчики в том же порядке, что мы подали на вход.
    """
    counter_list = ",".join(f"'{c}'" for c in _DIAG_COUNTERS)
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; "
        "$ErrorActionPreference='SilentlyContinue'; "
        f"$paths = @({counter_list}); "
        f"$s = Get-Counter -Counter $paths -SampleInterval 1 "
        f"-MaxSamples {duration_sec}; "
        "$out = @(); "
        "foreach ($sample in $s) { "
        "  $i = 0; "
        "  foreach ($cs in $sample.CounterSamples) { "
        "    $out += [PSCustomObject]@{ "
        "      Idx = $i; "
        "      Value = [double]$cs.CookedValue "
        "    }; "
        "    $i++ "
        "  } "
        "}; "
        "if ($out.Count -gt 0) { $out | ConvertTo-Json -Compress } "
    )
    if progress_cb:
        progress_cb(f"Сбор данных ({duration_sec} сек)...")
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True,
            timeout=duration_sec + 60,
            creationflags=CREATE_NO_WINDOW,
            encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return None
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        grouped = defaultdict(list)
        num = len(_DIAG_COUNTERS)
        for item in data:
            if not isinstance(item, dict):
                continue
            try:
                idx = int(item.get("Idx", -1))
                val = float(item.get("Value"))
            except Exception:
                continue
            if 0 <= idx < num:
                grouped[_DIAG_COUNTERS[idx]].append(val)
        return dict(grouped)
    except subprocess.TimeoutExpired:
        log_error("_collect_diag_counters",
                  Exception(f"Timeout {duration_sec + 60} сек"))
        return None
    except Exception as e:
        log_error("_collect_diag_counters", e)
        return None


def _diag_stat(values):
    if not values:
        return {"min": 0, "max": 0, "avg": 0, "n": 0}
    return {
        "min": min(values),
        "max": max(values),
        "avg": sum(values) / len(values),
        "n": len(values),
    }


def _diag_verdict_cpu(avg):
    if avg < 15:
        return "✅", "#7CFC7C", "Низкая загрузка — система свободна"
    if avg < 40:
        return "🟢", "#7CFC7C", "Нормальная загрузка"
    if avg < 70:
        return "🟡", "#FFD54F", "Заметная загрузка — проверьте процессы"
    return "🔴", "#FF8A8A", "Высокая загрузка — ищите проблему"


def _diag_verdict_ram(pct):
    if pct < 60:
        return "✅", "#7CFC7C", "Памяти хватает"
    if pct < 80:
        return "🟡", "#FFD54F", "Память заполнена наполовину"
    if pct < 90:
        return "🟠", "#FF9800", "Мало свободной памяти"
    return "🔴", "#FF8A8A", "Память почти закончилась"


def _diag_verdict_disk(pct):
    if pct < 30:
        return "✅", "#7CFC7C", "Диск не перегружен"
    if pct < 60:
        return "🟡", "#FFD54F", "Диск заметно нагружен"
    if pct < 85:
        return "🟠", "#FF9800", "Диск работает почти постоянно"
    return "🔴", "#FF8A8A", "Диск — узкое место системы"


def _diag_build_html(data, counters):
    """Собирает HTML-отчёт из данных о системе и счётчиков."""
    import html as _html

    def esc(s):
        return _html.escape(str(s))

    o = data.get("os", {})
    c = data.get("cpu", {})
    ram = data.get("ram", {})

    def stat_block(path_key):
        return _diag_stat(counters.get(path_key, []))

    cpu_stat = stat_block(r"\Processor(_Total)\% Processor Time")
    ram_avail = stat_block(r"\Memory\Available MBytes")
    ram_committed = stat_block(r"\Memory\Committed Bytes")
    ram_pct = stat_block(r"\Memory\% Committed Bytes In Use")
    ram_cache = stat_block(r"\Memory\Cache Bytes")
    disk_pct = stat_block(r"\PhysicalDisk(_Total)\% Disk Time")
    disk_queue = stat_block(r"\PhysicalDisk(_Total)\Avg. Disk Queue Length")
    disk_read = stat_block(r"\PhysicalDisk(_Total)\Disk Reads/sec")
    disk_write = stat_block(r"\PhysicalDisk(_Total)\Disk Writes/sec")
    sys_queue = stat_block(r"\System\Processor Queue Length")
    sys_ctx = stat_block(r"\System\Context Switches/sec")
    sys_calls = stat_block(r"\System\System Calls/sec")

    cpu_icon, cpu_col, cpu_note = _diag_verdict_cpu(cpu_stat["avg"])
    ram_icon, ram_col, ram_note = _diag_verdict_ram(ram_pct["avg"])
    disk_icon, disk_col, disk_note = _diag_verdict_disk(disk_pct["avg"])

    parts = ['<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8">',
             '<title>Диагностика Windows — Optix</title><style>',
             'body{font-family:"Inter",Arial;background:#0A1A30;',
             'color:#e0e8f5;padding:24px;margin:0}',
             '.header{background:linear-gradient(135deg,#1565C0,#0D47A1);',
             'padding:24px 30px;border-radius:16px;margin-bottom:20px}',
             '.header h1{margin:0;font-size:26px}',
             '.header p{margin:6px 0 0;opacity:.85;font-size:13px}',
             '.card{background:#1A2A4A;border-radius:14px;',
             'padding:18px 22px;margin-bottom:16px}',
             '.card h2{margin:0 0 12px;font-size:17px;color:#82B1FF}',
             '.verdict{padding:10px 14px;border-radius:10px;',
             'margin-bottom:12px;font-size:13px;font-weight:600}',
             'table{width:100%;border-collapse:collapse;margin-top:6px}',
             'td,th{padding:7px 8px;text-align:left;font-size:13px;',
             'border-bottom:1px solid #243A5E}',
             'th{color:#90CAF9;font-weight:600}',
             'td.v{font-family:Consolas,monospace;text-align:right;',
             'color:#fff}',
             '.legend{font-size:11px;color:#90A4AE;margin-top:8px}',
             '</style></head><body>']

    parts.append(
        f'<div class="header"><h1>🩺 Диагностика Windows</h1>'
        f'<p>Optix v{esc(APP_VERSION)} • '
        f'{esc(data.get("generated", "?"))} • '
        f'Период сбора: 30 сек</p></div>')

    # ─── Система ───
    parts.append('<div class="card"><h2>🖥 Система</h2><table>')
    for k, v in [
        ("Компьютер", o.get("computer_name", "?")),
        ("Пользователь", o.get("user", "?")),
        ("ОС", f"{o.get('system','?')} {o.get('release','')}"),
        ("Версия", o.get("version", "?")),
        ("Аптайм", data.get("uptime", "?")),
        ("CPU", c.get("name", "?")),
        ("Ядра", f"{c.get('cores',0)} физ. / {c.get('threads',0)} лог."),
        ("ОЗУ всего", human_size(ram.get("total", 0))),
    ]:
        parts.append(f'<tr><td>{esc(k)}</td><td class="v">{esc(v)}</td></tr>')
    parts.append('</table></div>')

    # ─── CPU ───
    parts.append(f'<div class="card"><h2>🖥 Процессор</h2>')
    parts.append(
        f'<div class="verdict" style="background:{cpu_col}22;'
        f'color:{cpu_col}">{cpu_icon} {esc(cpu_note)}</div>')
    parts.append('<table>'
                 '<tr><th>Метрика</th><th>Мин</th><th>Средн.</th>'
                 '<th>Макс</th></tr>')
    parts.append(
        f'<tr><td>% Processor Time</td>'
        f'<td class="v">{cpu_stat["min"]:.1f}%</td>'
        f'<td class="v">{cpu_stat["avg"]:.1f}%</td>'
        f'<td class="v">{cpu_stat["max"]:.1f}%</td></tr>')
    parts.append(
        f'<tr><td>Processor Queue Length</td>'
        f'<td class="v">{sys_queue["min"]:.1f}</td>'
        f'<td class="v">{sys_queue["avg"]:.2f}</td>'
        f'<td class="v">{sys_queue["max"]:.1f}</td></tr>')
    parts.append('</table>')
    parts.append('<div class="legend">Очередь процессора &gt; 2 '
                 'устойчиво — признак перегрузки CPU.</div>')
    parts.append('</div>')

    # ─── RAM ───
    parts.append(f'<div class="card"><h2>🧠 Память</h2>')
    parts.append(
        f'<div class="verdict" style="background:{ram_col}22;'
        f'color:{ram_col}">{ram_icon} {esc(ram_note)}</div>')
    parts.append('<table>'
                 '<tr><th>Метрика</th><th>Мин</th><th>Средн.</th>'
                 '<th>Макс</th></tr>')

    def _bytes_row(label, s):
        return (f'<tr><td>{label}</td>'
                f'<td class="v">{human_size(s["min"])}</td>'
                f'<td class="v">{human_size(s["avg"])}</td>'
                f'<td class="v">{human_size(s["max"])}</td></tr>')

    parts.append(_bytes_row("Available MBytes", {
        "min": ram_avail["min"] * 1024 * 1024,
        "avg": ram_avail["avg"] * 1024 * 1024,
        "max": ram_avail["max"] * 1024 * 1024}))
    parts.append(_bytes_row("Committed Bytes", ram_committed))
    parts.append(_bytes_row("Cache Bytes", ram_cache))
    parts.append(
        f'<tr><td>% Committed Bytes In Use</td>'
        f'<td class="v">{ram_pct["min"]:.1f}%</td>'
        f'<td class="v">{ram_pct["avg"]:.1f}%</td>'
        f'<td class="v">{ram_pct["max"]:.1f}%</td></tr>')
    parts.append('</table>')
    parts.append('<div class="legend">% Committed &gt; 85% — '
                 'система активно использует файл подкачки.</div>')
    parts.append('</div>')

    # ─── Диск ───
    parts.append(f'<div class="card"><h2>💾 Диски</h2>')
    parts.append(
        f'<div class="verdict" style="background:{disk_col}22;'
        f'color:{disk_col}">{disk_icon} {esc(disk_note)}</div>')
    parts.append('<table>'
                 '<tr><th>Метрика</th><th>Мин</th><th>Средн.</th>'
                 '<th>Макс</th></tr>')
    parts.append(
        f'<tr><td>% Disk Time</td>'
        f'<td class="v">{disk_pct["min"]:.1f}%</td>'
        f'<td class="v">{disk_pct["avg"]:.1f}%</td>'
        f'<td class="v">{disk_pct["max"]:.1f}%</td></tr>')
    parts.append(
        f'<tr><td>Avg Disk Queue Length</td>'
        f'<td class="v">{disk_queue["min"]:.2f}</td>'
        f'<td class="v">{disk_queue["avg"]:.2f}</td>'
        f'<td class="v">{disk_queue["max"]:.2f}</td></tr>')
    parts.append(
        f'<tr><td>Disk Reads/sec</td>'
        f'<td class="v">{disk_read["min"]:.0f}</td>'
        f'<td class="v">{disk_read["avg"]:.1f}</td>'
        f'<td class="v">{disk_read["max"]:.0f}</td></tr>')
    parts.append(
        f'<tr><td>Disk Writes/sec</td>'
        f'<td class="v">{disk_write["min"]:.0f}</td>'
        f'<td class="v">{disk_write["avg"]:.1f}</td>'
        f'<td class="v">{disk_write["max"]:.0f}</td></tr>')
    parts.append('</table>')
    parts.append('<div class="legend">% Disk Time &gt; 85% длительно — '
                 'диск узкое место. Avg Queue Length &gt; 2 — '
                 'нагрузка превышает возможности диска.</div>')
    parts.append('</div>')

    # ─── Система / ядро ───
    parts.append('<div class="card"><h2>⚙ Ядро системы</h2><table>'
                 '<tr><th>Метрика</th><th>Мин</th><th>Средн.</th>'
                 '<th>Макс</th></tr>')
    parts.append(
        f'<tr><td>Context Switches/sec</td>'
        f'<td class="v">{sys_ctx["min"]:.0f}</td>'
        f'<td class="v">{sys_ctx["avg"]:.0f}</td>'
        f'<td class="v">{sys_ctx["max"]:.0f}</td></tr>')
    parts.append(
        f'<tr><td>System Calls/sec</td>'
        f'<td class="v">{sys_calls["min"]:.0f}</td>'
        f'<td class="v">{sys_calls["avg"]:.0f}</td>'
        f'<td class="v">{sys_calls["max"]:.0f}</td></tr>')
    parts.append('</table></div>')

    # ─── Рекомендации ───
    recs = []
    if cpu_stat["avg"] > 70:
        recs.append("CPU загружен &gt; 70%. Откройте Мониторинг → "
                    "Топ-5 процессов и найдите виновника.")
    if sys_queue["avg"] > 2:
        recs.append("Очередь процессора &gt; 2. Если нет задач, "
                    "активно использующих CPU — возможна проблема "
                    "с драйвером или фоновым процессом.")
    if ram_pct["avg"] > 85:
        recs.append("Занято &gt; 85% ОЗУ. Закройте лишние приложения "
                    "или добавьте планку памяти.")
    if disk_pct["avg"] > 85:
        recs.append("Диск работает почти постоянно. Проверьте, "
                    "не идёт ли индексация Windows, обновление или "
                    "сканирование антивирусом.")
    if disk_queue["avg"] > 2:
        recs.append("Очередь диска &gt; 2 — диск не успевает. "
                    "Возможно, SSD деградирует — проверьте SMART.")
    if not recs:
        recs.append("✅ Система работает в нормальном режиме. "
                    "Признаков проблем не обнаружено.")

    parts.append('<div class="card"><h2>💡 Рекомендации</h2><ul>')
    for rec in recs:
        parts.append(f'<li>{rec}</li>')
    parts.append('</ul></div>')

    parts.append('<div class="legend" style="text-align:center;'
                 'margin-top:20px">Отчёт сформирован программой Optix '
                 f'v{esc(APP_VERSION)}</div>')
    parts.append('</body></html>')
    return "".join(parts)


def open_diagnostics_report():
    """Открывает окно сбора и генерирует HTML-отчёт."""
    if not _diag_ensure_dir():
        messagebox.showerror("Ошибка",
                              "Не удалось создать папку diagnostics_reports.")
        return

    dlg = ctk.CTkToplevel(app)
    dlg.title("🩺 Диагностика Windows")
    dlg.geometry("520x260")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="🩺  Диагностика Windows",
                 font=("Inter", 18, "bold"),
                 text_color="#ffffff", fg_color="#1565C0",
                 corner_radius=14, height=40).pack(
        pady=(16, 8), padx=20, ipadx=20)
    ctk.CTkLabel(dlg,
                 text="Сбор счётчиков производительности Windows "
                      "в течение 30 секунд.\n"
                      "После завершения отчёт откроется в браузере.",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 12))

    progress = ctk.CTkProgressBar(dlg, height=14,
                                    progress_color="#1976D2")
    progress.set(0)
    progress.pack(pady=(4, 8), padx=30, fill="x")

    status_lbl = ctk.CTkLabel(dlg, text="Запуск...",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7",
                              fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 6), padx=30, fill="x")

    def worker():
        duration = 30

        def progress_cb(msg):
            try:
                app.after(0, lambda m=msg: status_lbl.configure(
                    text=m, text_color="#FFD54F"))
            except Exception:
                pass

        # простой отсчёт
        def tick(i=0):
            if i > duration:
                return
            try:
                progress.set(i / duration)
                if i < duration:
                    status_lbl.configure(
                        text=f"⏳ Сбор данных... осталось: "
                             f"{duration - i} сек",
                        text_color="#FFD54F")
            except Exception:
                return
            try:
                dlg.after(1000, lambda: tick(i + 1))
            except Exception:
                pass

        def finish_countdown():
            try:
                progress.set(1.0)
            except Exception:
                pass

        try:
            dlg.after(0, lambda: tick(1))
        except Exception:
            pass

        counters = _collect_diag_counters(duration,
                                           progress_cb=progress_cb)
        if counters is None:
            def show_err():
                try:
                    status_lbl.configure(
                        text="❌ Не удалось собрать счётчики",
                        text_color="#FF8A8A")
                except Exception:
                    pass
                messagebox.showerror(
                    "Ошибка",
                    "Не удалось получить счётчики производительности.\n\n"
                    "Возможно, служба WMI или Performance Logs "
                    "отключены.")
            app.after(0, show_err)
            app.after(0, dlg.destroy)
            return

        try:
            data = collect_full_report()
        except Exception as e:
            log_error("open_diagnostics_report.collect", e)
            data = {"generated": datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"),
                "os": {}, "cpu": {}, "ram": {}, "disks": [],
                "uptime": "?"}

        html = _diag_build_html(data, counters)
        ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        path = os.path.join(DIAG_REPORTS_DIR,
                             f"Optix_Diagnostics_{ts}.html")
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(html)
        except Exception as e:
            log_error("open_diagnostics_report.save", e)
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", f"Не удалось сохранить HTML:\n{e}"))
            app.after(0, dlg.destroy)
            return

        def finish():
            try:
                finish_countdown()
                status_lbl.configure(text="✅ Готово",
                                     text_color="#7CFC7C")
            except Exception:
                pass
            app.after(0, dlg.destroy)
            app.after(100, lambda: os.startfile(path))

        app.after(0, finish)

    threading.Thread(target=worker, daemon=True).start()


# ================== ИНВЕНТАРИЗАЦИЯ СИСТЕМЫ ==================
def _inv_get_ram_sticks():
    """Возвращает список планок ОЗУ."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "Get-CimInstance -ClassName Win32_PhysicalMemory | "
        "Select-Object Manufacturer,PartNumber,Capacity,Speed,"
        "DeviceLocator | ConvertTo-Json -Compress"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        out_list = []
        for d in data:
            if not isinstance(d, dict):
                continue
            try:
                cap = int(d.get("Capacity") or 0)
            except Exception:
                cap = 0
            try:
                spd = int(d.get("Speed") or 0)
            except Exception:
                spd = 0
            out_list.append({
                "manufacturer": str(d.get("Manufacturer") or "?").strip(),
                "part": str(d.get("PartNumber") or "").strip(),
                "capacity": cap,
                "speed": spd,
