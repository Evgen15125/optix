def _file_info(path):
    info = {"exists": False, "company": "", "version": "", "size": 0}
    if not path or not os.path.isfile(path):
        return info
    info["exists"] = True
    try:
        info["size"] = os.path.getsize(path)
    except Exception:
        pass
    if not WIN32_AVAILABLE:
        return info
    try:
        info["company"] = str(win32api.GetFileVersionInfo(
            path, "\\StringFileInfo\\040904b0\\CompanyName") or "")
    except Exception:
        pass
    try:
        info["version"] = str(win32api.GetFileVersionInfo(
            path, "\\StringFileInfo\\040904b0\\FileVersion") or "")
    except Exception:
        pass
    return info


def _extract_exe_path(command):
    if not command:
        return ""
    cmd = command.strip()
    if cmd.startswith('"'):
        end = cmd.find('"', 1)
        if end > 1:
            return cmd[1:end]
    for ext in [".exe", ".bat", ".cmd", ".com", ".lnk"]:
        idx = cmd.lower().find(ext)
        if idx > 0:
            return cmd[:idx + len(ext)].strip().strip('"')
    return cmd.split(" ")[0].strip('"')


def _estimate_impact(command, source):
    exe = _extract_exe_path(command).lower()
    name = os.path.basename(exe)
    high_impact = ["steam.exe", "discord.exe", "spotify.exe", "onedrive.exe",
                   "dropbox.exe", "skype.exe", "teams.exe", "slack.exe",
                   "adobe", "creative", "acrobat", "nvidia", "geforce",
                   "razer", "logi", "corsair", "asus", "msi", "gamebar"]
    low_impact = ["update", "updater", "helper", "tray", "background",
                  "systray", "minimized", "check", "daemon"]
    if any(k in name or k in command.lower() for k in high_impact):
        return "🔴", "высокое"
    if any(k in name or k in command.lower() for k in low_impact):
        return "🟢", "низкое"
    if source == "scheduled":
        return "🟡", "среднее"
    return "🟡", "среднее"


def read_run_key(root, path, view_flag, source_label="registry", root_label=None):
    items = []
    try:
        key = winreg.OpenKey(root, path, 0, winreg.KEY_READ | view_flag)
        i = 0
        while True:
            try:
                name, value, _ = winreg.EnumValue(key, i)
                items.append({
                    "name": name,
                    "command": value,
                    "source": source_label,
                    "root": root_label or ("HKCU" if root == winreg.HKEY_CURRENT_USER else "HKLM"),
                    "reg_path": path,
                    "view": view_flag,
                    "enabled": True,
                })
                i += 1
            except OSError:
                break
        winreg.CloseKey(key)
    except Exception:
        pass
    return items


def read_startup_folder(common=False):
    """Читает папку Startup, ИГНОРИРУЯ desktop.ini и другие hidden+system файлы."""
    items = []
    if common:
        startup_dir = os.path.expandvars(
            r"%PROGRAMDATA%\Microsoft\Windows\Start Menu\Programs\StartUp")
    else:
        startup_dir = os.path.expandvars(
            r"%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup")
    if os.path.isdir(startup_dir):
        for f in os.listdir(startup_dir):
            full = os.path.join(startup_dir, f)
            if not os.path.isfile(full):
                continue
            # Пропускаем desktop.ini и подобное (hidden+system)
            if _is_hidden_system(full):
                continue
            if f.lower() == "desktop.ini":
                continue
            target = ""
            if f.lower().endswith(".lnk"):
                try:
                    from win32com.client import Dispatch
                    sh = Dispatch("WScript.Shell")
                    sc = sh.CreateShortCut(full)
                    target = sc.TargetPath or ""
                except Exception:
                    pass
            items.append({
                "name": f,
                "command": target or full,
                "source": "folder_common" if common else "folder",
                "folder_path": startup_dir,
                "enabled": True,
            })
    return items


def read_scheduled_tasks():
    items = []
    try:
        ps = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "Get-ScheduledTask | Where-Object { $_.State -ne 'Disabled' -and "
            "$_.Triggers | Where-Object { $_.CimClass.CimClassName -match 'Logon|Boot' } } "
            "| Select-Object TaskName,TaskPath,State,@{n='Action';e={$_.Actions.Execute}},"
            "@{n='Args';e={$_.Actions.Arguments}} | ConvertTo-Json -Compress"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        for t in data:
            name = t.get("TaskName", "")
            path = t.get("TaskPath", "\\")
            action = t.get("Action", "") or ""
            args = t.get("Args", "") or ""
            cmd = f"{action} {args}".strip()
            items.append({
                "name": name,
                "command": cmd,
                "source": "scheduled",
                "task_path": path,
                "task_full": f"{path}{name}",
                "enabled": True,
            })
    except Exception as e:
        log_error("read_scheduled_tasks", e)
    return items


def read_all_scheduled_tasks():
    """ВСЕ задачи планировщика с триггерами. UTF-8 + упрощённый запрос."""
    items = []
    try:
        ps = (
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
            "$ErrorActionPreference = 'SilentlyContinue'; "
            "Get-ScheduledTask | ForEach-Object { "
            "  $t = $_; "
            "  $triggers = @($t.Triggers | ForEach-Object { "
            "    try { $_.CimClass.CimClassName } catch { '' } }); "
            "  [PSCustomObject]@{ "
            "    TaskName = $t.TaskName; "
            "    TaskPath = $t.TaskPath; "
            "    State = [string]$t.State; "
            "    Author = [string]$t.Author; "
            "    Description = [string]$t.Description; "
            "    Triggers = ($triggers -join ','); "
            "    Action = (($t.Actions | ForEach-Object { [string]$_.Execute }) -join ' '); "
            "    Args = (($t.Actions | ForEach-Object { [string]$_.Arguments }) -join ' ') "
            "  } "
            "} | ConvertTo-Json -Compress -Depth 3"
        )
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=120,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out:
            return []
        try:
            data = json.loads(out)
        except json.JSONDecodeError as je:
            log_error("read_all_scheduled_tasks_json", je)
            return []
        if isinstance(data, dict):
            data = [data]
        for t in data:
            action = (t.get("Action", "") or "").strip()
            args = (t.get("Args", "") or "").strip()
            cmd = f"{action} {args}".strip()
            items.append({
                "name": t.get("TaskName", "") or "",
                "path": t.get("TaskPath", "\\") or "\\",
                "state": t.get("State", "") or "",
                "author": t.get("Author", "") or "",
                "description": t.get("Description", "") or "",
                "triggers": t.get("Triggers", "") or "",
                "command": cmd,
                "task_full": f"{t.get('TaskPath', '\\')}{t.get('TaskName', '')}",
            })
    except Exception as e:
        log_error("read_all_scheduled_tasks", e)
    return items


def _estimate_task_impact(task):
    name_l = (task.get("name", "") + " " + task.get("author", "")).lower()
    path_l = (task.get("path", "")).lower()

    low_impact = [
        "diagnostic", "feedback", "telemetry", "customer experience",
        "compatibility appraiser", "application experience",
        "diskdiagnostic", "windows error reporting",
    ]
    for k in low_impact:
        if k in name_l or k in path_l:
            return "🟢", "низкое"

    high_impact = [
        "update", "updater", "googleupdate", "chrome", "adobe", "nvidia",
        "intel", "amd", "steam", "epic", "office", "onedrive", "dropbox",
        "discord", "spotify", "battle.net", "ubisoft", "origin", "ea",
        "creative cloud", "ccleaner", "opera", "yandex",
    ]
    for k in high_impact:
        if k in name_l or k in path_l:
            return "🔴", "высокое"

    if task.get("state", "").lower() in ("ready", "running"):
        return "🟡", "среднее"
    return "⚪", "отключена"


def get_autostart_items():
    disabled = load_disabled_list()
    items = []

    items += read_run_key(winreg.HKEY_CURRENT_USER,
                          r"Software\Microsoft\Windows\CurrentVersion\Run",
                          winreg.KEY_WOW64_64KEY)
    items += read_run_key(winreg.HKEY_LOCAL_MACHINE,
                          r"Software\Microsoft\Windows\CurrentVersion\Run",
                          winreg.KEY_WOW64_64KEY)
    items += read_run_key(winreg.HKEY_LOCAL_MACHINE,
                          r"Software\Microsoft\Windows\CurrentVersion\Run",
                          winreg.KEY_WOW64_32KEY)
    items += read_run_key(winreg.HKEY_CURRENT_USER,
                          r"Software\Microsoft\Windows\CurrentVersion\RunOnce",
                          winreg.KEY_WOW64_64KEY, source_label="runonce")
    items += read_run_key(winreg.HKEY_LOCAL_MACHINE,
                          r"Software\Microsoft\Windows\CurrentVersion\RunOnce",
                          winreg.KEY_WOW64_64KEY, source_label="runonce")
    items += read_run_key(winreg.HKEY_CURRENT_USER,
                          r"Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run",
                          winreg.KEY_WOW64_64KEY, source_label="explorer")

    items += read_startup_folder(common=False)
    items += read_startup_folder(common=True)

    try:
        items += read_scheduled_tasks()
    except Exception:
        pass

    active_keys = {(it["name"], it["source"]) for it in items}
    for d in disabled:
        key = (d.get("name"), d.get("source"))
        if key in active_keys:
            continue
        items.append({
            "name": d.get("name", "?"),
            "command": d.get("command", ""),
            "source": d.get("source", "registry"),
            "root": d.get("root", "HKCU"),
            "reg_path": d.get("reg_path", ""),
            "view": d.get("view", winreg.KEY_WOW64_64KEY),
            "folder_path": d.get("folder_path", ""),
            "backup_path": d.get("backup_path", ""),
            "task_path": d.get("task_path", ""),
            "task_full": d.get("task_full", ""),
            "enabled": False,
        })

    for it in items:
        exe = _extract_exe_path(it["command"])
        fi = _file_info(exe) if exe else {"exists": False, "company": "", "version": "", "size": 0}
        it["exe"] = exe
        it["file_exists"] = fi["exists"]
        it["company"] = fi["company"]
        it["version"] = fi["version"]
        it["size"] = fi["size"]
        it["impact_icon"], it["impact_label"] = _estimate_impact(it["command"], it["source"])

    items.sort(key=lambda x: (not x["enabled"], x["source"], x["name"].lower()))
    return items, disabled


SOURCE_LABELS = {
    "registry": "📋 Реестр (Run)",
    "runonce": "1️⃣ Реестр (RunOnce)",
    "explorer": "🧭 Explorer",
    "folder": "📁 Папка Startup (пользователь)",
    "folder_common": "📁 Папка Startup (все пользователи)",
    "scheduled": "⏰ Планировщик задач",
}


def refresh_autostart_ui():
    for m in autostart_ui.get("_menus", []):
        try: m.destroy()
        except Exception: pass
    autostart_ui["_menus"] = []

    global autostart_items
    autostart_items, _ = get_autostart_items()

    query = autostart_ui.get("search", ctk.StringVar()).get().strip().lower()
    filter_src = autostart_ui.get("filter", ctk.StringVar()).get()

    filtered = []
    for it in autostart_items:
        if filter_src and filter_src != "Все" and SOURCE_LABELS.get(it["source"], it["source"]) != filter_src:
            continue
        if query:
            hay = f"{it['name']} {it['command']} {it.get('company','')}".lower()
            if query not in hay:
                continue
        filtered.append(it)

    for w in autostart_ui["list_frame"].winfo_children():
        w.destroy()
    autostart_ui["rows"].clear()

    if not filtered:
        ctk.CTkLabel(autostart_ui["list_frame"], text="Записей не найдено", font=("Inter", 14), text_color="#90A4AE").pack(pady=30)
        _update_autostart_status()
        return

    current_source = None
    for it in filtered:
        src_key = it["source"]
        if src_key != current_source:
            current_source = src_key
            ctk.CTkLabel(autostart_ui["list_frame"], text=SOURCE_LABELS.get(src_key, src_key), 
                         font=("Inter", 13, "bold"), text_color="#82B1FF", anchor="w").pack(
                fill="x", pady=(12, 4), padx=4)

        is_missing = not it.get("file_exists", True)
        if is_missing:
            default_bg = "#3A1F1F"
            name_color = "#FF8A8A"
        else:
            default_bg = "#1F2E4A" if it["enabled"] else "#2A2F3A"
            name_color = "#ffffff" if it["enabled"] else "#B0BEC5"

        row = ctk.CTkFrame(autostart_ui["list_frame"], fg_color=default_bg, corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=2)

        # ─── ЖЕЛЕЗОБЕТОННАЯ ПОДСВЕТКА ───
        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E")
            except Exception: pass
        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                try:
                    x, y = r.winfo_pointerxy()
                    rx, ry = r.winfo_rootx(), r.winfo_rooty()
                    rw, rh = r.winfo_width(), r.winfo_height()
                    if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                        r.configure(fg_color=bg)
                except Exception: pass
            r.after(15, check_later)

        def bind_hover(widget):
            if isinstance(widget, ctk.CTkButton): return
            try:
                widget.bind("<Enter>", on_enter, add="+")
                widget.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_canvas"):
                    widget._canvas.bind("<Enter>", on_enter, add="+")
                    widget._canvas.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_label"):
                    widget._label.bind("<Enter>", on_enter, add="+")
                    widget._label.bind("<Leave>", on_leave, add="+")
            except Exception: pass
            for child in widget.winfo_children(): bind_hover(child)
        bind_hover(row)

        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=(10, 10), pady=(8, 2))
        
        status_dot = "🟢" if it["enabled"] else "🔴"
        ctk.CTkLabel(top, text=f"{status_dot} {it['impact_icon']}", font=("Arial", 14), width=50).pack(side="left")
        ctk.CTkLabel(top, text=it["name"][:60], font=("Inter", 13, "bold"), text_color=name_color, anchor="w").pack(
            side="left", padx=4, fill="x", expand=True)

        cmd = it["command"] or "—"
        if len(cmd) > 110: cmd = cmd[:110] + "..."
        ctk.CTkLabel(row, text=cmd, font=("Consolas", 10), text_color="#90CAF9", anchor="w").pack(
            fill="x", padx=(14, 10), pady=(0, 2))

        meta_parts = []
        if it["file_exists"]:
            meta_parts.append("✅ файл найден")
            if it.get("company"): meta_parts.append(f"🏢 {it['company'][:30]}")
            if it.get("size", 0) > 0: meta_parts.append(human_size(it["size"]))
        else:
            meta_parts.append("❌ файл НЕ найден")
        
        meta_color = "#FF8A8A" if is_missing else "#B0BEC5"
        ctk.CTkLabel(row, text="   •   ".join(meta_parts), font=("Inter", 10), text_color=meta_color, anchor="w").pack(
            fill="x", padx=(14, 10), pady=(0, 6))

        btns = ctk.CTkFrame(row, fg_color="transparent")
        btns.pack(fill="x", padx=10, pady=(0, 8))

        def make_toggle(item=dict(it)):
            def toggle():
                if item["enabled"]: disable_item(item)
                else: enable_item(item)
            return toggle

        ctk.CTkButton(btns, text="🔴 Отключить" if it["enabled"] else "🟢 Включить", width=110, height=28,
                      font=("Inter", 11, "bold"), fg_color="#C62828" if it["enabled"] else "#2E7D32",
                      hover_color="#E53935" if it["enabled"] else "#43A047", corner_radius=14, command=make_toggle()
                      ).pack(side="left", padx=(0, 4))

        if it.get("exe") and it["file_exists"]:
            def make_open(path=it["exe"]):
                def do():
                    try: os.startfile(os.path.dirname(path))
                    except Exception: pass
                return do
            ctk.CTkButton(btns, text="📂", width=36, height=28, font=("Inter", 12),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=make_open()
                          ).pack(side="left", padx=2)

        if it["source"] in ("registry", "runonce", "explorer"):
            def make_reg(item=dict(it)):
                def do():
                    try: subprocess.Popen(["regedit.exe", "/e", os.path.join(BASE_DIR, "autostart_reg_dump.reg"), f"HKEY_CURRENT_USER\\{item['reg_path']}"])
                    except Exception: pass
                return do
            ctk.CTkButton(btns, text="🧬 regedit", width=90, height=28, font=("Inter", 11, "bold"),
                          fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=make_reg()
                          ).pack(side="left", padx=2)

        if it["source"] == "scheduled":
            ctk.CTkLabel(btns, text=f"⏰ {it.get('task_full','')[:50]}", font=("Consolas", 10), text_color="#B0BEC5").pack(side="left", padx=6)

        def _build_ctx(item=dict(it)):
            m = tk.Menu(row, tearoff=0, bg="#1A2A4A", fg="#ffffff",
                        activebackground="#1565C0", activeforeground="#ffffff", font=("Inter", 10))
            if item["enabled"]: m.add_command(label="🔴 Отключить", command=lambda: disable_item(item))
            else: m.add_command(label="🟢 Включить", command=lambda: enable_item(item))
            m.add_separator()
            if item.get("exe") and item["file_exists"]:
                m.add_command(label="📂 Открыть папку", command=lambda p=item["exe"]: os.startfile(os.path.dirname(p)))
            m.add_command(label="📋 Копировать команду", command=lambda c=item["command"]: (app.clipboard_clear(), app.clipboard_append(c)))
            m.add_command(label="📋 Копировать имя", command=lambda n=item["name"]: (app.clipboard_clear(), app.clipboard_append(n)))
            return m

        _ctx = _build_ctx()
        autostart_ui.setdefault("_menus", []).append(_ctx)
        def _show_ctx(event, m=_ctx):
            try: m.tk_popup(event.x_root, event.y_root)
            finally:
                try: m.grab_release()
                except Exception: pass

        for _widget in [row, top, btns] + list(row.winfo_children()) + list(top.winfo_children()) + list(btns.winfo_children()):
            try: _widget.bind("<Button-3>", _show_ctx)
            except Exception: pass

    _update_autostart_status()


def _update_autostart_status():
    total = len(autostart_items)
    enabled = sum(1 for x in autostart_items if x["enabled"])
    disabled = total - enabled
    missing = sum(1 for x in autostart_items if x["enabled"] and not x.get("file_exists", True))
    impact_high = sum(1 for x in autostart_items if x["enabled"] and x.get("impact_icon") == "🔴")
    txt = (f"Всего: {total}   •   🟢 {enabled}   •   🔴 {disabled}   •   "
           f"⚠️ не найдено: {missing}   •   🔥 высокое влияние: {impact_high}")
    color = "#4FC3F7"
    if missing > 0 or impact_high > 3:
        color = "#FFD54F"
    try:
        autostart_ui["status"].configure(text=txt, text_color=color)
    except Exception:
        pass


def disable_item(item):
    try:
        if item["source"] in ("registry", "runonce", "explorer"):
            root = (winreg.HKEY_CURRENT_USER if item["root"] == "HKCU"
                    else winreg.HKEY_LOCAL_MACHINE)
            key = winreg.OpenKey(root, item["reg_path"], 0,
                                 winreg.KEY_SET_VALUE | item.get("view", winreg.KEY_WOW64_64KEY))
            try:
                winreg.DeleteValue(key, item["name"])
            except FileNotFoundError:
                pass
            winreg.CloseKey(key)
            disabled = load_disabled_list()
            disabled.append({
                "name": item["name"], "command": item["command"],
                "source": item["source"], "root": item["root"],
                "reg_path": item["reg_path"],
                "view": item.get("view", winreg.KEY_WOW64_64KEY),
            })
            save_disabled_list(disabled)

        elif item["source"] in ("folder", "folder_common"):
            backup_dir = os.path.join(BASE_DIR, "startup_backup")
            os.makedirs(backup_dir, exist_ok=True)
            full = os.path.join(item["folder_path"], item["name"])
            if os.path.exists(full):
                shutil.move(full, os.path.join(backup_dir, item["name"]))
            disabled = load_disabled_list()
            disabled.append({
                "name": item["name"], "command": item["command"],
                "source": item["source"],
                "folder_path": item.get("folder_path", ""),
                "backup_path": os.path.join(backup_dir, item["name"]),
            })
            save_disabled_list(disabled)

        elif item["source"] == "scheduled":
            task_full = item.get("task_full", "")
            if task_full:
                subprocess.run(["schtasks", "/Change", "/TN", task_full,
                                "/DISABLE"],
                               capture_output=True, text=True, timeout=20,
                               creationflags=CREATE_NO_WINDOW)
                disabled = load_disabled_list()
                disabled.append({
                    "name": item["name"], "command": item["command"],
                    "source": "scheduled",
                    "task_path": item.get("task_path", ""),
                    "task_full": task_full,
                })
                save_disabled_list(disabled)

        refresh_autostart_ui()
    except Exception as e:
        messagebox.showerror("Ошибка отключения", str(e))
        log_error("disable_item", e)


def enable_item(item):
    try:
        disabled = load_disabled_list()
        entry = None
        for d in disabled:
            if d.get("name") != item["name"]:
                continue
            if d.get("source") != item["source"]:
                continue
            match = False
            if item.get("task_full") and d.get("task_full") == item["task_full"]:
                match = True
            elif item.get("reg_path") and d.get("reg_path") == item["reg_path"]:
                match = True
            elif item.get("folder_path") and d.get("folder_path") == item["folder_path"]:
                match = True
            elif not item.get("task_full") and not item.get("reg_path") \
                    and not item.get("folder_path"):
                match = True
            if match:
                entry = d
                break
        if not entry:
            messagebox.showerror("Ошибка", "Запись не найдена.")
            refresh_autostart_ui()
            return

        if entry["source"] in ("registry", "runonce", "explorer"):
            root = (winreg.HKEY_CURRENT_USER if entry["root"] == "HKCU"
                    else winreg.HKEY_LOCAL_MACHINE)
            key = winreg.OpenKey(root, entry["reg_path"], 0,
                                 winreg.KEY_SET_VALUE | entry.get("view", winreg.KEY_WOW64_64KEY))
            winreg.SetValueEx(key, entry["name"], 0, winreg.REG_SZ, entry["command"])
            winreg.CloseKey(key)

        elif entry["source"] in ("folder", "folder_common"):
            bp = entry.get("backup_path", "")
            fp = entry.get("folder_path", "")
            if bp and os.path.exists(bp) and fp:
                shutil.move(bp, os.path.join(fp, entry["name"]))

        elif entry["source"] == "scheduled":
            task_full = entry.get("task_full", "")
            if task_full:
                subprocess.run(["schtasks", "/Change", "/TN", task_full,
                                "/ENABLE"],
                               capture_output=True, text=True, timeout=20,
                               creationflags=CREATE_NO_WINDOW)

        disabled = [d for d in disabled
                    if not (d.get("name") == item["name"]
                            and d.get("source") == item["source"]
                            and d.get("task_full", "") == item.get("task_full", ""))]
        save_disabled_list(disabled)
        refresh_autostart_ui()
    except Exception as e:
        messagebox.showerror("Ошибка включения", str(e))
        log_error("enable_item", e)


