def backup_services():
    items, _ = get_services_list(), None
    snapshot = {
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "services": [{"name": s["name"], "display": s["display_name"],
                       "status": s["status"], "start_type": s["start_type"]}
                      for s in items],
    }
    try:
        save_services_backup(snapshot)
        show_toast("Optix — бэкап служб", f"Сохранено служб: {len(items)}")
        messagebox.showinfo("Готово", f"Бэкап сохранён:\n{SERVICES_BACKUP_PATH}\n\n"
                                       f"Служб: {len(items)}")
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def export_services(fmt="txt"):
    items = get_services_list()
    if not items:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    if fmt == "csv":
        default = f"Optix_Services_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.csv"
        path = filedialog.asksaveasfilename(
            title="Экспорт в CSV", defaultextension=".csv",
            initialfile=default, filetypes=[("CSV", "*.csv")])
        if not path:
            return
        try:
            import csv
            with open(path, "w", encoding="utf-8-sig", newline="") as f:
                w = csv.writer(f, delimiter=";")
                w.writerow(["Защита", "Статус", "Тип запуска", "Имя",
                            "Отображаемое имя", "Оценка", "Можно отключить", "Зависимости"])
                for s in items:
                    w.writerow([
                        "🔒 защищена" if s["protected"] else "—",
                        s["status"], s["start_type"], s["name"],
                        s["display_name"], s["impact_text"],
                        "да" if s["can_disable"] else "нет",
                        ", ".join(s.get("dependencies", [])),
                    ])
            messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))
    else:
        default = f"Optix_Services_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
        path = filedialog.asksaveasfilename(
            title="Экспорт в TXT", defaultextension=".txt",
            initialfile=default, filetypes=[("TXT", "*.txt")])
        if not path:
            return
        try:
            lines = ["=" * 70,
                     "  СЛУЖБЫ WINDOWS — отчёт Optix",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     f"  Всего: {len(items)}",
                     "=" * 70, ""]
            for s in items:
                st = "🟢" if str(s["status"]).lower() == "running" else "🔴"
                lines.append(f"{st} {s['impact_icon']} {s['display_name']}")
                lines.append(f"   Служба:      {s['name']}")
                lines.append(f"   Запуск:      {get_start_type_label(s['start_type'])}")
                lines.append(f"   Оценка:      {s['impact_text']}")
                if s["protected"]:
                    lines.append("   ⚠️ ЗАЩИЩЕНА (не отключать!)")
                if s.get("dependencies"):
                    lines.append(f"   Зависимости: {', '.join(s['dependencies'])}")
                lines.append("")
            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            messagebox.showinfo("Готово", f"TXT сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))


def export_services_config():
    items = get_services_list()
    if not items:
        messagebox.showinfo("Optix", "Список служб пуст.")
        return
    default = f"Optix_Services_Config_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.json"
    path = filedialog.asksaveasfilename(
        title="Экспорт конфигурации служб",
        defaultextension=".json", initialfile=default,
        filetypes=[("JSON", "*.json")])
    if not path:
        return
    try:
        data = {
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "computer": os.environ.get("COMPUTERNAME", "?"),
            "services": [],
        }
        for s in items:
            data["services"].append({
                "name": s["name"],
                "display_name": s["display_name"],
                "start_type": s["start_type"],
                "status": s["status"],
            })
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        messagebox.showinfo("Готово",
                             f"Экспортировано служб: {len(items)}\n\n{path}")
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def import_services_config():
    path = filedialog.askopenfilename(
        title="Импорт конфигурации служб",
        filetypes=[("JSON", "*.json"), ("Все файлы", "*.*")])
    if not path:
        return
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        services = data.get("services", [])
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))
        return
    if not services:
        messagebox.showinfo("Optix", "Файл не содержит служб.")
        return
    ts = data.get("timestamp", "?")
    computer = data.get("computer", "?")
    if not messagebox.askyesno(
        "Применить конфигурацию служб?",
        f"Источник: {computer}\nДата: {ts}\n"
        f"Служб в файле: {len(services)}\n\n"
        f"⚠️ Типы запуска служб будут ИЗМЕНЕНЫ в соответствии с файлом.\n"
        f"Это может повлиять на работу системы.\n\nПродолжить?"
    ):
        return
    if not messagebox.askyesno("Подтверждение",
                                "ТОЧНО применить? Рекомендуется сначала "
                                "сделать бэкап текущей конфигурации."):
        return

    ok = 0
    errors = 0
    for s in services:
        try:
            name = s.get("name", "")
            st = str(s.get("start_type", "")).lower()
            if not name:
                continue
            if "delayed" in st:
                service_action(name, "delayed")
            elif "auto" in st:
                service_action(name, "auto")
            elif "manual" in st:
                service_action(name, "manual")
            elif "disabled" in st:
                service_action(name, "disable")
            else:
                continue
            ok += 1
        except Exception as e:
            log_error("import_services_config", e)
            errors += 1

    messagebox.showinfo("Готово",
                         f"Применено: {ok}\nОшибок: {errors}")
    load_services_async()


def disable_recommended_services():
    items = get_services_list()
    targets = [s for s in items if s.get("can_disable")]
    if not targets:
        messagebox.showinfo("Optix", "Рекомендуемых к отключению служб не найдено.")
        return
    names = "\n".join([f"• {t['display_name']}" for t in targets[:15]])
    if len(targets) > 15:
        names += f"\n... и ещё {len(targets) - 15}"
    if not messagebox.askyesno(
        "⚠️ Отключить рекомендованные?",
        f"Будет отключено служб: {len(targets)}\n\n{names}\n\n"
        f"⚠️ ВНИМАНИЕ: изменения затронут систему!\n"
        f"Рекомендуется сначала сделать бэкап.\n\nПродолжить?"
    ):
        return
    if not messagebox.askyesno(
        "Подтвердите ещё раз",
        f"ТОЧНО отключить {len(targets)} служб?\n\n"
        f"Это может потребовать перезагрузку."
    ):
        return
    ok = 0
    for t in targets:
        try:
            service_action(t["name"], "disable")
            ok += 1
        except Exception:
            pass
    messagebox.showinfo("Готово", f"Отключено: {ok}")
    refresh_services_ui()


