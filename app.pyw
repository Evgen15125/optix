                day_lbl.pack(side="left", padx=(0, 4))
                day_entry.pack(side="left", padx=(4, 0))
                if not day_entry.get():
                    day_entry.delete(0, "end")
                    day_entry.insert(0, "1")
    trigger_menu.configure(command=update_time_visibility)
    update_time_visibility()

    # ─── Команда ───
    ctk.CTkLabel(win, text="Команда (программа или путь к .exe):",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF").pack(anchor="w", padx=30, pady=(4, 2))
    cmd_entry = ctk.CTkEntry(win, height=34, font=("Consolas", 12),
                              fg_color="#1A2A4A", text_color="#ffffff")
    cmd_entry.pack(fill="x", padx=30, pady=(0, 4))
    cmd_entry.insert(0, r"C:\Windows\System32\notepad.exe")

    def browse():
        p = filedialog.askopenfilename(
            title="Выберите программу",
            filetypes=[("Программы", "*.exe *.bat *.cmd"),
                        ("Все файлы", "*.*")])
        if p:
            cmd_entry.delete(0, "end")
            cmd_entry.insert(0, f'"{p}"')
    ctk.CTkButton(win, text="📁 Выбрать файл", height=28,
                  font=("Inter", 11), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=14,
                  command=browse).pack(anchor="w", padx=30, pady=(0, 8))

    # ─── Аргументы ───
    ctk.CTkLabel(win, text="Аргументы (опционально):",
                 font=("Arial", 11, "bold"),
                 text_color="#82B1FF").pack(anchor="w", padx=30, pady=(4, 2))
    args_entry = ctk.CTkEntry(win, height=34, font=("Consolas", 12),
                                fg_color="#1A2A4A", text_color="#ffffff")
    args_entry.pack(fill="x", padx=30, pady=(0, 12))

    # ─── Кнопки ───
    def do_create():
        name = name_entry.get().strip()
        if not name:
            messagebox.showerror("Ошибка", "Введите имя задачи.")
            return
        cmd = cmd_entry.get().strip()
        if not cmd:
            messagebox.showerror("Ошибка", "Введите команду.")
            return
        args = args_entry.get().strip()
        ch = trigger_var.get()
        t = time_entry.get().strip() or "03:00"

        # Собираем schtasks-команду
        args_list = ["schtasks", "/create", "/tn", name,
                     "/tr", f"{cmd} {args}".strip(), "/f"]
        if ch == "При входе в систему":
            args_list += ["/sc", "ONLOGON"]
        elif ch == "При запуске Windows":
            args_list += ["/sc", "ONSTART"]
        elif ch == "Ежедневно":
            args_list += ["/sc", "DAILY", "/st", t]
        elif ch == "Еженедельно":
            d = day_entry.get().strip().upper() or "MON"
            args_list += ["/sc", "WEEKLY", "/d", d, "/st", t]
        elif ch == "Ежемесячно":
            d = day_entry.get().strip() or "1"
            args_list += ["/sc", "MONTHLY", "/d", d, "/st", t]
        elif ch == "Один раз":
            date_str = datetime.now().strftime("%d/%m/%Y")
            args_list += ["/sc", "ONCE", "/st", t, "/sd", date_str]

        try:
            r = subprocess.run(args_list, capture_output=True, timeout=30,
                               creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b"\n" + (r.stderr or b""))
            if r.returncode == 0:
                messagebox.showinfo("Готово",
                    f"Задача создана:\n{name}")
                win.destroy()
                try:
                    refresh_autostart_ui()
                except Exception:
                    pass
            else:
                messagebox.showerror(
                    "Ошибка",
                    f"Код {r.returncode}\n\n{out[:600]}")
        except Exception as e:
            log_error("_sched_create_dialog.do_create", e)
            messagebox.showerror("Ошибка", str(e))

    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 14), padx=30, fill="x")
    ctk.CTkButton(br, text="💾 Создать", height=40,
                  font=("Inter", 14, "bold"), fg_color="#43A047",
                  hover_color="#66BB6A", corner_radius=20,
                  command=do_create).pack(side="left", padx=(0, 4),
                                            fill="x", expand=True)
    ctk.CTkButton(br, text="Отмена", height=40,
                  font=("Inter", 14, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=20,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


# ================== СРАВНЕНИЕ АВТОЗАПУСКА С BASELINE ==================

def _autostart_item_key(item):
    """Уникальный ключ записи автозапуска для сравнения."""
    src = item.get("source", "?")
    name = item.get("name", "?")
    locator = (item.get("reg_path") or
               item.get("folder_path") or
               item.get("task_full") or "")
    return f"{src}|{name}|{locator}"


def _autostart_get_baseline_items():
    """Возвращает список записей из сохранённого бэкапа."""
    data = load_autostart_backup()
    if not isinstance(data, dict):
        return [], None
    items = data.get("items", [])
    ts = data.get("timestamp")
    return items, ts


def _autostart_compare_current_with_baseline():
    """
    Сравнивает текущий автозапуск с baseline.
    Возвращает dict:
        {
            'added': [...],       # новые записи (нет в baseline)
            'removed': [...],     # удалённые (есть в baseline, нет сейчас)
            'changed': [...],     # изменилась команда
            'suspicious': [...],  # новые + impact_icon == '🔴'
            'baseline_ts': '...',
            'current_ts': '...',
            'has_baseline': True/False,
        }
    """
    current_items, _ = get_autostart_items()
    baseline_items, baseline_ts = _autostart_get_baseline_items()

    result = {
        "added": [],
        "removed": [],
        "changed": [],
        "suspicious": [],
        "baseline_ts": baseline_ts,
        "current_ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "has_baseline": bool(baseline_items),
    }

    if not baseline_items:
        result["added"] = list(current_items)
        result["suspicious"] = [
            it for it in current_items
            if it.get("impact_icon") == "🔴"
        ]
        return result

    cur_map = {_autostart_item_key(it): it for it in current_items}
    base_map = {_autostart_item_key(it): it for it in baseline_items}

    # Новое и изменённое
    for key, cur in cur_map.items():
        base = base_map.get(key)
        if base is None:
            result["added"].append(cur)
            if cur.get("impact_icon") == "🔴":
                result["suspicious"].append(cur)
            continue
        cur_cmd = (cur.get("command") or "").strip()
        base_cmd = (base.get("command") or "").strip()
        if cur_cmd != base_cmd:
            result["changed"].append({
                "item": cur,
                "old_command": base_cmd,
                "new_command": cur_cmd,
                "source": cur.get("source", "?"),
                "name": cur.get("name", "?"),
            })
            if cur.get("impact_icon") == "🔴":
                result["suspicious"].append(cur)

    # Удалённые
    for key, base in base_map.items():
        if key not in cur_map:
            result["removed"].append(base)

    # Сортировка — сначала высокое влияние
    order = {"🔴": 0, "🟡": 1, "🟢": 2, "⚪": 3}
    result["added"].sort(
        key=lambda x: (order.get(x.get("impact_icon", "⚪"), 4),
                       x.get("name", "").lower()))
    result["suspicious"].sort(
        key=lambda x: x.get("name", "").lower())
    result["removed"].sort(
        key=lambda x: (order.get(x.get("impact_icon", "⚪"), 4),
                       x.get("name", "").lower()))

    return result


def _autostart_count_changes():
    """Быстрый счётчик изменений — для отображения на кнопке."""
    try:
        baseline_items, _ = _autostart_get_baseline_items()
        if not baseline_items:
            return 0
        diff = _autostart_compare_current_with_baseline()
        return len(diff["added"]) + len(diff["removed"]) + \
               len(diff["changed"])
    except Exception:
        return 0


def open_autostart_diff_window():
    """Окно с 4 вкладками: Новое / Удалено / Изменено / Подозрительное."""
    diff = _autostart_compare_current_with_baseline()

    if not diff["has_baseline"]:
        if not messagebox.askyesno(
            "Baseline не найден",
            "Сохранённого эталона автозапуска ещё нет.\n\n"
            "Сделать его прямо сейчас? Он будет точкой "
            "для будущих сравнений — через неделю нажмёшь "
            "«🔍 Сравнить» и увидишь, что изменилось.\n\n"
            "Сделать baseline?"):
            return
        backup_autostart()
        # После создания baseline сразу открываем окно сравнения
        app.after(300, open_autostart_diff_window)
        return

    win = ctk.CTkToplevel(app)
    win.title("🔍 Аудит автозапуска")
    win.geometry("1100x760")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text="🔍  Аудит автозапуска — что изменилось",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(
        win,
        text=f"📌 Эталон: {diff['baseline_ts'] or '?'}    "
             f"→    Сейчас: {diff['current_ts']}",
        font=("Consolas", 12), text_color="#B0BEC5").pack(pady=(0, 6))

    total_changes = len(diff["added"]) + len(diff["removed"]) + \
                    len(diff["changed"])
    if total_changes == 0:
        summary_text = "✅ Изменений НЕТ — автозапуск не менялся"
        summary_color = "#7CFC7C"
    else:
        parts = []
        if diff["added"]:
            parts.append(f"➕ {len(diff['added'])}")
        if diff["removed"]:
            parts.append(f"➖ {len(diff['removed'])}")
        if diff["changed"]:
            parts.append(f"🔄 {len(diff['changed'])}")
        summary_text = "   •   ".join(parts) + \
                       f"   •   всего: {total_changes}"
        summary_color = "#FFD54F" if not diff["suspicious"] \
                        else "#FF8A8A"

    ctk.CTkLabel(win, text=summary_text,
                 font=("Inter", 13, "bold"),
                 text_color=summary_color,
                 fg_color="#0D47A1", corner_radius=10,
                 height=28).pack(pady=(0, 8), padx=20, fill="x")

    # Вкладки
    tabs = ctk.CTkTabview(win, fg_color="#0A1A30",
                            segmented_button_selected_color="#1565C0",
                            segmented_button_unselected_color="#1A2A4A")
    tabs.pack(fill="both", expand=True, padx=20, pady=(0, 8))

    def render_list(parent_tab, items, kind):
        """kind: 'added' | 'removed' | 'changed' | 'suspicious'."""
        for w in parent_tab.winfo_children():
            w.destroy()
        if not items:
            ctk.CTkLabel(parent_tab, text="(пусто)",
                         font=("Arial", 12),
                         text_color="#90A4AE").pack(pady=40)
            return

        wrap = ctk.CTkScrollableFrame(parent_tab,
                                        fg_color="#1A2A4A",
                                        corner_radius=8)
        wrap.pack(fill="both", expand=True, padx=2, pady=2)

        for entry in items:
            if kind == "changed":
                it = entry["item"]
                old_cmd = entry.get("old_command", "")
                new_cmd = entry.get("new_command", "")
            else:
                it = entry
                old_cmd = None
                new_cmd = None

            ic = it.get("impact_icon", "⚪")
            if kind == "added":
                fg = "#1F332A" if ic == "🟢" else \
                     ("#3A2430" if ic == "🔴" else "#243A5E")
            elif kind == "removed":
                fg = "#3A2A1E"
            elif kind == "changed":
                fg = "#2A2A3E"
            elif kind == "suspicious":
                fg = "#3A1F1F"
            else:
                fg = "#243A5E"

            row = ctk.CTkFrame(wrap, fg_color=fg, corner_radius=8)
            row.pack(fill="x", pady=2, padx=2)

            top = ctk.CTkFrame(row, fg_color="transparent")
            top.pack(fill="x", padx=10, pady=(6, 2))

            ctk.CTkLabel(top, text=ic, font=("Arial", 13),
                         width=22).pack(side="left")
            ctk.CTkLabel(top,
                         text=f"{it.get('name', '?')[:60]}",
                         font=("Inter", 13, "bold"),
                         text_color="#ffffff", anchor="w",
                         width=340).pack(side="left", padx=4)
            ctk.CTkLabel(top,
                         text=SOURCE_LABELS.get(it.get("source", "?"),
                                                  it.get("source", "?")),
                         font=("Arial", 9),
                         text_color="#90CAF9", anchor="w",
                         width=180).pack(side="left", padx=4)
            ctk.CTkLabel(top,
                         text=it.get("impact_label", "—"),
                         font=("Arial", 9),
                         text_color="#FF8A8A" if ic == "🔴"
                         else "#7CFC7C" if ic == "🟢"
                         else "#FFD54F").pack(side="right", padx=4)

            if kind == "changed" and old_cmd is not None:
                ctk.CTkLabel(row, text=f"Было:  {old_cmd[:120]}",
                             font=("Consolas", 9),
                             text_color="#FF8A8A", anchor="w").pack(
                    fill="x", padx=(14, 10), pady=(0, 1))
                ctk.CTkLabel(row, text=f"Стало: {new_cmd[:120]}",
                             font=("Consolas", 9),
                             text_color="#7CFC7C", anchor="w").pack(
                    fill="x", padx=(14, 10), pady=(0, 4))
            else:
                cmd = (it.get("command") or "—")[:130]
                ctk.CTkLabel(row, text=cmd, font=("Consolas", 9),
                             text_color="#B0BEC5", anchor="w").pack(
                    fill="x", padx=(14, 10), pady=(0, 4))

            meta = []
            if it.get("company"):
                meta.append(f"🏢 {it['company'][:25]}")
            if it.get("version"):
                meta.append(f"v{it['version']}")
            if not it.get("file_exists", True):
                meta.append("❌ файл не найден")
            if meta:
                ctk.CTkLabel(row, text="   •   ".join(meta),
                             font=("Arial", 9),
                             text_color="#90A4AE", anchor="w").pack(
                    fill="x", padx=(14, 10), pady=(0, 6))

            # Кнопки действий
            btns = ctk.CTkFrame(row, fg_color="transparent")
            btns.pack(fill="x", padx=10, pady=(0, 6))

            if it.get("exe") and it.get("file_exists"):
                def mk_open(p=it["exe"]):
                    def do():
                        try:
                            os.startfile(os.path.dirname(p))
                        except Exception:
                            pass
                    return do
                ctk.CTkButton(btns, text="📂 Папка", width=90,
                              height=24, font=("Arial", 10, "bold"),
                              fg_color="#455A64",
                              hover_color="#546E7A",
                              corner_radius=12, command=mk_open()
                              ).pack(side="left", padx=(0, 4))

            def mk_copy(text=it.get("command", "")):
                def do():
                    try:
                        app.clipboard_clear()
                        app.clipboard_append(text)
                        show_toast("Optix", "Скопировано")
                    except Exception:
                        pass
                return do
            ctk.CTkButton(btns, text="📋 Копировать", width=120,
                          height=24, font=("Arial", 10, "bold"),
                          fg_color="#1976D2",
                          hover_color="#42A5F5",
                          corner_radius=12, command=mk_copy()
                          ).pack(side="left", padx=4)

    t_added = tabs.add(f"➕ Новое ({len(diff['added'])})")
    t_removed = tabs.add(f"➖ Удалено ({len(diff['removed'])})")
    t_changed = tabs.add(f"🔄 Изменено ({len(diff['changed'])})")
    t_susp = tabs.add(f"⚠️ Подозрительное ({len(diff['suspicious'])})")

    render_list(t_added, diff["added"], "added")
    render_list(t_removed, diff["removed"], "removed")
    render_list(t_changed, diff["changed"], "changed")
    render_list(t_susp, diff["suspicious"], "suspicious")

    # Нижние кнопки
    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 14), padx=20, fill="x")

    def update_baseline():
        if not messagebox.askyesno(
            "Обновить baseline?",
            "Текущее состояние автозапуска будет сохранено "
            "как новый эталон.\n\n"
            "После этого «изменений» будет 0 — сравнение начнётся "
            "заново.\n\n"
            "Продолжить?"):
            return
        backup_autostart()
        win.destroy()
        try:
            refresh_autostart_ui()
        except Exception:
            pass

    def export_report():
        default = (f"Optix_AutostartDiff_"
                   f"{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt")
        path = filedialog.asksaveasfilename(
            title="Экспорт отчёта", defaultextension=".txt",
            initialfile=default, filetypes=[("TXT", "*.txt")])
        if not path:
            return
        try:
            lines = ["=" * 70,
                     "  АУДИТ АВТОЗАПУСКА — Optix",
                     "=" * 70,
                     f"  Эталон:  {diff['baseline_ts'] or '?'}",
                     f"  Сейчас:  {diff['current_ts']}",
                     f"  Всего изменений: {total_changes}",
                     ""]

            def dump(title, items, kind="item"):
                lines.append("─" * 70)
                lines.append(f"  {title} ({len(items)})")
                lines.append("─" * 70)
                if not items:
                    lines.append("  (пусто)")
                    lines.append("")
                    return
                for x in items:
                    if kind == "changed":
                        it = x["item"]
                        lines.append(f"  🔄 {it.get('name', '?')}")
                        lines.append(f"      Было:  {x.get('old_command', '')}")
                        lines.append(f"      Стало: {x.get('new_command', '')}")
                    else:
                        it = x
                        lines.append(f"  {it.get('impact_icon', '⚪')} "
                                     f"{it.get('name', '?')}")
                        lines.append(f"      {it.get('command', '')}")
                    lines.append("")
                lines.append("")

            dump("➕ НОВОЕ", diff["added"])
            dump("➖ УДАЛЕНО", diff["removed"])
            dump("🔄 ИЗМЕНЕНО", diff["changed"], kind="changed")
            dump("⚠️ ПОДОЗРИТЕЛЬНОЕ", diff["suspicious"])

            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            messagebox.showinfo("Готово", f"Отчёт сохранён:\n{path}")
            try:
                os.startfile(os.path.dirname(path))
            except Exception:
                pass
        except Exception as e:
            log_error("autostart_diff_export", e)
            messagebox.showerror("Ошибка", str(e))

    ctk.CTkButton(br, text="💾 Сделать этот снимок новым baseline",
                  height=38, font=("Arial", 11, "bold"),
                  fg_color="#2E7D32", hover_color="#43A047",
                  corner_radius=19, command=update_baseline
                  ).pack(side="left", padx=(0, 4), fill="x",
                          expand=True)
    ctk.CTkButton(br, text="📄 Экспорт отчёта", height=38,
                  font=("Arial", 11, "bold"), fg_color="#00838F",
                  hover_color="#0097A7", corner_radius=19,
                  command=export_report
                  ).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(br, text="Закрыть", height=38,
                  font=("Arial", 11, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)


