AUTOSTART_TASK_NAME = "Optix_AutoStart"
MANUAL_TASK_NAME = "Optix_ManualLaunch"


def _autostart_task_exists():
    """Проверяет, создана ли задача автозапуска в Планировщике."""
    try:
        r = subprocess.run(
            ["schtasks", "/Query", "/TN", AUTOSTART_TASK_NAME],
            capture_output=True, timeout=15,
            creationflags=CREATE_NO_WINDOW)
        return r.returncode == 0
    except Exception:
        return False


def _create_manual_launch_task():
    """
    Создаёт задачу по событию (ID 1001) + .bat для 100% надёжности.
    """
    pyw = _get_pythonw_path()
    app_path = os.path.abspath(__file__)
    user_domain = os.environ.get('USERDOMAIN', '')
    user_name = os.environ.get('USERNAME', '')
    user_id = f"{user_domain}\\{user_name}" if user_domain else user_name

    # 1. Регистрируем источник событий (с нужными ключами, чтобы не было отказа)
    try:
        import winreg
        key = winreg.CreateKey(
            winreg.HKEY_LOCAL_MACHINE, 
            r"SYSTEM\CurrentControlSet\Services\EventLog\Application\OptixTrigger"
        )
        winreg.SetValueEx(key, "EventMessageFile", 0, winreg.REG_EXPAND_SZ, r"%SystemRoot%\System32\EventCreate.exe")
        winreg.SetValueEx(key, "TypesSupported", 0, winreg.REG_DWORD, 7)
        winreg.CloseKey(key)
    except Exception:
        pass

    # 2. Создаём .bat для запуска (Планировщик любит батники больше, чем exe)
    bat_path = os.path.join(BASE_DIR, "optix_launch.bat")
    try:
        with open(bat_path, "w", encoding="cp866") as f:
            f.write(f'@echo off\n')
            f.write(f'cd /d "{BASE_DIR}"\n')
            f.write(f'start "" "{pyw}" "{app_path}"\n')
    except Exception as e:
        log_error("_create_manual_launch_task_bat", e)

    # 3. Формируем XML
    xml_content = f"""<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Application"&gt;&lt;Select Path="Application"&gt;*[System[Provider[@Name='OptixTrigger'] and EventID=1001]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{user_id}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{bat_path}</Command>
      <WorkingDirectory>{BASE_DIR}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
"""
    
    tmp_xml = os.path.join(tempfile.gettempdir(), "optix_manual_task.xml")
    try:
        with open(tmp_xml, "w", encoding="utf-16") as f:
            f.write(xml_content)
            
        subprocess.run(
            ["schtasks", "/Create", "/TN", MANUAL_TASK_NAME, 
             "/XML", tmp_xml, "/F"],
            capture_output=True, timeout=30, creationflags=CREATE_NO_WINDOW
        )
    except Exception as e:
        log_error("_create_manual_launch_task", e)
    finally:
        try:
            if os.path.exists(tmp_xml):
                os.remove(tmp_xml)
        except Exception:
            pass


def _create_autostart_task():
    """
    Создаёт задачу в Планировщике Windows:
      • триггер ONLOGON (при входе пользователя)
      • RL HIGHEST — запуск от админа без запроса UAC
      • флаг --minimized — окно стартует свёрнутым в трей
    Возвращает (ok: bool, msg: str).
    """
    pyw = _get_pythonw_path()
    app_path = os.path.abspath(__file__)
    tr = f'"{pyw}" "{app_path}" --minimized'
    args = ["schtasks", "/Create",
            "/TN", AUTOSTART_TASK_NAME,
            "/TR", tr,
            "/SC", "ONLOGON",
            "/RL", "HIGHEST",
            "/F"]
    try:
        r = subprocess.run(args, capture_output=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW)
        out = _decode_console_bytes(
            (r.stdout or b"") + b"\n" + (r.stderr or b"")).strip()
        
        if r.returncode != 0:
            try:
                messagebox.showerror(
                    "Ошибка автозапуска",
                    f"Не удалось создать задачу.\n\n"
                    f"Код {r.returncode}:\n{out[:1000]}")
            except Exception:
                pass
            return False, out
        return True, out
    except Exception as e:
        log_error("_create_autostart_task", e)
        try:
            messagebox.showerror("Ошибка", str(e))
        except Exception:
            pass
        return False, str(e)


def _launch_via_scheduled_task(task_name=AUTOSTART_TASK_NAME):
    """
    Запускает задачу. Сначала через COM (без UAC),
    затем через schtasks (запасной вариант).
    """
    # 1. Пробуем через COM API (самый надежный и тихий способ)
    try:
        import win32com.client
        scheduler = win32com.client.Dispatch("Schedule.Service")
        scheduler.Connect()
        root_folder = scheduler.GetFolder("\\")
        task = root_folder.GetTask(task_name)
        task.Run("")
        return True
    except Exception as e:
        log_error(f"_launch_via_task_COM_{task_name}", e)

    # 2. Запасной вариант: через schtasks
    try:
        r = subprocess.run(
            ["schtasks", "/Run", "/TN", task_name],
            capture_output=True, timeout=15,
            creationflags=CREATE_NO_WINDOW)
        if r.returncode == 0:
            return True
        else:
            out = _decode_console_bytes(
                (r.stdout or b"") + b" " + (r.stderr or b""))
            log_error(f"_launch_via_task_schtasks_{task_name}", 
                      Exception(f"Code {r.returncode}: {out}"))
    except Exception as e:
        log_error(f"_launch_via_task_schtasks_{task_name}", e)
    return False


def _delete_autostart_task():
    """Удаляет задачу автозапуска из Планировщика."""
    try:
        r = subprocess.run(
            ["schtasks", "/Delete", "/TN", AUTOSTART_TASK_NAME, "/F"],
            capture_output=True, timeout=20,
            creationflags=CREATE_NO_WINDOW)
        return r.returncode == 0
    except Exception as e:
        log_error("_delete_autostart_task", e)
        return False


def _ensure_autostart_state():
    """
    Сверяет настройку _STATE["autostart"] с реальным состоянием задачи.
    При первом запуске после обновления — создаёт задачу автоматически.
    """
    want = bool(_STATE.get("autostart", True))
    exists = _autostart_task_exists()
    if want and not exists:
        ok, msg = _create_autostart_task()
        if not ok:
            log_error("_ensure_autostart_state",
                      Exception(f"Не удалось создать задачу: {msg}"))
            _STATE["autostart"] = False
            _save_settings()
            try:
                show_toast(
                    "Optix — автозапуск недоступен",
                    "Не удалось настроить. Включите вручную в "
                    "«⚙️ Настройки».")
            except Exception:
                pass
    elif not want and exists:
        _delete_autostart_task()


def _load_settings():
