def open_process_priority_dialog():
    try:
        import psutil
    except ImportError:
        messagebox.showerror("Ошибка", "psutil не установлен.")
        return

    win = ctk.CTkToplevel(app)
    win.title("🎯 Приоритет процесса")
    win.geometry("700x550")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    win.grab_set()
    _center_window(win)

    ctk.CTkLabel(win, text="🎯  Установка приоритета процесса",
                 font=("Inter", 18, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14, height=44,
                 border_width=1, border_color="#4FC3F7").pack(pady=(16, 6), padx=20, ipadx=20)
                 
    ctk.CTkLabel(win, text="Выберите процесс и задайте ему приоритет.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text="Загрузка...", font=("Inter", 12, "bold"),
                              text_color="#FFD54F", fg_color="#131E32",
                              corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    search_var = ctk.StringVar()
    search_entry = ctk.CTkEntry(
        win, placeholder_text="🔍 Поиск процесса...",
        height=36, font=("Inter", 12), fg_color="#1F2E4A",
        text_color="#ffffff", corner_radius=10, textvariable=search_var)
    search_entry.pack(pady=(0, 8), padx=20, fill="x")

    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=4, pady=4)

    state = {"procs": []}

    def load_procs():
        procs = []
        for p in psutil.process_iter(["pid", "name", "cpu_percent", "memory_percent"]):
            try:
                i = p.info
                procs.append({"pid": i["pid"], "name": i["name"] or "?", "cpu": i["cpu_percent"] or 0.0, "ram": i["memory_percent"] or 0.0})
            except Exception:
                continue
        procs.sort(key=lambda x: -x["cpu"])
        state["procs"] = procs[:200]

    def render():
        q = search_var.get().strip().lower()
        for w in lst.winfo_children(): w.destroy()
        filtered = [p for p in state["procs"] if not q or q in p["name"].lower()]
        if not filtered:
            ctk.CTkLabel(lst, text="Процессы не найдены", font=("Inter", 14), text_color="#90A4AE").pack(pady=30)
            return
        status_lbl.configure(text=f"Процессов: {len(state['procs'])} • Показано: {len(filtered)}", text_color="#4FC3F7")
        
        for p in filtered:
            row = ctk.CTkFrame(lst, fg_color="#1F2E4A", corner_radius=8, border_width=1, border_color="#2A3B5C")
            row.pack(fill="x", pady=2, padx=2)
            
            ctk.CTkLabel(row, text=p['name'][:40], font=("Inter", 12, "bold"),
                         text_color="#ffffff", anchor="w", width=250).pack(side="left", padx=(12, 4), pady=6)
            ctk.CTkLabel(row, text=f"PID {p['pid']}", font=("Consolas", 11),
                         text_color="#90CAF9", width=70).pack(side="left", padx=4, pady=6)
            ctk.CTkLabel(row, text=f"CPU {p['cpu']:.1f}%", font=("Consolas", 11),
                         text_color="#FFD54F", width=80).pack(side="left", padx=4, pady=6)
            ctk.CTkLabel(row, text=f"RAM {p['ram']:.1f}%", font=("Consolas", 11),
                         text_color="#7CFC7C", width=80).pack(side="left", padx=4, pady=6)

            def mk_set(pid=p["pid"], name=p["name"]):
                def do():
                    dlg = ctk.CTkToplevel(win)
                    dlg.title(f"Приоритет: {name}")
                    dlg.geometry("420x300")
                    dlg.configure(fg_color="#0A1A30")
                    dlg.transient(win)
                    dlg.grab_set()
                    _center_window(dlg)
                    
                    ctk.CTkLabel(dlg, text=f"Приоритет для {name[:30]}",
                                 font=("Inter", 16, "bold"), text_color="#ffffff", fg_color="#1565C0",
                                 corner_radius=14, height=40, border_width=1, border_color="#4FC3F7").pack(pady=(16, 12), padx=20, ipadx=20)
                                 
                    prio_var = ctk.StringVar(value="Normal")
                    prio_menu = ctk.CTkOptionMenu(
                        dlg, values=["Idle", "Below Normal", "Normal", "Above Normal", "High", "Real Time"],
                        variable=prio_var, width=220, height=38, fg_color="#1F2E4A", button_color="#1976D2",
                        font=("Inter", 13))
                    prio_menu.pack(pady=(0, 16))

                    def apply_prio():
                        try:
                            import psutil
                            pr = psutil.Process(pid)
                            mapping = {
                                "Idle": psutil.IDLE_PRIORITY_CLASS,
                                "Below Normal": psutil.BELOW_NORMAL_PRIORITY_CLASS,
                                "Normal": psutil.NORMAL_PRIORITY_CLASS,
                                "Above Normal": psutil.ABOVE_NORMAL_PRIORITY_CLASS,
                                "High": psutil.HIGH_PRIORITY_CLASS,
                                "Real Time": psutil.REALTIME_PRIORITY_CLASS,
                            }
                            pr.nice(mapping.get(prio_var.get(), psutil.NORMAL_PRIORITY_CLASS))
                            messagebox.showinfo("Готово", f"Приоритет установлен: {prio_var.get()}")
                            dlg.destroy()
                        except Exception as e:
                            messagebox.showerror("Ошибка", str(e))
                            
                    ctk.CTkButton(dlg, text="💾 Применить", height=40,
                                  font=("Inter", 13, "bold"), fg_color="#43A047", hover_color="#66BB6A",
                                  corner_radius=20, command=apply_prio).pack(pady=10, padx=30, fill="x")
                return do

            ctk.CTkButton(row, text="⚙️", width=40, height=30,
                          font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A",
                          corner_radius=15, command=mk_set()).pack(side="right", padx=8, pady=6)

    def refresh():
        status_lbl.configure(text="⏳ Обновление...", text_color="#FFD54F")
        threading.Thread(target=lambda: (load_procs(), app.after(0, render)), daemon=True).start()

    search_entry.bind("<KeyRelease>", lambda e: render())

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=40,
                  font=("Inter", 12, "bold"), fg_color="#1976D2", hover_color="#42A5F5",
                  corner_radius=20, command=refresh).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40,
                  font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A",
                  corner_radius=20, command=win.destroy).pack(side="left", padx=(6, 0), fill="x", expand=True)
    refresh()


