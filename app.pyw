        parts.append('<table><tr><th>Имя</th><th>Включён</th>'
                     '<th>Пароль требуется</th><th>Последний вход</th>'
                     '<th>Админ</th></tr>')
        admin_set = set(admins)
        for u in users:
            en = ('<span class="g">да</span>' if u["enabled"]
                  else '<span class="r">нет</span>')
            pr = ('<span class="g">да</span>'
                  if u["password_required"] else '<span class="y">нет</span>')
            is_adm = ('<span class="g">✓</span>'
                      if u["name"] in admin_set else "—")
            parts.append(
                f'<tr><td class="v">{esc(u["name"])}</td>'
                f'<td>{en}</td><td>{pr}</td>'
                f'<td class="v">{esc(u["last_logon"])}</td>'
                f'<td>{is_adm}</td></tr>')
        parts.append('</table>')
    else:
        parts.append('<p class="legend">Нет данных</p>')
    if admins:
        parts.append('<div class="legend"><b>Администраторы:</b> '
                     + ", ".join(esc(a) for a in admins) + '</div>')
    parts.append('</div>')

    # ─── 12. Драйверы ───
    drivers = data.get("drivers", [])
    parts.append(f'<div class="card"><h2>🖥 Сторонние драйверы '
                 f'({data.get("drivers_all",0)} всего, '
                 f'показано {len(drivers)})</h2>')
    if not drivers:
        parts.append('<p class="legend">Нет данных</p>')
    else:
        parts.append('<table><tr><th>Издатель</th><th>Класс</th>'
                     '<th>Версия</th><th>Дата</th></tr>')
        for d in drivers:
            parts.append(
                f'<tr><td>{esc(d.get("provider","?"))[:50]}</td>'
                f'<td>{esc(d.get("class","—"))[:30]}</td>'
                f'<td class="v">{esc(d.get("version","—"))[:20]}</td>'
                f'<td class="v">{esc(d.get("date","—"))}</td></tr>')
        parts.append('</table>')
    parts.append('</div>')

    # ─── 13. Безопасность ───
    parts.append('<div class="card"><h2>🛡 Безопасность</h2>')
    score = sec.get("score", 0)
    parts.append(
        f'<div style="font-size:24px;font-weight:700;'
        f'color:{sec.get("color","#B0BEC5")};margin-bottom:8px">'
        f'{sec.get("icon","?")} {score}/100 — '
        f'{esc(sec.get("verdict","?"))}</div>')
    issues = sec.get("issues", [])
    if issues:
        parts.append('<ul>')
        for i in issues:
            parts.append(f'<li><span class="y">⚠</span> {esc(i)}</li>')
        parts.append('</ul>')
    else:
        parts.append('<p class="g">✅ Все проверки пройдены</p>')
    parts.append('</div>')

    parts.append('<div class="legend" style="text-align:center;'
                 'margin-top:20px">Отчёт сформирован программой Optix '
                 f'v{esc(APP_VERSION)}</div>')
    parts.append('</body></html>')
    return "".join(parts)


def open_inventory_report():
    """Открывает окно сбора и генерирует HTML-инвентаризацию."""
    if not _diag_ensure_dir():
        messagebox.showerror("Ошибка",
                              "Не удалось создать папку diagnostics_reports.")
        return

    dlg = ctk.CTkToplevel(app)
    dlg.title("📊 Инвентаризация системы")
    dlg.geometry("520x260")
    dlg.configure(fg_color="#0A1A30")
    dlg.transient(app)
    dlg.grab_set()

    ctk.CTkLabel(dlg, text="📊  Инвентаризация системы",
                 font=("Inter", 18, "bold"),
                 text_color="#ffffff", fg_color="#1565C0",
                 corner_radius=14, height=40).pack(
        pady=(16, 8), padx=20, ipadx=20)
    ctk.CTkLabel(dlg,
                 text="Сбор: железо, программы, службы, автозапуск, "
                      "пользователи, драйверы, безопасность.\n"
                      "Занимает 30–90 секунд. После завершения отчёт "
                      "откроется в браузере.",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 12))

    progress = ctk.CTkProgressBar(dlg, height=14,
                                    progress_color="#1976D2")
    progress.pack(pady=(4, 8), padx=30, fill="x")
    progress.configure(mode="indeterminate")
    progress.start()

    status_lbl = ctk.CTkLabel(dlg, text="Запуск...",
                              font=("Inter", 13, "bold"),
                              text_color="#4FC3F7",
                              fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 6), padx=30, fill="x")

    def worker():
        def progress_cb(msg):
            try:
                app.after(0, lambda m=msg: status_lbl.configure(
                    text=f"⏳ {m}", text_color="#FFD54F"))
            except Exception:
                pass

        try:
            data = _inv_collect_all(progress_cb)
        except Exception as e:
            log_error("open_inventory_report.collect", e)
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", f"Сбой сбора данных:\n{e}"))
            app.after(0, dlg.destroy)
            return

        try:
            html = _inv_build_html(data)
        except Exception as e:
            log_error("open_inventory_report.build_html", e)
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", f"Сбой генерации HTML:\n{e}"))
            app.after(0, dlg.destroy)
            return

        ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        path = os.path.join(DIAG_REPORTS_DIR,
                             f"Optix_Inventory_{ts}.html")
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(html)
        except Exception as e:
            log_error("open_inventory_report.save", e)
            app.after(0, lambda: messagebox.showerror(
                "Ошибка", f"Не удалось сохранить HTML:\n{e}"))
            app.after(0, dlg.destroy)
            return

        def finish():
            try:
                progress.stop()
                status_lbl.configure(text="✅ Готово",
                                     text_color="#7CFC7C")
            except Exception:
                pass
            app.after(0, dlg.destroy)
            app.after(100, lambda: os.startfile(path))

        app.after(0, finish)

    threading.Thread(target=worker, daemon=True).start()


# ================== СРАВНЕНИЕ ОТЧЁТОВ (DIFF) ==================
def _diff_lists(a_list, b_list, key_fn, change_keys=None):
    """
    Сравнивает два списка dict.
    Возвращает (added, removed, changed).
    added/removed — списки dict из b/a.
    changed — список dict: {"key", "old", "new", "diffs": {field: (old,new)}}.
    """
    a_map = {}
    for x in (a_list or []):
        try:
            k = key_fn(x)
        except Exception:
            k = None
        if k:
            a_map[k] = x
    b_map = {}
    for x in (b_list or []):
        try:
            k = key_fn(x)
        except Exception:
            k = None
        if k:
            b_map[k] = x

    added = [b_map[k] for k in b_map if k not in a_map]
    removed = [a_map[k] for k in a_map if k not in b_map]
    changed = []
    if change_keys:
        for k in a_map:
            if k not in b_map:
                continue
            diffs = {}
            for ck in change_keys:
                av = a_map[k].get(ck)
                bv = b_map[k].get(ck)
                if av != bv:
                    diffs[ck] = (av, bv)
            if diffs:
                changed.append({
                    "key": k,
                    "old": a_map[k],
                    "new": b_map[k],
                    "diffs": diffs,
                })
    return added, removed, changed


def _diff_load_json(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f), None
    except Exception as e:
        return None, str(e)


def _diff_fmt_val(v):
    """Короткое представление значения для отображения."""
    if v is None or v == "":
        return "—"
    if isinstance(v, bool):
        return "да" if v else "нет"
    if isinstance(v, int) and v > 100 * 1024 * 1024:
        return human_size(v)
    s = str(v)
    return s if len(s) <= 80 else s[:77] + "..."


def _diff_render_section(parent, title, items, kind, formatter, icon, color):
    """Рендерит одну секцию (➕/➖/🔄) внутри scrollable-фрейма."""
    ctk.CTkLabel(parent, text=f"{icon}  {title} ({len(items)})",
                 font=("Inter", 13, "bold"),
                 text_color=color, anchor="w").pack(
        fill="x", padx=6, pady=(10, 4))
    if not items:
        ctk.CTkLabel(parent, text="   (пусто)",
                     font=("Inter", 11),
                     text_color="#90A4AE", anchor="w").pack(
            fill="x", padx=14, pady=2)
        return
    for it in items[:500]:
        try:
            txt = formatter(it, kind)
        except Exception:
            txt = str(it)
        row = ctk.CTkFrame(parent, fg_color="#0D1B33",
                            corner_radius=6)
        row.pack(fill="x", padx=6, pady=1)
        ctk.CTkLabel(row, text=txt, font=("Consolas", 12),
                     text_color="#e0e8f5", anchor="w",
                     justify="left", wraplength=1050).pack(
            fill="x", padx=10, pady=4)
    if len(items) > 500:
        ctk.CTkLabel(parent, text=f"   ... и ещё {len(items) - 500}",
                     font=("Inter", 11),
                     text_color="#90A4AE", anchor="w").pack(
            fill="x", padx=14, pady=2)


def open_report_diff_window():
    """Окно сравнения двух JSON-отчётов."""
