    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)

    head = ctk.CTkLabel(win, text="🌐  Активные сетевые подключения",
                        font=("Inter", 20, "bold"), text_color="#ffffff",
                        fg_color="#1565C0", corner_radius=14, height=44,
                        border_width=1, border_color="#4FC3F7")
    head.pack(pady=(16, 6), padx=20, ipadx=20)
    
    ctk.CTkLabel(win, text="Аналог TCPView. Какие процессы и куда подключаются. Обновление каждые 3 сек.",
