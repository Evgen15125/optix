def report_to_markdown(data):
    """Конвертирует данные отчёта в Markdown."""
    L = []
    L.append("# 📋 Паспорт ПК — Optix")
    L.append("")
    L.append(f"**Дата:** {data.get('generated', '?')}")
    L.append("")
    o = data.get("os", {})
    L.append("## 🖥 Система")
    L.append("")
    L.append("| Параметр | Значение |")
    L.append("|---|---|")
    L.append(f"| Компьютер | {o.get('computer_name', '?')} |")
    L.append(f"| Пользователь | {o.get('user', '?')} |")
    L.append(f"| ОС | {o.get('system', '?')} {o.get('release', '')} |")
    L.append(f"| Версия | {o.get('version', '?')} |")
    L.append(f"| Архитектура | {o.get('arch', '?')} |")
    L.append(f"| Аптайм | {data.get('uptime', '?')} |")
    L.append("")
    c = data.get("cpu", {})
    L.append("## ⚙ Процессор")
    L.append("")
    L.append(f"- **Модель:** {c.get('name', '?')}")
    L.append(f"- **Ядра:** {c.get('cores', 0)} физ. / "
             f"{c.get('threads', 0)} лог.")
    if c.get("freq"):
        L.append(f"- **Частота:** {c['freq']}")
    L.append("")
    ram = data.get("ram", {})
    L.append("## 🧠 ОЗУ")
    L.append("")
    L.append(f"- **Всего:** {human_size(ram.get('total', 0))}")
    L.append(f"- **Доступно:** {human_size(ram.get('available', 0))}")
    L.append(f"- **Занято:** {ram.get('used_percent', 0)}%")
    L.append("")
    L.append("## 💾 Диски")
    L.append("")
    L.append("| Том | Занято | Всего | % |")
    L.append("|---|---|---|---|")
    for d in data.get("disks", []):
        L.append(f"| {d.get('mount', '?')} "
                 f"| {human_size(d.get('used', 0))} "
                 f"| {human_size(d.get('total', 0))} "
                 f"| {d.get('percent', 0)}% |")
    L.append("")
    tweaks = data.get("tweaks_count", 0)
    if tweaks:
        L.append("## ⚡ Оптимизация")
        L.append("")
        L.append(f"- **Применено твиков:** {tweaks}")
        L.append("")

    # ─── 🛡 Безопасность ───
    sec = data.get("security")
    if sec:
        score = sec.get("score", 0)
        icon = sec.get("icon", "?")
        verdict = sec.get("verdict", "?")
        L.append("## 🛡 Безопасность системы")
        L.append("")
        L.append(f"**{icon} Security Score: {score}/100 — {verdict}**")
        L.append("")
        issues = sec.get("issues", [])
        if issues:
            L.append("Замечания:")
            L.append("")
            for i in issues:
                L.append(f"- ⚠ {i}")
            L.append("")
        else:
            L.append("✅ Все проверки пройдены")
            L.append("")

    # ─── 📥 Ожидающие обновления Windows ───
    upd = data.get("updates")
    if upd is not None:
        L.append("## 📥 Ожидающие обновления Windows")
        L.append("")
        err = data.get("updates_error")
        if err:
            L.append(f"⚠️ Не удалось получить список: {err}")
            L.append("")
        elif not upd:
            L.append("✅ Все обновления установлены — система актуальна")
            L.append("")
        else:
            total_size = sum(u.get("size", 0) or 0 for u in upd)
            L.append(f"**Найдено:** {len(upd)}  •  "
                     f"**Суммарный размер:** {human_size(total_size)}")
            L.append("")
            L.append("| Название | KB | Важность | Размер |")
            L.append("|---|---|---|---|")
            for u in upd[:50]:
                kb_txt = u.get("kb", "") or "—"
                sev = u.get("severity", "") or "—"
                sz = u.get("size", 0) or 0
                sz_txt = human_size(sz) if sz else "—"
                title = (u.get("title", "?")[:80]
                         .replace("|", "\\|"))
                L.append(f"| {title} | {kb_txt} | {sev} | {sz_txt} |")
            L.append("")
            if len(upd) > 50:
                L.append(f"*... и ещё {len(upd) - 50}*")
                L.append("")


    L.append("---")
    L.append("")
    L.append(f"*Отчёт сформирован программой Optix v{APP_VERSION}*")
    return "\n".join(L)


