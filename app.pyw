def load_clean_profiles():
    try:
        with open(PROFILES_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return {"custom": []}
        data.setdefault("custom", [])
        return data
    except FileNotFoundError:
        return {"custom": []}
    except Exception as e:
        log_error("load_clean_profiles: файл поврежден", e)
        try:
            bad_path = PROFILES_PATH + ".bad"
            shutil.copy2(PROFILES_PATH, bad_path)
            log_error("load_clean_profiles", Exception(f"Копия сохранена в {bad_path}"))
        except Exception:
            pass
        return {"custom": []}


def save_clean_profiles(data):
    try:
        with open(PROFILES_PATH, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        log_error("save_clean_profiles", e)
        return False


def get_all_clean_profiles():
    """Возвращает список: встроенные + пользовательские."""
    result = []
    for p in BUILTIN_CLEAN_PROFILES:
        item = dict(p)
        item["builtin"] = True
        result.append(item)
    for p in load_clean_profiles().get("custom", []):
        item = dict(p)
        item["builtin"] = False
        result.append(item)
    return result


def apply_clean_profile_to_ui(profile, silent=False):
    """Применяет профиль: ставит/снимает чекбоксы в разделе Очистка."""
    if not profile:
        return
    cats = set(profile.get("categories", []))
    total_selected = 0
    total_size = 0
    sizes = _clean_state.get("last_scan_sizes", {})

    for cat in CATEGORIES:
        info = rows.get(cat["name"])
        if not info:
            continue
        if cat["name"] in cats:
            info["check"].select()
            total_selected += 1
            sz = sizes.get(cat["name"], 0)
            if sz and sz > 0:
                total_size += sz
        else:
            info["check"].deselect()

    name = profile.get("name", "Свой профиль")
    _clean_state["current_profile"] = "custom"
    try:
        widgets["profile_label"].configure(
            text=f"Профиль: 💼 {name}   •   выбрано: {total_selected}"
                 + (f"   •   ~{human_size(total_size)}"
                    if total_size > 0 else ""),
            text_color="#7CFC7C")
    except Exception:
        pass

    if not silent:
        try:
            show_toast("Optix — профиль применён", name)
        except Exception:
            pass


