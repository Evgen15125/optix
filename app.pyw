            ctk.CTkLabel(top, text=f"🌐 TCP: {e['tcp']}  UDP: {e['udp']}  Всего: {e['total']}",
                         font=("Consolas", 11, "bold"), text_color="#4FC3F7", anchor="w").pack(side="left", padx=8)

            def mk_kill(p=e["pid"], n=e["name"]):
                def do():
                    if _netproc_kill(p, n): _refresh()
                return do

            ctk.CTkButton(top, text="🗑 Kill", width=80, height=26, font=("Inter", 11, "bold"),
                          fg_color="#B71C1C", hover_color="#E53935", corner_radius=13, command=mk_kill()
                          ).pack(side="right", padx=2)

            if is_expanded:
                inner = ctk.CTkFrame(row, fg_color="#0D1B33", corner_radius=8)
                inner.pack(fill="x", padx=12, pady=(4, 8))
                hdr = ctk.CTkFrame(inner, fg_color="transparent")
                hdr.pack(fill="x", padx=8, pady=(6, 2))
                for txt, w in [("Прот.", 50), ("Локальный", 220), ("Удалённый", 220), ("Состояние", 130)]:
                    ctk.CTkLabel(hdr, text=txt, font=("Inter", 10, "bold"), text_color="#82B1FF", width=w, anchor="w").pack(side="left", padx=4)
                for c in e["connections"][:200]:
                    cr = ctk.CTkFrame(inner, fg_color="transparent")
                    cr.pack(fill="x", padx=8, pady=1)
                    ctk.CTkLabel(cr, text=c["proto"], font=("Consolas", 10), text_color="#4FC3F7", width=50, anchor="w").pack(side="left", padx=4)
