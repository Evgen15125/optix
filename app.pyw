def _inv_get_mb_bios():
    """Возвращает {mb: ..., bios_vendor: ..., bios_version: ...}."""
    result = {"mb": "?", "bios_vendor": "?", "bios_version": "?",
              "bios_date": "?"}
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "$bb = Get-CimInstance -ClassName Win32_BaseBoard; "
        "$bios = Get-CimInstance -ClassName Win32_BIOS; "
        "[PSCustomObject]@{ "
        "  MbMfr = $bb.Manufacturer; "
        "  MbProd = $bb.Product; "
        "  BiosMfr = $bios.Manufacturer; "
        "  BiosVer = $bios.SMBIOSBIOSVersion; "
        "  BiosDate = $bios.ReleaseDate "
        "} | ConvertTo-Json -Compress"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return result
        d = json.loads(out)
        if isinstance(d, dict):
            mfr = str(d.get("MbMfr") or "").strip()
            prod = str(d.get("MbProd") or "").strip()
            if mfr or prod:
                result["mb"] = f"{mfr} {prod}".strip()
            result["bios_vendor"] = str(d.get("BiosMfr") or "?").strip()
            result["bios_version"] = str(d.get("BiosVer") or "?").strip()
            bd = d.get("BiosDate")
            if bd:
                try:
                    s = str(bd)
                    if s.startswith("/Date(") and s.endswith(")/"):
                        ms = int(s[6:-2])
                        if ms > 0:
                            result["bios_date"] = datetime.fromtimestamp(
                                ms / 1000).strftime("%Y-%m-%d")
                    else:
                        result["bios_date"] = s[:10]
                except Exception:
                    pass
    except Exception as e:
        log_error("_inv_get_mb_bios", e)
    return result


    try:
        import psutil
        addrs = psutil.net_if_addrs()
        stats = psutil.net_if_stats()
        AF_LINK = getattr(psutil, "AF_LINK", None)
        for nic in sorted(addrs.keys(), key=lambda x: x.lower()):
            ipv4, ipv6, mac = "", "", ""
            for a in addrs[nic]:
                fam = getattr(a, "family", None)
                try:
                    if fam == 2:  # AF_INET
                        ipv4 = a.address
                    elif fam == 23:  # AF_INET6
                        if not ipv6 and not a.address.startswith("fe80"):
                            ipv6 = a.address.split("%")[0]
                    elif fam == AF_LINK or (
                            mac == "" and a.address and
                            ("-" in a.address or ":" in a.address)
                            and not a.address.replace("-", "").replace(":", "").replace(".", "").isalnum() is False
                            and len(a.address.replace("-", "").replace(":", "")) == 12):
                        mac = a.address
                except Exception:
                    continue
            st = stats.get(nic)
            out.append({
                "name": nic,
                "ipv4": ipv4 or "—",
                "ipv6": ipv6 or "—",
                "mac": mac or "—",
                "up": bool(st.isup) if st else False,
                "speed": (st.speed if st and st.speed else 0),
            })
    except Exception as e:
        log_error("_inv_get_network_adapters", e)


def _inv_get_network_adapters():
    """Возвращает список сетевых адаптеров с IP/MAC/скоростью."""
    out = []
    try:
        import psutil
        addrs = psutil.net_if_addrs()
        stats = psutil.net_if_stats()
        AF_LINK = getattr(psutil, "AF_LINK", None)
        for nic in sorted(addrs.keys(), key=lambda x: x.lower()):
            ipv4, ipv6, mac = "", "", ""
            for a in addrs[nic]:
                fam = getattr(a, "family", None)
                try:
                    if fam == 2:  # AF_INET
                        ipv4 = a.address
                    elif fam == 23:  # AF_INET6
                        if not ipv6 and not a.address.startswith("fe80"):
                            ipv6 = a.address.split("%")[0]
                    elif AF_LINK is not None and fam == AF_LINK:
                        mac = a.address
                    elif mac == "" and a.address:
                        clean = (a.address.replace("-", "")
                                          .replace(":", "")
                                          .replace(".", ""))
                        if (len(clean) == 12
                                and "-" in a.address
                                and all(c in "0123456789abcdefABCDEF"
                                        for c in clean)):
                            mac = a.address
                except Exception:
                    continue
            st = stats.get(nic)
            out.append({
                "name": nic,
                "ipv4": ipv4 or "—",
                "ipv6": ipv6 or "—",
                "mac": mac or "—",
                "up": bool(st.isup) if st else False,
                "speed": (st.speed if st and st.speed else 0),
            })
    except Exception as e:
        log_error("_inv_get_network_adapters", e)
    return out


def _inv_get_local_users():
    """Список локальных пользователей (только имя и enabled)."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "$ErrorActionPreference='SilentlyContinue';"
        "Get-LocalUser | Select-Object Name,Enabled,"
        "PasswordRequired,LastLogon | ConvertTo-Json -Compress"
    )
    users = []
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=30,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if out and out != "null":
            data = json.loads(out)
            if isinstance(data, dict):
                data = [data]
            for u in data:
                if not isinstance(u, dict):
                    continue
                ll = u.get("LastLogon")
                ll_str = "—"
                if ll:
                    try:
                        s = str(ll)
                        if s.startswith("/Date(") and s.endswith(")/"):
                            ms = int(s[6:-2])
                            if ms > 0:
                                ll_str = datetime.fromtimestamp(
                                    ms / 1000).strftime("%Y-%m-%d %H:%M")
                        else:
                            ll_str = s[:16]
                    except Exception:
                        pass
                users.append({
                    "name": str(u.get("Name") or "?"),
                    "enabled": bool(u.get("Enabled")),
                    "password_required": bool(u.get("PasswordRequired")),
                    "last_logon": ll_str,
                })
    except Exception as e:
        log_error("_inv_get_local_users", e)
    return users


def _inv_security_summary():
    """Краткая сводка безопасности (0–100 score)."""
    score = 100
    issues = []
    # UAC
    try:
        uac = _sec_check_uac()
        if not uac.get("ok"):
            score -= 20
            issues.append("UAC отключён или ослаблен")
    except Exception:
        pass
    # Defender
    try:
        d = _sec_check_defender()
        if d.get("available"):
            if not d.get("antivirus_enabled"):
                score -= 20
                issues.append("Defender: антивирус выключен")
            elif not d.get("real_time"):
                score -= 15
                issues.append("Defender: реальное время выключено")
    except Exception:
        pass
    # Firewall
    try:
        fw = _sec_check_firewall()
        bad_fw = [p["name"] for p in fw if not p["enabled"]]
        if bad_fw:
            score -= 15
            issues.append(f"Брандмауэр выключен: {', '.join(bad_fw)}")
    except Exception:
        pass
    # Пустые пароли
    try:
        no_pass = _sec_check_empty_passwords()
        if no_pass:
            score -= 10
            issues.append(f"Пользователи без пароля: {len(no_pass)}")
    except Exception:
        pass
    # Автовход
    try:
        al = _sec_check_autologon()
        if al.get("enabled"):
            score -= 5
            issues.append(f"Автовход включён: {al.get('user','?')}")
    except Exception:
        pass
    score = max(0, min(100, score))
    if score >= 90:
        icon, color, verdict = "✅", "#7CFC7C", "Отлично"
    elif score >= 70:
        icon, color, verdict = "🟢", "#7CFC7C", "Хорошо"
    elif score >= 50:
        icon, color, verdict = "🟡", "#FFD54F", "Средне"
    else:
        icon, color, verdict = "🔴", "#FF8A8A", "Плохо"
    return {"score": score, "issues": issues,
            "icon": icon, "color": color, "verdict": verdict}


def _inv_collect_all(progress_cb=None):
    """Собирает все данные для инвентаризации."""
    def _p(msg):
        if progress_cb:
            try:
                progress_cb(msg)
            except Exception:
                pass

    result = {}
    _p("Сбор базовой информации...")
    try:
        result["base"] = collect_full_report()
    except Exception as e:
        log_error("_inv_collect_all.base", e)
        result["base"] = {"generated": datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"), "os": {}, "cpu": {}, "ram": {},
            "disks": [], "uptime": "?"}

    _p("Чтение планок ОЗУ...")
    result["ram_sticks"] = _inv_get_ram_sticks()

    _p("Чтение мат. платы и BIOS...")
    result["mb_bios"] = _inv_get_mb_bios()

    _p("Чтение видеокарт...")
    try:
        result["gpus"] = _get_gpu_info()
    except Exception:
        result["gpus"] = []

    _p("Чтение сетевых адаптеров...")
    result["nics"] = _inv_get_network_adapters()

    _p("Чтение списка программ...")
    try:
        progs = load_installed_programs()
        progs.sort(key=lambda x: (x.get("name") or "").lower())
        result["programs"] = progs[:100]
        result["programs_total"] = len(progs)
    except Exception:
        result["programs"] = []
        result["programs_total"] = 0

    _p("Чтение служб...")
    try:
        services = get_services_list()
        third = [s for s in services
                 if not s.get("protected")
                 and "microsoft" not in (s.get("username", "") or "").lower()
                 and "auto" in str(s.get("start_type", "")).lower()]
        result["services"] = third[:100]
        result["services_all"] = len(services)
        result["services_third_auto"] = len(third)
    except Exception:
        result["services"] = []
        result["services_all"] = 0
        result["services_third_auto"] = 0

    _p("Чтение автозапуска...")
    try:
        items, _ = get_autostart_items()
        result["autostart"] = items[:150]
        result["autostart_all"] = len(items)
    except Exception:
        result["autostart"] = []
        result["autostart_all"] = 0

    _p("Чтение пользователей...")
    result["users"] = _inv_get_local_users()
    try:
        result["admins"] = _sec_check_admins()
    except Exception:
        result["admins"] = []

    _p("Чтение драйверов...")
    try:
        drivers = _drivers_list_installed()
        result["drivers"] = drivers[:80]
        result["drivers_all"] = len(drivers)
    except Exception:
        result["drivers"] = []
        result["drivers_all"] = 0

    _p("Оценка безопасности...")
    result["security"] = _inv_security_summary()

    return result


