def get_services_list():
    import psutil
    result = []
    try:
        for svc in psutil.win_service_iter():
            try:
                info = svc.as_dict()
                name = info.get("name", "")
                display = info.get("display_name", "") or name
                rec_icon, rec_text, safe = get_service_recommendation(name, display)

                deps = []
                try:
                    if hasattr(svc, "dependencies"):
                        deps = svc.dependencies() or []
                except Exception:
                    pass

                result.append({
                    "name": name,
                    "display_name": display,
                    "status": info.get("status", ""),
                    "start_type": info.get("start_type", ""),
                    "username": info.get("username", ""),
                    "dependencies": deps,
                    "impact_icon": rec_icon,
                    "impact_text": rec_text,
                    "can_disable": safe,
                    "protected": name in PROTECTED_SERVICES,
                })
            except Exception:
                continue
    except Exception:
        return []
    result.sort(key=lambda x: (x["protected"], x["display_name"].lower()))
    return result


def service_action(name, action):
    try:
        cmds = {
            "start": ["sc", "start", name],
            "stop": ["sc", "stop", name],
            "auto": ["sc", "config", name, "start=", "auto"],
            "delayed": ["sc", "config", name, "start=", "delayed-auto"],
            "manual": ["sc", "config", name, "start=", "demand"],
            "disable": ["sc", "config", name, "start=", "disabled"],
        }
        if action in cmds:
            subprocess.run(cmds[action], capture_output=True, text=True,
                           timeout=20, creationflags=CREATE_NO_WINDOW)
    except Exception as e:
        log_error(f"service_action({name}, {action})", e)


def get_status_icon(status):
    s = str(status).lower()
    if s == "running":
        return "🟢", "#7CFC7C"
    if s == "stopped":
        return "🔴", "#FF8A8A"
    return "⚪", "#B0BEC5"


def get_start_type_label(st):
    s = str(st).lower()
    if "delayed" in s:
        return "Авто (отложенно)"
    if "auto" in s:
        return "Авто"
    if "manual" in s:
        return "Вручную"
    if "disabled" in s:
        return "Отключена"
    return st or "?"


def refresh_services_ui():
    for m in services_ui.get("_menus", []):
        try: m.destroy()
        except Exception: pass
    services_ui["_menus"] = []

    query = services_ui["search"].get().strip().lower()
    filter_type = services_ui["filter"].get()
    tab = services_ui.get("tab", "all")

    filtered = []
    for s in services_all:
        st = str(s["status"]).lower()
        st_type = str(s["start_type"]).lower()

        if tab == "auto":
            if "auto" not in st_type: continue
        elif tab == "third_party":
            if s["protected"] or "microsoft" in (s.get("username", "") or "").lower(): continue

        if filter_type == "Работающие" and st != "running": continue
        if filter_type == "Остановленные" and st != "stopped": continue
        if filter_type == "Рекомендуемые к отключению" and not s.get("can_disable", False): continue

        if query and query not in s["name"].lower() and query not in s["display_name"].lower(): continue
        filtered.append(s)

    filtered.sort(key=lambda x: (x["protected"], not x.get("can_disable", False), x["display_name"].lower()))
    services_ui["filtered_cache"] = filtered
    shown = services_ui.get("shown_count", SERVICES_PAGE_SIZE)

    for w in services_ui["list_frame"].winfo_children():
        w.destroy()
    if not filtered:
        ctk.CTkLabel(services_ui["list_frame"], text="Службы не найдены",
                     font=("Inter", 14), text_color="#90A4AE").pack(pady=30)
        return

    to_show = filtered[:shown]
    for s in to_show:
        icon, color = get_status_icon(s["status"])
        protected = s["protected"]
        safe_off = s.get("can_disable", False)

        if protected: default_bg = "#2A1F33"
        elif safe_off: default_bg = "#1F332A"
        else: default_bg = "#1F2E4A"
            
        row = ctk.CTkFrame(services_ui["list_frame"], fg_color=default_bg,
                           corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=2)

        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E")
            except Exception: pass

        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                try:
                    x, y = r.winfo_pointerxy()
                    rx, ry = r.winfo_rootx(), r.winfo_rooty()
                    rw, rh = r.winfo_width(), r.winfo_height()
                    if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                        r.configure(fg_color=bg)
                except Exception: pass
            r.after(20, check_later)

        def bind_hover(widget):
            if isinstance(widget, ctk.CTkButton): return
            try:
                widget.bind("<Enter>", on_enter, add="+")
                widget.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_canvas"):
                    widget._canvas.bind("<Enter>", on_enter, add="+")
                    widget._canvas.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_label"):
                    widget._label.bind("<Enter>", on_enter, add="+")
                    widget._label.bind("<Leave>", on_leave, add="+")
            except Exception: pass
            for child in widget.winfo_children():
                bind_hover(child)

        bind_hover(row)

        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=(12, 12), pady=(8, 2))
        
        ctk.CTkLabel(top, text=icon, font=("Inter", 13), text_color=color, width=24).pack(side="left")
        ctk.CTkLabel(top, text=s["impact_icon"], font=("Inter", 12), width=24).pack(side="left", padx=(2, 4))
        
        name_text = s["display_name"] or s["name"]
        if protected: name_text = "🔒 " + name_text
            
        ctk.CTkLabel(top, text=name_text[:60], font=("Inter", 13, "bold"),
                     text_color="#E0C0FF" if protected else "#ffffff",
                     anchor="w").pack(side="left", padx=4, fill="x", expand=True)
                     
        ctk.CTkLabel(top, text=s["impact_text"], font=("Inter", 11, "bold"),
                     text_color="#7CFC7C" if safe_off else "#FFD54F"
                     if s["impact_icon"] == "🟡" else "#FF8A8A").pack(side="right")

        meta = ctk.CTkFrame(row, fg_color="transparent")
        meta.pack(fill="x", padx=(14, 12), pady=(0, 4))
        
        ctk.CTkLabel(meta, text=s["name"], font=("Consolas", 10),
                     text_color="#90CAF9", anchor="w").pack(side="left", padx=(0, 10))
        ctk.CTkLabel(meta, text=f"▶ {get_start_type_label(s['start_type'])}",
                     font=("Inter", 10), text_color="#B0BEC5").pack(side="left", padx=4)
        if s.get("dependencies"):
            ctk.CTkLabel(meta, text=f"📦 {len(s['dependencies'])} завис.",
                         font=("Inter", 10), text_color="#B0BEC5").pack(side="left", padx=4)

        btns = ctk.CTkFrame(row, fg_color="transparent")
        btns.pack(fill="x", padx=12, pady=(4, 10))

        if protected:
            ctk.CTkLabel(btns, text="🔒 защищена (критичная для системы)",
                         font=("Inter", 11, "bold"),
                         text_color="#E0C0FF").pack(side="left", padx=4)
        else:
            svc_name = s["name"]
            is_running = str(s["status"]).lower() == "running"

            def make_cmd(n, action):
                def do():
                    def worker():
                        service_action(n, action)
                        app.after(800, refresh_services_ui)
                    threading.Thread(target=worker, daemon=True).start()
                return do

            if is_running:
                ctk.CTkButton(btns, text="⏹ Стоп", width=80, height=28,
                              font=("Inter", 11, "bold"), fg_color="#C62828",
                              hover_color="#E53935", corner_radius=14,
                              command=make_cmd(svc_name, "stop")).pack(side="left", padx=(0, 4))
            else:
                ctk.CTkButton(btns, text="▶ Пуск", width=80, height=28,
                              font=("Inter", 11, "bold"), fg_color="#2E7D32",
                              hover_color="#43A047", corner_radius=14,
                              command=make_cmd(svc_name, "start")).pack(side="left", padx=(0, 4))

            ctk.CTkButton(btns, text="⚙ Авто", width=70, height=28,
                          font=("Inter", 11, "bold"), fg_color="#1F2E4A",
                          hover_color="#2E5A8E", corner_radius=14,
                          command=make_cmd(svc_name, "auto")).pack(side="left", padx=4)
            ctk.CTkButton(btns, text="⏱ Отложенно", width=100, height=28,
                          font=("Inter", 11, "bold"), fg_color="#1F2E4A",
                          hover_color="#2E5A8E", corner_radius=14,
                          command=make_cmd(svc_name, "delayed")).pack(side="left", padx=4)
            ctk.CTkButton(btns, text="⊕ Вручную", width=90, height=28,
                          font=("Inter", 11, "bold"), fg_color="#1F2E4A",
                          hover_color="#2E5A8E", corner_radius=14,
                          command=make_cmd(svc_name, "manual")).pack(side="left", padx=4)
            ctk.CTkButton(btns, text="🔒 Откл.", width=80, height=28,
                          font=("Inter", 11, "bold"), fg_color="#6A1B4D",
                          hover_color="#8E24AA", corner_radius=14,
                          command=make_cmd(svc_name, "disable")).pack(side="left", padx=4)

    remaining = len(filtered) - shown
    if remaining > 0:
        ctk.CTkButton(services_ui["list_frame"],
                      text=f"⬇  Показать ещё ({remaining})",
                      height=40, font=("Inter", 14, "bold"),
                      fg_color="#1F2E4A", hover_color="#2E5A8E",
                      corner_radius=20,
                      command=lambda: (services_ui.update(
                          {"shown_count": services_ui.get("shown_count", SERVICES_PAGE_SIZE) + SERVICES_PAGE_SIZE}),
                          refresh_services_ui())
                      ).pack(pady=12, padx=20, fill="x")


