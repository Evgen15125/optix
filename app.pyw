                              text_color="#FFD54F", fg_color="#131E32",
                              corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    ctrl = ctk.CTkFrame(win, fg_color="transparent")
    ctrl.pack(pady=(0, 6), padx=20, fill="x")
    search_var = ctk.StringVar()
    search_entry = ctk.CTkEntry(ctrl, placeholder_text="🔍 Поиск по имени / классу / ID...",
                                 height=36, font=("Inter", 12), fg_color="#1F2E4A",
                                 text_color="#ffffff", corner_radius=10, textvariable=search_var)
    search_entry.pack(side="left", fill="x", expand=True, padx=(0, 8))
    
    filter_var = ctk.StringVar(value="Все")
    filter_menu = ctk.CTkOptionMenu(ctrl, values=["Все", "⚠️ С проблемами", "Только ОК", "Без драйвера"],
                                     variable=filter_var, width=180, height=36,
                                     fg_color="#1F2E4A", button_color="#1976D2", font=("Inter", 12))
    filter_menu.pack(side="left")

    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    wrap.pack(padx=20, pady=(0, 8), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0,
                                 scrollbar_button_color="#243A5E", scrollbar_button_hover_color="#4FC3F7")
    lst.pack(fill="both", expand=True, padx=4, pady=4)

    state = {"devices": []}

    def render():
        for w in lst.winfo_children(): w.destroy()
        q = search_var.get().strip().lower()
        f = filter_var.get()
        shown = 0
        problems = 0
        
        for d in state["devices"]:
            if q:
                hay = (d["name"] + " " + d["class"] + " " + d["device_id"] + " " + d["manufacturer"]).lower()
                if q not in hay: continue
            has_problem = bool(d.get("problem")) and d["problem"] not in (0, "0", None)
            
            if f == "⚠️ С проблемами" and not has_problem: continue
            if f == "Только ОК" and has_problem: continue
            if f == "Без драйвера":
                if has_problem and d.get("problem") in (28, "28"): pass
                else: continue
                
            shown += 1
            if has_problem: problems += 1

            cls = d.get("class", "")
            icon = _DEVICE_CLASS_ICONS.get(cls, "🔧")

            if has_problem: bg = "#3A1F1F"
            elif d["status"].lower() == "ok": bg = "#1F2E4A"
            else: bg = "#2A2F3A"

            row = ctk.CTkFrame(lst, fg_color=bg, corner_radius=8)
            row.pack(fill="x", pady=2, padx=2)

            top = ctk.CTkFrame(row, fg_color="transparent")
            top.pack(fill="x", padx=(10, 10), pady=(8, 2))

            ctk.CTkLabel(top, text=icon, font=("Inter", 14), width=24).pack(side="left")
            st_icon = "🟢" if d["status"].lower() == "ok" else ("🔴" if has_problem else "⚪")
            ctk.CTkLabel(top, text=st_icon, font=("Inter", 11), width=20).pack(side="left", padx=(2, 4))

            ctk.CTkLabel(top, text=d["name"][:60], font=("Inter", 13, "bold"), text_color="#ffffff", anchor="w", width=380).pack(side="left", padx=4)
            ctk.CTkLabel(top, text=(d.get("manufacturer") or "—")[:26], font=("Inter", 11), text_color="#90CAF9", anchor="w", width=200).pack(side="left", padx=4)
            ctk.CTkLabel(top, text=(cls or "—")[:18], font=("Inter", 11), text_color="#B0BEC5", anchor="w", width=140).pack(side="left", padx=4)
            ver = d.get("driver_version") or "—"
            ctk.CTkLabel(top, text=ver[:14], font=("Consolas", 11), text_color="#ffffff", anchor="w", width=130).pack(side="left", padx=4)

            if has_problem:
                pcode = d.get("problem")
                try: code_int = int(pcode)
                except Exception: code_int = None
                if code_int in _DEVICE_ERROR_CODES:
                    code_name, code_desc = _DEVICE_ERROR_CODES[code_int]
                else:
                    code_name = f"Code {pcode}"
                    code_desc = d.get("problem_desc", "")[:40]
                ctk.CTkLabel(top, text=f"⚠️ {code_name}", font=("Inter", 10, "bold"), text_color="#FF8A8A", anchor="e", width=120).pack(side="right", padx=4)

            btns = ctk.CTkFrame(row, fg_color="transparent")
            btns.pack(fill="x", padx=10, pady=(0, 8))

            def mk_details(iid=d["instance_id"], nm=d["name"]):
                return lambda: _pnp_get_details(iid, nm)
            ctk.CTkButton(btns, text="ℹ️ Детали", width=100, height=28, font=("Inter", 11, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=mk_details()).pack(side="left", padx=(0, 4))

            is_enabled = d["status"].lower() == "ok"
            if is_enabled:
                def mk_dis(iid=d["instance_id"], nm=d["name"]):
                    def do():
                        if not messagebox.askyesno("Отключить устройство?", f"Отключить «{nm}»?\n\nУстройство перестанет работать до повторного включения."): return
                        ok, err = _pnp_disable(iid)
                        if ok:
                            messagebox.showinfo("Готово", "Устройство отключено.")
                            threading.Thread(target=lambda: app.after(0, worker), daemon=True).start()
                        else:
                            messagebox.showerror("Ошибка", err)
                    return do
                ctk.CTkButton(btns, text="⏹ Отключить", width=110, height=28, font=("Inter", 11, "bold"), fg_color="#C62828", hover_color="#E53935", corner_radius=14, command=mk_dis()).pack(side="left", padx=4)
            else:
                def mk_en(iid=d["instance_id"]):
                    def do():
                        ok, err = _pnp_enable(iid)
                        if ok:
                            messagebox.showinfo("Готово", "Устройство включено.")
                            threading.Thread(target=lambda: app.after(0, worker), daemon=True).start()
                        else:
                            messagebox.showerror("Ошибка", err)
                    return do
                ctk.CTkButton(btns, text="▶ Включить", width=110, height=28, font=("Inter", 11, "bold"), fg_color="#2E7D32", hover_color="#43A047", corner_radius=14, command=mk_en()).pack(side="left", padx=4)

            def mk_rollback(iid=d["instance_id"], nm=d["name"]):
                return lambda: _pnp_rollback(iid, nm)
            ctk.CTkButton(btns, text="🔄 Откатить драйвер", width=150, height=28, font=("Inter", 11, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=14, command=mk_rollback()).pack(side="left", padx=4)

            ctk.CTkLabel(row, text=d["instance_id"], font=("Consolas", 8), text_color="#90A4AE", anchor="w").pack(fill="x", padx=(14, 10), pady=(0, 5))

        status_lbl.configure(
            text=f"Устройств: {len(state['devices'])}   •   Показано: {shown}   •   ⚠️ С проблемами: {problems}",
            text_color="#FF8A8A" if problems > 0 else "#7CFC7C")

    def worker():
        devices = _pnp_list_devices()
        devices.sort(key=lambda d: (not d.get("problem") or d["problem"] in (0, "0", None), d.get("class", ""), d.get("name", "").lower()))
        state["devices"] = devices
        try: _driver_history_add_snapshot(devices)
        except Exception: pass
        app.after(0, render)

    search_entry.bind("<KeyRelease>", lambda e: render())
    filter_menu.configure(command=lambda v: render())

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=40, font=("Inter", 12, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=20, command=lambda: threading.Thread(target=worker, daemon=True).start()).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="📜 История", height=40, font=("Inter", 12, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=20, command=_driver_history_show).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="📄 Экспорт CSV", height=40, font=("Inter", 12, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=20, command=lambda: _pnp_export_csv(state["devices"])).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40, font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A", corner_radius=20, command=win.destroy).pack(side="left", padx=(4, 0), fill="x", expand=True)

    threading.Thread(target=worker, daemon=True).start()


# ================== РАСШИРЕННЫЙ ПОИСК ДРАЙВЕРОВ В ИНТЕРНЕТЕ ==================

# ─── Поиск через WUA (Windows Update Agent) ───

def _wua_search_drivers_extended(hardware_id=None, include_optional=True,
                                  progress_cb=None):
    """
    Расширенный поиск драйверов через WUA API.
    Если hardware_id задан — фильтрует по нему.
    include_optional — искать ли опциональные (BrowseOnly) драйверы.
    """
    import pythoncom
    pythoncom.CoInitialize()
    try:
        wua = win32com.client.Dispatch("Microsoft.Update.Session")
        searcher = wua.CreateUpdateSearcher()
        # Пробуем Microsoft Update (ssOthers + ServiceID).
        # Если не подключён — fallback на ssDefault.
        _use_ms_update = False
        try:
            searcher.ServerSelection = 3  # ssOthers
            searcher.ServiceID = "7971f918-a847-4430-9279-4a52d1efe18d"
            # Проверяем, что сервер доступен, коротким поиском
            _test = searcher.Search("IsInstalled=0 AND Type='Driver'")
            _use_ms_update = True
        except Exception:
            _use_ms_update = False
        if not _use_ms_update:
            # Fallback: стандартный Windows Update
            try:
                searcher = wua.CreateUpdateSearcher()
                searcher.ServerSelection = 2  # ssDefault
            except Exception as e:
                log_error("_wua_search_fallback", e)

        # Базовый поиск
        criteria = "IsInstalled=0 AND IsHidden=0 AND Type='Driver'"
        if progress_cb:
            progress_cb("Поиск драйверов через Windows Update...")
        result = searcher.Search(criteria)

        drivers = []
        for u in result.Updates:
            try:
                # Проверяем, является ли драйвером
                is_driver = False
                try:
                    drv = u.DriverModel
                    if drv:
                        is_driver = True
                except Exception:
                    pass
                if not is_driver:
                    continue

                # Фильтр по Hardware ID
                hw_id = ""
                try:
                    hw_id = u.DriverHardwareID or ""
                except Exception:
                    pass
                if hardware_id:
                    if hardware_id.lower() not in hw_id.lower():
                        # Проверяем также DriverModel
                        try:
                            model = u.DriverModel or ""
                            if hardware_id.lower() not in model.lower():
                                continue
                        except Exception:
                            continue

                title = u.Title or "?"
                driver_model = ""
                driver_class = ""
                driver_mfr = ""
                driver_ver = ""
                try:
                    driver_model = u.DriverModel or ""
                except Exception:
                    pass
                try:
                    driver_class = u.DriverClass or ""
                except Exception:
                    pass
                try:
                    driver_mfr = u.DriverManufacturer or ""
                except Exception:
                    pass
                try:
                    driver_ver = u.DriverVerDate or ""
                except Exception:
                    pass

                size = 0
                try:
                    size = int(u.MaxDownloadSize or 0)
                except Exception:
                    pass

                # Опциональные (BrowseOnly)
                is_optional = False
                try:
                    if u.BrowseOnly:
                        is_optional = True
                except Exception:
                    pass

                if not include_optional and is_optional:
                    continue

                # Скачиваемый URL
                download_url = ""
                try:
                    download_url = u.DownloadUrl or ""
                except Exception:
                    pass

                drivers.append({
                    "title": title,
                    "model": driver_model,
                    "class": driver_class,
                    "manufacturer": driver_mfr,
                    "version_date": driver_ver,
                    "hardware_id": hw_id,
                    "size_bytes": size,
                    "optional": is_optional,
                    "download_url": download_url,
                    "kb": ", ".join(u.KBArticleIDs or []),
                    "source": "wua",
                })
            except Exception as e:
                log_error("_wua_search_drivers_extended_item", e)
                continue

        if progress_cb:
            progress_cb(f"Найдено драйверов: {len(drivers)}")
        return drivers
    except Exception as e:
        log_error("_wua_search_drivers_extended", e)
        return []
    finally:
        try:
            pythoncom.CoUninitialize()
        except Exception:
            pass


# ─── Поиск в Microsoft Update Catalog ───

_MSUC_SEARCH_URL = "https://www.catalog.update.microsoft.com/Search.aspx"


def _msuc_search_web(query, progress_cb=None):
    """
    Поиск в Microsoft Update Catalog.
    Возвращает список найденных обновлений.
    """
    import urllib.parse
    import urllib.request
    import ssl

    if progress_cb:
        progress_cb(f"Поиск в каталоге Microsoft: {query[:60]}")

    params = urllib.parse.urlencode({"q": query})
    url = f"{_MSUC_SEARCH_URL}?{params}"

    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                          "AppleWebKit/537.36 (KHTML, like Gecko) "
                          "Chrome/120.0.0.0 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;"
                      "q=0.9,*/*;q=0.8",
            "Accept-Language": "ru-RU,ru;q=0.9,en;q=0.8",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
            html = resp.read().decode("utf-8", errors="replace")
    except Exception as e:
        log_error("_msuc_search_web", e)
        return []

    # Парсим HTML вручную (без BeautifulSoup)
    results = []

    # Ищем строки таблицы: <tr id="..." ...> ... </tr>
    row_pattern = re.compile(
        r'<tr[^>]*id="([a-f0-9\-]{36})"[^>]*>(.*?)</tr>',
        re.DOTALL | re.IGNORECASE
    )

    for match in row_pattern.finditer(html):
        guid = match.group(1)
        row_html = match.group(2)

        # Извлекаем td-шки
        tds = re.findall(r'<td[^>]*>(.*?)</td>', row_html,
                          re.DOTALL | re.IGNORECASE)

        def clean(s):
            s = re.sub(r"<[^>]+>", "", s or "")
            s = (s.replace("&amp;", "&").replace("&lt;", "<")
                   .replace("&gt;", ">").replace("&quot;", '"')
                   .replace("&nbsp;", " ").replace("&#39;", "'"))
            return " ".join(s.split()).strip()

        if len(tds) < 7:
            continue

        title = clean(tds[0])
        if not title:
            continue
        # Пропускаем заголовок таблицы
        if title.lower() in ("title", "заголовок", "update title"):
            continue

        product = clean(tds[1]) if len(tds) > 1 else ""
        classification = clean(tds[2]) if len(tds) > 2 else ""
        last_updated = clean(tds[3]) if len(tds) > 3 else ""
        version = clean(tds[4]) if len(tds) > 4 else ""
        size_str = clean(tds[5]) if len(tds) > 5 else ""
        size_bytes = 0
        # Парсим размер: "1.2 MB", "523 KB", "12.3 GB"
        m = re.search(r"([\d.,]+)\s*(KB|MB|GB|МБ|КБ|ГБ)",
                       size_str, re.IGNORECASE)
        if m:
            try:
                num = float(m.group(1).replace(",", "."))
                unit = m.group(2).upper()
                if unit in ("KB", "КБ"):
                    size_bytes = int(num * 1024)
                elif unit in ("MB", "МБ"):
                    size_bytes = int(num * 1024 * 1024)
                elif unit in ("GB", "ГБ"):
                    size_bytes = int(num * 1024 * 1024 * 1024)
            except Exception:
                pass

        results.append({
            "guid": guid,
            "title": title,
            "product": product,
            "classification": classification,
            "last_updated": last_updated,
            "version": version,
            "size_bytes": size_bytes,
            "source": "catalog",
        })

    if progress_cb:
        progress_cb(f"Найдено в каталоге: {len(results)}")
    return results


def _msuc_get_download_url(guid):
    """
    Получает прямые ссылки на скачивание для GUID обновления.
    Возвращает список dict: {url, filename, size_bytes}
    """
    import urllib.request
    import ssl

    # Шаг 1: POST-запрос на DownloadDialog.aspx
    dialog_url = ("https://www.catalog.update.microsoft.com/"
                  "DownloadDialog.aspx")
    payload = (
        "updateIDs=" +
        urllib.parse.quote(f'[{{"size":0,"updateID":"{guid}"}}]') +
        "&updateIDsBlockedForImport=&wsusApiPresent=&contentImport="
        "&sku=&serverName=&ssl=&portNumber=&version="
    )
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                      "AppleWebKit/537.36 (KHTML, like Gecko) "
                      "Chrome/120.0.0.0 Safari/537.36",
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
    }

    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    req = urllib.request.Request(
        dialog_url, data=payload.encode("utf-8"),
        headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
            html = resp.read().decode("utf-8", errors="replace")
    except Exception as e:
        log_error("_msuc_get_download_url_post", e)
        return []

    # Извлекаем ссылки вида: downloadInformation[0].files[0].url='http...'
    links = re.findall(
        r"downloadInformation\[\d+\]\.files\[\d+\]\.url\s*=\s*'([^']+)'",
        html)
    filenames = re.findall(
        r"downloadInformation\[\d+\]\.files\[\d+\]\.name\s*=\s*'([^']+)'",
        html)

    out = []
    for i, url in enumerate(links):
        name = filenames[i] if i < len(filenames) else ""
        out.append({
            "url": url,
            "filename": name,
        })
    return out


def _msuc_download_file(url, dest_dir, progress_cb=None, filename=None):
    """Скачивает файл по URL в указанную папку."""
    import urllib.request
    import ssl

    if not filename:
        filename = url.split("/")[-1]
        if not filename:
            filename = "download.msi"

    if progress_cb:
        progress_cb(f"Скачиваю: {filename}")

    dest_path = os.path.join(dest_dir, filename)
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                          "AppleWebKit/537.36 (KHTML, like Gecko) "
                          "Chrome/120.0.0.0 Safari/537.36",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=300, context=ctx) as resp:
            total = int(resp.headers.get("Content-Length", 0) or 0)
            downloaded = 0
            chunk_size = 1024 * 256
            with open(dest_path, "wb") as f:
                while True:
                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break
                    f.write(chunk)
                    downloaded += len(chunk)
                    if progress_cb and total > 0:
                        pct = int(downloaded * 100 / total)
                        progress_cb(f"Скачано {pct}% — {filename}")
        return dest_path, None
    except Exception as e:
        log_error("_msuc_download_file", e)
        return None, str(e)


def _msuc_install_downloaded(path):
    """
    Устанавливает скачанный файл драйвера.
    .msu → DISM /Add-Package или wusa
    .cab → pnputil /add-driver
    .exe → запуск
    """
    if not path or not os.path.exists(path):
        return False, "Файл не найден"
    low = path.lower()

    try:
        if low.endswith(".msu"):
            # DISM предпочтительнее wusa
            r = subprocess.run(
                ["dism", "/Online", "/Add-Package", f"/PackagePath:{path}"],
                capture_output=True, timeout=1800,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b" " + (r.stderr or b""))
            return r.returncode == 0, out[:2000]

        if low.endswith(".cab"):
            r = subprocess.run(
                ["pnputil", "/add-driver", path, "/install", "/subdirs"],
                capture_output=True, timeout=1800,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b" " + (r.stderr or b""))
            return r.returncode == 0, out[:2000]

        if low.endswith(".exe"):
            subprocess.Popen([path], creationflags=CREATE_NO_WINDOW)
            return True, "Установщик запущен"

        if low.endswith(".inf"):
            r = subprocess.run(
                ["pnputil", "/add-driver", path, "/install"],
                capture_output=True, timeout=600,
                creationflags=CREATE_NO_WINDOW)
            out = _decode_console_bytes(
                (r.stdout or b"") + b" " + (r.stderr or b""))
            return r.returncode == 0, out[:2000]

        return False, f"Неизвестный тип файла: {low}"
    except Exception as e:
        log_error("_msuc_install_downloaded", e)
        return False, str(e)


# ─── Windows Update Agent: установка конкретного драйвера ───

def _wua_install_driver_by_title(title, progress_cb=None):
    """Скачивает и устанавливает драйвер WUA по его заголовку."""
    import pythoncom
    pythoncom.CoInitialize()
    try:
        if progress_cb:
            progress_cb(f"Поиск: {title[:60]}")
        wua = win32com.client.Dispatch("Microsoft.Update.Session")
        searcher = wua.CreateUpdateSearcher()
        searcher.ServerSelection = 3
        searcher.ServiceID = "7971f918-a847-4430-9279-4a52d1efe18d"
        safe_title = title.replace("'", "''")
        result = searcher.Search(
            f"IsInstalled=0 AND Type='Driver' AND Title='{safe_title}'")

        target = None
        for u in result.Updates:
            if u.Title == title:
                target = u
                break
        if target is None:
            return False, "Драйвер не найден в WUA"

        if not target.EulaAccepted:
            target.EulaAccepted = True

        coll = win32com.client.Dispatch("Microsoft.Update.UpdateColl")
        coll.Add(target)

        if progress_cb:
            progress_cb("Скачивание...")
        dl = wua.CreateUpdateDownloader()
        dl.Updates = coll
        dl_result = dl.Download()
        if dl_result.ResultCode not in (2, 3):
            return False, f"Ошибка скачивания, код: {dl_result.ResultCode}"

        if progress_cb:
            progress_cb("Установка...")
        inst = wua.CreateUpdateInstaller()
        inst.Updates = coll
        inst_result = inst.Install()
        return inst_result.ResultCode in (2, 3), \
               f"Код: {inst_result.ResultCode}, перезагрузка: " \
               f"{inst_result.RebootRequired}"
    except Exception as e:
        log_error("_wua_install_driver_by_title", e)
        return False, str(e)
    finally:
        try:
            pythoncom.CoUninitialize()
        except Exception:
            pass


