def _xml_escape(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def show_toast(title, message=""):
    try:
        ps = (
            '[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null; '
            '[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] > $null; '
            '$template = @"' + "\n" + '<toast><visual><binding template="ToastGeneric">'
            '<text>' + _xml_escape(title) + '</text>'
            '<text>' + _xml_escape(message) + '</text>'
            '</binding></visual></toast>' + "\n" + '"@; '
            '$xml = New-Object Windows.Data.Xml.Dom.XmlDocument; '
            '$xml.LoadXml($template); '
            '$toast = [Windows.UI.Notifications.ToastNotification]::new($xml); '
            '[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier("Optix").Show($toast);'
        )
        subprocess.Popen(["powershell", "-NoProfile", "-Command", ps],
                         creationflags=CREATE_NO_WINDOW,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        pass


