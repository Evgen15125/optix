def open_trash_monitor():
    win = ctk.CTkToplevel(app)
    win.title("📈 Мониторинг роста мусора")
    win.geometry("850x620")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)

    ctk.CTkLabel(win, text="📈  Мониторинг роста мусора",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14, height=44,
                 border_width=1, border_color="#4FC3F7").pack(
        pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Слежение за ростом мусора в ключевых категориях. Обновление каждые 30 сек.",
                 font=("Inter", 12), text_color="#B0BEC5").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text="Готово", font=("Inter", 12, "bold"),
                              text_color="#4FC3F7", fg_color="#131E32",
                              corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0)
    lst.pack(fill="both", expand=True, padx=4, pady=4)

    monitor_cats = [
        "Временные файлы Windows", "Временные файлы пользователя", "Prefetch (Windows)",
        "Кэш Chrome", "Кэш Edge", "Кэш Discord", "🗑️ Корзина"
    ]
    cat_rows = {}

    for cat_name in monitor_cats:
        row = ctk.CTkFrame(lst, fg_color="#1F2E4A", corner_radius=10)
        row.pack(fill="x", pady=2, padx=2)
        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=12, pady=(8, 2))
        ctk.CTkLabel(top, text=cat_name, font=("Inter", 13, "bold"), text_color="#ffffff", anchor="w").pack(
            side="left", fill="x", expand=True)
        size_lbl = ctk.CTkLabel(top, text="—", font=("Inter", 13, "bold"), text_color="#4FC3F7", anchor="e")
        size_lbl.pack(side="right")
        trend_lbl = ctk.CTkLabel(row, text="⏳ ожидание...", font=("Inter", 11), text_color="#B0BEC5", anchor="w")
        trend_lbl.pack(fill="x", padx=12, pady=(0, 8))
        cat_rows[cat_name] = {"size": size_lbl, "trend": trend_lbl, "last_size": None}

    def update_loop():
        if not win.winfo_exists(): return
        total = 0
        for cat_name in monitor_cats:
            cat = next((c for c in CATEGORIES if c["name"] == cat_name), None)
            if not cat: continue
            try: size = category_size(cat)
            except Exception: size = -1
            if size < 0: size = 0
            total += size
            row_data = cat_rows[cat_name]
            row_data["size"].configure(text=human_size(size), text_color="#4FC3F7")
            last = row_data["last_size"]
            if last is not None:
                delta = size - last
                if abs(delta) < 1024: row_data["trend"].configure(text="— без изменений", text_color="#90A4AE")
                elif delta > 0: row_data["trend"].configure(text=f"⬆ +{human_size(delta)}", text_color="#FF8A8A")
                else: row_data["trend"].configure(text=f"⬇ {human_size(abs(delta))}", text_color="#7CFC7C")
            else:
                row_data["trend"].configure(text="первое измерение", text_color="#90A4AE")
            row_data["last_size"] = size

        status_lbl.configure(text=f"Всего мусора: {human_size(total)}  •  Обновлено: {datetime.now().strftime('%H:%M:%S')}", text_color="#7CFC7C")
        if total > TRASH_MONITOR["threshold_mb"] * 1024 * 1024:
            now = time.time()
            if now - TRASH_MONITOR["last_alert"] > 300:
                TRASH_MONITOR["last_alert"] = now
                try: show_toast("Optix — много мусора", f"Накопилось: {human_size(total)}")
                except Exception: pass
        if win.winfo_exists(): app.after(30000, update_loop)

    def start_monitoring():
        TRASH_MONITOR["active"] = True
        status_lbl.configure(text="🔄 Мониторинг активен", text_color="#7CFC7C")
        update_loop()

    def stop_monitoring():
        TRASH_MONITOR["active"] = False
        status_lbl.configure(text="⏹ Остановлено", text_color="#B0BEC5")

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="▶ Запустить", height=40, font=("Inter", 12, "bold"),
                  fg_color="#43A047", hover_color="#66BB6A", corner_radius=20, command=start_monitoring
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="⏹ Стоп", height=40, font=("Inter", 12, "bold"),
                  fg_color="#D32F2F", hover_color="#EF5350", corner_radius=20, command=stop_monitoring
                  ).pack(side="left", padx=6, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40, font=("Inter", 12, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=20, command=win.destroy
                  ).pack(side="left", padx=(6, 0), fill="x", expand=True)
    start_monitoring()


