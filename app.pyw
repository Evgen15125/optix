CM_BACKUP_PATH = os.path.join(BASE_DIR, "context_menu_disabled.json")

CM_SCOPES = [
    # (hive, path, отображаемое имя группы, тип)
    ("HKCR", r"*\shell", "📄 Файлы — команды (shell)", "shell"),
    ("HKCR", r"*\shellex\ContextMenuHandlers",
     "📄 Файлы — COM-обработчики", "shellex"),
    ("HKCR", r"Directory\shell", "📁 Папки — команды (shell)", "shell"),
    ("HKCR", r"Directory\shellex\ContextMenuHandlers",
     "📁 Папки — COM-обработчики", "shellex"),
    ("HKCR", r"Directory\Background\shell",
     "🖥 Рабочий стол — команды", "shell"),
    ("HKCR", r"Directory\Background\shellex\ContextMenuHandlers",
     "🖥 Рабочий стол — COM", "shellex"),
    ("HKCR", r"AllFilesystemObjects\shellex\ContextMenuHandlers",
     "🌍 Все объекты ФС — COM", "shellex"),
    ("HKCR", r"Drive\shell", "💾 Диски — команды", "shell"),
    ("HKCR", r"Drive\shellex\ContextMenuHandlers",
     "💾 Диски — COM-обработчики", "shellex"),
    ("HKCR", r"Folder\shellex\ContextMenuHandlers",
     "📁 Папки — доп. COM", "shellex"),
]


def _cm_load_disabled():
    """Загружает список отключённых пунктов."""
    try:
        with open(CM_BACKUP_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"entries": []}


def _cm_save_disabled(data):
    """Сохраняет список отключённых пунктов."""
    try:
        with open(CM_BACKUP_PATH, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log_error("_cm_save_disabled", e)


def _cm_scan():
    """
    Сканирует HKCR по всем CM_SCOPES.
    Возвращает список: [{scope_key, group, type, name, display,
                          clsid_or_cmd, enabled}]
    """
    items = []
    disabled = {e["scope"] + "|" + e["name"]
                for e in _cm_load_disabled().get("entries", [])}

    for hive, path, group, kind in CM_SCOPES:
        try:
            root = winreg.HKEY_CLASSES_ROOT
            try:
                key = winreg.OpenKey(root, path, 0, winreg.KEY_READ)
            except FileNotFoundError:
                continue
            i = 0
            while True:
                try:
                    sub_name = winreg.EnumKey(key, i)
                    i += 1
                except OSError:
                    break
                try:
                    sub = winreg.OpenKey(key, sub_name, 0,
                                          winreg.KEY_READ)
                except Exception:
                    continue

                # Читаем отображаемое имя
                display = ""
                # Пробуем MUIVerb (локализованное)
                for name_attr in ("MUIVerb", ""):
                    try:
                        val, _ = winreg.QueryValueEx(sub, name_attr)
                        if val:
                            display = str(val)
                            break
                    except FileNotFoundError:
                        continue
                    except Exception:
                        continue

                # Читаем CLSID или команду
                detail = ""
                if kind == "shellex":
                    try:
                        val, _ = winreg.QueryValueEx(sub, "")
                        detail = str(val or "")
                    except Exception:
                        pass
                else:
                    try:
                        cmd_key = winreg.OpenKey(sub, "command", 0,
                                                   winreg.KEY_READ)
                        try:
                            val, _ = winreg.QueryValueEx(cmd_key, "")
                            detail = str(val or "")
                        except Exception:
                            pass
                        winreg.CloseKey(cmd_key)
                    except Exception:
                        pass

                if not display:
                    display = sub_name
                # Убираем @ из MUIVerb
                if display.startswith("@"):
                    # Ссылка на ресурс — пытаемся извлечь понятное
                    # из последней части
                    display = display.split(",")[0].rsplit("\\", 1)[-1]
                    if display.lower().endswith(".dll"):
                        display = sub_name

                scope_key = f"{hive}|{path}"
                is_disabled = (scope_key + "|" + sub_name) in disabled

                items.append({
                    "scope": scope_key,
                    "hive": hive,
                    "path": path,
                    "group": group,
                    "type": kind,
                    "name": sub_name,
                    "display": display[:80],
                    "detail": detail[:120],
                    "enabled": not is_disabled,
                })
                try:
                    winreg.CloseKey(sub)
                except Exception:
                    pass
            try:
                winreg.CloseKey(key)
            except Exception:
                pass
        except Exception as e:
            log_error(f"_cm_scan({path})", e)
    return items


def _cm_disable(item):
    """Отключает пункт: сохраняет в backup и удаляет ключ."""
    scope = item["scope"]
    name = item["name"]
    path = item["path"]

    # Пробуем найти ключ в HKCU\Software\Classes (приоритет),
    # затем в HKLM\Software\Classes
    hives_to_try = [
        ("HKCU", winreg.HKEY_CURRENT_USER,
         r"Software\Classes\\" + path + "\\" + name),
        ("HKLM", winreg.HKEY_LOCAL_MACHINE,
         r"Software\Classes\\" + path + "\\" + name),
    ]

    found_hive = None
    for label, root, full_path in hives_to_try:
        try:
            test_key = winreg.OpenKey(root, full_path, 0, winreg.KEY_READ)
            winreg.CloseKey(test_key)
            found_hive = (label, root, full_path)
            break
        except FileNotFoundError:
            continue
        except Exception:
            continue

    if not found_hive:
        messagebox.showerror(
            "Ошибка",
            f"Не удалось найти ключ в реестре:\n{path}\\{name}\n\n"
            f"Возможно, он находится в HKCR как объединённый view, "
            f"но не существует физически.")
        return False

    label, root, full_path = found_hive

    # Backup перед удалением: сохраняем через reg export
    backup_dir = os.path.join(BASE_DIR, "cm_backup")
    try:
        os.makedirs(backup_dir, exist_ok=True)
    except Exception:
        pass
    safe = (path + "_" + name).replace("\\", "_").replace("/", "_") \
                                 .replace("*", "star").replace(":", "_")
    if len(safe) > 150:
        safe = safe[-150:]
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    reg_file = os.path.join(backup_dir, f"{safe}_{ts}.reg")

    # reg export
    full_reg_path = f"{label}\\{full_path}" if label == "HKCU" \
        else f"HKLM\\{full_path}"
    try:
        r = subprocess.run(
            ["reg", "export", full_reg_path, reg_file, "/y"],
            capture_output=True, timeout=30,
            creationflags=CREATE_NO_WINDOW)
        export_ok = (r.returncode == 0)
        if not export_ok:
            log_error("_cm_disable_reg_export",
                      Exception(
                          f"reg export {full_reg_path} → "
                          f"код {r.returncode}, "
                          f"{_decode_console_bytes(r.stderr or b'')[:300]}"))
    except Exception as e:
        export_ok = False
        log_error("_cm_disable_reg_export", e)

    # Удаляем ключ
    try:
        winreg.DeleteKey(root, full_path)
    except Exception as e:
        # Возможно, остались подключи — удаляем рекурсивно
        try:
            _cm_delete_tree(root, full_path)
        except Exception as e2:
            log_error("_cm_disable_delete", e2)
            messagebox.showerror(
                "Ошибка",
                f"Не удалось удалить ключ:\n{e2}\n\n"
                f"Попробуйте вручную через regedit.")
            return False

    # Сохраняем в JSON
    data = _cm_load_disabled()
    data["entries"].append({
        "scope": scope,
        "name": name,
        "path": path,
        "hive": label,
        "reg_file": reg_file if export_ok else "",
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "display": item["display"],
    })
    _cm_save_disabled(data)
    return True


def _cm_delete_tree(root, path):
    """Рекурсивно удаляет ключ и подключи."""
    try:
        key = winreg.OpenKey(root, path, 0, winreg.KEY_READ)
    except FileNotFoundError:
        return
    subkeys = []
    i = 0
    while True:
        try:
            sub = winreg.EnumKey(key, i)
            subkeys.append(sub)
            i += 1
        except OSError:
            break
    winreg.CloseKey(key)
    for sub in subkeys:
        _cm_delete_tree(root, path + "\\" + sub)
    winreg.DeleteKey(root, path)


def _cm_restore_all():
    """Восстанавливает все отключённые пункты из бэкапа."""
    data = _cm_load_disabled()
    entries = data.get("entries", [])
    if not entries:
        messagebox.showinfo("Optix",
                             "Нет отключённых пунктов для восстановления.")
        return

    if not messagebox.askyesno(
        "Восстановить все?",
        f"Будет восстановлено пунктов: {len(entries)}\n\n"
        f"Каждый импортируется из .reg-бэкапа и вернётся "
        f"в контекстное меню.\n\nПродолжить?"):
        return

    restored = 0
    failed = 0
    for e in entries:
        reg_file = e.get("reg_file", "")
        if not reg_file or not os.path.exists(reg_file):
            failed += 1
            continue
        try:
            r = subprocess.run(
                ["reg", "import", reg_file],
                capture_output=True, timeout=30,
                creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                restored += 1
            else:
                failed += 1
        except Exception:
            failed += 1

    # Очищаем список восстановленных
    _cm_save_disabled({"entries": []})
    messagebox.showinfo(
        "Готово",
        f"Восстановлено: {restored}\n"
        f"Ошибок: {failed}\n\n"
        f"Перезапустите Проводник (explorer.exe), чтобы увидеть "
        f"изменения — либо выйдите и войдите в систему.")


def _cm_export(fmt="txt"):
    """Экспорт списка в TXT."""
    items = _cm_scan()
    if not items:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    default = f"Optix_ContextMenu_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
    path = filedialog.asksaveasfilename(
        title="Экспорт списка",
        defaultextension=".txt", initialfile=default,
        filetypes=[("TXT", "*.txt")])
    if not path:
        return
    try:
        lines = ["=" * 70,
                 "  КОНТЕКСТНОЕ МЕНЮ WINDOWS — Optix",
                 "=" * 70,
                 f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                 f"  Всего пунктов: {len(items)}",
                 ""]
        cur_group = None
        for it in items:
            if it["group"] != cur_group:
                cur_group = it["group"]
                lines.append("")
                lines.append("─" * 70)
                lines.append(f"  {cur_group}")
                lines.append("─" * 70)
            status = "🟢" if it["enabled"] else "🔴"
            lines.append(f"  {status} {it['display']}")
            lines.append(f"      Ключ: {it['name']}")
            if it["detail"]:
                lines.append(f"      Данные: {it['detail'][:100]}")
        with open(path, "w", encoding="utf-8-sig") as f:
            f.write("\n".join(lines))
        messagebox.showinfo("Готово", f"Сохранено:\n{path}")
    except Exception as e:
        log_error("_cm_export", e)
        messagebox.showerror("Ошибка", str(e))


