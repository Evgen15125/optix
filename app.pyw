# ─── Disk: Mixed 70/30 ───
def bench_disk_mixed():
    """70% чтение / 30% запись, 4K блоки, NO_BUFFERING."""
    import random
    test_file = os.path.join(BASE_DIR, "bench_tmp_mixed.bin")
    block_size = 4096
    total_mb = 256
    ops = 50000
    try:
        with open(test_file, "wb") as fp:
            chunk = os.urandom(1024 * 1024)
            for _ in range(total_mb):
                fp.write(chunk)
        random.seed(42)
        total_blocks = (total_mb * 1024 * 1024) // block_size
        ops_list = [(random.randint(0, total_blocks - 1) * block_size,
                      random.random() < 0.7)
                     for _ in range(ops)]

        f = UnbufferedFile(test_file, mode="rw")
        try:
            f.open()
            gc.collect()
            start = time.perf_counter()
            # Разбиваем на два потока: чтение и запись
            reads = [off for off, is_r in ops_list if is_r]
            writes = [off for off, is_r in ops_list if not is_r]

            from concurrent.futures import ThreadPoolExecutor

            def do_reads():
                f2 = UnbufferedFile(test_file, mode="r")
                try:
                    f2.open()
                    f2.read_random(reads, block_size)
                finally:
                    f2.close()

            def do_writes():
                f3 = UnbufferedFile(test_file, mode="rw")
                try:
                    f3.open()
                    f3.write_random(writes, block_size)
                finally:
                    f3.close()

            with ThreadPoolExecutor(max_workers=2) as ex:
                futs = [ex.submit(do_reads), ex.submit(do_writes)]
                for ft in futs:
                    ft.result()
            elapsed = time.perf_counter() - start
        finally:
            f.close()
        elapsed = max(0.005, elapsed)
        mbps = (ops * block_size) / (1024 * 1024) / elapsed
        read_mbps = mbps * 0.7
        write_mbps = mbps * 0.3
        return {"value": round(mbps, 0), "unit": "МБ/с",
                "elapsed": elapsed,
                "read_mbps": round(read_mbps, 0),
                "write_mbps": round(write_mbps, 0),
                "score": _bench_normalize(mbps,
                                            BENCH_REFERENCE["disk_mixed"]),
                "ref": BENCH_REFERENCE["disk_mixed"]}
    finally:
        try:
            if os.path.exists(test_file):
                os.remove(test_file)
        except Exception:
            pass


# ─── Параллельные вычисления (CPU) ───
def bench_parallel_cpu():
    import concurrent.futures
    import psutil
    cores = min(psutil.cpu_count(logical=True) or 4, 16)
    iters = 500_000

    def heavy(n):
        total = 0.0
        for i in range(n):
            total += math.sin(i) * math.cos(i) + math.sqrt(i + 1)
        return total

    def work():
        with concurrent.futures.ThreadPoolExecutor(max_workers=cores) as ex:
            fs = [ex.submit(heavy, iters) for _ in range(cores)]
            return [f.result() for f in fs]

    _, elapsed = _bench_timing(work)
    elapsed = max(0.1, elapsed)
    score = int(cores * 250 * 1.0 / elapsed)
    return {"value": score, "unit": "балл", "elapsed": elapsed,
            "cores": cores,
            "score": _bench_normalize(score, BENCH_REFERENCE["parallel_cpu"]),
            "ref": BENCH_REFERENCE["parallel_cpu"]}


# ─── Stability ───
def bench_stability(duration_sec=300):
    import psutil
    cores = psutil.cpu_count(logical=True) or 4
    temp_samples = []
    freq_samples = []

    py_exe = _get_python_console_path()

    child_code = (
        "import time\n"
        f"end = time.time() + {duration_sec + 30}\n"
        "x = 0\n"
        "while time.time() < end:\n"
        "    for i in range(1, 100001):\n"
        "        x = (x + i * i) % 1000003\n"
    )
    procs = []
    for _ in range(cores):
        p = subprocess.Popen([py_exe, "-c", child_code],
                             creationflags=CREATE_NO_WINDOW,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        procs.append(p)

    start = time.time()
    try:
        while time.time() - start < duration_sec:
            try:
                temps = _get_temperatures()
                t = temps.get("cpu")
                if t is not None:
                    temp_samples.append(t)
            except Exception:
                pass
            try:
                freq = psutil.cpu_freq()
                if freq:
                    freq_samples.append(freq.current)
            except Exception:
                pass
            time.sleep(2)
    finally:
        for p in procs:
            try:
                p.kill()
            except Exception:
                pass

    throttle_pct = 0.0
    if freq_samples and len(freq_samples) > 3:
        nominal = max(freq_samples)
        threshold = nominal * 0.8
        throttled = sum(1 for f in freq_samples if f < threshold)
        throttle_pct = (throttled / len(freq_samples)) * 100

    stability_pct = max(0.0, 100.0 - throttle_pct)
    result = {
        "value": round(stability_pct, 1),
        "unit": "%",
        "temp_min": min(temp_samples) if temp_samples else None,
        "temp_avg": round(statistics.mean(temp_samples), 1) if temp_samples else None,
        "temp_max": max(temp_samples) if temp_samples else None,
        "freq_min": round(min(freq_samples), 0) if freq_samples else None,
        "freq_avg": round(statistics.mean(freq_samples), 0) if freq_samples else None,
        "freq_max": round(max(freq_samples), 0) if freq_samples else None,
        "throttle_pct": round(throttle_pct, 1),
        "elapsed": duration_sec,
        "score": _bench_normalize(stability_pct, BENCH_REFERENCE["stability"]),
        "ref": BENCH_REFERENCE["stability"],
    }
    return result


