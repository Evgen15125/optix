                         width=220).pack(side="left")
            ctk.CTkLabel(r_, text=str(value), font=("Consolas", 12, "bold"),
                         text_color=color, anchor="w").pack(
                side="left", fill="x", expand=True)

        add_info_row("🏭 Производитель / модель:", smart.get("friendly_name", "—"))
        add_info_row("📀 Тип носителя:", smart.get("media_type", "—"))
        add_info_row("🔌 Интерфейс:", smart.get("bus_type", "—"))
        add_info_row("📋 Прошивка:", smart.get("firmware", "—"))
        add_info_row("🔢 Серийный номер:", smart.get("serial", "—"))

        health = smart.get("health_status", "")
        op_status = smart.get("operational_status", "")
        h_color = "#7CFC7C"
        if health and health.lower() not in ("healthy", "good", "ok"): h_color = "#FF8A8A"
        if op_status and op_status.lower() not in ("ok", "online"): h_color = "#FFD54F"
        
