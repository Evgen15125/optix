def _on_tray_quick_clean():
    def worker():
        total = 0
        for cat in CATEGORIES:
            if "quick" in cat.get("profile", []):
                try:
                    f_, _, _ = clean_category(cat)
                    total += f_
                except Exception:
                    pass
        try:
            show_toast("Optix — быстрая очистка",
                       f"Освобождено: {human_size(total)}")
        except Exception:
            pass
    threading.Thread(target=worker, daemon=True).start()


