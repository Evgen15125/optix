        app.after(0, finish)

    threading.Thread(target=monitor_worker, daemon=True).start()


def diag_reliability_index():
    diag_ui["status"].configure(text="⏳ Индекс надёжности...", text_color="#FFD54F")
    close_busy = _show_busy_dialog("Индекс надёжности", "Запрос истории стабильности Windows...")
    def worker():
        ps = (
            "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
            "$ErrorActionPreference='SilentlyContinue';"
            "$d = Get-CimInstance -ClassName Win32_ReliabilityStabilityMetrics "
            "-ErrorAction SilentlyContinue | "
            "Sort-Object TimeGenerated -Descending | "
            "Select-Object -First 30 TimeGenerated,SystemStabilityIndex; "
            "$d | ConvertTo-Json -Compress"
        )
        data = []
        try:
            r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                               capture_output=True, text=True, timeout=60,
                               creationflags=CREATE_NO_WINDOW,
                               encoding="utf-8", errors="replace")
            out = (r.stdout or "").strip()
            if out.startswith("\ufeff"):
                out = out[1:]
            if out:
                data = json.loads(out)
                if isinstance(data, dict):
                    data = [data]
        except Exception as e:
            log_error("diag_reliability_index", e)

        def finish():
            close_busy()
            if not data:
                diag_ui["status"].configure(
                    text="⚠ Индекс надёжности недоступен",
                    text_color="#FF8A8A")
                messagebox.showinfo(
                    "Индекс надёжности",
                    "Windows не отдал данные.\n\n"
                    "Возможно, отключён мониторинг надёжности "
                    "или система собрала слишком мало статистики.")
                return
            lines = ["=" * 60,
                     "  ИНДЕКС НАДЁЖНОСТИ WINDOWS",
                     "=" * 60,
                     "",
                     "  Шкала: 1 = плохо, 10 = отлично",
                     "  Если значения падают — недавно были сбои.",
                     ""]
            shown = 0
            for d in data:
                t = str(d.get("TimeGenerated", ""))[:10]
                idx = d.get("SystemStabilityIndex")
                if idx is None:
                    continue
                try:
                    idxf = float(idx)
                except Exception:
                    continue
                bar_len = max(0, min(10, int(round(idxf))))
                bar = "█" * bar_len + "░" * (10 - bar_len)
                lines.append(f"  {t}   {idxf:>4.2f}   {bar}")
                shown += 1
            lines.append("")
            lines.append("─" * 60)
            lines.append(f"Всего измерений: {shown}")
            diag_ui["status"].configure(
                text=f"✅ Готово ({shown} записей)", text_color="#7CFC7C")
            show_output_dialog("Индекс надёжности Windows", "\n".join(lines))

        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


