                     font=("Inter", 14, "bold"),
                     text_color="#82B1FF", anchor="w").pack(
            fill="x", padx=14, pady=(10, 6))

        def add_info_row(label, value, color="#ffffff"):
            if value is None or value == "":
                return
            r_ = ctk.CTkFrame(info_card, fg_color="transparent")
            r_.pack(fill="x", padx=14, pady=2)
            ctk.CTkLabel(r_, text=label, font=("Inter", 12),
