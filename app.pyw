    status = ctk.CTkLabel(f, text="Загрузка...", font=("Inter", 12, "bold"),
                          text_color="#FFD54F", fg_color="#131E32",
                          corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status.pack(pady=(0, 8), padx=15, fill="x")
    
    # ─── Список дисков ───
    wrap = ctk.CTkFrame(f, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C", height=500)
    wrap.pack(padx=15, pady=(0, 10), fill="both", expand=True)
    wrap.pack_propagate(False)
    
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0,
                                 scrollbar_button_color="#243A5E",
                                 scrollbar_button_hover_color="#4FC3F7")
    lst.pack(fill="both", expand=True, padx=4, pady=4)
    
    # ─── Кнопка Обновить ───
    refresh_btn = ctk.CTkButton(f, text="🔄 Обновить", height=42, font=("Inter", 14, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5",
                  corner_radius=21,
                  command=lambda: _refresh_disks_with_pulse(refresh_btn))
    refresh_btn.pack(pady=(0, 12), padx=15, fill="x")
    disks_ui["refresh_btn"] = refresh_btn
                  
    disks_ui["list_frame"] = lst
    disks_ui["status"] = status
    
    refresh_disks_ui()
    return f


def _refresh_disks_with_pulse(btn):
    """Обновляет информацию о дисках с пульсацией кнопки."""
    _start_button_pulse(btn, "#1976D2", "#42A5F5")
    btn.configure(state="disabled")
    
    def worker():
        try:
            # Вызываем сбор данных в фоновом потоке
            global disks_all
            disks_all = get_disks_info()
            temps_map = _get_disk_temperatures()
            
            # Переносим отрисовку в главный поток
            def finish():
                _stop_button_pulse(btn)
                btn.configure(state="normal")
                _render_disks_data(disks_all, temps_map)
            app.after(0, finish)
        except Exception as e:
            app.after(0, lambda: _stop_button_pulse(btn))
            app.after(0, lambda: btn.configure(state="normal"))
            log_error("_refresh_disks_with_pulse", e)
    threading.Thread(target=worker, daemon=True).start()


def _render_disks_data(disks_data, temps_map):
    """Отрисовывает список дисков (выделено в отдельную функцию для потокобезопасности)."""
    for w in disks_ui["list_frame"].winfo_children():
        w.destroy()
        
    if not disks_data:
        ctk.CTkLabel(disks_ui["list_frame"], text="Диски не найдены",
                     font=("Inter", 14), text_color="#90A4AE").pack(pady=30)
        return
        
    total_size = sum(d["total"] for d in disks_data)
    total_used = sum(d["used"] for d in disks_data)
    total_free = sum(d["free"] for d in disks_data)
    
    disks_ui["status"].configure(
        text=f"Дисков: {len(disks_data)}   •   Всего: {human_size(total_size)}   •   "
             f"Занято: {human_size(total_used)}   •   Свободно: {human_size(total_free)}",
        text_color="#4FC3F7")
        
    for d in disks_data:
        letter = d["mount"][0]
        default_bg = "#1F2E4A"
        
        row = ctk.CTkFrame(disks_ui["list_frame"], fg_color=default_bg, 
                           corner_radius=12, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=4, padx=2)
        
        # ─── ИДЕАЛЬНЫЙ ХОВЕР ───
        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E", border_color="#4FC3F7")
            except Exception: pass

        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                try:
                    x, y = r.winfo_pointerxy()
                    rx, ry = r.winfo_rootx(), r.winfo_rooty()
                    rw, rh = r.winfo_width(), r.winfo_height()
                    if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                        r.configure(fg_color=bg, border_color="#2A3B5C")
                except Exception: pass
            r.after(20, check_later)

        def bind_hover(widget):
            if isinstance(widget, ctk.CTkButton): return
            try:
                widget.bind("<Enter>", on_enter, add="+")
                widget.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_canvas"):
                    widget._canvas.bind("<Enter>", on_enter, add="+")
                    widget._canvas.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_label"):
                    widget._label.bind("<Enter>", on_enter, add="+")
                    widget._label.bind("<Leave>", on_leave, add="+")
            except Exception: pass
            for child in widget.winfo_children(): bind_hover(child)
        bind_hover(row)
        
        # ─── Заголовок карточки ───
        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=14, pady=(10, 4))
        
        ctk.CTkLabel(top, text=f"💾  {d['mount']}",
                     font=("Inter", 16, "bold"),
                     text_color="#ffffff").pack(side="left")
                     
        ctk.CTkLabel(top, text=d["model"] or "Неизвестная модель",
                     font=("Consolas", 11), text_color="#90CAF9").pack(
            side="left", padx=12)
            
        media = (d["media"] or "Unknown").lower()
        media_label = {"ssd": "SSD", "hdd": "HDD"}.get(media, "?")
        ctk.CTkLabel(top, text=f"[{media_label}]", font=("Inter", 11, "bold"),
                     text_color="#82B1FF").pack(side="left", padx=4)
                     
        # Температура
        temp = None
        try:
            if temps_map:
                r = subprocess.run(
                    ["powershell", "-NoProfile", "-Command",
                     f"(Get-Partition -DriveLetter '{letter}' -ErrorAction SilentlyContinue | "
                     f"Get-Disk -ErrorAction SilentlyContinue).Number"],
                    capture_output=True, text=True, timeout=10,
                    creationflags=CREATE_NO_WINDOW)
                num = (r.stdout or "").strip()
                if num and num in temps_map:
                    temp = temps_map[num]
                elif temps_map:
                    temp = list(temps_map.values())[0]
        except Exception:
            pass
            
        if temp is not None:
            t_color = "#7CFC7C"
            if temp > 70: t_color = "#FF8A8A"
            elif temp > 50: t_color = "#FFD54F"
            ctk.CTkLabel(top, text=f"🌡 {temp}°C",
                         font=("Inter", 12, "bold"),
                         text_color=t_color).pack(side="left", padx=8)

        # ─── Информация о месте ───
        info = ctk.CTkFrame(row, fg_color="transparent")
        info.pack(fill="x", padx=14, pady=(0, 6))
        ctk.CTkLabel(info,
                     text=f"Занято: {human_size(d['used'])} / {human_size(d['total'])}   "
                          f"•   Свободно: {human_size(d['free'])}   •   ФС: {d['fstype']}",
                     font=("Consolas", 11), text_color="#B0BEC5",
                     anchor="w").pack(anchor="w")
                     
        bar_color = "#E53935" if d["percent"] > 85 else ("#FFD54F" if d["percent"] > 70 else "#7CFC7C")
        bar = ctk.CTkProgressBar(row, height=18, progress_color=bar_color, fg_color="#0D1B33", corner_radius=9)
        bar.set(d["percent"] / 100)
        bar.pack(fill="x", padx=14, pady=(4, 6))
        
        ctk.CTkLabel(row, text=f"{d['percent']:.0f}% заполнено",
                     font=("Inter", 11), text_color="#B0BEC5",
                     anchor="w").pack(anchor="w", padx=14, pady=(0, 8))

        def mk(letter_=letter, fn=None):
