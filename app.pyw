# ================== СТАТИСТИКА ПО ТИПАМ ФАЙЛОВ ==================
def _get_file_type_stats(letter):
    stats = defaultdict(lambda: {"size": 0, "count": 0})
    ext_colors = {
        ".mp4": "#E53935", ".avi": "#D32F2F", ".mkv": "#C62828",
        ".mp3": "#8E24AA", ".flac": "#7B1FA2", ".wav": "#6A1B9A",
        ".jpg": "#43A047", ".jpeg": "#388E3C", ".png": "#2E7D32",
        ".gif": "#1B5E20", ".bmp": "#4CAF50",
        ".pdf": "#F9A825", ".doc": "#FBC02D", ".docx": "#FDD835",
        ".xls": "#FFA000", ".xlsx": "#FF8F00",
        ".zip": "#00ACC1", ".rar": "#00838F", ".7z": "#0097A7",
        ".exe": "#5D4037", ".msi": "#6D4C41", ".dll": "#795548",
        ".iso": "#D81B60", ".bin": "#C2185B", ".img": "#AD1457",
        ".txt": "#90A4AE", ".log": "#78909C",
    }

    def get_color(ext):
        return ext_colors.get(ext, "#455A64")

    try:
        for root, dirs, files in os.walk(f"{letter}:\\"):
            if "$Recycle.Bin" in root or "System Volume Information" in root:
                continue
            for f in files:
                try:
                    fp = os.path.join(root, f)
                    size = os.path.getsize(fp)
                    ext = os.path.splitext(f)[1].lower() or "(без расширения)"
                    stats[ext]["size"] += size
                    stats[ext]["count"] += 1
                except (OSError, PermissionError):
                    continue
    except (OSError, PermissionError):
        pass
    result = []
    for ext, data in stats.items():
        result.append({
            "ext": ext,
            "size": data["size"],
            "count": data["count"],
            "color": get_color(ext),
        })
    result.sort(key=lambda x: -x["size"])
    return result


