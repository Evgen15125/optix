        os.makedirs(IW_SESSIONS_DIR, exist_ok=True)
        return True
    except Exception as e:
        log_error("_iw_ensure_dir", e)
        return False


def _iw_scan_registry(progress_cb=None):
    """
    Рекурсивно обходит реестр, возвращает set путей всех ключей.
    Путь в формате 'HKCU|SOFTWARE\\Vendor\\App' или 'HKLM|...'.
    """
    keys = set()

    def walk(root, path, hive_prefix, max_depth, current=0):
        if current > max_depth:
            return
        try:
            key = winreg.OpenKey(root, path, 0, winreg.KEY_READ)
        except (FileNotFoundError, PermissionError, OSError):
            return
        try:
            full = f"{hive_prefix}|{path}"
            keys.add(full)
            i = 0
            while True:
                try:
                    sub = winreg.EnumKey(key, i)
                    i += 1
                except OSError:
                    break
                walk(root, path + "\\" + sub, hive_prefix,
                     max_depth, current + 1)
        finally:
            try:
                winreg.CloseKey(key)
            except Exception:
                pass

    for root, path, depth in IW_REGISTRY_ROOTS:
        hive = "HKLM" if root == winreg.HKEY_LOCAL_MACHINE else "HKCU"
        if progress_cb:
            try:
                progress_cb(f"Реестр: {hive}\\{path}")
            except Exception:
                pass
        walk(root, path, hive, depth)

    # Uninstall-ключи — целиком, без ограничения глубины
    for root, path in IW_REG_UNINSTALL:
        hive = "HKLM" if root == winreg.HKEY_LOCAL_MACHINE else "HKCU"
        if progress_cb:
            try:
                progress_cb(f"Реестр (Uninstall): {hive}")
            except Exception:
                pass
        walk(root, path, hive, 5)

    return keys


def _iw_scan_filesystem(progress_cb=None):
    """
    Обходит файловую систему, возвращает dict:
      { abs_path_lower: {"is_dir": bool, "size": int, "mtime": float} }
    Для папок size=0.
    """
    result = {}

    def walk(path, max_depth, current=0):
        if current > max_depth:
            return
        try:
            with os.scandir(path) as it:
                for entry in it:
                    try:
                        if entry.is_symlink():
                            continue
                        abs_path = entry.path
                        key = os.path.normcase(abs_path)
                        if entry.is_dir(follow_symlinks=False):
                            result[key] = {"is_dir": True, "size": 0,
                                            "mtime": 0.0}
                            walk(abs_path, max_depth, current + 1)
                        elif entry.is_file(follow_symlinks=False):
                            try:
                                st = entry.stat(follow_symlinks=False)
                                result[key] = {
                                    "is_dir": False,
                                    "size": st.st_size,
                                    "mtime": st.st_mtime,
                                }
                            except OSError:
                                pass
                    except (OSError, PermissionError):
                        continue
        except (OSError, PermissionError, FileNotFoundError):
            return

    for root, depth in IW_FS_ROOTS:
        if not root or not os.path.isdir(root):
            continue
        if progress_cb:
            try:
                progress_cb(f"Файлы: {root}")
            except Exception:
                pass
        walk(root, depth)

    return result


def _iw_save_snapshot(session_dir, reg_keys, fs_files):
    """Сохраняет снимок в JSON."""
    try:
        os.makedirs(session_dir, exist_ok=True)
        reg_path = os.path.join(session_dir, "registry.json")
        fs_path = os.path.join(session_dir, "filesystem.json")
        with open(reg_path, "w", encoding="utf-8") as f:
            json.dump(sorted(reg_keys), f, ensure_ascii=False)
        with open(fs_path, "w", encoding="utf-8") as f:
            json.dump(fs_files, f, ensure_ascii=False)
        return True
    except Exception as e:
        log_error("_iw_save_snapshot", e)
        return False


def _iw_load_snapshot(session_dir, name):
    p = os.path.join(session_dir, name)
    if not os.path.exists(p):
        return None
    try:
        with open(p, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        log_error(f"_iw_load_snapshot({name})", e)
        return None

# ─── Фильтр фонового шума (браузеры, кэши, логи, temp) ───
IW_NOISE_PATH_PARTS = (
    "\\temp\\", "\\tmp\\", "\\cache\\", "\\caches\\",
    "\\inetcache\\", "\\code cache\\", "\\gpucache\\",
    "\\cachestorage\\", "\\service worker\\",
    "\\logs\\", "\\log\\",
    "\\microsoft\\windows\\inetcache\\",
    "\\microsoft\\windows\\webcache\\",
    "\\microsoft\\windows\\temporary internet files\\",
    "\\microsoft\\windows\\explorer\\thumbcache",
    "\\microsoft\\windows\\explorer\\iconcache",
    "\\packages\\",
    "\\softwaredistribution\\",
    "\\crashdumps\\",
    "\\d3dscache\\",
    "\\nv_cache\\", "\\nvidia\\dxcache",
    "\\google\\chrome\\user data\\",
    "\\microsoft\\edge\\user data\\",
    "\\mozilla\\firefox\\profiles\\",
    "\\yandex\\yandexbrowser\\",
    "\\opera software\\",
    "\\brave-browser\\",
    "\\discord\\",
    "\\slack\\",
    "\\telegram desktop\\",
    "\\whatsapp\\",
    "\\viber\\",
    "\\microsoft\\onedrive\\",
    "\\microsoft\\office\\",
)

IW_NOISE_EXTENSIONS = (
    ".log", ".tmp", ".temp", ".etl", ".blf",
    ".regtrans-ms", ".dmp", ".old", ".bak",
    ".cache", ".lock", ".pf", ".db-shm", ".db-wal",
    ".lnk",
)

IW_NOISE_FILENAMES = (
    "desktop.ini", "thumbs.db", ".ds_store",
    "iconcache.db",
)


def _iw_is_noise_path(path, is_dir=False):
    """True, если путь — фоновый шум, а не следы программы."""
    if not path:
        return True
    low = path.lower()
    for part in IW_NOISE_PATH_PARTS:
        if part in low:
            return True
    name = os.path.basename(low)
    if name in IW_NOISE_FILENAMES:
        return True
    for pref in IW_NOISE_FILENAMES:
        if pref.endswith("_") and name.startswith(pref):
            return True
    if not is_dir:
        _, ext = os.path.splitext(low)
        if ext in IW_NOISE_EXTENSIONS:
            return True
    return False



def _iw_diff(reg_before, reg_after, fs_before, fs_after):
    """
    Возвращает dict с новыми ключами реестра и новыми файлами/папками.
    Фоновый шум (кэши, логи, temp, браузеры) отфильтровывается.
    """
    reg_before_set = set(reg_before or [])
    reg_after_set = set(reg_after or [])
    new_reg_raw = sorted(reg_after_set - reg_before_set)

    # Фильтруем шум в реестре
    new_reg = [k for k in new_reg_raw
               if not _iw_is_noise_path(k.replace("|", "\\"), True)]
    reg_filtered = len(new_reg_raw) - len(new_reg)

    fs_before_d = fs_before or {}
    fs_after_d = fs_after or {}
    new_fs_dirs = []
    new_fs_files = []
    modified_fs = []
    filtered_count = 0

    for path, info in fs_after_d.items():
        is_dir = info.get("is_dir", False)
        is_noise = _iw_is_noise_path(path, is_dir)

        if path not in fs_before_d:
            if is_noise:
                filtered_count += 1
                continue
            if is_dir:
                new_fs_dirs.append(path)
            else:
                new_fs_files.append(path)
        else:
            old = fs_before_d[path]
            if (not is_dir) and \
               (old.get("size") != info.get("size") or
                abs(old.get("mtime", 0) - info.get("mtime", 0)) > 1):
                if is_noise:
                    filtered_count += 1
                    continue
                modified_fs.append(path)

    return {
        "new_registry": new_reg,
        "new_dirs": sorted(new_fs_dirs),
        "new_files": sorted(new_fs_files),
        "modified_files": sorted(modified_fs),
        "filtered_noise": filtered_count,
        "filtered_registry": reg_filtered,
    }


def _iw_list_sessions():
    """Возвращает список сессий наблюдения."""
    if not os.path.isdir(IW_SESSIONS_DIR):
        return []
    result = []
    try:
        for name in os.listdir(IW_SESSIONS_DIR):
            sdir = os.path.join(IW_SESSIONS_DIR, name)
            if not os.path.isdir(sdir):
                continue
            meta_path = os.path.join(sdir, "meta.json")
            if not os.path.exists(meta_path):
                continue
            try:
                with open(meta_path, "r", encoding="utf-8") as f:
                    meta = json.load(f)
            except Exception:
                continue
            meta["_dir"] = sdir
            meta["_name"] = name
            result.append(meta)
        result.sort(key=lambda m: m.get("started_at", ""), reverse=True)
    except Exception as e:
        log_error("_iw_list_sessions", e)
    return result


