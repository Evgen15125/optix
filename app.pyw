    score_filter_menu.pack(side="left")
    programs_ui["score_filter"] = score_filter_menu

    # ─── Список ───
    wrap = ctk.CTkFrame(f, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C", height=440)
    wrap.pack(padx=15, pady=(0, 8), fill="both", expand=True)
    wrap.pack_propagate(False)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0,
