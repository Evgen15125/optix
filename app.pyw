    ctk.CTkButton(btn_row, text="Закрыть", height=38, font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A", corner_radius=19, command=win.destroy).pack(side="left", padx=(4, 0), fill="x", expand=True)
    render()


