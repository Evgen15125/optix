                          fg_color="#1976D2", hover_color="#42A5F5",
                          corner_radius=13, command=make_run()
                          ).pack(side="left", padx=2)

            def make_details(n=svc_name, name=t["name"]):
                def do():
                    _sched_show_details(n, name)
                return do

            def make_delete(n=svc_name, name=t["name"]):
                def do():
                    if _sched_delete_task(n, name):
                        try:
                            refresh_autostart_ui()
                        except Exception:
                            pass
                return do

            ctk.CTkButton(btns, text="📋 Детали", width=90, height=26,
                          font=("Arial", 10, "bold"),
                          fg_color="#455A64", hover_color="#546E7A",
                          corner_radius=13, command=make_details()
                          ).pack(side="left", padx=2)
            ctk.CTkButton(btns, text="🗑 Удалить", width=90, height=26,
                          font=("Arial", 10, "bold"),
                          fg_color="#7B1FA2", hover_color="#9C27B0",
                          corner_radius=13, command=make_delete()
                          ).pack(side="left", padx=2)

            shown += 1

        status_lbl.configure(
            text=f"Всего задач: {len(state['all'])}   •   Показано: {shown}",
            text_color="#7CFC7C")

    def worker():
        try:
            tasks = read_all_scheduled_tasks()
            result = []
            for t in tasks:
                tr = t["triggers"].lower()
                if "logon" in tr or "boot" in tr or "startup" in tr:
                    icon, label = _estimate_task_impact(t)
                    t["impact_icon"] = icon
                    t["impact_label"] = label
                    result.append(t)
            result.sort(key=lambda x: (
                {"🔴": 0, "🟡": 1, "🟢": 2, "⚪": 3}.get(x.get("impact_icon", "⚪"), 4),
                x["name"].lower()
            ))
            state["all"] = result
            if not result:
                app.after(0, lambda: status_lbl.configure(
                    text="Задач с триггерами Logon/Boot не найдено",
                    text_color="#90A4AE"))
                return
            app.after(0, render)
        except Exception as e:
            log_error("show_hidden_scheduler_tasks", e)
            app.after(0, lambda: status_lbl.configure(
                text=f"⚠ Ошибка: {str(e)[:100]}",
                text_color="#FF8A8A"))

    search_entry.bind("<KeyRelease>", lambda e: render())
    filter_menu.configure(command=lambda v: render())

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔄 Обновить", height=38,
                  font=("Inter", 13, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=19,
                  command=lambda: threading.Thread(
                      target=worker, daemon=True).start()
                  ).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="⏰ Планировщик Windows", height=38,
                  font=("Inter", 13, "bold"), fg_color="#7B1FA2",
                  hover_color="#9C27B0", corner_radius=19,
                  command=lambda: subprocess.Popen(["taskschd.msc"])
                  ).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=38,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=19,
                  command=win.destroy).pack(side="left", padx=(4, 0),
                                             fill="x", expand=True)
    threading.Thread(target=worker, daemon=True).start()


def export_autostart(fmt="txt"):
    items, _ = get_autostart_items()
    if not items:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    if fmt == "csv":
        default = f"Optix_Autostart_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.csv"
        path = filedialog.asksaveasfilename(
            title="Экспорт в CSV", defaultextension=".csv",
            initialfile=default, filetypes=[("CSV", "*.csv")])
        if not path:
            return
        try:
            import csv
            with open(path, "w", encoding="utf-8-sig", newline="") as f:
                w = csv.writer(f, delimiter=";")
                w.writerow(["Состояние", "Источник", "Имя", "Влияние",
                            "Команда", "Файл существует", "Издатель", "Версия", "Размер"])
                for it in items:
                    w.writerow([
                        "включено" if it["enabled"] else "отключено",
                        it["source"], it["name"], it["impact_label"],
                        it["command"],
                        "да" if it["file_exists"] else "нет",
                        it.get("company", ""), it.get("version", ""),
                        it.get("size", 0),
                    ])
            messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))
    else:
        default = f"Optix_Autostart_{datetime.now().strftime('%Y-%m-%d_%H-%M')}.txt"
        path = filedialog.asksaveasfilename(
            title="Экспорт в TXT", defaultextension=".txt",
            initialfile=default, filetypes=[("TXT", "*.txt")])
        if not path:
            return
        try:
            lines = ["=" * 70,
                     f"  АВТОЗАПУСК — отчёт Optix",
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     f"  Всего: {len(items)}",
                     "=" * 70, ""]
            cur_src = None
            for it in items:
                if it["source"] != cur_src:
                    cur_src = it["source"]
                    lines.append("")
                    lines.append(f"── {SOURCE_LABELS.get(cur_src, cur_src)} ──")
                    lines.append("")
                st = "🟢" if it["enabled"] else "🔴"
                lines.append(f"{st} {it['impact_icon']} {it['name']}")
                lines.append(f"   Команда:    {it['command']}")
                lines.append(f"   Влияние:    {it['impact_label']}")
                if it["file_exists"]:
                    lines.append(f"   Файл:       ✅ существует")
                    if it.get("company"):
                        lines.append(f"   Издатель:   {it['company']}")
                    if it.get("version"):
                        lines.append(f"   Версия:     {it['version']}")
                    if it.get("size"):
                        lines.append(f"   Размер:     {human_size(it['size'])}")
                else:
                    lines.append(f"   Файл:       ❌ НЕ найден")
                lines.append("")
            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            messagebox.showinfo("Готово", f"TXT сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))


