def _sched_export_all_tasks():
    tasks = load_optix_tasks()
    if not tasks:
        messagebox.showinfo("Optix", "Нет задач.")
        return
    path = filedialog.asksaveasfilename(
        title="Экспорт задач", defaultextension=".json",
        initialfile=f"Optix_Tasks_{datetime.now().strftime('%Y-%m-%d')}.json",
        filetypes=[("JSON", "*.json")])
    if not path:
        return
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump({
                "exported": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "computer": os.environ.get("COMPUTERNAME", "?"),
                "count": len(tasks),
                "tasks": tasks,
            }, f, ensure_ascii=False, indent=2)
        messagebox.showinfo("Готово", f"Экспортировано: {len(tasks)}\n{path}")
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))


def _sched_import_tasks():
    path = filedialog.askopenfilename(
        title="Импорт задач",
        filetypes=[("JSON", "*.json"), ("Все", "*.*")])
    if not path:
        return
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        tasks = data.get("tasks", [])
        if not tasks:
            messagebox.showinfo("Optix", "Нет задач в файле.")
            return
    except Exception as e:
        messagebox.showerror("Ошибка", str(e))
        return
    if not messagebox.askyesno(
        "Импортировать задачи?",
        f"Найдено: {len(tasks)}\n"
        f"Из: {data.get('computer', '?')}\n"
        f"Дата: {data.get('exported', '?')}\n\n"
        f"Будут добавлены как новые задачи."):
        return
    cur = load_optix_tasks()
    added = 0
    for t in tasks:
        t = dict(t)
        t["id"] = _task_id()
        t["name"] = t.get("name", "Задача") + " (импорт)"
        t["enabled"] = False
        cur.append(t)
        added += 1
    save_optix_tasks(cur)
    messagebox.showinfo("Готово", f"Импортировано: {added}")
    try:
        show_page("scheduler")
    except Exception:
        pass


# ─── Запуск задачи из UI ───

def _task_run_now(task, on_done=None):
    """Запускает задачу сейчас в фоновом потоке."""
    def worker():
        try:
            result = _task_execute_with_retry(task)
        except Exception as e:
            log_error("_task_run_now", e)
            result = {"success": False, "log": str(e)}

        def finish():
            if result.get("success"):
                show_output_dialog(
                    f"✅ {task.get('name', '?')}",
                    result.get("log", "Готово"))
            elif result.get("skipped"):
                messagebox.showinfo(
                    "Пропущено",
                    f"Задача не выполнена.\n\n"
                    f"Причина: {result.get('reason', '?')}")
            else:
                show_output_dialog(
                    f"⚠️ {task.get('name', '?')} (с ошибками)",
                    result.get("log", "?"))
            if on_done:
                try:
                    on_done()
                except Exception:
                    pass
        app.after(0, finish)
    threading.Thread(target=worker, daemon=True).start()


