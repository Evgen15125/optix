def human_size(num_bytes):
    for unit in ["Б", "КБ", "МБ", "ГБ", "ТБ"]:
        if num_bytes < 1024:
            return f"{num_bytes:.1f} {unit}"
        num_bytes /= 1024
    return f"{num_bytes:.1f} ТБ"


def expand_paths(path):
    if path is None:
        return []
    if "*" in path:
        return glob.glob(path)
    return [path]


def load_exclusions():
    try:
        with open(EXCLUSIONS_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return []


def save_exclusions(items):
    try:
        with open(EXCLUSIONS_PATH, "w", encoding="utf-8") as f:
            json.dump(items, f, ensure_ascii=False, indent=2)
    except Exception as e:
        log_error("save_exclusions", e)


def is_excluded(path):
    if not path:
        return False
    exclusions = load_exclusions()
    p_low = os.path.normpath(path).lower()
    for ex in exclusions:
        ex_low = os.path.normpath(ex).lower()
        if p_low == ex_low or p_low.startswith(ex_low + os.sep):
            return True
    return False


def _is_hidden_system(path):
    """Проверяет, что файл — скрытый+системный (например, desktop.ini)."""
    try:
        if WIN32_AVAILABLE:
            import win32con
            attrs = win32api.GetFileAttributes(path)
            if attrs != -1:
                if (attrs & win32con.FILE_ATTRIBUTE_HIDDEN) and \
                   (attrs & win32con.FILE_ATTRIBUTE_SYSTEM):
                    return True
                return False
    except Exception:
        pass
    try:
        st = os.stat(path)
        attrs = getattr(st, "st_file_attributes", 0)
        if attrs & 0x02 and attrs & 0x04:  # HIDDEN | SYSTEM
            return True
    except Exception:
        pass
    return False


SECURE_DELETE = {"enabled": False, "passes": 1, "use_backup": False}

DRY_RUN = {"enabled": False}
CLEAN_AGE_FILTER = {"min_days": 0}

TRASH_MONITOR = {
    "active": False,
    "history": {},
    "started_at": 0,
    "threshold_mb": 500,
    "last_alert": 0,
    "watched_cats": [],
}


def secure_delete_file(path):
    try:
        if not os.path.isfile(path):
            return False
        size = os.path.getsize(path)
        if size == 0:
            os.remove(path)
            return True
        if size > 100 * 1024 * 1024:
            os.remove(path)
            return True
        passes = SECURE_DELETE.get("passes", 1)
        with open(path, "r+b") as f:
            for _ in range(passes):
                f.seek(0)
                remaining = size
                chunk = 65536
                while remaining > 0:
                    write_size = min(chunk, remaining)
                    f.write(os.urandom(write_size))
                    remaining -= write_size
                f.flush()
                os.fsync(f.fileno())
        os.remove(path)
        return True
    except PermissionError:
        # Файл занят другим процессом (WinError 32) или нет прав
        # (WinError 13). Для Temp-папок, кэшей браузеров, C:\Windows\Temp
        # это норма — файл просто пропускается. Не пишем в лог.
        try:
            os.remove(path)
        except Exception:
            pass
        return False
    except Exception as e:
        log_error(f"secure_delete({path})", e)
        try:
            os.remove(path)
        except Exception:
            pass
        return False


def folder_size(path):
    total = 0
    if not path or not os.path.exists(path):
        return -1
    try:
        for root, dirs, files in os.walk(path):
            for f in files:
                try:
                    fp = os.path.join(root, f)
                    if os.path.isfile(fp):
                        total += os.path.getsize(fp)
                except (OSError, PermissionError):
                    pass
    except (OSError, PermissionError):
        pass
    return total


def count_files_in_folder(path):
    cnt = 0
    if not path or not os.path.isdir(path):
        return 0
    try:
        for _, _, fs in os.walk(path):
            cnt += len(fs)
    except Exception:
        pass
    return cnt


def _expand_packages(pattern):
    base = os.path.expandvars(r"%LOCALAPPDATA%\Packages")
    if not os.path.isdir(base):
        return []
    result = []
    try:
        for pkg in os.listdir(base):
            full = os.path.join(base, pkg, pattern)
            if "*" in full:
                result.extend(glob.glob(full))
            elif os.path.isdir(full):
                result.append(full)
    except Exception:
        pass
    return result


def _move_to_backup(full_path):
    try:
        if not os.path.exists(full_path):
            return
        os.makedirs(BACKUP_DIR, exist_ok=True)
        rel = full_path.replace(":", "").replace("\\", "_").replace("/", "_")
        if len(rel) > 180:
            rel = rel[-180:]
        dst = os.path.join(BACKUP_DIR, rel)
        if os.path.exists(dst):
            base, ext = os.path.splitext(rel)
            dst = os.path.join(BACKUP_DIR, f"{base}_{int(time.time())}{ext}")
        shutil.move(full_path, dst)
    except Exception as e:
        log_error(f"_move_to_backup({full_path})", e)


def category_size(cat):
    ctype = cat.get("type", "folder")
    if ctype == "recycle_bin":
        return recycle_bin_size()
    if ctype == "packages_cache":
        total = 0
        found = False
        for base in _expand_packages(""):
            for sub in ["LocalCache", "AC\\INetCache", "LocalState\\Cache"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p):
                    found = True
                    total += max(0, folder_size(p))
        return total if found else -1
    if ctype == "packages_temp":
        total = 0
        found = False
        for base in _expand_packages(""):
            for sub in ["TempState", "AC\\Temp"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p):
                    found = True
                    total += max(0, folder_size(p))
        return total if found else -1
    if ctype == "old_drivers":
        return -1
    total = 0
    found_any = False
    for p in expand_paths(cat["path"]):
        s = folder_size(p)
        if s >= 0:
            found_any = True
            total += s
    return total if found_any else -1


def clean_folder(path, exclusions_aware=True):
    freed = 0
    files_del = 0
    errors = 0
    if not path or not os.path.exists(path):
        return 0, 0, 0
    use_backup = SECURE_DELETE.get("use_backup", False) and not SECURE_DELETE["enabled"]
    dry = DRY_RUN.get("enabled", False)
    min_days = CLEAN_AGE_FILTER.get("min_days", 0)
    cutoff_time = time.time() - (min_days * 86400) if min_days > 0 else 0

    try:
        for entry in os.listdir(path):
            full = os.path.join(path, entry)
            if exclusions_aware and is_excluded(full):
                continue
            try:
                if min_days > 0:
                    try:
                        mtime = os.path.getmtime(full)
                        if mtime > cutoff_time:
                            continue
                    except Exception:
                        pass

                if os.path.isfile(full) or os.path.islink(full):
                    size = os.path.getsize(full)
                    if dry:
                        freed += size
                        files_del += 1
                        continue
                    if use_backup:
                        _move_to_backup(full)
                        freed += size
                        files_del += 1
                    elif SECURE_DELETE["enabled"]:
                        if secure_delete_file(full):
                            freed += size
                            files_del += 1
                    else:
                        os.remove(full)
                        freed += size
                        files_del += 1
                elif os.path.isdir(full):
                    if exclusions_aware and is_excluded(full):
                        continue
                    size = max(0, folder_size(full))
                    cnt = count_files_in_folder(full)
                    if dry:
                        freed += size
                        files_del += cnt
                        continue
                    if use_backup:
                        _move_to_backup(full)
                    elif SECURE_DELETE["enabled"]:
                        for root_, _, files_ in os.walk(full, topdown=False):
                            for f_ in files_:
                                fp_ = os.path.join(root_, f_)
                                if not is_excluded(fp_):
                                    secure_delete_file(fp_)
                        shutil.rmtree(full, ignore_errors=True)
                    else:
                        shutil.rmtree(full, ignore_errors=True)
                    freed += size
                    files_del += cnt
            except (OSError, PermissionError):
                errors += 1
                continue
    except (OSError, PermissionError):
        pass
    return freed, files_del, errors


def clean_category(cat):
    ctype = cat.get("type", "folder")
    if ctype == "recycle_bin":
        return clean_recycle_bin()
    if ctype == "old_drivers":
        return clean_old_drivers()
    if ctype == "packages_cache":
        tf = tn = te = 0
        for base in _expand_packages(""):
            for sub in ["LocalCache", "AC\\INetCache", "LocalState\\Cache"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p):
                    f_, n_, e_ = clean_folder(p)
                    tf += f_
                    tn += n_
                    te += e_
        return tf, tn, te
    if ctype == "packages_temp":
        tf = tn = te = 0
        for base in _expand_packages(""):
            for sub in ["TempState", "AC\\Temp"]:
                p = os.path.join(base, sub)
                if os.path.isdir(p):
                    f_, n_, e_ = clean_folder(p)
                    tf += f_
                    tn += n_
                    te += e_
        return tf, tn, te
    freed = files_del = errors = 0
    for p in expand_paths(cat["path"]):
        f_, n_, e_ = clean_folder(p)
        freed += f_
        files_del += n_
        errors += e_
    return freed, files_del, errors


def clean_old_drivers():
    try:
        r = subprocess.run(["pnputil", "/enum-drivers"],
                           capture_output=True, text=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="cp866", errors="replace")
        out = r.stdout or ""
        oem_drivers = []
        current = {}
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("Опубликованное имя") or line.startswith("Published Name"):
                if current.get("oem"):
                    oem_drivers.append(current)
                current = {"oem": line.split(":", 1)[-1].strip()}
            elif line.startswith("Имя поставщика") or line.startswith("Provider Name"):
                current["provider"] = line.split(":", 1)[-1].strip()
        if current.get("oem"):
            oem_drivers.append(current)
        to_delete = [d for d in oem_drivers
                     if "microsoft" not in d.get("provider", "").lower()]
        if not to_delete:
            return 0, 0, 0
        if DRY_RUN.get("enabled", False):
            return 0, len(to_delete), 0
        deleted = 0
        for d in to_delete[:20]:
            try:
                rr = subprocess.run(
                    ["pnputil", "/delete-driver", d["oem"], "/uninstall", "/force"],
                    capture_output=True, text=True, timeout=30,
                    creationflags=CREATE_NO_WINDOW,
                    encoding="cp866", errors="replace")
                if rr.returncode == 0:
                    deleted += 1
            except Exception:
                continue
        return 0, deleted, 0
    except Exception as e:
        log_error("clean_old_drivers", e)
        return 0, 0, 1


def recycle_bin_size():
    total = 0
    found_any = False
    for drive in string.ascii_uppercase:
        rb = f"{drive}:\\$Recycle.Bin"
        if os.path.isdir(rb):
            found_any = True
            s = folder_size(rb)
            if s > 0:
                total += s
    return total if found_any else -1


def clean_recycle_bin():
    size_before = recycle_bin_size()
    if size_before < 0:
        size_before = 0
    if DRY_RUN.get("enabled", False):
        return size_before, 0, 0
    try:
        ctypes.windll.shell32.SHEmptyRecycleBinW(None, None, 1 | 2 | 4)
    except Exception:
        pass
    return size_before, 0, 0


def extract_key_lines(text):
    keywords_good = [
        "восстанов", "успешно заверш", "не найдено", "не обнаружено",
        "не требуется", "защита ресурсов windows не обнаружила",
        "коррект", "healthy", "successfully", "no integrity",
        "found no", "все компоненты", "компоненты восстановлены",
        "нарушений целостности не обнаружено", "операция успешно",
        "the operation completed successfully",
    ]
    keywords_bad = [
        "поврежд", "ошиб", "error", "corrupt", "failed", "не удалось",
        "не выполнена", "отказ", "дефект", "сбой",
        "could not", "was not", "cannot",
    ]
    found = []
    for line in text.splitlines():
        s = line.strip()
        if not s or len(s) < 3:
            continue
        low = s.lower()
        is_good = any(k in low for k in keywords_good)
        is_bad = any(k in low for k in keywords_bad)
        if is_good and not is_bad:
            found.append(("good", s))
        elif is_bad and not is_good:
            found.append(("bad", s))
    return found[:15]


def run_command_with_output(cmd, timeout=600):
    """
    Запускает команду. Кодировка определяется автоматически по первым байтам:
    BOM UTF-16LE/BE, UTF-8 BOM, иначе cp866 (OEM для русской Windows).
    """
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           creationflags=CREATE_NO_WINDOW)
        raw_out = r.stdout or b""
        raw_err = r.stderr or b""
        out = _decode_console_bytes(raw_out)
        if raw_err:
            out += "\n" + _decode_console_bytes(raw_err)
        return r.returncode == 0, out
    except subprocess.TimeoutExpired:
        return False, f"Таймаут ({timeout} сек)"
    except Exception as e:
        return False, str(e)


def _text_quality(text):
    """
    Оценивает «читаемость» текста от 0.0 до 1.0.
    Считаем «хорошими»: пробелы, ASCII, кириллицу, типографские знаки.
    «Плохими»: управляющие символы, replacement char (U+FFFD).
    """
    if not text:
        return 0.0
    sample = text[:3000]
    good = 0
    bad = 0
    total = 0
    for ch in sample:
        total += 1
        o = ord(ch)
        if ch in " \t\r\n":
            good += 1
        elif 32 <= o <= 126:
            good += 1
        elif 0x0400 <= o <= 0x04FF:
            good += 1
        elif o in (0x00AB, 0x00BB, 0x2013, 0x2014, 0x2018, 0x2019,
                   0x201C, 0x201D, 0x2026, 0x00A0, 0x2022):
            good += 1
        elif o == 0xFFFD:
            bad += 1
        elif o < 32 and ch not in " \t\r\n":
            bad += 1
    if total == 0:
        return 0.0
    # Хорошие делим на общее число, плюс штраф за мусор
    return (good - bad * 0.5) / total


def _decode_console_bytes(raw):
    """
    Определяет кодировку консольного вывода.
    Пробует несколько вариантов и выбирает наиболее читаемый.
    """
    if not raw:
        return ""
    # 1. BOM-детект
    if raw[:2] == b"\xff\xfe":
        try:
            return raw.decode("utf-16-le", errors="replace")
        except Exception:
            pass
    if raw[:2] == b"\xfe\xff":
        try:
            return raw.decode("utf-16-be", errors="replace")
        except Exception:
            pass
    if raw[:3] == b"\xef\xbb\xbf":
        try:
            return raw.decode("utf-8", errors="replace")
        except Exception:
            pass

    # 2. Пробуем все варианты и оцениваем качество
    candidates = []
    for enc in ("utf-16-le", "utf-16-be", "cp866", "cp1251", "utf-8"):
        try:
            text = raw.decode(enc, errors="replace")
            score = _text_quality(text)
            candidates.append((score, text))
        except Exception:
            continue

    if not candidates:
        return raw.decode("utf-8", errors="replace")

    candidates.sort(key=lambda x: -x[0])
    return candidates[0][1]


