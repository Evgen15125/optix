                                 font=("Inter", 12, "bold"),
                                 fg_color=c["fg"], hover_color=c["hover"],
                                 corner_radius=18, command=cmd)

        # Ряд 1
        make_btn(btn_grid, "🔍 SMART", mk(fn=show_smart)).grid(row=0, column=0, padx=3, pady=3, sticky="ew")
        if media == "ssd":
            make_btn(btn_grid, "⚡ TRIM", mk(fn=run_trim), "green").grid(row=0, column=1, padx=3, pady=3, sticky="ew")
        elif media == "hdd":
            make_btn(btn_grid, "🧩 Дефраг", mk(fn=run_defrag), "green").grid(row=0, column=1, padx=3, pady=3, sticky="ew")
        else:
            make_btn(btn_grid, "—", lambda: None).grid(row=0, column=1, padx=3, pady=3, sticky="ew")
        make_btn(btn_grid, "🔬 Детальный SMART", mk(fn=show_detailed_smart)).grid(row=0, column=2, padx=3, pady=3, sticky="ew")

        # Ряд 2
