def _open_feedback_mail():
    """
    Окно отправки отзыва через Web3Forms API.
    Письмо уходит напрямую на email разработчика.
    Не требует почтовых клиентов, браузеров и mailto:.
    """
    import urllib.request
    import urllib.parse
    import json as _json

    # ⚠️ Ключи Web3Forms
    ACCESS_KEY = "581bd5b6-80c3-4cf3-b282-3e61d5ab2037"
    DEVELOPER_EMAIL = "evgen.chernyatin@gmail.com"

    dlg = ctk.CTkToplevel(app)
    dlg.title("📨 Отправить отзыв")
    dlg.geometry("700x680")
    _center_window(dlg)
    dlg.configure(fg_color="#0A1A30")
