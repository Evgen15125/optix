def _cleanup_optix_files():
    """Очищает папку программы от старых логов, отчетов и кэша."""
    if not messagebox.askyesno(
        "🧹 Очистка папки Optix",
        "Удалить временные файлы, старые отчеты, логи и историю?\n\n"
        "✅ Будут удалены: кэш, старые отчеты (.txt), логи, "
        "история очисток/тестов/температур.\n"
        "❌ НЕ будут удалены: настройки, профили, задачи, бэкапы твиков."
    ):
        return

    deleted_count = 0
    freed_bytes = 0
    errors = []

    def safe_remove(path, is_dir=False):
        nonlocal deleted_count, freed_bytes
        try:
            if is_dir:
                if os.path.exists(path):
                    size = folder_size(path)
                    shutil.rmtree(path, ignore_errors=True)
                    freed_bytes += max(0, size)
                    deleted_count += 1
            else:
                if os.path.exists(path):
                    size = os.path.getsize(path)
                    os.remove(path)
                    freed_bytes += size
                    deleted_count += 1
        except Exception as e:
            errors.append(f"{os.path.basename(path)}: {e}")

    # 1. Папки (кэш и старые снимки)
    safe_remove(os.path.join(BASE_DIR, "__pycache__"), True)
    safe_remove(os.path.join(BASE_DIR, "disk_snapshots"), True)
    safe_remove(os.path.join(BASE_DIR, "diagnostics_reports"), True)

    # 2. Старые текстовые отчеты (по маске)
    for pattern in ("Optix_AutoReport_*.txt", "Optix_DiagReport_*.txt", "monitor_report_*.txt"):
        for fp in glob.glob(os.path.join(BASE_DIR, pattern)):
            safe_remove(fp)

    # 3. Логи
    for fname in ("startup_debug.log", "scheduler_log.txt"):
        safe_remove(os.path.join(BASE_DIR, fname))

    # optix_errors.log — очищаем (не удаляем)
    try:
        if os.path.exists(ERRORS_LOG):
            freed_bytes += os.path.getsize(ERRORS_LOG)
            with open(ERRORS_LOG, "w", encoding="utf-8") as f:
                f.write("")
            deleted_count += 1
    except Exception as e:
        errors.append(f"optix_errors.log: {e}")

    # 4. История
    for fname in ("benchmark_history.json", "clean_history.json",
                  "driver_history.json", "task_history.json",
                  "temp_history.json"):
        safe_remove(os.path.join(BASE_DIR, fname))

    # 5. Старый бэкап кода
    safe_remove(os.path.join(BASE_DIR, "app_backup.pyw"))

    # Итог
    msg = f"Удалено файлов и папок: {deleted_count}\nОсвобождено: {human_size(freed_bytes)}"
    if errors:
        msg += f"\n\nОшибки ({len(errors)}):\n" + "\n".join(errors[:5])
    
    messagebox.showinfo("Очистка завершена", msg)
    try: 
        show_toast("Optix — Очистка", f"Освобождено: {human_size(freed_bytes)}")
    except Exception: 
        pass


