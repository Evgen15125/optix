    ctrl = ctk.CTkFrame(win, fg_color="transparent")
    ctrl.pack(pady=(0, 8), padx=20, fill="x")
    path_var = ctk.StringVar(value="")
    ctk.CTkEntry(ctrl, textvariable=path_var, placeholder_text="Папка для поиска",
                 height=38, font=("Inter", 12), fg_color="#1F2E4A", text_color="#ffffff", corner_radius=10).pack(
        side="left", fill="x", expand=True, padx=(0, 8))

    def choose_dir():
        d = filedialog.askdirectory(title="Папка для поиска")
        if d: path_var.set(d)

    ctk.CTkButton(ctrl, text="📁 Выбрать", height=38, font=("Inter", 12, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5", corner_radius=10, command=choose_dir
                  ).pack(side="left", padx=(0, 8))
                  
    min_mb_var = ctk.StringVar(value="1")
    ctk.CTkLabel(ctrl, text="мин. МБ:", font=("Inter", 12), text_color="#82B1FF").pack(side="left", padx=(0, 4))
    ctk.CTkEntry(ctrl, textvariable=min_mb_var, width=60, height=38, font=("Consolas", 12),
                 fg_color="#1F2E4A", text_color="#ffffff", corner_radius=10).pack(side="left")
                 
    status_lbl = ctk.CTkLabel(win, text="Готово к поиску", font=("Inter", 12, "bold"),
                              text_color="#4FC3F7", fg_color="#131E32", corner_radius=10, height=28, border_width=1, border_color="#2A3B5C")
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")
    
    list_wrapper = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    list_wrapper.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    list_frame = ctk.CTkScrollableFrame(list_wrapper, fg_color="transparent", corner_radius=0)
    list_frame.pack(fill="both", expand=True, padx=4, pady=4)
    result_q = queue.Queue()

    def scan_worker(root, min_bytes):
        try:
            by_size = {}
            for r, dirs, files in os.walk(root):
                if "$Recycle.Bin" in r or "Windows\\System32" in r: continue
                for f in files:
                    try:
                        fp = os.path.join(r, f)
                        s = os.path.getsize(fp)
                        if s >= min_bytes: by_size.setdefault(s, []).append(fp)
                    except Exception: continue
            groups = []
            total = sum(1 for v in by_size.values() if len(v) > 1)
            done = 0
            for size, files in by_size.items():
                if len(files) < 2: continue
                by_hash = {}
                for fp in files:
                    try:
                        h = hashlib.md5()
                        with open(fp, "rb") as fh:
                            for chunk in iter(lambda: fh.read(1024 * 1024), b""): h.update(chunk)
                        by_hash.setdefault(h.hexdigest(), []).append(fp)
                    except Exception: continue
                for hh, group in by_hash.items():
                    if len(group) > 1: groups.append({"size": size, "files": group})
                done += 1
                result_q.put(("progress", done, total))
            groups.sort(key=lambda g: -g["size"] * (len(g["files"]) - 1))
            result_q.put(("done", groups))
        except Exception as e:
            log_error("dup scan", e)
            result_q.put(("error", str(e)))

    def poll():
        try: item = result_q.get_nowait()
        except queue.Empty:
            app.after(150, poll)
            return
        if item[0] == "progress":
            _, done, total = item
            status_lbl.configure(text=f"⏳ Хэширую: {done}/{total}", text_color="#FFD54F")
            app.after(100, poll)
            return
        if item[0] == "error":
            status_lbl.configure(text=f"⚠ {item[1][:120]}", text_color="#FF8A8A")
            return
        if item[0] == "done":
            groups = item[1]
            for w in list_frame.winfo_children(): w.destroy()
            if not groups:
                status_lbl.configure(text="✅ Дубликатов не найдено", text_color="#7CFC7C")
                return
            total_dup_size = sum(g["size"] * (len(g["files"]) - 1) for g in groups)
            status_lbl.configure(text=f"🎯 Групп: {len(groups)}  •  Можно освободить: {human_size(total_dup_size)}", text_color="#7CFC7C")
            for g in groups[:200]:
                box = ctk.CTkFrame(list_frame, fg_color="#1F2E4A", corner_radius=10)
                box.pack(fill="x", pady=3, padx=2)
                ctk.CTkLabel(box, text=f"📦 {human_size(g['size'])} × {len(g['files'])} копий",
                             font=("Inter", 12, "bold"), text_color="#4FC3F7", anchor="w").pack(fill="x", padx=12, pady=(6, 2))
                for fp in g["files"]:
                    ctk.CTkLabel(box, text=fp, font=("Consolas", 10), text_color="#e0e8f5", anchor="w").pack(fill="x", padx=18, pady=1)

                def mk_delete(files=g["files"]):
                    def do():
                        to_del = files[1:]
                        if not messagebox.askyesno("Удалить?", f"Удалить файлов: {len(to_del)}?\n(Первый файл будет сохранён)"): return
                        total = 0
                        for fp in to_del:
                            try:
                                if DRY_RUN.get("enabled", False): total += 1; continue
                                if SECURE_DELETE["enabled"]: secure_delete_file(fp)
                                elif SECURE_DELETE.get("use_backup"): _move_to_backup(fp)
                                else: os.remove(fp)
                                total += 1
                            except Exception as e: log_error(f"dup del {fp}", e)
                        prefix = "Могло быть удалено" if DRY_RUN.get("enabled") else "Удалено"
                        messagebox.showinfo("Готово", f"{prefix} файлов: {total}")
                    return do

                ctk.CTkButton(box, text="🗑 Удалить дубликаты", height=30, font=("Inter", 11, "bold"),
                              fg_color="#B71C1C", hover_color="#E53935", corner_radius=15, command=mk_delete()
                              ).pack(padx=12, pady=(6, 8), anchor="w")
            return
        app.after(100, poll)

    def start_scan():
        root = path_var.get().strip()
        if not root or not os.path.isdir(root):
            messagebox.showerror("Ошибка", "Укажите существующую папку.")
            return
        try: min_mb = float(min_mb_var.get().replace(",", "."))
        except Exception: min_mb = 1.0
        min_bytes = int(min_mb * 1024 * 1024)
        status_lbl.configure(text="⏳ Сканирование...", text_color="#FFD54F")
        for w in list_frame.winfo_children(): w.destroy()
        threading.Thread(target=scan_worker, args=(root, min_bytes), daemon=True).start()
        app.after(100, poll)

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="▶ Начать поиск", height=44, font=("Inter", 14, "bold"),
                  fg_color="#43A047", hover_color="#66BB6A", corner_radius=22, command=start_scan
                  ).pack(side="left", padx=(0, 6), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=44, font=("Inter", 14, "bold"),
                  fg_color="#455A64", hover_color="#546E7A", corner_radius=22, command=win.destroy
                  ).pack(side="left", padx=(6, 0), fill="x", expand=True)


