def open_task_history_window():
    win = ctk.CTkToplevel(app)
    win.title("📜 История задач")
    win.geometry("1100x740")
    win.configure(fg_color="#0A1A30")
    win.transient(app)
    _center_window(win)

    header_frame = ctk.CTkFrame(win, fg_color="#1565C0", corner_radius=18, height=44, border_width=1, border_color="#4FC3F7")
    header_frame.pack(pady=(16, 6), padx=20, ipadx=20)
    ctk.CTkLabel(header_frame, text="📜  История выполнения задач", font=("Inter", 20, "bold"), text_color="#ffffff").pack(pady=8, padx=15)

    runs = load_task_history()
    total = len(runs)
    success = sum(1 for r in runs if r.get("success"))
    fail = sum(1 for r in runs if not r.get("success") and not r.get("skipped"))
    skipped = sum(1 for r in runs if r.get("skipped"))

    stats_frame = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=12, border_width=1, border_color="#2A3B5C")
    stats_frame.pack(pady=(0, 8), padx=20, fill="x")
    ctk.CTkLabel(stats_frame,
                 text=f"Всего запусков: {total}   •   ✅ Успешно: {success}   •   ⚠️ Ошибки: {fail}   •   ⏹ Пропущено: {skipped}",
                 font=("Inter", 12, "bold"), text_color="#7CFC7C").pack(pady=8)

    chart_canvas = tk.Canvas(win, height=100, bg="#0D1B33", highlightthickness=0)
    chart_canvas.pack(fill="x", padx=20, pady=(0, 8))
    try: _draw_task_chart(chart_canvas, runs)
    except Exception as e: log_error("_draw_task_chart", e)

    wrap = ctk.CTkFrame(win, fg_color="#131E32", corner_radius=14, border_width=1, border_color="#2A3B5C")
    wrap.pack(padx=20, pady=(0, 8), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="transparent", corner_radius=0,
                                 scrollbar_button_color="#243A5E", scrollbar_button_hover_color="#4FC3F7")
    lst.pack(fill="both", expand=True, padx=4, pady=4)

    for r in reversed(runs[-200:]):
        row = ctk.CTkFrame(lst, fg_color="#1F2E4A", corner_radius=8, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=1, padx=2)
        
        if r.get("skipped"): icon, color = "⏹", "#FFD54F"
        elif r.get("success"): icon, color = "✅", "#7CFC7C"
        else: icon, color = "⚠️", "#FF8A8A"
        
        ctk.CTkLabel(row, text=icon, font=("Inter", 14), text_color=color, width=24).pack(side="left", padx=6)
        ctk.CTkLabel(row, text=r.get("task_name", "?")[:40], font=("Inter", 12, "bold"), text_color="#ffffff", width=280, anchor="w").pack(side="left", padx=4, pady=6)
        ctk.CTkLabel(row, text=r.get("started", "?")[:19], font=("Consolas", 10), text_color="#90CAF9", width=150, anchor="w").pack(side="left", padx=4)
        dur = r.get("duration", 0)
        ctk.CTkLabel(row, text=f"{dur:.1f} сек", font=("Consolas", 10), text_color="#B0BEC5", width=80, anchor="w").pack(side="left", padx=4)
        if r.get("freed"): ctk.CTkLabel(row, text=human_size(r["freed"]), font=("Consolas", 10, "bold"), text_color="#4FC3F7", width=100, anchor="e").pack(side="right", padx=6)
        if r.get("skipped"): ctk.CTkLabel(row, text=r.get("reason", "")[:30], font=("Inter", 10), text_color="#FFD54F").pack(side="right", padx=4)

    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 16), padx=20, fill="x")
    ctk.CTkButton(br, text="🔄 Обновить", height=38, font=("Inter", 12, "bold"), fg_color="#1F2E4A", hover_color="#2E5A8E", corner_radius=19,
                  command=lambda: (win.destroy(), open_task_history_window())).pack(side="left", padx=(0, 4), fill="x", expand=True)

    def clear_hist():
        if messagebox.askyesno("Очистить историю?", "Удалить все записи о запусках?"):
            save_task_history([])
            win.destroy()
            open_task_history_window()
    ctk.CTkButton(br, text="🗑 Очистить", height=38, font=("Inter", 12, "bold"), fg_color="#C62828", hover_color="#E53935", corner_radius=19, command=clear_hist).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(br, text="Закрыть", height=38, font=("Inter", 12, "bold"), fg_color="#455A64", hover_color="#546E7A", corner_radius=19, command=win.destroy).pack(side="left", padx=(4, 0), fill="x", expand=True)


def _draw_task_chart(canvas, runs):
    """График успехов/неудач за последние 7 дней."""
    canvas.delete("all")
    w = canvas.winfo_width()
    if w < 50:
        w = 1000
    h = 100
    canvas.create_rectangle(0, 0, w, h, fill="#0D1B33", outline="")

    # Группируем по дням
    from collections import defaultdict
    by_day = defaultdict(lambda: {"ok": 0, "fail": 0, "skip": 0})
    for r in runs:
        try:
            day = r.get("started", "")[:10]
            if not day:
                continue
            if r.get("skipped"):
                by_day[day]["skip"] += 1
            elif r.get("success"):
                by_day[day]["ok"] += 1
            else:
                by_day[day]["fail"] += 1
        except Exception:
            pass

    # Последние 7 дней
    today = datetime.now().date()
    days = []
    for i in range(6, -1, -1):
        d = today - __import__("datetime").timedelta(days=i)
        key = d.strftime("%Y-%m-%d")
        days.append((key, by_day.get(key, {"ok": 0, "fail": 0,
                                            "skip": 0})))

    max_val = max((v["ok"] + v["fail"] + v["skip"] for _, v in days),
                   default=1)
    if max_val <= 0:
        max_val = 1
    bar_w = (w - 40) / len(days)
    for i, (day, vals) in enumerate(days):
        x = 20 + i * bar_w
        bottom = h - 20
        total_h = (h - 40)
        y_ok = bottom - (vals["ok"] / max_val) * total_h
        y_fail = y_ok - (vals["fail"] / max_val) * total_h
        y_skip = y_fail - (vals["skip"] / max_val) * total_h

        if vals["ok"]:
            canvas.create_rectangle(x + 4, y_ok, x + bar_w - 4,
                                      bottom, fill="#7CFC7C",
                                      outline="")
        if vals["fail"]:
            canvas.create_rectangle(x + 4, y_fail, x + bar_w - 4,
                                      y_ok, fill="#FF8A8A", outline="")
        if vals["skip"]:
            canvas.create_rectangle(x + 4, y_skip, x + bar_w - 4,
                                      y_fail, fill="#FFD54F", outline="")

        canvas.create_text(x + bar_w / 2, bottom + 6,
                            text=day[5:], fill="#B0BEC5",
                            font=("Arial", 8))


