            if gone_iss:
                ctk.CTkLabel(sec_card,
                             text=f"   🟢 Исправлено замечаний: "
                                  f"{len(gone_iss)}",
                             font=("Arial", 10, "bold"),
                             text_color="#7CFC7C", anchor="w").pack(
                    fill="x", padx=14, pady=1)
            ctk.CTkLabel(sec_card, text="", height=6).pack()

    # ─── Кнопки ───
    br = ctk.CTkFrame(win, fg_color="transparent")
    br.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(br, text="🔍 Сравнить", height=42,
