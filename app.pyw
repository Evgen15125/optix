# ================== УМНЫЕ СЦЕНАРИИ ==================
def _run_scenario_logic(scenario_id, log_box, progress_bar, status_lbl):
    def log(msg, color="#e0e8f5"):
        def _ui():
            log_box.configure(state="normal")
            log_box.insert("end", f"{msg}\n", color)
            log_box.see("end")
            log_box.configure(state="disabled")
        app.after(0, _ui)

    def set_progress(val):
        # Плавная анимация прогресс-бара
        app.after(0, lambda: _animate_bar(progress_bar, progress_bar.get(), val, duration=400))

    try:
        # Запускаем пульсацию прогресс-бара при старте
        app.after(0, lambda: _start_pulse(progress_bar, "#43A047"))
        
        if scenario_id == "full":
            log("🌟 Запуск: Полное обслуживание", "#82B1FF")
            
            log("▶ Шаг 1/3: Очистка временных файлов...")
            set_progress(0.1)
            total_freed = 0
            for cat in CATEGORIES:
                if cat["name"] in ["Временные файлы Windows", "Временные файлы пользователя", "Prefetch (Windows)"]:
                    freed, _, _ = clean_category(cat)
                    total_freed += freed
            log(f"✅ Очистка завершена. Освобождено: {human_size(total_freed)}", "#7CFC7C")
            
            log("▶ Шаг 2/3: Применение оптимизаций...")
            set_progress(0.4)
            apply_power_high()
            apply_telemetry_off()
            apply_visual_effects_off()
            log("✅ Оптимизация применена (Питание, Телеметрия, Визуал)", "#7CFC7C")
            
            log("▶ Шаг 3/3: Формирование отчёта...")
            set_progress(0.7)
            data = collect_full_report()
            text = report_to_text(data)
            path = os.path.join(BASE_DIR, f"Optix_AutoReport_{datetime.now().strftime('%H%M%S')}.txt")
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            log(f"✅ Отчёт сохранён: {os.path.basename(path)}", "#7CFC7C")

        elif scenario_id == "gaming":
            log("🎮 Запуск: Игровой буст", "#82B1FF")
            
            log("▶ Шаг 1/2: Очистка кэшей GPU...")
            set_progress(0.2)
            total_freed = 0
            for cat in CATEGORIES:
                if "Кэш" in cat["name"] and ("DirectX" in cat["name"] or "NVIDIA" in cat["name"] or "AMD" in cat["name"]):
                    freed, _, _ = clean_category(cat)
                    total_freed += freed
            log(f"✅ Кэш GPU очищен. Освобождено: {human_size(total_freed)}", "#7CFC7C")
            
            log("▶ Шаг 2/2: Настройка производительности...")
            set_progress(0.6)
            apply_power_high()
            apply_gamebar_off()
            log("✅ Установлена высокая производительность, GameBar отключён.", "#7CFC7C")

        elif scenario_id == "diag":
            log("🩺 Запуск: Диагностика", "#82B1FF")
            
            log("▶ Шаг 1/2: Проверка системных файлов (SFC)...")
            set_progress(0.1)
            ok, out = run_command_with_output(["sfc", "/verifyonly"], timeout=600)
            log(f"✅ SFC завершён. Код: {ok}", "#7CFC7C")
            
            log("▶ Шаг 2/2: Сбор отчёта...")
            set_progress(0.7)
            data = collect_full_report()
            text = report_to_text(data)
            path = os.path.join(BASE_DIR, f"Optix_DiagReport_{datetime.now().strftime('%H%M%S')}.txt")
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            log(f"✅ Отчёт готов: {os.path.basename(path)}", "#7CFC7C")

        set_progress(1.0)
        app.after(0, lambda: _stop_pulse(progress_bar))
        app.after(0, lambda: status_lbl.configure(text="✅ Сценарий выполнен успешно!", text_color="#7CFC7C"))
        
        try: show_toast("Optix — Сценарий завершён", "Все действия выполнены успешно.")
        except: pass
        
    except Exception as e:
        app.after(0, lambda: _stop_pulse(progress_bar))
        log_error("_run_scenario_logic", e)
        log(f"❌ Ошибка: {e}", "#FF8A8A")
        app.after(0, lambda: status_lbl.configure(text="❌ Ошибка выполнения", text_color="#FF8A8A"))


