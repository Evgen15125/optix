    def _install_wua_driver_from_dialog(title):
        if not messagebox.askyesno(
            "Установить драйвер?",
            f"Установить через Windows Update Agent:\n\n{title}\n\n"
            f"⚠️ Будет скачан и установлен драйвер.\n"
            f"Рекомендуется создать точку восстановления.\n\n"
            f"Продолжить?"):
            return
        if not _driver_ensure_restore_point():
            return

        def worker():
            def progress(msg):
                app.after(0, lambda m=msg: status_lbl.configure(
                    text=f"⏳ {m[:80]}", text_color="#FFD54F"))
            ok, info = _wua_install_driver_by_title(title, progress)

            def finish():
                if ok:
                    status_lbl.configure(text="✅ Установлено",
                                          text_color="#7CFC7C")
                    show_output_dialog(
                        "Установка драйвера",
                        f"Драйвер установлен успешно.\n\n{info}")
                else:
                    status_lbl.configure(text="⚠️ Ошибка установки",
                                          text_color="#FF8A8A")
                    show_output_dialog(
                        "Ошибка установки драйвера", info or "?")
            app.after(0, finish)
        threading.Thread(target=worker, daemon=True).start()

    def _catalog_download_and_install(guid, title):
        if not messagebox.askyesno(
            "Скачать и установить драйвер?",
            f"Файл: {title}\n\n"
            f"Будет скачан с Microsoft Update Catalog и установлен.\n\n"
            f"⚠️ Рекомендуется создать точку восстановления.\n\n"
            f"Продолжить?"):
            return
        if not _driver_ensure_restore_point():
            return

        def worker():
            def progress(msg):
                app.after(0, lambda m=msg: status_lbl.configure(
                    text=f"⏳ {m[:80]}", text_color="#FFD54F"))

            progress("Получаю ссылки...")
            urls = _msuc_get_download_url(guid)
            if not urls:
                app.after(0, lambda: messagebox.showerror(
                    "Ошибка",
                    "Не удалось получить ссылки на скачивание.\n\n"
                    "Попробуйте открыть обновление в браузере "
                    "и скачать вручную."))
                return

            dl_dir = os.path.join(BASE_DIR, "driver_downloads")
            os.makedirs(dl_dir, exist_ok=True)

            downloaded = []
            for u in urls:
                path, err = _msuc_download_file(
                    u["url"], dl_dir, progress, u.get("filename"))
                if path:
                    downloaded.append(path)

            if not downloaded:
                app.after(0, lambda: messagebox.showerror(
                    "Ошибка", "Файлы не скачаны."))
                return

            for path in downloaded:
                progress(f"Установка: {os.path.basename(path)}")
                ok, info = _msuc_install_downloaded(path)
                if not ok:
                    app.after(0, lambda p=path, i=info:
                        messagebox.showwarning(
                            "Предупреждение",
                            f"Установка {os.path.basename(p)}:\n"
                            f"{i[:500]}"))

            def finish():
                status_lbl.configure(
                    text=f"✅ Скачано: {len(downloaded)} файл(ов) "
                         f"в {dl_dir}",
                    text_color="#7CFC7C")
                if messagebox.askyesno(
                    "Готово",
                    f"Скачано файлов: {len(downloaded)}\n\n"
                    f"Папка: {dl_dir}\n\n"
                    f"Открыть папку?"):
                    try:
                        os.startfile(dl_dir)
                    except Exception:
                        pass
            app.after(0, finish)
        threading.Thread(target=worker, daemon=True).start()

    def do_search():
        query = search_var.get().strip()
        source = src_var.get()
        search_state["source"] = source
        if not query and source == "WUA":
            query = ""  # Поиск всех
        if not query and source == "CAT":
            messagebox.showinfo("Optix",
                                 "Введите запрос для поиска в каталоге.")
            return

        status_lbl.configure(text="⏳ Поиск...", text_color="#FFD54F")
        for w in results_frame.winfo_children():
            w.destroy()
        ctk.CTkLabel(results_frame, text="⏳ Поиск...",
                     font=("Arial", 12),
                     text_color="#FFD54F").pack(pady=30)

        def worker():
            def progress(msg):
                app.after(0, lambda m=msg: status_lbl.configure(
                    text=f"⏳ {m[:80]}", text_color="#FFD54F"))

            if source == "WUA":
                # Если query похож на Hardware ID — используем как фильтр
                hw = query if ("\\" in query or "VEN_" in query
                                or "DEV_" in query) else None
                items = _wua_search_drivers_extended(
                    hardware_id=hw, include_optional=True,
                    progress_cb=progress)
                # Дополнительная фильтрация по названию
                if query and hw is None:
                    q_low = query.lower()
                    items = [x for x in items
                              if q_low in x["title"].lower()
                              or q_low in x.get("manufacturer", "").lower()
                              or q_low in x.get("model", "").lower()]
            else:
                items = _msuc_search_web(query, progress_cb=progress)

            search_state["items"] = items
            app.after(0, render_results)
            app.after(0, lambda: status_lbl.configure(
                text=f"✅ Найдено: {len(items)}",
                text_color="#7CFC7C" if items
                else "#FFD54F"))
        threading.Thread(target=worker, daemon=True).start()

    search_entry.bind("<Return>", lambda e: do_search())

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row, text="🔍 Искать", height=40,
                  font=("Inter", 14, "bold"), fg_color="#1976D2",
                  hover_color="#42A5F5", corner_radius=20,
                  command=do_search
                  ).pack(side="left", padx=(0, 4), fill="x", expand=True)
    ctk.CTkButton(btn_row, text="📂 Папка загрузок", height=40,
                  font=("Inter", 13, "bold"), fg_color="#455A64",
                  hover_color="#546E7A", corner_radius=20,
                  command=lambda: os.startfile(
                      os.path.join(BASE_DIR, "driver_downloads"))
                  if os.path.isdir(os.path.join(BASE_DIR,
                                                  "driver_downloads"))
                  else messagebox.showinfo("Optix",
                                            "Папка пуста.")
                  ).pack(side="left", padx=4, fill="x", expand=True)
    ctk.CTkButton(btn_row, text="Закрыть", height=40,
