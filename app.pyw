def _load_sidebar_icon(key):
    """Загружает PNG-иконку из папки icons и красит её в премиум-цвет."""
    icon_map = {
        "dashboard": "home", "clean": "trash-2", "monitor": "activity",
        "network": "globe", 
        "scenarios": "sparkles",  # <--- ДОБАВЬ ВОТ ЭТУ СТРОКУ
        "autostart": "rocket", "services": "wrench", "optimize": "zap",
        "disks": "hard-drive", "diagnostic": "stethoscope", "bench": "bar-chart-2",
        "programs": "package", "drivers": "cpu", "scheduler": "calendar-clock",
        "reports": "file-text"
    }
    fname = icon_map.get(key)
    if not fname:
        return None
        
    path = os.path.join(BASE_DIR, "icons", f"{fname}.png")
    if not os.path.exists(path):
        return None
        
    if key in _icon_cache:
        return _icon_cache[key]

    try:
        from PIL import Image
        img = Image.open(path).convert("RGBA")
        
        alpha = img.split()[3]
        color = Image.new("RGBA", img.size, (130, 177, 255, 255)) # #82B1FF
        color.putalpha(alpha)
        
        img = color.resize((22, 22), Image.LANCZOS)
        ctk_img = ctk.CTkImage(light_image=img, dark_image=img, size=(22, 22))
        _icon_cache[key] = ctk_img
        return ctk_img
    except Exception as e:
        log_error("_load_sidebar_icon", e)
        return None


