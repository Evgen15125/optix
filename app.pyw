        compare_btn = ctk.CTkButton(
            cmp_row, text="📊 Сравнить выбранные (2 снимка)",
            height=40, font=("Inter", 14, "bold"),
            fg_color="#7B1FA2", hover_color="#9C27B0",
            corner_radius=20, command=lambda: do_compare())
        compare_btn.pack(fill="x")
        state["compare_btn"] = compare_btn

        def update_compare_btn():
            n = len(state["selected"])
            if n == 2:
                compare_btn.configure(
                    state="normal",
                    text="📊 Сравнить выбранные (2 снимка)")
            else:
                compare_btn.configure(
                    state="disabled",
                    text=f"📊 Выберите 2 снимка (выбрано: {n})")

        update_compare_btn()

    def do_compare():
        if len(state["selected"]) != 2:
            return
        # Упорядочиваем по дате (более ранний — первый)
        a_path, b_path = state["selected"]
        a, b, deltas, err = _snapshots_compare(a_path, b_path)
        if err:
            messagebox.showerror("Ошибка", err)
            return
        # Сортируем по времени
        if a["timestamp"] > b["timestamp"]:
            a, b = b, a
            a_path, b_path = b_path, a_path
            a2, b2, deltas, err = _snapshots_compare(a_path, b_path)
        show_snapshot_diff(a, b, deltas)

    def refresh():
        state["snapshots"] = _snapshots_list()
        # Чистим selected от исчезнувших
        valid = {s["path"] for s in state["snapshots"]}
        state["selected"] = [p for p in state["selected"]
                              if p in valid]
        render()
        if state["snapshots"]:
            status_lbl.configure(
                text=f"Снимков: {len(state['snapshots'])}",
                text_color="#7CFC7C")

    refresh()


