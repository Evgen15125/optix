def _program_scan_leftovers(prog):
    """
    Ищет остатки программы:
    - файлы и папки в типовых местах
    - ключи реестра
    - ярлыки
    - службы
    - задачи планировщика
    """
    result = {"files": [], "registry": [],
              "shortcuts": [], "services": [], "tasks": []}
    name = prog.get("name", "")
    if not name:
        return result
    target_norm = _normalize_name(name)
    if len(target_norm) < 3:
        # Слишком короткое имя — избегаем ложных срабатываний
        return result

    # ─── 1. Файлы и папки ───
    search_dirs = [
        r"C:\Program Files",
        r"C:\Program Files (x86)",
        r"C:\ProgramData",
        os.path.expandvars(r"%APPDATA%"),
        os.path.expandvars(r"%LOCALAPPDATA%"),
        os.path.expandvars(r"%LOCALAPPDATA%\Programs"),
        os.path.expandvars(r"%LOCALAPPDATA%\Packages"),
        os.path.expandvars(r"%USERPROFILE%\Documents"),
        os.path.expandvars(r"%USERPROFILE%\Downloads"),
    ]
    for base in search_dirs:
        if not base or not os.path.isdir(base):
            continue
        try:
            for entry in os.listdir(base):
                full = os.path.join(base, entry)
                level = _match_level(entry, target_norm)
                if level == "none":
                    continue
                try:
                    if os.path.isdir(full):
                        sz = folder_size(full)
                    else:
                        sz = os.path.getsize(full)
                except Exception:
                    sz = 0
                result["files"].append({
                    "path": full,
                    "level": level,
                    "size": max(0, sz),
                    "is_dir": os.path.isdir(full),
                })
        except Exception:
            continue

    # ─── 2. Реестр ───
    reg_roots = [
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE", 2),
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\WOW6432Node", 2),
        (winreg.HKEY_CURRENT_USER, r"SOFTWARE", 2),
    ]

    def scan_reg_recursive(root, path, depth, max_depth):
        if depth > max_depth:
            return
        try:
            key = winreg.OpenKey(root, path, 0, winreg.KEY_READ)
        except Exception:
            return
        try:
            i = 0
            while True:
                try:
                    sub = winreg.EnumKey(key, i)
                    i += 1
                except OSError:
                    break
                level = _match_level(sub, target_norm)
                if level != "none":
                    full_path = path + "\\" + sub
                    result["registry"].append({
                        "path": full_path,
                        "hive": "HKLM" if root == winreg.HKEY_LOCAL_MACHINE
                                else "HKCU",
                        "key_name": sub,
                        "level": level,
                    })
                else:
                    # Продолжаем рекурсию
                    scan_reg_recursive(root, path + "\\" + sub,
                                        depth + 1, max_depth)
        finally:
            try:
                winreg.CloseKey(key)
            except Exception:
                pass

    for root, base_path, max_d in reg_roots:
        scan_reg_recursive(root, base_path, 0, max_d)

    # ─── 3. Ярлыки ───
    shortcut_dirs = [
        os.path.expandvars(r"%USERPROFILE%\Desktop"),
        os.path.expandvars(r"%PUBLIC%\Desktop"),
        os.path.expandvars(
            r"%APPDATA%\Microsoft\Windows\Start Menu\Programs"),
        os.path.expandvars(
            r"%PROGRAMDATA%\Microsoft\Windows\Start Menu\Programs"),
        os.path.expandvars(
            r"%APPDATA%\Microsoft\Internet Explorer\Quick Launch"),
    ]
    for base in shortcut_dirs:
        if not os.path.isdir(base):
            continue
        try:
            for root, dirs, files in os.walk(base):
                for f in files:
                    if not f.lower().endswith(".lnk"):
                        continue
                    base_name = os.path.splitext(f)[0]
                    level = _match_level(base_name, target_norm)
                    if level == "none":
                        continue
                    result["shortcuts"].append({
                        "path": os.path.join(root, f),
                        "name": f,
                        "level": level,
                    })
        except Exception:
            continue

    # ─── 4. Службы ───
    try:
        import psutil
        for svc in psutil.win_service_iter():
            try:
                info = svc.as_dict()
                disp = info.get("display_name", "") or info.get("name", "")
                nm = info.get("name", "")
                lvl1 = _match_level(nm, target_norm)
                lvl2 = _match_level(disp, target_norm)
                level = "exact" if "exact" in (lvl1, lvl2) else \
                    ("partial" if "partial" in (lvl1, lvl2) else "none")
                if level == "none":
                    continue
                result["services"].append({
                    "name": nm,
                    "display": disp,
                    "level": level,
                })
            except Exception:
                continue
    except Exception:
        pass

    # ─── 5. Задачи планировщика ───
    try:
        tasks = read_all_scheduled_tasks()
        for t in tasks:
            name_t = t.get("name", "")
            lvl = _match_level(name_t, target_norm)
            if lvl == "none":
                continue
            result["tasks"].append({
                "name": name_t,
                "task_full": t.get("task_full", ""),
                "level": lvl,
            })
    except Exception:
        pass

    return result


def _program_delete_leftovers(prog, to_delete):
    """Удаляет выбранные остатки с бэкапом реестра."""
    import shutil as _shutil
    stats = {
        "files_ok": 0, "files_err": 0,
        "reg_ok": 0, "reg_err": 0,
        "lnk_ok": 0, "lnk_err": 0,
        "svc_ok": 0, "svc_err": 0,
        "task_ok": 0, "task_err": 0,
        "backup_reg": "",
        "errors": [],
    }

    # ─── Бэкап реестра перед удалением ───
    if to_delete.get("registry"):
        try:
            os.makedirs(UNINSTALL_BACKUP_DIR, exist_ok=True)
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            safe_name = "".join(c if c.isalnum() else "_"
                                 for c in prog["name"])[:60]
            backup_file = os.path.join(
                UNINSTALL_BACKUP_DIR,
                f"reg_{safe_name}_{ts}.reg")
            # Экспортируем через reg export
            reg_paths = []
            for item in to_delete["registry"]:
                hive = "HKLM" if item["hive"] == "HKLM" \
                    else "HKCU"
                reg_paths.append(f"{hive}\\{item['path']}")
            if reg_paths:
                # reg export работает с одним ключом за раз
                # Экспортируем первый ключ — этого достаточно для восстановления
                r = subprocess.run(
                    ["reg", "export", reg_paths[0], backup_file, "/y"],
                    capture_output=True, timeout=30,
                    creationflags=CREATE_NO_WINDOW)
                if r.returncode == 0:
                    stats["backup_reg"] = backup_file
        except Exception as e:
            stats["errors"].append(f"backup_reg: {e}")

    # ─── Файлы и папки ───
    for item in to_delete.get("files", []):
        path = item["path"]
        try:
            if os.path.isdir(path):
                _shutil.rmtree(path, ignore_errors=False)
                stats["files_ok"] += 1
            elif os.path.isfile(path):
                os.remove(path)
                stats["files_ok"] += 1
        except Exception as e:
            stats["files_err"] += 1
            if len(stats["errors"]) < 20:
                stats["errors"].append(f"file {path}: {e}")

    # ─── Ярлыки ───
    for item in to_delete.get("shortcuts", []):
        try:
            os.remove(item["path"])
            stats["lnk_ok"] += 1
        except Exception as e:
            stats["lnk_err"] += 1
            if len(stats["errors"]) < 20:
                stats["errors"].append(f"lnk {item['path']}: {e}")

    # ─── Реестр ───
    def del_reg_tree(root, path):
        try:
            key = winreg.OpenKey(root, path, 0,
                                  winreg.KEY_READ)
        except FileNotFoundError:
            return True
        subkeys = []
        i = 0
        while True:
            try:
                subkeys.append(winreg.EnumKey(key, i))
                i += 1
            except OSError:
                break
        winreg.CloseKey(key)
        for sub in subkeys:
            del_reg_tree(root, path + "\\" + sub)
        try:
            winreg.DeleteKey(root, path)
            return True
        except Exception:
            return False

    for item in to_delete.get("registry", []):
        try:
            root = (winreg.HKEY_LOCAL_MACHINE
                     if item["hive"] == "HKLM"
                     else winreg.HKEY_CURRENT_USER)
            ok = del_reg_tree(root, item["path"])
            if ok:
                stats["reg_ok"] += 1
            else:
                stats["reg_err"] += 1
        except Exception as e:
            stats["reg_err"] += 1
            if len(stats["errors"]) < 20:
                stats["errors"].append(f"reg {item['path']}: {e}")

    # ─── Службы ───
    for item in to_delete.get("services", []):
        try:
            r = subprocess.run(
                ["sc", "stop", item["name"]],
                capture_output=True, timeout=30,
                creationflags=CREATE_NO_WINDOW)
            r = subprocess.run(
                ["sc", "delete", item["name"]],
                capture_output=True, timeout=30,
                creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                stats["svc_ok"] += 1
            else:
                stats["svc_err"] += 1
        except Exception as e:
            stats["svc_err"] += 1
            if len(stats["errors"]) < 20:
                stats["errors"].append(f"service {item['name']}: {e}")

    # ─── Задачи ───
    for item in to_delete.get("tasks", []):
        try:
            r = subprocess.run(
                ["schtasks", "/delete", "/tn", item["task_full"], "/f"],
                capture_output=True, timeout=30,
                creationflags=CREATE_NO_WINDOW)
            if r.returncode == 0:
                stats["task_ok"] += 1
            else:
                stats["task_err"] += 1
        except Exception as e:
            stats["task_err"] += 1
            if len(stats["errors"]) < 20:
                stats["errors"].append(f"task {item['task_full']}: {e}")

    return stats


def _programs_export(fmt="csv"):
    """Экспорт списка программ."""
    if not programs_all:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    default_name = f"Optix_Programs_{datetime.now().strftime('%Y-%m-%d_%H-%M')}"
    if fmt == "csv":
        path = filedialog.asksaveasfilename(
            title="Экспорт в CSV", defaultextension=".csv",
            initialfile=default_name + ".csv",
            filetypes=[("CSV", "*.csv")])
        if not path:
            return
        try:
            import csv
            with open(path, "w", encoding="utf-8-sig",
                      newline="") as f:
                w = csv.writer(f, delimiter=";")
                w.writerow(["Имя", "Версия", "Издатель", "Дата установки",
                            "Размер", "Оценка", "Путь установки",
                            "Деинсталлятор"])
                for p in programs_all:
                    icon, label, _, _ = _program_score_rating(
                        p["name"], p["publisher"])
                    w.writerow([
                        p["name"], p["version"], p["publisher"],
                        p["install_date"],
                        human_size(p["size_bytes"])
                        if p["size_bytes"] > 0 else "",
                        f"{icon} {label}",
                        _get_program_install_dir(p) or "",
                        p.get("uninstall", "") or "",
                    ])
            messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
        except Exception as e:
            log_error("_programs_export_csv", e)
            messagebox.showerror("Ошибка", str(e))

    elif fmt == "json":
        path = filedialog.asksaveasfilename(
            title="Экспорт в JSON", defaultextension=".json",
            initialfile=default_name + ".json",
            filetypes=[("JSON", "*.json")])
        if not path:
            return
        try:
            data = []
            for p in programs_all:
                icon, label, _, comment = _program_score_rating(
                    p["name"], p["publisher"])
                data.append({
                    "name": p["name"],
                    "version": p["version"],
                    "publisher": p["publisher"],
                    "install_date": p["install_date"],
                    "size_bytes": p["size_bytes"],
                    "rating": label,
                    "rating_comment": comment,
                    "install_location": _get_program_install_dir(p),
                    "uninstall_string": p.get("uninstall", ""),
                })
            with open(path, "w", encoding="utf-8") as f:
                json.dump({
                    "exported": datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"),
                    "computer": os.environ.get("COMPUTERNAME", "?"),
                    "total": len(data),
                    "programs": data,
                }, f, ensure_ascii=False, indent=2)
            messagebox.showinfo("Готово", f"JSON сохранён:\n{path}")
        except Exception as e:
            log_error("_programs_export_json", e)
            messagebox.showerror("Ошибка", str(e))

    else:  # txt
        path = filedialog.asksaveasfilename(
            title="Экспорт в TXT", defaultextension=".txt",
            initialfile=default_name + ".txt",
            filetypes=[("TXT", "*.txt")])
        if not path:
            return
        try:
            lines = ["=" * 70,
                     "  УСТАНОВЛЕННЫЕ ПРОГРАММЫ — Optix",
                     "=" * 70,
                     f"  Дата: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
                     f"  Всего: {len(programs_all)}",
                     ""]
            total_size = sum(p.get("size_bytes", 0) for p in programs_all)
            lines.append(f"  Общий размер: {human_size(total_size)}")
            lines.append("")
            # Группируем по издателю
            by_pub = {}
            for p in programs_all:
                pub = p.get("publisher", "") or "Без издателя"
                by_pub.setdefault(pub, []).append(p)
            for pub in sorted(by_pub.keys()):
                lines.append("─" * 70)
                lines.append(f"  {pub}")
                lines.append("─" * 70)
                for p in sorted(by_pub[pub],
                                 key=lambda x: x["name"].lower()):
                    icon, label, _, _ = _program_score_rating(
                        p["name"], p["publisher"])
                    lines.append(f"  {icon} {p['name']}")
                    lines.append(f"      Версия: {p['version'] or '—'}")
                    lines.append(f"      Дата:   {p['install_date'] or '—'}")
                    if p["size_bytes"] > 0:
                        lines.append(f"      Размер: "
                                     f"{human_size(p['size_bytes'])}")
                    lines.append("")
            with open(path, "w", encoding="utf-8-sig") as f:
                f.write("\n".join(lines))
            messagebox.showinfo("Готово", f"TXT сохранён:\n{path}")
        except Exception as e:
            log_error("_programs_export_txt", e)
            messagebox.showerror("Ошибка", str(e))


def _get_uwp_apps():
    """Возвращает список UWP-приложений (Microsoft Store)."""
    ps = (
        "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8;"
        "Get-AppxPackage | Where-Object { -not $_.IsFramework -and "
        "  $_.Name -notmatch '^Microsoft\\.(Windows|NET|VCLibs|UI)' } | "
        "Select-Object Name,PackageFullName,Version,PublisherDisplayName,"
        "InstallLocation,NonRemovable | ConvertTo-Json -Compress -Depth 3"
    )
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=60,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        out = (r.stdout or "").strip()
        if out.startswith("\ufeff"):
            out = out[1:]
        if not out or out == "null":
            return []
        data = json.loads(out)
        if isinstance(data, dict):
            data = [data]
        result = []
        for a in data:
            if not isinstance(a, dict):
                continue
            result.append({
                "name": str(a.get("Name") or "?"),
                "package": str(a.get("PackageFullName") or ""),
                "version": str(a.get("Version") or ""),
                "publisher": str(a.get("PublisherDisplayName") or ""),
                "install_location": str(a.get("InstallLocation") or ""),
                "non_removable": bool(a.get("NonRemovable")),
            })
        return result
    except Exception as e:
        log_error("_get_uwp_apps", e)
        return []


def _uwp_uninstall(pkg_name, app_name):
    """Удаляет UWP-приложение."""
    if not messagebox.askyesno(
        "Удалить UWP?",
        f"Удалить приложение Store:\n\n{app_name}\n\n"
        f"⚠️ Приложение будет удалено для всех пользователей.\n"
        f"Восстановить можно через Microsoft Store.\n\n"
        f"Продолжить?"):
        return
    ps = (f"Get-AppxPackage -AllUsers -Name '{pkg_name}' | "
          f"Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue")
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=120,
                           creationflags=CREATE_NO_WINDOW,
                           encoding="utf-8", errors="replace")
        if r.returncode == 0:
            messagebox.showinfo("Готово",
                f"Приложение {app_name} удалено.")
        else:
            messagebox.showerror("Ошибка",
                (r.stderr or r.stdout)[:500])
    except Exception as e:
        log_error("_uwp_uninstall", e)
        messagebox.showerror("Ошибка", str(e))


def load_installed_programs():
    programs = []
    seen = set()
    for root, path, view in UNINSTALL_KEYS:
        try:
            key = winreg.OpenKey(root, path, 0, winreg.KEY_READ | view)
        except Exception:
            continue
        i = 0
        while True:
            try:
                sub_name = winreg.EnumKey(key, i)
                i += 1
            except OSError:
                break
            try:
                sub = winreg.OpenKey(key, sub_name, 0,
                                     winreg.KEY_READ | view)
            except Exception:
                continue

            def gv(n, default=""):
                try:
                    v, _ = winreg.QueryValueEx(sub, n)
                    return v
                except Exception:
                    return default

            display_name = gv("DisplayName", "").strip()
            if not display_name:
                try:
                    winreg.CloseKey(sub)
                except Exception:
                    pass
                continue
            sc = gv("SystemComponent", 0)
            try:
                if int(sc) == 1:
                    winreg.CloseKey(sub)
                    continue
            except Exception:
                pass
            key_sign = (display_name.lower(), gv("DisplayVersion", ""))
            if key_sign in seen:
                try:
                    winreg.CloseKey(sub)
                except Exception:
                    pass
                continue
            seen.add(key_sign)
            size_kb = 0
            try:
                size_kb = int(gv("EstimatedSize", 0) or 0)
            except Exception:
                size_kb = 0
            uninstall_str = gv("UninstallString", "")
            quiet_str = gv("QuietUninstallString", "")
            install_loc = gv("InstallLocation", "")

            # ─── Определяем, битая ли запись ───
            broken = False
            broken_reason = ""
            if not uninstall_str and not quiet_str and not install_loc:
                broken = True
                broken_reason = "Нет деинсталлятора и пути установки"
            else:
                check_cmd = quiet_str or uninstall_str
                if check_cmd:
                    exe = _extract_exe_path(check_cmd)
                    if exe and not os.path.exists(exe) and not install_loc:
                        broken = True
                        broken_reason = f"Деинсталлятор не найден: {exe[:60]}"
                elif install_loc:
                    clean_loc = install_loc.strip().strip('"')
                    if clean_loc and not os.path.isdir(clean_loc):
                        broken = True
                        broken_reason = f"Папка не найдена: {clean_loc[:60]}"

            programs.append({
                "name": display_name,
                "version": gv("DisplayVersion", "").strip(),
                "publisher": gv("Publisher", "").strip(),
                "install_date": gv("InstallDate", "").strip(),
                "size_bytes": size_kb * 1024,
                "uninstall": uninstall_str,
                "quiet_uninstall": quiet_str,
                "install_location": install_loc,
                "broken": broken,
                "broken_reason": broken_reason,
                "_reg_root": root,
                "_reg_path": path,
                "_reg_view": view,
                "_reg_subkey": sub_name,
            })
            try:
                winreg.CloseKey(sub)
            except Exception:
                pass
        try:
            winreg.CloseKey(key)
        except Exception:
            pass
    programs.sort(key=lambda x: x["name"].lower())
    return programs


def refresh_programs_ui():
    tab = programs_ui.get("tab", "all")
    query = programs_ui["search"].get().strip().lower()
    sort_by = programs_ui["sort"].get()
    date_filter = programs_ui.get("date_filter", ctk.StringVar(value="Все")).get()
    score_filter = programs_ui.get("score_filter", ctk.StringVar(value="Все")).get()
    batch_selected = programs_ui.setdefault("batch_selected", set())

    if tab == "portable":
        _refresh_portable_ui(query, sort_by)
        return
    if tab == "watch":
        _refresh_install_watch_ui(query)
        return

    if tab == "uwp":
        source = programs_ui.get("uwp_cache", [])
        items = [{"name": a["name"], "version": a["version"], "publisher": a["publisher"],
                   "install_date": "", "size_bytes": 0, "uninstall": "", "quiet_uninstall": "",
                   "install_location": a["install_location"], "_is_uwp": True,
                   "_uwp_pkg": a["package"], "_non_removable": a.get("non_removable", False)} for a in source]
    elif tab == "broken":
        items = [p for p in programs_all if p.get("broken")]
    else:
        items = list(programs_all)

    if tab == "recent":
        items = [p for p in items if p.get("install_date")]
        items.sort(key=lambda x: x["install_date"] or "", reverse=True)

    if date_filter != "Все":
        try: days = int(date_filter.split()[1])
        except Exception: days = 0
        if days > 0:
            cutoff = datetime.now() - __import__("datetime").timedelta(days=days)
            filtered_items = []
            for p in items:
                dt = _parse_install_date(p.get("install_date", ""))
                if dt and dt >= cutoff: filtered_items.append(p)
            items = filtered_items

    if score_filter != "Все":
        filtered_items = []
        for p in items:
            icon, label, _, _ = _program_score_rating(p["name"], p.get("publisher", ""))
            if score_filter == "🟢 Нормальные" and icon != "🟢": continue
            if score_filter == "🟡 Осторожно" and icon != "🟡": continue
            if score_filter == "🔴 Подозрительные" and icon != "🔴": continue
            filtered_items.append(p)
        items = filtered_items

    if query:
        items = [p for p in items if query in p["name"].lower() or query in (p.get("publisher", "") or "").lower()]

    if sort_by == "По имени": items.sort(key=lambda x: x["name"].lower())
    elif sort_by == "По размеру": items.sort(key=lambda x: -(x.get("size_bytes", 0) or 0))
    elif sort_by == "По дате": items.sort(key=lambda x: x.get("install_date", "") or "0", reverse=True)
    elif sort_by == "По издателю": items.sort(key=lambda x: ((x.get("publisher", "") or "").lower(), x["name"].lower()))
    elif sort_by == "По оценке":
        order = {"🔴": 0, "🟡": 1, "⚪": 2, "🟢": 3}
        items.sort(key=lambda x: (order.get(_program_score_rating(x["name"], x.get("publisher", ""))[0], 4), x["name"].lower()))

    for w in programs_ui["list_frame"].winfo_children(): w.destroy()
    if not items:
        empty_frame = ctk.CTkFrame(programs_ui["list_frame"], fg_color="transparent")
        empty_frame.pack(pady=60)
        ctk.CTkLabel(empty_frame, text="🔍", font=("Inter", 48)).pack()
        ctk.CTkLabel(empty_frame, text="Ничего не найдено", font=("Inter", 18, "bold"), text_color="#ffffff").pack(pady=(10, 5))
        ctk.CTkLabel(empty_frame, text="Попробуйте изменить фильтры или строку поиска.", font=("Inter", 12), text_color="#90A4AE").pack()
        programs_ui["status"].configure(text="Показано: 0", text_color="#90A4AE")
        return

    total_size = sum(p.get("size_bytes", 0) or 0 for p in items)
    suspicious = sum(1 for p in items if _program_score_rating(p["name"], p.get("publisher", ""))[0] == "🔴")
    broken_count = sum(1 for p in items if p.get("broken"))
    
    status_color = "#7CFC7C"
    if broken_count > 0 or suspicious > 0: status_color = "#FFD54F"
    if broken_count > 5 or suspicious > 5: status_color = "#FF8A8A"
        
    programs_ui["status"].configure(
        text=f"Показано: {len(items)}   •   Размер: {human_size(total_size)}   •   "
             f"🔴 Подозрительных: {suspicious}   •   ⚠️ Битых: {broken_count}   •   "
             f"✔ Выбрано: {len(batch_selected)}", text_color=status_color)

    to_show = items[:200]
    for p in to_show:
        icon, label, color, comment = _program_score_rating(p["name"], p.get("publisher", ""))
        is_broken = p.get("broken", False)
        
        if is_broken: default_bg = "#3A1F1F"
        elif icon == "🔴": default_bg = "#2A2A3E"
        else: default_bg = "#1F2E4A"

        row = ctk.CTkFrame(programs_ui["list_frame"], fg_color=default_bg, corner_radius=10, border_width=1, border_color="#2A3B5C")
        row.pack(fill="x", pady=2, padx=2)

        def on_enter(e, r=row):
            try: r.configure(fg_color="#2E5A8E")
            except Exception: pass
        def on_leave(e, r=row, bg=default_bg):
            def check_later():
                try:
                    x, y = r.winfo_pointerxy()
                    rx, ry = r.winfo_rootx(), r.winfo_rooty()
                    rw, rh = r.winfo_width(), r.winfo_height()
                    if not (rx <= x <= rx + rw and ry <= y <= ry + rh):
                        r.configure(fg_color=bg)
                except Exception: pass
            r.after(15, check_later)

        def bind_hover(widget):
            if isinstance(widget, ctk.CTkButton): return
            try:
                widget.bind("<Enter>", on_enter, add="+")
                widget.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_canvas"):
                    widget._canvas.bind("<Enter>", on_enter, add="+")
                    widget._canvas.bind("<Leave>", on_leave, add="+")
                if hasattr(widget, "_label"):
                    widget._label.bind("<Enter>", on_enter, add="+")
                    widget._label.bind("<Leave>", on_leave, add="+")
            except Exception: pass
            for child in widget.winfo_children(): bind_hover(child)
        bind_hover(row)

        top = ctk.CTkFrame(row, fg_color="transparent")
        top.pack(fill="x", padx=(10, 10), pady=(8, 2))

        prog_key = p.get("_uwp_pkg") or p.get("name", "")
        var_batch = ctk.IntVar(value=1 if prog_key in batch_selected else 0)

        def mk_batch_toggle(key=prog_key, v=var_batch):
            def do():
                if v.get() == 1: batch_selected.add(key)
                else: batch_selected.discard(key)
                _update_batch_button()
            return do

        ctk.CTkCheckBox(top, text="", variable=var_batch, width=24, checkbox_width=20, checkbox_height=20, corner_radius=6,
                        fg_color="#43A047", hover_color="#66BB6A", border_color="#4FC3F7", border_width=2,
                        command=mk_batch_toggle()).pack(side="left", padx=(0, 8))
        
        ctk.CTkLabel(top, text="●", font=("Inter", 16, "bold"), text_color=color, width=18).pack(side="left")
        
        icon_img = _program_icon_cache.get(p["name"])
        if icon_img:
            ctk.CTkLabel(top, text="", image=icon_img, width=28).pack(side="left", padx=(0, 6))
        else:
            ctk.CTkLabel(top, text="📦", font=("Inter", 14), width=28).pack(side="left", padx=(0, 6))
        
        name_color = "#FF8A8A" if is_broken else ("#FFD54F" if icon == "🔴" else "#ffffff")
        ctk.CTkLabel(top, text=f"{p['name'][:60]}", font=("Inter", 13, "bold"), text_color=name_color, anchor="w", width=340).pack(side="left", padx=4)
        ctk.CTkLabel(top, text=(p.get("publisher") or "—")[:35], font=("Inter", 11), text_color="#90CAF9", anchor="w", width=180).pack(side="left", padx=4)
        ctk.CTkLabel(top, text=p.get("version") or "—", font=("Consolas", 11), text_color="#B0BEC5", anchor="w", width=100).pack(side="left", padx=4)
        
        size_text = human_size(p["size_bytes"]) if p.get("size_bytes", 0) > 0 else "—"
        ctk.CTkLabel(top, text=size_text, font=("Consolas", 12, "bold"), text_color="#4FC3F7", anchor="e", width=90).pack(side="left", padx=4)
        
        if p.get("install_date"):
            ctk.CTkLabel(top, text=p["install_date"][:10], font=("Consolas", 10), text_color="#90CAF9", anchor="e", width=100).pack(side="right", padx=4)

        btns = ctk.CTkFrame(row, fg_color="transparent")
        btns.pack(fill="x", padx=10, pady=(0, 8))
        
        if is_broken:
            ctk.CTkLabel(btns, text=f"⚠️ {p.get('broken_reason', '')[:70]}", font=("Inter", 11), text_color="#FF8A8A").pack(side="left", padx=4)
        elif p.get("_is_uwp"):
            if not p.get("_non_removable"):
                def mk_uwp_del(pkg=p["_uwp_pkg"], name=p["name"]):
                    return lambda: _uwp_uninstall(pkg, name)
                ctk.CTkButton(btns, text="🗑 Удалить", width=100, height=28, font=("Inter", 11, "bold"), fg_color="#C62828", hover_color="#E53935", corner_radius=14, command=mk_uwp_del()).pack(side="left", padx=(0, 4))
        else:
            def mk_un(prog=dict(p)):
                return lambda: _program_uninstall_single(prog)
            ctk.CTkButton(btns, text="🗑 Удалить", width=100, height=28, font=("Inter", 11, "bold"), fg_color="#C62828", hover_color="#E53935", corner_radius=14, command=mk_un()).pack(side="left", padx=(0, 4))

    try:
        btn_broken = programs_ui.get("tab_btns", {}).get("broken")
        if btn_broken:
            broken_total = sum(1 for p in programs_all if p.get("broken"))
            current_tab = programs_ui.get("tab", "all")
            if broken_total > 0:
                btn_broken.configure(text=f"⚠️ Битые ({broken_total})", fg_color="#C62828" if current_tab != "broken" else "#1565C0")
            else:
                btn_broken.configure(text="⚠️ Битые записи", fg_color="#1F2E4A" if current_tab != "broken" else "#1565C0")
    except Exception: pass
    try: _update_batch_button()
    except Exception: pass


def open_batch_uninstall():
    """Окно пакетного удаления выбранных программ."""
    batch = list(programs_ui.get("batch_selected", set()))
    if not batch:
        messagebox.showinfo("Optix", "Ни одна программа не выбрана.")
        return

    # Формируем список программ
    selected_progs = []
    for key in batch:
        # Ищем в обычных или UWP
        found = None
        for p in programs_all:
            if p.get("name") == key:
                found = dict(p)
                found["_is_uwp"] = False
                break
        if not found:
            for a in programs_ui.get("uwp_cache", []):
                if a.get("package") == key:
                    found = {
                        "name": a["name"],
                        "version": a["version"],
                        "publisher": a["publisher"],
                        "uninstall": "",
                        "quiet_uninstall": "",
                        "_is_uwp": True,
                        "_uwp_pkg": a["package"],
                        "_non_removable": a.get("non_removable", False),
                    }
                    break
        if found:
            selected_progs.append(found)

    if not selected_progs:
        messagebox.showinfo("Optix", "Не удалось найти выбранные программы.")
        return

    win = ctk.CTkToplevel(app)
    win.title("🗑 Пакетное удаление")
    win.geometry("900x680")
    win.configure(fg_color="#0A1A30")
    win.transient(app)

    ctk.CTkLabel(win, text="🗑  Пакетное удаление программ",
                 font=("Inter", 20, "bold"), text_color="#ffffff",
                 fg_color="#1565C0", corner_radius=14,
                 height=40).pack(pady=(14, 6), padx=20, ipadx=20)
    ctk.CTkLabel(win,
                 text="Программы удаляются по одной. После запуска "
                      "деинсталлятора дождитесь завершения мастера, "
                      "затем нажмите «Следующий».",
                 font=("Inter", 12), text_color="#B0BEC5",
                 justify="center").pack(pady=(0, 8))

    status_lbl = ctk.CTkLabel(win, text=f"К удалению: {len(selected_progs)}",
                              font=("Inter", 13, "bold"),
                              text_color="#FFD54F", fg_color="#0D47A1",
                              corner_radius=10, height=28)
    status_lbl.pack(pady=(0, 8), padx=20, fill="x")

    progress = ctk.CTkProgressBar(win, height=14,
                                    progress_color="#1976D2")
    progress.set(0)
    progress.pack(pady=(0, 8), padx=20, fill="x")

    wrap = ctk.CTkFrame(win, fg_color="#1A2A4A", corner_radius=14)
    wrap.pack(padx=20, pady=(0, 10), fill="both", expand=True)
    lst = ctk.CTkScrollableFrame(wrap, fg_color="#1A2A4A",
                                   corner_radius=0)
    lst.pack(fill="both", expand=True, padx=3, pady=3)

    state = {
        "index": 0,
        "progs": selected_progs,
        "row_widgets": [],
        "current_row": None,
    }

    def render():
        for w in lst.winfo_children():
            w.destroy()
        state["row_widgets"] = []
        for i, p in enumerate(state["progs"]):
            r = ctk.CTkFrame(lst, fg_color="#243A5E",
                              corner_radius=8)
            r.pack(fill="x", pady=2, padx=2)
            state["row_widgets"].append(r)
            # Индикатор
            icon_lbl = ctk.CTkLabel(r, text="●",
                                     font=("Inter", 18, "bold"),
                                     text_color="#90A4AE", width=24)
            icon_lbl.pack(side="left", padx=(8, 4), pady=6)
            ctk.CTkLabel(r, text=f"{i+1:>3}. {p['name'][:60]}",
                         font=("Inter", 13, "bold"),
                         text_color="#ffffff", anchor="w",
                         width=440).pack(side="left", padx=4, pady=6)
            ctk.CTkLabel(r, text=(p.get("publisher") or "—")[:30],
                         font=("Inter", 11),
                         text_color="#90CAF9",
                         anchor="w", width=180).pack(side="left",
                                                       padx=4, pady=6)
            ctk.CTkLabel(r, text="ожидание",
                         font=("Arial", 10, "bold"),
                         text_color="#B0BEC5", width=100,
                         anchor="e").pack(side="right", padx=8,
                                           pady=6)
        update_row_states()

    def update_row_states():
        for i, r in enumerate(state["row_widgets"]):
            try:
                icon_lbl = r.winfo_children()[0]
                status_lbl_w = r.winfo_children()[-1]
                if i < state["index"]:
                    icon_lbl.configure(text_color="#7CFC7C")
                    status_lbl_w.configure(text="✅ готово",
                                            text_color="#7CFC7C")
                elif i == state["index"]:
                    icon_lbl.configure(text_color="#FFD54F")
                    status_lbl_w.configure(text="▶ текущая",
                                            text_color="#FFD54F")
                else:
                    icon_lbl.configure(text_color="#90A4AE")
                    status_lbl_w.configure(text="ожидание",
                                            text_color="#B0BEC5")
            except Exception:
                pass
        # Прогресс
        total = len(state["progs"])
        progress.set(state["index"] / max(1, total))
        # Счётчик + «Следующая»
        next_text = ""
        if state["index"] < total:
            next_name = state["progs"][state["index"]]["name"][:40]
            next_text = f"   •   Следующая: {next_name}"
        status_lbl.configure(
            text=f"Осталось: {total - state['index']}   •   "
                 f"Готово: {state['index']} из {total}{next_text}",
            text_color="#4FC3F7" if state["index"] < total
            else "#7CFC7C")

    def run_current():
        if state["index"] >= len(state["progs"]):
            return
        p = state["progs"][state["index"]]

        # UWP-приложение
        if p.get("_is_uwp"):
            if p.get("_non_removable"):
                messagebox.showinfo(
                    "Optix",
                    f"«{p['name']}» — системное UWP-приложение.\n\n"
                    f"Его нельзя удалить через этот инструмент.")
                state["index"] += 1
                update_row_states()
                return
            _uwp_uninstall(p["_uwp_pkg"], p["name"])
            state["index"] += 1
            update_row_states()
            return

        # Обычная — запускаем деинсталлятор
        un = p.get("quiet_uninstall") or p.get("uninstall", "")
        if not un:
            if messagebox.askyesno(
                "Нет деинсталлятора",
                f"«{p['name']}» не имеет команды удаления.\n\n"
                f"Пропустить?"):
                state["index"] += 1
                update_row_states()
            return

        # Разбираем команду
        cmd = un.strip()
        if cmd.startswith('"'):
            end = cmd.find('"', 1)
            exe = cmd[1:end]
            params = cmd[end + 1:].strip()
        else:
            parts = cmd.split(" ", 1)
            exe = parts[0].strip('"')
            params = parts[1] if len(parts) > 1 else ""

        try:
            import ctypes
            ret = ctypes.windll.shell32.ShellExecuteW(
                None, "runas", exe, params, os.path.dirname(exe), 1)
            if ret <= 32:
                ret = ctypes.windll.shell32.ShellExecuteW(
                    None, "open", exe, params, os.path.dirname(exe), 1)
            if ret <= 32:
                raise OSError(f"ShellExecuteW код {ret}")
        except Exception as e:
            log_error("batch_uninstall_run", e)
            try:
                subprocess.Popen(un, shell=True)
            except Exception as e2:
                messagebox.showerror(
                    "Ошибка",
                    f"Не удалось запустить деинсталлятор:\n{e2}")
                return

        status_lbl.configure(
            text=f"▶ Запущено: {p['name']}\n"
                 f"Дождитесь мастера, потом нажмите «Следующий»",
            text_color="#FFD54F")

    def next_program():
        state["index"] += 1
        update_row_states()
        if state["index"] < len(state["progs"]):
            status_lbl.configure(
                text=f"Следующая: "
                     f"{state['progs'][state['index']]['name']}",
                text_color="#4FC3F7")

    def skip_current():
        p = state["progs"][state["index"]]
        if not messagebox.askyesno(
            "Пропустить?",
            f"Пропустить «{p['name']}»?"):
            return
        state["index"] += 1
        update_row_states()

    def clear_batch():
        if not messagebox.askyesno(
            "Очистить список?",
            "Все галочки в основном списке будут сняты."):
            return
        programs_ui["batch_selected"] = set()
        win.destroy()
        try:
            refresh_programs_ui()
        except Exception:
            pass

    def finish_batch():
        if not messagebox.askyesno(
            "Завершить?",
            "Закрыть окно пакетного удаления и очистить выбор?"):
            return
        programs_ui["batch_selected"] = set()
        win.destroy()
        try:
            refresh_programs_ui()
        except Exception:
            pass

    btn_row1 = ctk.CTkFrame(win, fg_color="transparent")
    btn_row1.pack(pady=(0, 6), padx=20, fill="x")
    ctk.CTkButton(btn_row1, text="▶ Запустить / Следующий",
                  height=42, font=("Inter", 14, "bold"),
                  fg_color="#43A047", hover_color="#66BB6A",
                  corner_radius=21, command=lambda: (
                      run_current() if state["index"] <
                      len(state["progs"]) else None)
                  ).pack(side="left", padx=(0, 4), fill="x",
                          expand=True)
    ctk.CTkButton(btn_row1, text="⏭ Пропустить",
                  height=42, font=("Inter", 13, "bold"),
                  fg_color="#455A64", hover_color="#546E7A",
                  corner_radius=21, command=skip_current
                  ).pack(side="left", padx=4, fill="x",
                          expand=True)
    ctk.CTkButton(btn_row1, text="✅ Следующий",
                  height=42, font=("Inter", 13, "bold"),
                  fg_color="#1976D2", hover_color="#42A5F5",
                  corner_radius=21, command=next_program
                  ).pack(side="left", padx=(4, 0), fill="x",
                          expand=True)

    btn_row2 = ctk.CTkFrame(win, fg_color="transparent")
    btn_row2.pack(pady=(0, 14), padx=20, fill="x")
    ctk.CTkButton(btn_row2, text="🧹 Очистить выбор",
                  height=38, font=("Inter", 13, "bold"),
                  fg_color="#455A64", hover_color="#546E7A",
                  corner_radius=19, command=clear_batch
                  ).pack(side="left", padx=(0, 4), fill="x",
                          expand=True)
    ctk.CTkButton(btn_row2, text="Готово", height=38,
                  font=("Inter", 13, "bold"), fg_color="#2E7D32",
                  hover_color="#43A047", corner_radius=19,
                  command=finish_batch
                  ).pack(side="left", padx=(4, 0), fill="x",
                          expand=True)

    render()


def load_programs_async():
    def worker():
        global programs_all
        programs_ui["status"].configure(text="Загрузка...", text_color="#FFD54F")
        programs_all = load_installed_programs()
        app.after(0, refresh_programs_ui)
    threading.Thread(target=worker, daemon=True).start()


# ================== ПОРТАТИВНЫЕ ПРИЛОЖЕНИЯ ==================

# Папки, которые НЕ сканируем (системные и служебные)
_PORTABLE_SKIP_DIRS = {
    "windows", "program files", "program files (x86)", "programdata",
    "$recycle.bin", "system volume information", "recovery", "perflogs",
    ".git", ".svn", "node_modules", "__pycache__", ".venv", "venv",
    ".idea", ".vscode", ".nuget", ".gradle", ".m2", ".cargo", ".npm",
    ".cache", "temp", "tmp", "appdata", "obj", "bin",
    "onedrivetemp", "packages", "winsxs",
}

# Имена папок, которые считаем "портативными" — заходим глубже
_PORTABLE_FAVORITE_NAMES = {
    "portable", "portableapps", "portable_apps", "portable programs",
    "portablesoft", "green", "greensoft", "greensoftware",
    "tools", "apps", "программы", "приложения", "софт", "сборник",
    "soft", "software", "portable soft",
}
_PORTABLE_FAVORITE_NAMES_LOWER = {s.lower() for s in _PORTABLE_FAVORITE_NAMES}

# Минимальный размер .exe, чтобы считать его приложением
_PORTABLE_MIN_SIZE = 5 * 1024 * 1024   # 5 МБ

# Плохие имена .exe — установщики, апдейтеры, хелперы
_PORTABLE_BAD_EXE_PREFIXES = (
    "unins", "uninstall", "setup", "install", "update", "updater",
    "installer", "vc_redist", "dxsetup", "directx", "crashpad",
    "helper", "agent", "service", "svc", "daemon",
    "crashreporter", "crashreport", "bugreport", "report",
    "7zsetup", "winsetup", "dotnet", "nvidia",  # Nvidia-хелперы в корне
)


def _get_drive_type(root):
    """1=NoRoot, 2=Removable, 3=Fixed, 4=Remote, 5=CD-ROM, 6=RAM."""
    try:
        return int(ctypes.windll.kernel32.GetDriveTypeW(root))
    except Exception:
        return 0


def _portable_should_skip_dir(dirname):
    low = dirname.lower()
    if low in _PORTABLE_SKIP_DIRS:
        return True
    if dirname.startswith("$") or dirname.startswith("."):
        return True
    return False


def _portable_is_bad_exe(name):
    low = name.lower()
    if not low.endswith(".exe"):
        return False
    for bad in _PORTABLE_BAD_EXE_PREFIXES:
        if low.startswith(bad):
            return True
    return False


def _get_exe_version_info(path):
    """Извлекает издателя, версию, описание из ресурсов .exe."""
    info = {"publisher": "", "version": "", "description": ""}
    if not WIN32_AVAILABLE:
        return info
    try:
        if not os.path.isfile(path):
            return info
        try:
            trans = win32api.GetFileVersionInfo(
                path, "\\VarFileInfo\\Translation")
            if trans:
                lang, cp = trans[0]
            else:
                lang, cp = 0x0409, 0x04B0
        except Exception:
            lang, cp = 0x0409, 0x04B0
        base = f"\\StringFileInfo\\{lang:04x}{cp:04x}\\"
        for key, target in (("CompanyName", "publisher"),
                             ("FileVersion", "version"),
                             ("FileDescription", "description")):
            try:
                val = win32api.GetFileVersionInfo(path, base + key)
                if val:
                    info[target] = str(val).strip()
            except Exception:
                continue
    except Exception:
        pass
    return info


def _extract_icon_pil(path, size=32):
    """
    Извлекает иконку файла через WinAPI (SHGetFileInfoW + DrawIconEx).
    Возвращает PIL.Image или None.
    """
    try:
        from PIL import Image
    except ImportError:
        return None

    SHGFI_ICON = 0x000000100
    SHGFI_SMALLICON = 0x000000001
    DI_NORMAL = 0x0003

    class SHFILEINFOW(ctypes.Structure):
        _fields_ = [
            ("hIcon", wintypes.HICON),
            ("iIcon", ctypes.c_int),
            ("dwAttributes", wintypes.DWORD),
            ("szDisplayName", ctypes.c_wchar * 260),
            ("szTypeName", ctypes.c_wchar * 80),
        ]

    shfi = SHFILEINFOW()
    user32 = ctypes.windll.user32
    gdi32 = ctypes.windll.gdi32
    shell32 = ctypes.windll.shell32

    try:
        res = shell32.SHGetFileInfoW(
            path, 0, ctypes.byref(shfi), ctypes.sizeof(shfi),
            SHGFI_ICON | SHGFI_SMALLICON)
        if not res or not shfi.hIcon:
            return None
        hicon = shfi.hIcon
    except Exception:
        return None

    hdc_screen = None
    hdc_mem = None
    hbmp = None
    try:
        hdc_screen = user32.GetDC(0)
        hdc_mem = gdi32.CreateCompatibleDC(hdc_screen)
        hbmp = gdi32.CreateCompatibleBitmap(hdc_screen, size, size)
        gdi32.SelectObject(hdc_mem, hbmp)

        # Заливаем чёрным (BLACKNESS = 0x00FF0062)
        gdi32.PatBlt(hdc_mem, 0, 0, size, size, 0x00FF0062)

        user32.DrawIconEx(hdc_mem, 0, 0, hicon, size, size, 0, None,
                           DI_NORMAL)

        class BITMAPINFOHEADER(ctypes.Structure):
            _fields_ = [
                ("biSize", wintypes.DWORD),
                ("biWidth", ctypes.c_long),
                ("biHeight", ctypes.c_long),
                ("biPlanes", wintypes.WORD),
                ("biBitCount", wintypes.WORD),
                ("biCompression", wintypes.DWORD),
                ("biSizeImage", wintypes.DWORD),
                ("biXPelsPerMeter", ctypes.c_long),
                ("biYPelsPerMeter", ctypes.c_long),
                ("biClrUsed", wintypes.DWORD),
                ("biClrImportant", wintypes.DWORD),
            ]

        bmi = BITMAPINFOHEADER()
        bmi.biSize = ctypes.sizeof(BITMAPINFOHEADER)
        bmi.biWidth = size
        bmi.biHeight = -size  # top-down
        bmi.biPlanes = 1
        bmi.biBitCount = 32
        bmi.biCompression = 0  # BI_RGB

        buffer_len = size * size * 4
        buffer = ctypes.create_string_buffer(buffer_len)

        got = gdi32.GetDIBits(
            hdc_mem, hbmp, 0, size, buffer, ctypes.byref(bmi), 0)
        if not got:
            return None

        img = Image.frombuffer(
            "RGBA", (size, size), buffer, "raw", "BGRA", 0, 1)
        img.load()

        # Убираем артефакт: чёрный фон → прозрачный (грубо, но работает)
        # Конвертируем в RGB для сохранения ссылки
        return img.convert("RGBA")
    except Exception:
        return None
    finally:
        try:
            if hbmp:
                gdi32.DeleteObject(hbmp)
        except Exception:
            pass
        try:
            if hdc_mem:
                gdi32.DeleteDC(hdc_mem)
        except Exception:
            pass
        try:
            if hdc_screen:
                user32.ReleaseDC(0, hdc_screen)
        except Exception:
            pass
        try:
            user32.DestroyIcon(hicon)
        except Exception:
            pass


def _make_placeholder_icon(name, size=32):
    """Fallback-иконка: цветной квадрат с буквой."""
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        return None
    img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    # Цвет по хэшу имени
    h = abs(hash(name)) & 0xFFFFFF
    r = (h >> 16) & 0xFF
    g = (h >> 8) & 0xFF
    b = h & 0xFF
    # Приглушаем и делаем насыщеннее
    r = min(200, (r + 100) // 2)
    g = min(200, (g + 100) // 2)
    b = min(200, (b + 100) // 2)
    draw.rectangle([0, 0, size - 1, size - 1], fill=(r, g, b, 255))
    letter = (name[0] if name else "?").upper()
    try:
        font = ImageFont.truetype("segoeui.ttf", int(size * 0.6))
    except Exception:
        font = ImageFont.load_default()
    try:
        bbox = draw.textbbox((0, 0), letter, font=font)
        tw = bbox[2] - bbox[0]
        th = bbox[3] - bbox[1]
        draw.text(((size - tw) / 2 - bbox[0],
                    (size - th) / 2 - bbox[1]),
                   letter, font=font, fill=(255, 255, 255, 255))
    except Exception:
        pass
    return img


def _is_path_running(path):
    """Проверяет, запущен ли процесс из этого .exe."""
    try:
        import psutil
        target = os.path.normcase(os.path.abspath(path))
        for p in psutil.process_iter(["exe"]):
            try:
                exe = p.info.get("exe")
                if exe and os.path.normcase(os.path.abspath(exe)) == target:
                    return True
            except Exception:
                continue
    except Exception:
        pass
    return False


def _scan_portable_apps(progress_cb=None):
    """
    Сканирует систему на портативные приложения.
    Возвращает список dict с ключами:
      path, name, filename, size, mtime, folder, is_removable.
    """
    results = {}

    def report(msg):
        if progress_cb:
            try:
                progress_cb(msg)
            except Exception:
                pass

    def walk_dir(root, max_depth, is_removable, current_depth=0):
        if current_depth > max_depth:
            return
        try:
            entries = list(os.scandir(root))
        except (PermissionError, OSError, FileNotFoundError):
            return

        exes_here = []
        subdirs = []
        for entry in entries:
            try:
                if entry.is_symlink():
                    continue
                if entry.is_file(follow_symlinks=False):
                    if entry.name.lower().endswith(".exe"):
                        exes_here.append(entry)
                elif entry.is_dir(follow_symlinks=False):
                    subdirs.append(entry)
            except OSError:
                continue

        # В текущей папке берём .exe подходящие
        for entry in exes_here:
            if _portable_is_bad_exe(entry.name):
                continue
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if st.st_size < _PORTABLE_MIN_SIZE:
                continue
            abs_path = entry.path
            if abs_path in results:
                continue
            results[abs_path] = {
                "path": abs_path,
                "name": os.path.splitext(entry.name)[0],
                "filename": entry.name,
                "size": st.st_size,
                "mtime": st.st_mtime,
                "folder": os.path.dirname(abs_path),
                "is_removable": is_removable,
            }

        # Рекурсия
        for entry in subdirs:
            if _portable_should_skip_dir(entry.name):
                continue
            if entry.name.lower() in _PORTABLE_FAVORITE_NAMES_LOWER:
                walk_dir(entry.path, max_depth + 2, is_removable,
                         current_depth + 1)
            else:
                walk_dir(entry.path, max_depth, is_removable,
                         current_depth + 1)

    # 1. Папки пользователя
    userprofile = os.path.expanduser("~")
    user_dirs = [
        ("Downloads", 2), ("Загрузки", 2),
        ("Desktop", 2), ("Рабочий стол", 2),
        ("Documents", 2), ("Документы", 2),
        ("PortableApps", 4), ("Portable", 4),
    ]
    for name, depth in user_dirs:
        p = os.path.join(userprofile, name)
        if os.path.isdir(p):
            report(f"Сканирую: {p}")
            walk_dir(p, depth, False)

    # 2. Все диски
    for letter in "CDEFGHIJKLMNOPQRSTUVWXYZ":
        root = f"{letter}:\\"
        if not os.path.exists(root):
            continue
        dtype = _get_drive_type(root)
        if dtype not in (2, 3):
            continue
        is_removable = (dtype == 2)
        if letter.upper() == "C":
            # Корень C: не сканируем, только «портативные» папки
            for special in _PORTABLE_FAVORITE_NAMES:
                p = os.path.join(root, special)
                if os.path.isdir(p):
                    report(f"Сканирую: {p}")
                    walk_dir(p, 3, False)
            continue
        depth = 3 if is_removable else 2
        # Сначала любимые папки
        for special in _PORTABLE_FAVORITE_NAMES:
            p = os.path.join(root, special)
            if os.path.isdir(p):
                report(f"Сканирую: {p}")
                walk_dir(p, depth + 1, is_removable)
        # Затем корень
        report(f"Сканирую корень: {root}")
        walk_dir(root, depth, is_removable)

    out = list(results.values())
    out.sort(key=lambda x: (x["name"].lower(), x["path"].lower()))
    return out


def _portable_recycle(paths):
    """
    Перемещает указанные пути в Корзину через SHFileOperationW.
    Возвращает True при успехе.
    """
    if not paths:
        return False
    FO_DELETE = 3
    FOF_ALLOWUNDO = 0x0040
    FOF_NOCONFIRMATION = 0x0010
    FOF_SILENT = 0x0004
    FOF_NOERRORUI = 0x0400

    class SHFILEOPSTRUCTW(ctypes.Structure):
        _fields_ = [
            ("hwnd", wintypes.HWND),
            ("wFunc", wintypes.UINT),
            ("pFrom", wintypes.LPCWSTR),
            ("pTo", wintypes.LPCWSTR),
            ("fFlags", ctypes.c_uint16),
            ("fAnyOperationsAborted", wintypes.BOOL),
            ("hNameMappings", wintypes.LPVOID),
            ("lpszProgressTitle", wintypes.LPCWSTR),
        ]

    # Двойной \0 в конце каждого пути
    buf = "\0".join(os.path.abspath(p) for p in paths) + "\0\0"
    op = SHFILEOPSTRUCTW()
    op.hwnd = None
    op.wFunc = FO_DELETE
    op.pFrom = buf
    op.pTo = None
    op.fFlags = (FOF_ALLOWUNDO | FOF_NOCONFIRMATION |
                  FOF_SILENT | FOF_NOERRORUI)
    try:
        res = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))
        return res == 0 and not op.fAnyOperationsAborted
    except Exception as e:
        log_error("_portable_recycle", e)
        return False


def _load_portable_async():
    """Запускает сканирование портативных приложений в фоне."""
    programs_ui["portable_scanning"] = True
    try:
        programs_ui["status"].configure(
            text="⏳ Поиск портативных приложений...",
            text_color="#FFD54F")
    except Exception:
        pass

    def progress_cb(msg):
        try:
            app.after(0, lambda m=msg: programs_ui["status"].configure(
                text=f"⏳ {m}", text_color="#FFD54F"))
        except Exception:
            pass

    def worker():
        try:
            items = _scan_portable_apps(progress_cb)
        except Exception as e:
            log_error("_scan_portable_apps", e)
            items = []

        # Обогащаем данными (издатель, версия, иконка) — только для 150 элементов
        enriched = []
        total = min(len(items), 150)
        for i, it in enumerate(items[:150]):
            if i % 10 == 0:
                try:
                    app.after(0, lambda n=i, t=total:
                        programs_ui["status"].configure(
                            text=f"⏳ Обработка иконок: {n}/{t}...",
                            text_color="#FFD54F"))
                except Exception:
                    pass
            info = _get_exe_version_info(it["path"])
            it["publisher"] = info["publisher"]
            it["version"] = info["version"]
            it["description"] = info["description"]
            try:
                pil = _extract_icon_pil(it["path"], 32)
                if pil is None:
                    pil = _make_placeholder_icon(it["name"], 32)
                it["_pil_icon"] = pil
            except Exception:
                it["_pil_icon"] = None
            enriched.append(it)

        # Остальные — без иконок
        for it in items[150:]:
            info = _get_exe_version_info(it["path"])
            it["publisher"] = info["publisher"]
            it["version"] = info["version"]
            it["description"] = info["description"]
            it["_pil_icon"] = None
            enriched.append(it)

        programs_ui["portable_cache"] = enriched
        programs_ui["portable_scanning"] = False
        app.after(0, refresh_programs_ui)

    threading.Thread(target=worker, daemon=True).start()


def _portable_delete_items(paths):
    """Удаляет список .exe-файлов в Корзину с подтверждением."""
    if not paths:
        return
    # Проверка на запущенные
    running = [p for p in paths if _is_path_running(p)]
    if running:
        names = "\n".join(f"• {os.path.basename(p)}" for p in running[:5])
        if not messagebox.askyesno(
            "⚠️ Некоторые процессы запущены",
            f"Следующие файлы сейчас используются:\n\n{names}\n\n"
            f"Они будут пропущены. Продолжить удаление остальных?"):
            return
        paths = [p for p in paths if p not in running]
    if not paths:
        messagebox.showinfo("Optix", "Нечего удалять.")
        return

    names = "\n".join(f"• {os.path.basename(p)}" for p in paths[:15])
    if len(paths) > 15:
        names += f"\n... и ещё {len(paths) - 15}"
    if not messagebox.askyesno(
        "Удалить в Корзину?",
        f"Будет перемещено в Корзину файлов: {len(paths)}\n\n"
        f"{names}\n\n"
        f"Файлы можно восстановить из Корзины.\n\n"
        f"Продолжить?"):
        return

    ok = _portable_recycle(paths)
    if ok:
        try:
            show_toast("Optix — портативные", f"Удалено: {len(paths)}")
        except Exception:
            pass
        messagebox.showinfo("Готово",
            f"Перемещено в Корзину: {len(paths)}")
        # Обновляем кэш
        ps = {os.path.normcase(p) for p in paths}
        programs_ui["portable_cache"] = [
            x for x in programs_ui.get("portable_cache", [])
            if os.path.normcase(x["path"]) not in ps
        ]
        refresh_programs_ui()
    else:
        messagebox.showerror(
            "Ошибка",
            "Не удалось переместить в Корзину. "
            "Возможно, файлы используются.")


def _portable_export(fmt="csv"):
    """Экспорт списка портативных приложений."""
    items = programs_ui.get("portable_cache", [])
    if not items:
        messagebox.showinfo("Optix", "Список пуст.")
        return
    ts = datetime.now().strftime("%Y-%m-%d_%H-%M")
    if fmt == "csv":
        default = f"Optix_Portable_{ts}.csv"
        path = filedialog.asksaveasfilename(
            title="Экспорт CSV", defaultextension=".csv",
            initialfile=default, filetypes=[("CSV", "*.csv")])
        if not path:
            return
        try:
            import csv
            with open(path, "w", encoding="utf-8-sig", newline="") as f:
                w = csv.writer(f, delimiter=";")
                w.writerow(["Имя", "Файл", "Издатель", "Версия",
                            "Размер", "Дата изменения", "Съёмный",
                            "Папка", "Полный путь"])
                for it in items:
                    w.writerow([
                        it["name"], it["filename"],
                        it.get("publisher", ""),
                        it.get("version", ""),
                        human_size(it["size"]),
                        datetime.fromtimestamp(it["mtime"])
                            .strftime("%Y-%m-%d %H:%M"),
                        "да" if it.get("is_removable") else "",
                        it["folder"], it["path"],
                    ])
            messagebox.showinfo("Готово", f"CSV сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))
    elif fmt == "json":
        default = f"Optix_Portable_{ts}.json"
        path = filedialog.asksaveasfilename(
            title="Экспорт JSON", defaultextension=".json",
            initialfile=default, filetypes=[("JSON", "*.json")])
        if not path:
            return
        try:
            data = []
            for it in items:
                data.append({
                    "name": it["name"],
                    "filename": it["filename"],
                    "publisher": it.get("publisher", ""),
                    "version": it.get("version", ""),
                    "size_bytes": it["size"],
                    "mtime": it["mtime"],
                    "is_removable": it.get("is_removable", False),
                    "folder": it["folder"],
                    "path": it["path"],
                })
            with open(path, "w", encoding="utf-8") as f:
                json.dump({
                    "exported": datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"),
                    "computer": os.environ.get("COMPUTERNAME", "?"),
                    "total": len(data),
                    "items": data,
                }, f, ensure_ascii=False, indent=2)
            messagebox.showinfo("Готово", f"JSON сохранён:\n{path}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))


def _refresh_portable_ui(query="", sort_by="По имени"):
    from PIL import ImageTk
    items = programs_ui.get("portable_cache", [])
    scanning = programs_ui.get("portable_scanning", False)

    if query:
        q = query.lower()
        items = [it for it in items if q in it["name"].lower() or q in it.get("publisher", "").lower() or q in it["path"].lower()]

    if sort_by == "По размеру": items.sort(key=lambda x: -x["size"])
    elif sort_by == "По дате": items.sort(key=lambda x: -x["mtime"])
    elif sort_by == "По издателю": items.sort(key=lambda x: ((x.get("publisher", "") or "").lower(), x["name"].lower()))
    else: items.sort(key=lambda x: x["name"].lower())

    lst = programs_ui["list_frame"]
    for w in lst.winfo_children(): w.destroy()
    programs_ui["_portable_icon_refs"].clear()

    if scanning:
        ctk.CTkLabel(lst, text="⏳ Идёт сканирование...\n\nОбход дисков может занять 30–120 секунд.",
                     font=("Inter", 13), text_color="#FFD54F").pack(pady=40)
        return

    if not items:
        ctk.CTkLabel(lst, text="Портативных приложений не найдено.\n\nНажмите «🔄 Скан портативных».",
                     font=("Inter", 13), text_color="#90A4AE").pack(pady=40)
        programs_ui["status"].configure(text="Портативных приложений: 0", text_color="#90A4AE")
        return

    total_size = sum(it["size"] for it in items)
    removable_count = sum(1 for it in items if it.get("is_removable"))
    programs_ui["status"].configure(
        text=f"Портативных: {len(items)}   •   Общий размер: {human_size(total_size)}   •   На съёмных: {removable_count}",
        text_color="#4FC3F7")

    to_show = items[:200]
